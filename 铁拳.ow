规则("死亡")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	动作
	{
		事件玩家.degene = 1;
		创建地图文本(事件玩家.degene == 1 ? 已过滤的数组(所有玩家(所有队伍), 当前数组元素.hero == 英雄(莫伊拉)) : 空, 自定义字符串("{0}", 数组包含(所有输出英雄, 所用英雄(事件玩家)) || (所用英雄(事件玩家)
			== 英雄(末日铁拳) && 事件玩家.ZT[0] == 0) ? 技能图标字符串(英雄(猎空), 按钮(主要攻击模式)) : (数组包含(所有重装英雄, 所用英雄(事件玩家)) ? 技能图标字符串(英雄(毛加), 按钮(技能2)) : 技能图标字符串(
			英雄(雾子), 按钮(主要攻击模式)))), 眼睛位置(事件玩家), 2, 根据表面截取, 可见, 颜色(白色), 默认可见度);
		事件玩家.TX[90] = 上一个文本ID;
		根据条件跳过(已过滤的数组(所有玩家(所有队伍), 当前数组元素.hero == 英雄(毛加) && 存活(当前数组元素)) == 空数组, 1);
		已过滤的数组(所有玩家(所有队伍), 当前数组元素.hero == 英雄(毛加) && 存活(当前数组元素)).mga[2] = 1;
		If((所用英雄(事件玩家) == 英雄(末日铁拳) && 事件玩家.ZT[0] == 1) || (所用英雄(事件玩家) == 英雄(艾什)) || 所用英雄(事件玩家) == 英雄(拉玛刹));
			事件玩家.va = 0;
			根据条件跳过(所用英雄(事件玩家) != 英雄(拉玛刹), 2);
			等待(0.016, 无视条件);
			事件玩家.Pain[0] = 0;
		Else If(所用英雄(事件玩家) == 英雄(死神));
			根据条件跳过(事件玩家.RPkill[0] < 13 || 随机整数(0, 1) > 0, 6);
			复活(事件玩家);
			事件玩家.va = 终极技能充能百分比(事件玩家);
			设置终极技能充能(事件玩家, 100);
			按下按键(事件玩家, 按钮(终极技能));
			等待(0.016, 无视条件);
			设置终极技能充能(事件玩家, 事件玩家.va);
		Else If(所用英雄(事件玩家) == 英雄(猎空));
			根据条件跳过(随机整数(0, 9) > 0, 3);
			复活(事件玩家);
			设置技能冷却(事件玩家, 按钮(技能2), 0);
			按下按键(事件玩家, 按钮(技能2));
		Else If(所用英雄(事件玩家) == 英雄(奥丽莎));
			事件玩家.va3 = 3;
		Else If(所用英雄(事件玩家) == 英雄(温斯顿));
			大字体信息(所有玩家(所有队伍), 数组随机取值(全局.say));
		End;
		等待直到 (存活(事件玩家), 1);
		等待直到 (存活(事件玩家) || 已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(天使) && 正在使用表情交流(当前数组元素)) != 空数组 || (正在等待玩家 && 按钮被按下(事件玩家, 按钮(跳跃))),
			99);
		事件玩家.degene = 0;
		消除地图文本(事件玩家.TX[90]);
		If(事件玩家.hero == 英雄(破坏球));
			设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
		End;
		根据条件中止(存活(事件玩家));
		传送(事件玩家, 重生点(所在队伍(事件玩家)));
		复活(事件玩家);
