		调整玩家队伍(事件玩家, 对方队伍(所在队伍(事件玩家)), -1);
		If(事件玩家.hero == 英雄(巴蒂斯特));
			根据条件中止(在地面上(事件玩家) || 事件玩家.pd == 0);
			施加推力(事件玩家, 下, 40, 至地图, 取消相反运动XYZ);
