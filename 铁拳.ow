规则("互动")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		根据条件跳过(!正在使用表情交流(事件玩家), 1);
		事件玩家.hud = 绝对值(事件玩家.hud - 1);
		If(事件玩家.hero == 英雄(托比昂));
			等待直到 ((事件玩家.hack < 1 && 事件玩家.kong == 0 && (按钮被按下(事件玩家, 按钮(主要攻击模式)) || 按钮被按下(事件玩家, 按钮(辅助攻击模式)) || 按钮被按下(事件玩家, 按钮(装填)) || 按钮被按下(事件玩家,
				按钮(近身攻击)) || 按钮被按下(事件玩家, 按钮(技能1)) || 按钮被按下(事件玩家, 按钮(技能2)))) || !按钮被按下(事件玩家, 按钮(互动)) || 事件玩家.hero != 英雄(托比昂), 99999);
			根据条件中止(!按钮被按下(事件玩家, 按钮(互动)));
			根据条件循环(事件玩家.hero != 英雄(托比昂));
			If(事件玩家.tob[1] > 0 && 按钮被按下(事件玩家, 按钮(辅助攻击模式)));
				事件玩家.dansu += 事件玩家.tob[1] == 1 ? -400 : 400;
				事件玩家.tob[1] = 事件玩家.tob[1] == 1 ? 2 : 1;
				小字体信息(事件玩家, 自定义字符串("   5倍弹速(全英雄通用) {0}", 事件玩家.tob[1] == 1 ? 图标字符串(对号) : 图标字符串(X)));
			Else If(终极技能充能百分比(事件玩家) == 100);
				设置终极技能充能(事件玩家, 0);
				If(按钮被按下(事件玩家, 按钮(主要攻击模式)));
					事件玩家.tob[0] += 0.300;
					大字体信息(所有玩家(所有队伍), 自定义字符串("{0}{1}：{2}+30%伤害", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家, 技能图标字符串(英雄(托比昂), 按钮(主要攻击模式))));
				Else If(按钮被按下(事件玩家, 按钮(近身攻击)));
					事件玩家.tob[3] += 0.500;
					大字体信息(所有玩家(所有队伍), 自定义字符串("{0}{1}：锻造锤+50%伤害", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家));
				Else If(按钮被按下(事件玩家, 按钮(技能2)));
					事件玩家.tob[5] += 50;
					根据条件跳过(!正在使用技能 2(事件玩家), 3);
					为玩家添加生命池(事件玩家, 生命值, 50, 假, 假);
					修改玩家变量(事件玩家, pd4, 添加至数组, 最后创建的生命池);
					事件玩家.yisu += 50;
					设置技能冷却(事件玩家, 按钮(技能2), 0);
					大字体信息(所有玩家(所有队伍), 自定义字符串("{0}{1}：{2}+50生命 +50%移速", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家, 技能图标字符串(英雄(托比昂), 按钮(技能2))));
				Else If(按钮被按下(事件玩家, 按钮(装填)) && 事件玩家.tob[2] == 0);
					事件玩家.tob[2] = 999;
					设置最大弹药(事件玩家, 0, 事件玩家.tob[2]);
					大字体信息(所有玩家(所有队伍), 自定义字符串("{0}{1}：{2}备弹999", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家, 技能图标字符串(英雄(托比昂), 按钮(主要攻击模式))));
				Else If(按钮被按下(事件玩家, 按钮(技能1)) && 事件玩家.tob[4] == 0);
					事件玩家.tob[4] = 1;
					设置技能冷却(事件玩家, 按钮(技能1), 0);
					大字体信息(所有玩家(所有队伍), 自定义字符串("{0}{1}：{2}无冷却", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家, 技能图标字符串(英雄(托比昂), 按钮(技能1))));
				Else If(按钮被按下(事件玩家, 按钮(辅助攻击模式)));
					事件玩家.tob[1] = 1;
					事件玩家.dansu += 400;
					大字体信息(所有玩家(所有队伍), 自定义字符串("{0}{1} 解锁：5倍弹速(全英雄通用)", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家));
				End;
				播放效果(所有玩家(所有队伍), 有益选择效果 , 所在队伍(事件玩家), 事件玩家, 1);
			End;
		Else If(事件玩家.hero == 英雄(布丽吉塔));
			等待直到 ((事件玩家.hack < 1 && 事件玩家.kong == 0 && 终极技能充能百分比(事件玩家) == 100 && (按钮被按下(事件玩家, 按钮(装填)) || 按钮被按下(事件玩家, 按钮(技能2)))) || !按钮被按下(事件玩家,
				按钮(互动)) || 事件玩家.hero != 英雄(布丽吉塔), 99999);
			根据条件中止(!按钮被按下(事件玩家, 按钮(互动)));
			根据条件循环(事件玩家.hero != 英雄(布丽吉塔));
			If(按钮被按下(事件玩家, 按钮(装填)));
				为玩家添加生命池(事件玩家, 护甲, 50, 真, 假);
				事件玩家.bri[0] += 50;
				事件玩家.bri[9] += 50;
				设置技能充能(事件玩家, 按钮(技能2), 技能充能(事件玩家, 按钮(技能2)) + 1);
				设置终极技能充能(事件玩家, 0);
				播放效果(所有玩家(所有队伍), 有益选择效果 , 颜色(橙色), 事件玩家, 1);
				大字体信息(所有玩家(所有队伍), 自定义字符串("{0}{1} +50永久护甲", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家));
			Else If(按钮被按下(事件玩家, 按钮(技能2)));
				设置技能充能(事件玩家, 按钮(技能2), 技能充能(事件玩家, 按钮(技能2)) + 1);
				等待直到 (正在使用技能 2(事件玩家) || !按钮被按下(事件玩家, 按钮(技能2)) || !按钮被按下(事件玩家, 按钮(互动)) || 事件玩家.hero != 英雄(布丽吉塔), 99999);
				根据条件跳过(正在使用技能 2(事件玩家) || 事件玩家.hero != 英雄(布丽吉塔), 1);
				设置技能充能(事件玩家, 按钮(技能2), 技能充能(事件玩家, 按钮(技能2)) - 1);
				根据条件中止(!按钮被按下(事件玩家, 按钮(技能2)) || !按钮被按下(事件玩家, 按钮(互动)) || 事件玩家.hero != 英雄(布丽吉塔));
				事件玩家.player = 首个(已排序的数组(已过滤的数组(范围内玩家(事件玩家, 27, 所在队伍(事件玩家), 关闭), 存活(当前数组元素) && 当前数组元素 != 事件玩家), 矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家),
					当前数组元素))));
				设置终极技能充能(事件玩家, 0);
				等待(相距距离(事件玩家, 事件玩家.player) / 45, 无视条件);
				为玩家添加生命池(事件玩家.player, 护甲, 50, 真, 假);
				事件玩家.player.bri[0] += 50;
				事件玩家.player.bri[9] += 50;
				播放效果(所有玩家(所有队伍), 有益选择效果 , 颜色(橙色), 事件玩家.player, 1);
				大字体信息(所有玩家(所有队伍), 自定义字符串("{2} 提供{0}{1} 50永久护甲", 英雄图标字符串(事件玩家.player.hero), 事件玩家.player, 自定义字符串("{0}{1}", 英雄图标字符串(所用英雄(事件玩家)),
					事件玩家)));
			End;
		End;
	}
}

规则("受击退")
{
	事件
	{
		玩家受到击退;
		双方;
		全部;
	}

	动作
	{
		If(攻击方.hero == 英雄(狂鼠));
			根据条件中止(攻击方 != 事件玩家 || 事件技能 != 按钮(技能1));
			事件玩家.fast[0] = 1;
		Else If(攻击方.hero == 英雄(士兵：76));
			根据条件中止(攻击方 != 事件玩家);
			施加推力(事件玩家, 事件方向, 0.144 * (100 + 攻击方.jitui), 至地图, 合并相反运动);
		Else If(攻击方.hero == 英雄(毛加));
			根据条件中止(!事件暴击);
			伤害(事件玩家, 攻击方, 生命值(攻击方) * 0.200);
		Else If(攻击方.hero == 英雄(D.Va));
			根据条件中止(全局.game != 5 || 事件技能 != 按钮(技能1));
			攻击方.dva[0] += 1;
		Else If(攻击方.hero == 英雄(破坏球));
			If(事件技能 == 按钮(辅助攻击模式));
				设置技能冷却(攻击方, 按钮(辅助攻击模式), 技能冷却时间(攻击方, 按钮(辅助攻击模式)) - 1);
				攻击方.va += 1;
				根据条件跳过((事件伤害 + 生命值(事件玩家)) / 最大生命值(事件玩家) < 0.500 || 事件伤害 == 0, 1);
				伤害(事件玩家, 攻击方, 60);
			Else If(事件伤害 > 0);
				If(事件技能 == 按钮(蹲下));
					根据条件中止((事件伤害 + 生命值(事件玩家)) / 最大生命值(事件玩家) < 0.500);
					根据条件跳过(生命值(事件玩家) > 事件伤害, 1);
					伤害(事件玩家, 攻击方, 100000);
					设置玩家生命值(事件玩家, 生命值(事件玩家) - 事件伤害);
				Else If(事件技能 == 按钮(终极技能) && (事件玩家.hero == 英雄(毛加) && 正在使用终极技能(事件玩家)) == 假);
					事件玩家.ballQ[0] = 1;
				End;
			End;
		Else If(攻击方.hero == 英雄(末日铁拳));
			根据条件中止(!具有状态(事件玩家, 无敌) || (攻击方.ZT[0] == 1 && 攻击方.pd3 != 1) || 事件技能 != 按钮(辅助攻击模式));
			创建弹道(球弹道, 空, 事件玩家, 上, 至地图, 伤害, 所有队伍, 攻击方.ZT[0] == 0 ? 25 : 64, 1, 0, 有益爆炸, 爆炸声音, 0, 1000, 0.100, 0, 0, 0);
		Else If(事件玩家.BT == 0);
			If(攻击方.hero == 英雄(查莉娅));
				根据条件中止(攻击方.zt == 0 || 攻击方 == 事件玩家 || 事件技能 != 按钮(辅助攻击模式));
				设置状态(事件玩家, 攻击方, 定身, 0.500);
			Else If(攻击方.hero == 英雄(布丽吉塔));
				根据条件中止(事件技能 != 按钮(主要攻击模式));
				设置状态(事件玩家, 攻击方, 击晕, 0.900);
			Else If(事件玩家.BT2 == 0);
				If(攻击方.hero == 英雄(法老之鹰));
					根据条件中止(!按钮被按下(攻击方, 按钮(技能2)) || 攻击方 == 事件玩家 || 事件技能 != 按钮(技能2));
					施加推力(事件玩家, 速率(事件玩家), -1 * 速度(事件玩家), 至地图, 合并相反运动);
					根据条件中止(事件伤害 != 0);
					施加推力(事件玩家, 事件方向, -10, 至地图, 取消相反运动);
				Else If(攻击方.hero == 英雄(艾什));
					根据条件中止(事件技能 != 按钮(终极技能));
					设置状态(事件玩家, 攻击方, 击晕, 1);
				Else If(攻击方.hero == 英雄(朱诺));
					根据条件中止(事件技能 != 按钮(近身攻击));
					施加推力(事件玩家, 上 + 地图矢量(前, 攻击方, 旋转), 70, 至地图, 取消相反运动XYZ);
					设置地形消灭者玩家(事件玩家, 攻击方);
				Else If(攻击方.hero == 英雄(天使));
					根据条件中止(事件技能 != 按钮(近身攻击) || 武器(攻击方) != 1);
					施加推力(事件玩家, 面朝方向(攻击方), 70, 至地图, 取消相反运动XYZ);
					设置地形消灭者玩家(事件玩家, 攻击方);
				Else If(攻击方.hero == 英雄(渣客女王));
					根据条件中止(全局.map == 0 || 事件伤害 > 0 || !数组包含(所有重装英雄, 事件玩家.hero) || 事件玩家.hero == 英雄(莱因哈特) || 事件技能 != 按钮(辅助攻击模式));
					施加推力(事件玩家, 事件方向, 3.600, 至地图, 合并相反运动);
				End;
			End;
		End;
	}
}

规则("坠落")
{
	事件
	{
		玩家受到击退;
		双方;
		全部;
	}

	动作
	{
		根据条件中止(攻击方.hero != 英雄(探奇) || 事件技能 != 按钮(终极技能) || 随机整数(0, 9) > 0);
		取消与环境的移动碰撞(事件玩家, 真);
		等待直到 (死亡(事件玩家) || 具有状态(事件玩家, 无敌) || 具有状态(事件玩家, 相移), 1);
		If((事件玩家.hero == 英雄(探奇) && 正在使用技能 1(事件玩家)) || 正在近战攻击(事件玩家) || (正在使用辅助武器(事件玩家) && 按钮被按下(事件玩家, 按钮(辅助攻击模式))) || (事件玩家.hero == 英雄(美)
			&& 正在使用技能 1(事件玩家)) || ((事件玩家.hero == 英雄(禅雅塔) || 事件玩家.hero == 英雄(毛加)) && 正在使用终极技能(事件玩家)));
			取消与环境的移动碰撞(事件玩家, 假);
		Else;
			开启与环境的移动碰撞(事件玩家);
		End;
	}
}

规则("西格玛q")
{
	事件
	{
		玩家受到击退;
		双方;
		全部;
	}

	动作
	{
		根据条件中止(攻击方.hero != 英雄(西格玛) || 事件技能 != 按钮(终极技能));
		设置弹道引力(事件玩家, 0);
		事件玩家.dansu -= 1000;
		If(事件玩家.hero == 英雄(D.Va) && !处于非初始状态(事件玩家));
			等待直到 ((事件玩家.hero == 英雄(D.Va) && 处于非初始状态(事件玩家)) || (事件玩家.BT > 0) || 死亡(事件玩家), 2.300);
		Else;
			等待直到 (事件玩家.BT > 0 || 死亡(事件玩家), 2.300);
		End;
		设置弹道引力(事件玩家, 100);
		事件玩家.dansu += 1000;
	}
}

规则("感应地雷")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.ballQ[0] == 1;
	}

	动作
	{
		事件玩家.ballQ[0] = 0;
		根据条件跳过(事件玩家.ballQ[1] != 0, 3);
		开始调整玩家大小(事件玩家, 0.500, 假);
		事件玩家.yisu -= 50;
		事件玩家.ballQ[1] = 事件玩家.hero;
		等待直到 (事件玩家.ballQ[0] == 1 || 具有状态(事件玩家, 相移) || 具有状态(事件玩家, 无敌) || 死亡(事件玩家) || (事件玩家.hero == 英雄(毛加) && 正在使用终极技能(事件玩家))
			|| 事件玩家.ballQ[1] != 事件玩家.hero, 5);
		如条件为“真”则循环;
		事件玩家.yisu += 50;
		事件玩家.ballQ[1] = 0;
		根据条件中止(事件玩家.hero == 英雄(毛加) && 正在使用终极技能(事件玩家));
		停止调整玩家大小(事件玩家);
	}
}

规则("击杀")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		If(事件玩家.hero == 英雄(死神));
			事件玩家.RPkill[0] += 1;
			事件玩家.dam += 1;
		Else If(事件玩家.hero == 英雄(黑百合));
			设置玩家生命值(事件玩家, 10000);
			移除玩家的生命池(事件玩家.va2);
			为玩家添加生命池(事件玩家, 生命值, 100, 假, 假);
			事件玩家.va2 = 最后创建的生命池;
			设置弹药(事件玩家, 0, 较大(弹药(事件玩家, 0), 35));
			设置技能冷却(事件玩家, 按钮(技能1), 0);
			设置技能冷却(事件玩家, 按钮(技能2), 0);
		Else If(事件玩家.hero == 英雄(艾什));
			事件玩家.ash[0] += 1;
		Else If(事件玩家.hero == 英雄(弗蕾娅));
			根据条件中止(事件技能 != 按钮(终极技能));
			设置终极技能充能(事件玩家, 100);
		Else If(事件玩家.hero == 英雄(毛加));
			事件玩家.mga[0] += 5;
			设置最大生命值(事件玩家, 100 + 事件玩家.mga[0]);
		Else If(事件玩家.hero == 英雄(回声));
			根据条件中止(所用英雄(被攻击方) != 英雄(回声));
			设置终极技能充能(事件玩家, 终极技能充能百分比(事件玩家) + 终极技能充能百分比(被攻击方));
		Else If(事件玩家.hero == 英雄(D.Va));
			根据条件中止(((全局.game == 0 && 事件技能 == 按钮(主要攻击模式) && 处于非初始状态(事件玩家)) || (全局.game == 1 && 事件技能 == 按钮(近身攻击)) || (全局.game == 2 && 事件技能 == 按钮(
				终极技能) && 终极技能充能百分比(事件玩家) > 0) || (全局.game == 3 && 事件技能 == 按钮(终极技能) && 终极技能充能百分比(事件玩家) == 0)) == 假);
			事件玩家.dva[0] += 1;
		End;
	}
}

规则("参与消灭")
{
