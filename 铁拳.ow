		事件玩家.getheal += 10;
		事件玩家.dam += 事件玩家.xie != 英雄(托比昂) ? 10 : 15;
		等待直到 (已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(禅雅塔) && 当前数组元素.pd == 事件玩家) == 空数组, 99999);
		事件玩家.dam -= 事件玩家.xie != 英雄(托比昂) ? 10 : 15;
		事件玩家.getdam += 10;
		事件玩家.heal -= 10;
		事件玩家.getheal -= 10;
	}
}

规则("乱")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 当前数组元素.hero == 英雄(禅雅塔) && 当前数组元素.va == 事件玩家) != 空数组;
	}

	动作
	{
		等待(2, 当为“假”时中止);
		事件玩家.RDM[4] = 随机整数(0, 9);
		If(事件玩家.RDM[4] == 0);
			设置状态(事件玩家, 空, 击晕, 1);
		Else If(事件玩家.RDM[4] < 4);
			开始定向阈值(事件玩家, 地图矢量(数组随机取值(数组(前, 后, 左, 右)), 事件玩家, 旋转), 1, 至地图, 替换现有阈值, 无);
			等待直到 (已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 当前数组元素.hero == 英雄(禅雅塔) && 当前数组元素.va == 事件玩家) == 空数组, 0.700);
			根据条件跳过(事件玩家.GO == 1, 1);
			停止定向阈值(事件玩家);
		Else If(事件玩家.RDM[4] < 7);
			按下按键(事件玩家, 数组随机取值(数组(按钮(主要攻击模式), 按钮(辅助攻击模式), 按钮(技能1), 按钮(技能2), 按钮(终极技能), 按钮(互动), 按钮(跳跃), 按钮(蹲下), 按钮(近身攻击), 按钮(装填))));
		Else;
			设置朝向(事件玩家, 面朝方向(事件玩家) + 矢量(随机实数(0, 1), 随机实数(0, 1), 随机实数(0, 1)), 至地图);
		End;
		如条件为“真”则循环;
	}
}

规则("防住目标点")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		全局.map2 == 1;
		(事件玩家.hero == 英雄(探奇) || 事件玩家.hero == 英雄(禅雅塔) || 事件玩家.hero == 英雄(毛加)) == 真;
		((当前地图 == 地图(南极半岛) && 相距距离(事件玩家, 目标位置(2)) < 1.800) || (当前地图 == 地图(尼泊尔) && 相距距离(事件玩家, 目标位置(1)) < 2.280) || (当前地图 == 地图(漓江塔) && (
			相距距离(事件玩家, 目标位置(1)) < 2.500 || 相距距离(事件玩家, 目标位置(2)) < 2.300)) || (当前地图 == 地图(绿洲城) && 相距距离(事件玩家, 目标位置(1)) < 2.200) || (
			当前地图 == 地图(釜山) && 相距距离(事件玩家, 目标位置(1)) < 10.430) || (字符串包含(自定义字符串("{0}", 当前地图), 自定义字符串("花村")) && (相距距离(事件玩家, 矢量(-2.910, -0.920,
			-82.410)) < 1.400 || 相距距离(事件玩家, 矢量(-8.690, -0.920, -76.850)) < 1.400))) == 真;
	}

	动作
	{
		取消与环境的移动碰撞(事件玩家, 假);
		施加推力(事件玩家, 上, 2, 至地图, 取消相反运动XYZ);
		施加推力(事件玩家, 数组随机取值(数组(前, 后, 左, 右)), 10, 至地图, 取消相反运动XYZ);
		等待(0.100, 无视条件);
		如条件为“真”则循环;
		根据条件中止((事件玩家.hero == 英雄(探奇) && (正在近战攻击(事件玩家) || 正在使用技能 1(事件玩家) || (正在使用辅助武器(事件玩家) && 按钮被按下(事件玩家, 按钮(辅助攻击模式))))) || ((
			事件玩家.hero == 英雄(禅雅塔) || 事件玩家.hero == 英雄(毛加)) && 正在使用终极技能(事件玩家)));
		开启与环境的移动碰撞(事件玩家);
	}
}