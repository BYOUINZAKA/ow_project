{
	事件
	{
		子程序;
		CAM;
	}

	动作
	{
		事件玩家.Cam = (事件玩家.Cam + 1) % 2;
		调用子程序(camera);
	}
}

规则("子程序Map——”地图随机取点“取自W00S6，感谢扑向小白兔")
{
	事件
	{
		子程序;
		Map;
	}

	动作
	{
		等待直到 (总计消耗时间 >= 1, 99999);
		If(当前游戏模式 != 游戏模式(团队死斗) && 当前游戏模式 != 游戏模式(死斗));
			全局.Map_Position[0] = 目标位置(对象索引);
			"此变量为采集点位之间的半径系数，5乘以此系数为最终距离。小图尽量缩短，大图可以增加。以80个点位为例，一般大图点位之间相隔10多米都是没问题的，计算也很快。占点图这种，尽量保证5米以内，计算快一些"
			全局.Map_Height[2] = 1.750;
			全局.Map_Position[1] = 映射的数组(重生点(队伍2), 当前数组元素 + 矢量(0, 0, 0))[4];
			全局.Map_Position[2] = 映射的数组(重生点(队伍1), 当前数组元素 + 矢量(0, 0, 0))[4];
			If(全局.Map_Position[0] == 矢量(0, 0, 0));
				全局.Map_Position[0] = 最近的可行走位置((全局.Map_Position[1] + 全局.Map_Position[2]) / 2);
			End;
			等待(0.016, 无视条件);
			全局.Map_Position[3] = 最近的可行走位置((全局.Map_Position[0] + 全局.Map_Position[1]) / 2);
			全局.Map_Position[4] = 最近的可行走位置((全局.Map_Position[0] + 全局.Map_Position[2]) / 2);
			If(当前游戏模式 == 游戏模式(决斗先锋) || 当前游戏模式 == 游戏模式(勇夺锦旗) || 自定义字符串("{0}", 当前游戏模式) == 自定义字符串("占领要点"));
				全局.Map_Position[5] = 最近的可行走位置((全局.Map_Position[1] + 全局.Map_Position[2]) / 2);
				If(相距距离(全局.Map_Position[0], 全局.Map_Position[5]) < 25);
					修改全局变量(Map_Position, 根据索引从数组中移除, 5);
				End;
				全局.Map_Height[2] = 1;
			Else;
				"新出模式及抢旗模式本身没有给出目标点对象索引，好在返回的0.0.0里目标点都非常接近，暂时可以忽略这点。抢旗也可用旗帜位置。"
				If(自定义字符串("{0}", 当前游戏模式) == 自定义字符串("闪点作战") || 自定义字符串("{0}", 当前游戏模式) == 自定义字符串("攻防阵线"));
					全局.Map_Position[5] = 最近的可行走位置((全局.Map_Position[3] + 全局.Map_Position[1]) / 2);
					全局.Map_Position[6] = 最近的可行走位置((全局.Map_Position[3] + 全局.Map_Position[0]) / 2);
					全局.Map_Position[7] = 最近的可行走位置((全局.Map_Position[4] + 全局.Map_Position[2]) / 2);
					全局.Map_Position[8] = 最近的可行走位置((全局.Map_Position[4] + 全局.Map_Position[0]) / 2);
					全局.Map_Height[2] = 2;
				Else;
					全局.Map_Position[5] = 目标位置(1);
					全局.Map_Position[6] = 最近的可行走位置((全局.Map_Position[0] + 全局.Map_Position[5]) / 2);
					If(目标位置(2) != 矢量(0, 0, 0));
						全局.Map_Position[7] = 目标位置(2);
						全局.Map_Position[8] = 最近的可行走位置((全局.Map_Position[7] + 全局.Map_Position[5]) / 2);
					End;
				End;
			End;
		Else;
			全局.Map_Position = 映射的数组(重生点(所有队伍), 当前数组元素 + 矢量(0, 0, 0));
			全局.Map_Height[2] = 1;
		End;
		等待(0.016, 无视条件);
		全局.Map_Height[0] = Y方向分量(已排序的数组(全局.Map_Position, Y方向分量(当前数组元素))[0]);
		调用子程序(Map_1);
		"根据数量分割一半数组，再次扩展，散步更广。可根据点位数量更改分割数"
		全局.Map_Position = 添加至数组(随机数组(数组分割(全局.Map_Position, 20, 20)), 数组分割(全局.Map_Position, 49, 30));
		调用子程序(Map_1);
		全局.Map_Position = 随机数组(全局.Map_Position);
		"矢量数组最低高度，一般都是地图最低点Y轴。少部分地图需加上上一条注释的重生室点位"
		全局.Map_Height[0] = 较小(全局.Map_Height[0], Y方向分量(已排序的数组(全局.Map_Position, Y方向分量(当前数组元素))[0]));
		"一般图的最高Y轴，少部分图可能加50。这个和上个变量设置与否无所谓，用不上就删除。"
		全局.Map_Height[1] = 全局.Map_Height[0] + 40;
	}
}

规则("子程序Map_1")
{
	事件
	{
		子程序;
		Map_1;
	}

	动作
	{
		等待(0.016, 无视条件);
		"想生成点位的数量，如果是小图，建议间隔5米内的点位最多生成90个。大图间隔10米的点位150个左右，计算也是很快的。"
		While(数量(全局.Map_Position) < 90);
			For 全局变量(F, 0, 数量(全局.Map_Position), 1);
				全局.G = 最近的可行走位置(全局.Map_Position[全局.F] + 矢量(随机整数(0, 1) ? 随机整数(全局.Map_Height[2] * -1 * 20, 全局.Map_Height[2] * -5) : 随机整数(
					全局.Map_Height[2] * 5, 全局.Map_Height[2] * 20), 随机整数(0, 15), 随机整数(0, 1) ? 随机整数(全局.Map_Height[2] * -1 * 20, 全局.Map_Height[2] * -5)
					: 随机整数(全局.Map_Height[2] * 5, 全局.Map_Height[2] * 20)));
				等待直到 (服务器负载平均值 <= 240 && 服务器负载 <= 240, 99999);
				等待(0.016, 无视条件);
				If(对任意为“真”(全局.Map_Position, 相距距离(当前数组元素, 全局.G) < 全局.Map_Height[2] * 5));
				Else;
					修改全局变量(Map_Position, 添加至数组, 全局.G);
					"大于80个点退出，可自行更改"
					If(数量(全局.Map_Position) >= 90);
						中断;
					End;
				End;
			End;
		End;
		等待(0.016, 无视条件);
	}
}

规则("防炸")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		服务器负载平均值 > 254;
	}

	动作
	{
		等待(2, 当为“假”时中止);
		设置慢动作(50);
		等待直到 (服务器负载平均值 <= 200, 99999);
		设置慢动作(100);
	}
}

规则("全局")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		禁用查看器录制;
		全局.omn = 数组(英雄(拉玛刹), 英雄(禅雅塔), 英雄(回声), 英雄(堡垒), 英雄(奥丽莎));
		全局.yw = 数组(自定义字符串("脆弱"), 自定义字符串("空间"), 自定义字符串("时间"), 自定义字符串("偏执"), 自定义字符串("报应"), 自定义字符串("永恒"), 自定义字符串("贪婪"));
		全局.say = 数组(自定义字符串("我们只是尘与影。——《When The Darkness Comes》"), 自定义字符串("欲望熄灭时，生命的内核便消逝，独剩空壳。——叔本华"), 自定义字符串("无人永存，无事经久。——泰戈尔"), 自定义字符串(
			"死非生的对立面，而作为生的一部分永存。——村上春树"), 自定义字符串("生命的结局都一样。——海明威"), 自定义字符串("死对于智者并不恐怖，对于善者并非终点。——歌德"), 自定义字符串("不知死，焉知生。——孔子"), 自定义字符串(
			"别以为活着是理所当然，别等到来不及才知道珍惜。——《Saw》"), 自定义字符串("没有死亡，我们都会迷失。——《Hannibal》"), 自定义字符串("我对真理的探索终于结束了, 我要回家了。——《Zima Blue》"), 自定义字符串(
			"我们所知的只是沧海一粟，所不知的却是汪洋大海。——《dark》"), 自定义字符串("死亡无足轻重, 我存在时它还没来, 当它来时我已不在。——伊比鸠鲁"), 自定义字符串("在死亡门前，要思量的不是生命的空虚，而是它的重要性。——苏格拉底"),
			自定义字符串("我并不想送死，只是想确认一下我是否真的活着。——《Cowboy Bebop》"), 自定义字符串("死亡是公平的。——《冰海战记》"), 自定义字符串("死亡那般安详、简单，活着却如此艰难。——《Twilight》"), 自定义字符串(
			"生命的力量在于不顺从。——冯骥才"), 自定义字符串("有些事远比死亡更可怕。——《Star Wars》"), 自定义字符串("世上只有一种英雄主义，那就是在认清生活真相后仍旧热爱它。——罗曼·罗兰"), 自定义字符串(
			"人生有两出悲剧，一是万念俱灰，二是踌躇满志。——萧伯纳"), 自定义字符串("人生天地之间，若白驹过隙，忽然而已。——庄子"), 自定义字符串("现实并不存在。——Alan Watts"), 自定义字符串(
			"永恒只是一瞬间，刚够开一个玩笑。——《荒原狼》"), 自定义字符串("Be water my friend.——李小龙"), 自定义字符串("永远不要只满足于世界的表象，要敢于探索未知的可能。——哈罗德"), 自定义字符串(
			"我们要去的地方，不需要有路。——《回到未来》"), 自定义字符串("什么也无法舍弃，什么也改变不了。——《AOT》"), 自定义字符串("Thisi is the way.——《曼达洛人》"));
		全局.GAME = 数组(自定义字符串("「手枪」击杀10人"), 自定义字符串("「近战」击杀10人"), 自定义字符串("{0}击杀10人", 技能图标字符串(英雄(D.Va), 按钮(终极技能))), 自定义字符串("「呼叫机甲」击杀10人"),
			自定义字符串("使用50个「急救包」"), 自定义字符串("{0}撞击敌人50次", 技能图标字符串(英雄(D.Va), 按钮(技能1))), 自定义字符串("{0}累计造成1w伤害", 技能图标字符串(英雄(D.Va), 按钮(技能2))));
		全局.game = 数组值的索引(全局.GAME, 数组随机取值(全局.GAME));
		全局.map = 自定义字符串("{0}", 当前游戏模式) != 自定义字符串("攻防作战") ? 0 : 1;
		全局.map2 = 当前地图 == 地图(南极半岛) || 当前地图 == 地图(尼泊尔) || 当前地图 == 地图(漓江塔) || 当前地图 == 地图(绿洲城) || 当前地图 == 地图(釜山) || 字符串包含(自定义字符串("{0}", 当前地图),
			自定义字符串("花村")) ? 1 : 0;
		创建HUD文本(本地玩家, 空, 自定义字符串("{0}[收到]换人称 [表情+{1}]关介绍  [表情+蹲]换队\n群915037526", 自定义字符串("{0}{1}{2}", 本地玩家.bri[0] > 0 ? 自定义字符串("+{0}永久护甲\n",
