规则("子程序CS")
{
	事件
	{
		子程序;
		CS;
	}

	动作
	{
		事件玩家.gou = 0;
		事件玩家.SC = 0;
		事件玩家.inseat = 0;
	}
}

规则("子程序TQ")
{
	事件
	{
		子程序;
		TQ;
	}

	动作
	{
		取消与环境的移动碰撞(事件玩家, 假);
		等待直到 ((!正在近战攻击(事件玩家) && !正在使用技能 1(事件玩家) && (!正在使用辅助武器(事件玩家) || !按钮被按下(事件玩家, 按钮(辅助攻击模式)))) || (事件玩家.hero != 英雄(探奇)), 9);
		开启与环境的移动碰撞(事件玩家);
	}
}

规则("子程序pd")
{
	事件
	{
		子程序;
		pd;
	}

	动作
	{
		事件玩家.pd = 首个(已排序的数组(已过滤的数组(范围内玩家(事件玩家, 42, 所在队伍(事件玩家), 关闭), 当前数组元素 != 事件玩家 && 存活(当前数组元素) && (在视线内(地图矢量(矢量(0, 1, 0), 事件玩家, 旋转并转换),
			当前数组元素, 屏障不会阻挡视线) || 在视线内(眼睛位置(事件玩家), 当前数组元素, 屏障不会阻挡视线))), 矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家), 当前数组元素))));
	}
}

规则("子程序JY")
{
	事件
	{
		子程序;
		JY;
	}

	动作
	{
		开始限制阈值(事件玩家, 0, 0, 0, 0, 0, 0);
		禁用按钮(事件玩家, 按钮(跳跃));
		禁用按钮(事件玩家, 按钮(主要攻击模式));
		禁用按钮(事件玩家, 按钮(辅助攻击模式));
		禁用按钮(事件玩家, 按钮(近身攻击));
		禁用按钮(事件玩家, 按钮(技能2));
	}
}

规则("子程序KY")
{
