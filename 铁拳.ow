规则("按跳")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(跳跃)) == 真;
	}

	动作
	{
		根据条件跳过(事件玩家.gou == 0 || 事件玩家.kong != 0, 1);
		事件玩家.gou -= 0.500;
		If(事件玩家.hero == 英雄(美));
			根据条件中止(!正在使用技能 1(事件玩家));
			持续追踪玩家变量(事件玩家, va, 当前地图 != 地图(南极半岛) ? 5 : 7.500, 5, 无);
			等待直到 (!按钮被按下(事件玩家, 按钮(跳跃)) || !具有状态(事件玩家, 无敌) || !正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(美), 5);
			停止追踪玩家变量(事件玩家, va);
		Else If(事件玩家.hero == 英雄(法老之鹰));
			等待直到 ((事件玩家.va < 90 && 正在空中(事件玩家) && !正在跳跃(事件玩家) && 存活(事件玩家) && !正在使用终极技能(事件玩家) && !具有状态(事件玩家, 定身)
				&& 事件玩家.kong == 0 && 事件玩家.hack < 1 && 事件玩家.rval == 0) || !按钮被按下(事件玩家, 按钮(跳跃)) || 事件玩家.hero != 英雄(法老之鹰), 99999);
			根据条件中止(!按钮被按下(事件玩家, 按钮(跳跃)));
			根据条件循环(事件玩家.hero != 英雄(法老之鹰));
			追踪玩家变量频率(事件玩家, va, 100, 50, 无);
			事件玩家.zt2 = 1;
			等待直到 (!按钮被按下(事件玩家, 按钮(跳跃)) || 事件玩家.va == 100 || 在地面上(事件玩家) || 死亡(事件玩家) || 正在使用终极技能(事件玩家) || 具有状态(事件玩家, 定身)
				|| 事件玩家.kong != 0 || 事件玩家.hack > 0.500 || 事件玩家.hero != 英雄(法老之鹰), 999);
			停止追踪玩家变量(事件玩家, va);
			事件玩家.zt2 = 0;
			如条件为“真”则循环;
		End;
	}
}

