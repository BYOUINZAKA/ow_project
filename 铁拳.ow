		技能冷却时间(事件玩家, 按钮(技能1)) > 标准化生命值(事件玩家) * 6;
	}

	动作
	{
		设置技能冷却(事件玩家, 按钮(技能1), 标准化生命值(事件玩家) * 6);
	}
}

