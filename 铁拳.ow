			设置技能冷却(事件玩家, 按钮(技能1), 0);
			设置技能冷却(事件玩家, 按钮(技能2), 0);
		Else If(事件玩家.hero == 英雄(死神));
			设置弹药(事件玩家, 0, 较大(弹药(事件玩家, 0), 8));
		Else If(事件玩家.hero == 英雄(朱诺));
			大字体信息(所有玩家(所在队伍(事件玩家)), 自定义字符串("{0}{1}: {2}所有人自由飞行 [空格/蹲]上升/下降", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家, 技能图标字符串(英雄(朱诺), 按钮(终极技能))));
		End;
	}
}

规则("按R")
{
	事件
