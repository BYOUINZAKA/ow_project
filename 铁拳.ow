		设置终极技能充能(事件玩家, 100);
		If(事件玩家.hero == 英雄(禅雅塔));
			开始持续治疗(事件玩家, 事件玩家, 9999, 300);
			事件玩家.pd4 = 上一个持续治疗效果ID;
			创建效果(所有玩家(所有队伍), 有益光环, 颜色(白色), 事件玩家, 0.800, 位置和半径);
			事件玩家.TX[2] = 最后创建的实体;
