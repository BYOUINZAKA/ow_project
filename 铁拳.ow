			取消主要动作(事件玩家);
			设置终极技能充能(事件玩家, 0);
		Else If(事件玩家.hero == 英雄(探奇));
			根据条件中止(!正在使用技能 1(事件玩家));
			取消与环境的移动碰撞(事件玩家, 真);
			等待直到 (!按钮被按下(事件玩家, 按钮(蹲下)) || !正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(探奇), 9);
			取消与环境的移动碰撞(事件玩家, 假);
			根据条件中止(正在使用技能 1(事件玩家) && 事件玩家.hero == 英雄(探奇));
			开启与环境的移动碰撞(事件玩家);
		Else If(事件玩家.hero == 英雄(D.Va));
			根据条件中止(处于非初始状态(事件玩家));
			击杀(事件玩家, 空);
		End;
	}
}

