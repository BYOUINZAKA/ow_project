			小字体信息(事件玩家, 自定义字符串("   非法跃迁"));
			等待(1, 当为“假”时中止);
			If(自定义字符串("{0}", 当前游戏模式) == 自定义字符串("运载目标") || 自定义字符串("{0}", 当前游戏模式) == 自定义字符串("机动推进"));
				传送(事件玩家, 运载目标位置);
			Else If(自定义字符串("{0}", 当前游戏模式) == 自定义字符串("占领要点"));
				传送(事件玩家, 最近的可行走位置(首个(已排序的数组(数组(目标位置(0), 目标位置(1), 目标位置(2)), 相距距离(事件玩家, 当前数组元素)))));
			Else;
				传送(事件玩家, 最近的可行走位置(目标位置(目标是否完成(1) ? 2 : (目标是否完成(0) ? 1 : 0))));
			End;
		Else If(事件玩家.hero == 英雄(猎空));
			小字体信息(事件玩家, 自定义字符串("   时空跳跃"));
			等待(1, 当为“假”时中止);
			传送(事件玩家, 数组随机取值(全局.Map_Position));
		Else If(事件玩家.hero == 英雄(D.Va));
			根据条件中止(!处于非初始状态(事件玩家) || 终极技能充能百分比(事件玩家) == 100);
			小字体信息(事件玩家, 自定义字符串("   呼叫岱玹..."));
			等待(1, 当为“假”时中止);
			设置终极技能充能(事件玩家, 100);
		End;
