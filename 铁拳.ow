			等待直到 (按钮被按下(事件玩家, 按钮(技能2)) || !正在使用技能 2(事件玩家) || 事件玩家.hero != 英雄(查莉娅), 9);
			根据条件中止(!正在使用技能 2(事件玩家) || 事件玩家.hero != 英雄(查莉娅));
			创建弹道(球弹道, 空, 事件玩家.player, 上, 至地图, 伤害, 所有队伍, 1000, 1, 0, 有益爆炸, 爆炸声音, 0, 1000, 0.100, 0, 0, 0);
			播放效果(所有玩家(所在队伍(事件玩家)), 有害选择效果 , 颜色(紫色), 事件玩家, 0.400);
			播放效果(所有玩家(对方队伍(所在队伍(事件玩家))), 有害选择效果 , 颜色(红色), 事件玩家, 0.400);
		Else If(事件玩家.hero == 英雄(生命之梭));
			事件玩家.player = 首个(已排序的数组(已过滤的数组(范围内玩家(事件玩家, 30.500, 所在队伍(事件玩家), 表面), 当前数组元素 != 事件玩家 && 存活(当前数组元素)), 矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家),
				当前数组元素))));
			治疗(事件玩家, 事件玩家, 终极技能充能百分比(事件玩家.player));
		Else If(事件玩家.hero == 英雄(黑影));
			事件玩家.pd = 1;
			等待直到 (!正在使用技能 2(事件玩家), 2);
			事件玩家.pd = 0;
		End;
	}
}

规则("按q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(终极技能)) == 真;
	}

	动作
	{
		If(事件玩家.hero == 英雄(源氏));
			根据条件中止(事件玩家.pd != 1 || 终极技能充能百分比(事件玩家) < 100 || 事件玩家.kong != 0 || 事件玩家.hack > 0.500);
			设置终极技能充能(事件玩家, 0);
			开始伤害调整(所有玩家(所有队伍), 事件玩家, 0, 受伤害者，伤害者及伤害百分比);
			事件玩家.va4 = 上一个伤害调整ID;
			设置状态(事件玩家, 空, 相移, 99);
			设置不可见(事件玩家, 全部);
			调用子程序(JY);
			事件玩家.pd4 = 所选位置(事件玩家);
			事件玩家.va2 = 面朝方向(事件玩家);
			开始镜头(事件玩家, 射线命中位置(事件玩家.pd4 - 矢量(0, 1, 0) + 上 * (相距距离(事件玩家.pd4 + 矢量(0, 2, 0), 事件玩家.pd4 - 矢量(0, 1, 0)) + 0.500), 射线命中位置(
				事件玩家.pd4 - 矢量(0, 1, 0) + 上 * (相距距离(事件玩家.pd4 + 矢量(0, 2, 0), 事件玩家.pd4 - 矢量(0, 1, 0)) + 0.500), 事件玩家.pd4 - 矢量(0, 1, 0) + 上 * (
				相距距离(事件玩家.pd4 + 矢量(0, 2, 0), 事件玩家.pd4 - 矢量(0, 1, 0)) + 0.500) + 事件玩家.va2 * -3, 空, 事件玩家, 真), 空, 事件玩家, 真), 事件玩家.pd4 - 矢量(0, 1, 0)
				+ 事件玩家.va2 * 100, 100);
			事件玩家.W = 0;
			事件玩家.S = 空数组;
			事件玩家.pd = 2;
			While(事件玩家.W < 63 && 事件玩家.pd != 0);
				事件玩家.player = 已过滤的数组(范围内玩家(事件玩家.pd4, 10, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素) && !具有状态(当前数组元素, 无敌) && !具有状态(当前数组元素, 相移));
				设置状态(已过滤的数组(事件玩家.player, !具有状态(当前数组元素, 击晕)), 事件玩家, 击晕, 0.300);
				施加推力(事件玩家.player, 上, 0.001, 至地图, 取消相反运动XYZ);
				施加推力(事件玩家.player, 下, 0.001, 至地图, 取消相反运动XYZ);
				施加推力(事件玩家.player, 左, 0.001, 至地图, 取消相反运动XYZ);
				施加推力(事件玩家.player, 右, 0.001, 至地图, 取消相反运动XYZ);
				施加推力(事件玩家.player, 前, 0.001, 至地图, 取消相反运动XYZ);
				施加推力(事件玩家.player, 后, 0.001, 至地图, 取消相反运动XYZ);
				传送(事件玩家, 事件玩家.pd4 + 矢量(随机实数(-8, 8), 随机整数(0, 8), 随机实数(-8, 8)));
				设置技能冷却(事件玩家, 按钮(技能1), 0);
				按下按键(事件玩家, 按钮(技能1));
				设置状态(事件玩家, 空, 定身, 0.001);
				创建光束效果(所有玩家(所有队伍), 有害光束, 事件玩家.pd4 + 矢量(随机实数(-10, 10), 随机整数(-10, 10), 随机实数(-10, 10)), 事件玩家.pd4 + 矢量(随机实数(-10, 10), 随机整数(-10, 10),
					随机实数(-10, 10)), 颜色(白色), 无);
				修改玩家变量(事件玩家, S, 添加至数组, 最后创建的实体);
				等待直到 (事件玩家.pd == 0, 0.016);
				事件玩家.W += 1;
			End;
			开始强制设置玩家位置(事件玩家, 事件玩家.pd4, 假);
			根据条件跳过(事件玩家.hero != 英雄(源氏), 14);
			停止伤害调整(事件玩家.va4);
			根据条件跳过(事件玩家.pd == 0, 1);
			设置状态(已过滤的数组(范围内玩家(事件玩家.pd4, 10, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素) && !具有状态(当前数组元素, 无敌)), 事件玩家, 击晕, 1);
			等待直到 (!正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(源氏), 0.310);
			等待直到 (事件玩家.pd == 0, 0.100);
			根据条件跳过(事件玩家.pd == 0, 8);
			事件玩家.player = 已过滤的数组(范围内玩家(事件玩家.pd4, 10, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素) && !具有状态(当前数组元素, 无敌) && !具有状态(当前数组元素, 相移));
			While(事件玩家.player != 空数组);
				伤害(首个(事件玩家.player), 事件玩家, 50 + 较大((最大生命值(首个(事件玩家.player)) - 生命值(首个(事件玩家.player))) * 0.500, 0));
				播放效果(所有玩家(所有队伍), 有害选择效果 , 颜色(白色), 首个(事件玩家.player), 3);
				修改玩家变量(事件玩家, player, 根据索引从数组中移除, 0);
				等待(0.016, 无视条件);
			End;
			事件玩家.pd = 1;
			调用子程序(camera);
			根据条件跳过(事件玩家.YS[1] != 0, 1);
			设置不可见(事件玩家, 无);
			停止强制设置玩家位置(事件玩家);
			清除状态(事件玩家, 相移);
			停止限制阈值(事件玩家);
			调用子程序(KY);
			设置技能冷却(事件玩家, 按钮(技能1), 0);
			根据条件跳过(!按钮被按下(事件玩家, 按钮(技能2)), 1);
			按下按键(事件玩家, 按钮(技能2));
			根据条件跳过(!按钮被按下(事件玩家, 按钮(近身攻击)), 1);
			按下按键(事件玩家, 按钮(近身攻击));
			消除效果(事件玩家.S);
			根据条件中止(正在使用终极技能(事件玩家));
			设置终极技能充能(事件玩家, 0);
		Else If(事件玩家.hero == 英雄(法老之鹰));
			根据条件中止(正在使用终极技能(事件玩家) || 终极技能充能百分比(事件玩家) == 0 || 事件玩家.kong != 0 || 事件玩家.hack > 0.500);
			事件玩家.va2 = 终极技能充能百分比(事件玩家);
			设置终极技能充能(事件玩家, 100);
			按下按键(事件玩家, 按钮(终极技能));
			等待直到 (!正在使用终极技能(事件玩家), 0.025 * 事件玩家.va2);
			取消主要动作(事件玩家);
		End;
	}
}

规则("q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		If(事件玩家.hero == 英雄(禅雅塔));
			取消与环境的移动碰撞(事件玩家, 假);
			等待直到 (事件玩家.cf != 1 || !正在使用终极技能(事件玩家), 99);
			根据条件跳过(!正在使用终极技能(事件玩家), 3);
			开始加速(事件玩家, 按钮被按下(事件玩家, 按钮(跳跃)) ? 上 : 下, 按钮被按下(事件玩家, 按钮(跳跃)) || 按钮被按下(事件玩家, 按钮(蹲下)) ? 90 : 0, 4, 至玩家, 方向，速率，及最大速度);
			等待直到 (事件玩家.cf == 1 || !正在使用终极技能(事件玩家), 9);
			如条件为“真”则循环;
			开启与环境的移动碰撞(事件玩家);
			根据条件中止(正在使用辅助武器(事件玩家));
			停止加速(事件玩家);
		Else If(事件玩家.hero == 英雄(奥丽莎));
			事件玩家.BT = 1;
			等待直到 (!正在使用终极技能(事件玩家), 99999);
			根据条件中止(事件玩家.hero == 英雄(奥丽莎) && 正在使用技能 1(事件玩家));
			事件玩家.BT = 0;
		Else If(事件玩家.hero == 英雄(伊拉锐));
			事件玩家.player = 已过滤的数组(范围内玩家(事件玩家, 30, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素) && !具有状态(当前数组元素, 相移) && !具有状态(当前数组元素, 无敌));
			伤害(已过滤的数组(事件玩家.player, 具有状态(当前数组元素, 燃烧)), 事件玩家, 200);
			停止持续伤害(事件玩家.player.CSdam[2]);
			开始持续伤害(事件玩家.player, 事件玩家, 3, 20);
			事件玩家.player.CSdam[2] = 上一个持续伤害效果ID;
			设置状态(事件玩家.player, 事件玩家, 燃烧, 3);
		Else If(事件玩家.hero == 英雄(毛加));
			设置技能冷却(事件玩家, 按钮(技能1), 0);
			设置技能冷却(事件玩家, 按钮(技能2), 0);
			为玩家添加生命池(事件玩家, 生命值, 最大生命值(事件玩家), 真, 假);
			事件玩家.va2 = 最后创建的生命池;
			取消与环境的移动碰撞(事件玩家, 假);
			开始调整玩家大小(事件玩家, 2, 假);
			开始修改英雄语音(事件玩家, 数组随机取值(数组(0.500, 1.500)), 假);
			等待直到 (!正在使用终极技能(事件玩家), 99999);
			移除玩家的生命池(事件玩家.va2);
			开启与环境的移动碰撞(事件玩家);
			停止调整玩家大小(事件玩家);
			停止修改英雄语音(事件玩家);
		Else If(事件玩家.hero == 英雄(安娜));
			等待直到 (!正在使用终极技能(事件玩家), 99999);
			事件玩家.pd = 0;
		Else If(事件玩家.hero == 英雄(末日铁拳));
			事件玩家.ZT[99] = 事件玩家.ZT[0];
			If(事件玩家.ZT[99] == 1);
				设置玩家生命值(事件玩家, 100000);
				事件玩家.va = 100;
			Else;
				事件玩家.zt = 1;
				等待直到 (!正在使用终极技能(事件玩家), 6.300);
				根据条件跳过(事件玩家.hero != 英雄(末日铁拳), 4);
				按下按键(事件玩家, 按钮(辅助攻击模式));
				等待(0.016, 无视条件);
				取消主要动作(事件玩家);
				设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
				事件玩家.zt = 0;
			End;
		Else If(事件玩家.hero == 英雄(秩序之光));
			事件玩家.a3 = 所选位置(事件玩家);
			创建效果(所有玩家(所有队伍), 光柱, 所在队伍(事件玩家), 所选位置(事件玩家), 2, 无);
			事件玩家.TX[2] = 最后创建的实体;
			创建地图文本(所有玩家(所在队伍(事件玩家)), 技能图标字符串(英雄(秩序之光), 按钮(终极技能)), 所选位置(事件玩家), 4, 不要截取, 可见, 颜色(白色), 默认可见度);
			事件玩家.TX[6] = 上一个文本ID;
			大字体信息(所有玩家(所在队伍(事件玩家)), 自定义字符串("{0}{1}: {2}激活 [长按互动]传送", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家, 技能图标字符串(英雄(秩序之光), 按钮(终极技能))));
			等待直到 (!正在使用终极技能(事件玩家), 999);
			事件玩家.a3 = 0;
			消除效果(事件玩家.TX[2]);
			消除地图文本(事件玩家.TX[6]);
		Else If(事件玩家.hero == 英雄(源氏));
			等待直到 (!正在使用终极技能(事件玩家), 1);
			根据条件中止(!正在使用终极技能(事件玩家));
			事件玩家.pd = 1;
			根据条件跳过(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(雾子) && 当前数组元素.pd == 1) == 空数组, 2);
			小字体信息(事件玩家, 自定义字符串("   {0} Q可用「极」", 技能图标字符串(英雄(源氏), 按钮(终极技能))));
			设置终极技能充能(事件玩家, 100);
			等待直到 (!正在使用终极技能(事件玩家), 7.980);
			事件玩家.pd = 0;
			设置终极技能充能(事件玩家, 0);
		Else If(事件玩家.hero == 英雄(雾子));
			等待直到 (!正在使用终极技能(事件玩家), 0.340);
			如条件为“假”则中止;
			小字体信息(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(源氏) && 当前数组元素.pd == 1 && 终极技能充能百分比(当前数组元素) < 100), 自定义字符串("   {0} Q可用「极」",
				技能图标字符串(英雄(源氏), 按钮(终极技能))));
			设置终极技能充能(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(源氏) && 当前数组元素.pd == 1 && 终极技能充能百分比(当前数组元素) < 100), 100);
			事件玩家.pd = 1;
			等待直到 (!正在使用终极技能(事件玩家), 11);
			事件玩家.pd = 0;
		Else If(事件玩家.hero == 英雄(莫伊拉));
			为玩家添加生命池(事件玩家, 生命值, 事件玩家.gene[0] * 0.200, 真, 真);
			事件玩家.va2 = 最后创建的生命池;
			事件玩家.dam += 事件玩家.gene[1] * 0.020;
			事件玩家.heal += 事件玩家.gene[2] * 0.020;
			If(正在人格复制(事件玩家));
				等待直到 (!正在使用终极技能(事件玩家), 9);
				根据条件跳过(正在人格复制(事件玩家), 4);
				事件玩家.dam -= 事件玩家.gene[7] * 0.020;
				事件玩家.heal -= 事件玩家.gene[8] * 0.020;
			Else;
				等待直到 (!正在使用终极技能(事件玩家), 9);
				事件玩家.dam -= 事件玩家.gene[1] * 0.020;
				事件玩家.heal -= 事件玩家.gene[2] * 0.020;
			End;
			移除玩家的生命池(事件玩家.va2);
		Else If(事件玩家.hero == 英雄(狂鼠));
			根据条件跳过(!事件玩家.Cam, 2);
			调用子程序(CAM);
			事件玩家.pd4 = 1;
			创建HUD文本(事件玩家, 空, 空, 自定义字符串("\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n      {0}\n{1}", 事件玩家.pd > 0 ? 取整(事件玩家.pd, 上) : 技能图标字符串(英雄(D.Va),
				按钮(技能1)), 输入绑定字符串(按钮(技能1))), 顶部, 9, 颜色(白色), 颜色(白色), 事件玩家.pd == 0 ? 颜色(白色) : 颜色(橙色), 可见，字符串和颜色, 默认可见度);
			事件玩家.TX[2] = 上一个文本ID;
			等待直到 (!正在使用终极技能(事件玩家), 12);
			消除HUD文本(事件玩家.TX[2]);
			根据条件中止(事件玩家.pd4 != 1);
			调用子程序(CAM);
			事件玩家.pd4 = 0;
		Else If(事件玩家.hero == 英雄(卢西奥));
			等待直到 (!在地面上(事件玩家) || !正在使用终极技能(事件玩家), 99);
			等待直到 (在地面上(事件玩家) || !正在使用终极技能(事件玩家), 99);
			根据条件中止(!正在使用终极技能(事件玩家));
			创建弹道(球弹道, 事件玩家, 事件玩家, 下, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 500, 1 / 5, 5, 有害爆炸, 爆炸声音, 0.100, 0, 0.100, 正在使用技能 1(事件玩家) && 正在使用技能 2(事件玩家)
				? 32 : 20, 0, 0);
		Else If(事件玩家.hero == 英雄(堡垒));
			等待直到 (!正在使用终极技能(事件玩家) || !按钮被按下(事件玩家, 按钮(终极技能)), 0.500);
			根据条件中止(!正在使用终极技能(事件玩家) || !按钮被按下(事件玩家, 按钮(终极技能)));
			设置朝向(事件玩家, 地图矢量(前, 事件玩家, 旋转), 至地图);
			取消主要动作(事件玩家);
			设置技能冷却(事件玩家, 按钮(技能1), 0);
			设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
			按下按键(事件玩家, 按钮(技能1));
			禁用按钮(事件玩家, 按钮(主要攻击模式));
			禁用按钮(事件玩家, 按钮(技能1));
			创建效果(所有玩家(所有队伍), 云, 所在队伍(事件玩家), 事件玩家, 1, 位置和半径);
			事件玩家.TX[7] = 最后创建的实体;
			开始限制阈值(事件玩家, 0, 0, 0, 0, 0, 0);
			禁用按钮(事件玩家, 按钮(跳跃));
			事件玩家.dam += 100;
			事件玩家.dansu += 50;
			设置弹道引力(事件玩家, 0);
			等待直到 (!正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(堡垒), 1);
			根据条件跳过(事件玩家.ZT[98] != 3, 1);
			事件玩家.yisu += 35 / 0.650;
			停止限制阈值(事件玩家);
			可用按钮(事件玩家, 按钮(跳跃));
			事件玩家.zt = 1;
			等待直到 (!正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(堡垒), 6.016);
			事件玩家.zt = 0;
			事件玩家.dam -= 100;
			事件玩家.dansu -= 50;
			设置弹道引力(事件玩家, 100);
			根据条件跳过(事件玩家.ZT[98] != 3, 1);
			事件玩家.yisu -= 35 / 0.650;
			消除效果(事件玩家.TX[7]);
			可用按钮(事件玩家, 按钮(主要攻击模式));
			等待直到 (!正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(堡垒), 1);
			根据条件中止(事件玩家.hero != 英雄(堡垒));
			可用按钮(事件玩家, 按钮(技能1));
			设置技能冷却(事件玩家, 按钮(技能1), 0);
			设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
		Else If(事件玩家.hero == 英雄(骇灾));
			设置终极技能充能(已过滤的数组(所有存活玩家(所有队伍), 当前数组元素 != 事件玩家 && (当前数组元素.hero == 英雄(骇灾) && 正在使用终极技能(当前数组元素)) == 假), 100);
			按下按键(所有存活玩家(所有队伍), 按钮(终极技能));
		Else If(事件玩家.hero == 英雄(艾什));
			移除玩家的生命池(事件玩家.va2);
			为玩家添加生命池(事件玩家, 护甲, 200, 假, 假);
			事件玩家.va2 = 最后创建的生命池;
		Else If(事件玩家.hero == 英雄(生命之梭));
			已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 当前数组元素 != 事件玩家).tree = 1;
		Else If(事件玩家.hero == 英雄(天使));
			已过滤的数组(范围内玩家(事件玩家, 16, 所在队伍(事件玩家), 关闭), 死亡(当前数组元素)).rval = 事件玩家;
		Else If(事件玩家.hero == 英雄(温斯顿));
			设置技能冷却(事件玩家, 按钮(技能2), 0);
			等待直到 (!正在使用终极技能(事件玩家), 9999);
			设置技能冷却(事件玩家, 按钮(技能2), 0);
		Else If(事件玩家.hero == 英雄(巴蒂斯特));
			等待直到 (!正在使用终极技能(事件玩家), 9999);
			设置终极技能充能(事件玩家, 0);
		Else If(事件玩家.hero == 英雄(渣客女王));
