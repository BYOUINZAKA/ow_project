		停止强制设置玩家轮廓(所有玩家(所在队伍(事件玩家)), 事件玩家);
		显示姓名板(所有玩家(所在队伍(事件玩家)), 事件玩家);
		开始强制设置玩家轮廓(已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 当前数组元素.hero == 英雄(安娜)), 事件玩家, 假, 颜色(白色), 默认);
		隐藏姓名板(已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 当前数组元素.hero == 英雄(安娜)), 事件玩家);
	}
}

规则("——设置——")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到 (数组(事件玩家.yisu, 事件玩家.dam, 事件玩家.getdam, 事件玩家.heal, 事件玩家.getheal, 事件玩家.dansu, 事件玩家.miaosu, 事件玩家.jitui) != 单次赋值(数组(事件玩家.yisu,
			事件玩家.dam, 事件玩家.getdam, 事件玩家.heal, 事件玩家.getheal, 事件玩家.dansu, 事件玩家.miaosu, 事件玩家.jitui)), 99999);
		设置移动速度(事件玩家, 100 + 事件玩家.yisu);
		设置造成伤害(事件玩家, 100 + 事件玩家.dam);
		设置受到伤害(事件玩家, 100 + 事件玩家.getdam);
		设置造成治疗(事件玩家, 100 + 事件玩家.heal);
		设置受到治疗(事件玩家, 100 + 事件玩家.getheal);
		设置弹道速度(事件玩家, 100 + 事件玩家.dansu);
		设置造成的击退(事件玩家, 100 + 事件玩家.jitui);
		设置瞄准速度(事件玩家, 100 + 事件玩家.miaosu);
		循环;
	}
}

规则("选人")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		已重生(事件玩家) == 真;
	}

	动作
	{
		事件玩家.hero = 正在人格复制(事件玩家) ? 正在复制的英雄(事件玩家) : 所用英雄(事件玩家);
		设置受到的击退(事件玩家, 全局.map == 0 || !数组包含(所有重装英雄, 事件玩家.hero) || 事件玩家.hero == 英雄(莱因哈特) ? 100 : 100 / 0.750);
		事件玩家.pd = 0;
		事件玩家.va = 0;
		停止伤害调整(事件玩家.va4);
		停止治疗调整(事件玩家.va5);
		设置最大生命值(事件玩家, 100);
		移除玩家的所有生命值(事件玩家);
		根据条件跳过(事件玩家.bri[0] == 0 || 正在人格复制(事件玩家), 1);
		为玩家添加生命池(事件玩家, 护甲, 事件玩家.bri[0], 真, 假);
		停止强制设置玩家轮廓(事件玩家, 已过滤的数组(所有玩家(所有队伍), 当前数组元素.flash[1] == 0));
		显示姓名板(事件玩家, 已过滤的数组(所有玩家(所有队伍), 当前数组元素.flash[1] == 0));
		消除HUD文本(事件玩家.TX[0]);
		消除HUD文本(事件玩家.TX[1]);
		消除地图文本(事件玩家.TX[0]);
		消除地图文本(事件玩家.TX[5]);
