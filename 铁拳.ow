规则("伤人")
{
	事件
	{
		玩家造成伤害;
		双方;
		全部;
	}

	动作
	{
		If(事件玩家.hero == 英雄(拉玛刹));
			根据条件中止(事件技能 != 0);
			事件玩家.va += 事件伤害;
			等待(0.016, 无视条件);
		Else If(事件玩家.hero == 英雄(查莉娅));
			根据条件跳过(事件玩家.zt == 0 || 事件技能 != 按钮(主要攻击模式), 1);
			伤害(射线命中玩家(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 15.500, 所有存活玩家(所在队伍(被攻击方)), 被攻击方, 真), 事件玩家, 事件伤害);
			等待(0.016, 无视条件);
		Else If(事件玩家.hero == 英雄(渣客女王));
			根据条件跳过(事件技能 == 0 || 事件技能 == 按钮(近身攻击), 1);
			设置技能冷却(事件玩家, 按钮(技能2), 0);
			等待(0.016, 无视条件);
		Else If(事件玩家.hero == 英雄(回声));
			根据条件跳过(事件技能 != 按钮(技能2) || 标准化生命值(被攻击方) < 0.500, 1);
			治疗(事件玩家, 事件玩家, 事件伤害);
			等待(0.016, 无视条件);
		Else If(事件玩家.hero == 英雄(巴蒂斯特));
			根据条件跳过(!正在使用终极技能(事件玩家), 1);
			设置终极技能充能(事件玩家, 终极技能充能百分比(事件玩家) + 事件伤害 * 0.200);
			等待(0.016, 无视条件);
		Else If(事件玩家.hero == 英雄(源氏));
			根据条件中止(!正在使用终极技能(事件玩家) || 事件技能 != 按钮(技能1) || !正在使用技能 1(事件玩家));
			While(!技能冷却时间(事件玩家, 按钮(技能1)) && 正在使用技能 1(事件玩家));
				设置技能冷却(事件玩家, 按钮(技能1), 0.017);
				等待直到 (技能冷却时间(事件玩家, 按钮(技能1)) > 0 || !正在使用技能 1(事件玩家), 0.016);
			End;
			设置技能冷却(事件玩家, 按钮(技能1), 0);
		Else If(事件玩家.hero == 英雄(末日铁拳));
			根据条件中止(事件玩家.ZT[0] != 0 || 事件技能 != 按钮(辅助攻击模式));
			If(事件玩家.pd3 == 0);
				伤害(被攻击方, 事件玩家, 25);
				根据条件跳过(正在人格复制(事件玩家) && 全局.map == 1, 1);
				为玩家添加生命池(事件玩家, 生命值, 全局.map == 0 ? (1 - 300 / 425) * 35 : 3, 假, 假);
				根据条件中止(被攻击方.BT > 0);
				设置状态(被攻击方, 事件玩家, 击晕, 0.496);
				事件玩家.pd3 = 被攻击方;
			Else If(事件玩家.pd3 == 被攻击方);
				伤害(被攻击方, 事件玩家, 40 + 取整(攻击方.va2, 下));
			End;
		Else If(事件玩家.hero == 英雄(路霸));
			根据条件中止(事件技能 != 按钮(技能1) || 被攻击方.BT > 0);
			被攻击方.gou = 0;
			被攻击方.SC = 0;
			被攻击方.inseat = 0;
			等待直到 (!按钮被按下(事件玩家, 按钮(技能1)) || !正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(路霸), 9);
			根据条件中止(!按钮被按下(事件玩家, 按钮(技能1)) || 事件玩家.kong != 0 || 事件玩家.hack > 0.500 || 死亡(事件玩家) || 事件玩家.hero != 英雄(路霸) || 相距距离(事件玩家, 被攻击方) > 4);
			被攻击方.PIG = 事件玩家;
			绑定玩家(被攻击方, 事件玩家, 矢量(0.500, 0, -1));
			开始朝向(被攻击方, 地图矢量(后, 事件玩家, 旋转), 10000, 至地图, 方向及角速率);
			被攻击方.gou = 10;
			创建进度条地图文本(被攻击方, 被攻击方.gou * 10, 自定义字符串("被{0}{1} 捆住  [空格]挣扎", 英雄图标字符串(英雄(路霸)), 事件玩家), 逐帧更新(眼睛位置(被攻击方) + 100 * (-0.900 * 与此角度的相对方向(
				与此方向的水平角度(面朝方向(被攻击方)), 与此方向的垂直角度(面朝方向(被攻击方)) - 90) + 3 * 面朝方向(被攻击方))), 1.400, 不要截取, 颜色(白色), 颜色(白色), 可见，位置和值, 默认可见度);
			事件玩家.TX[4] = 上一个文本ID;
			小字体信息(事件玩家, 自定义字符串("   捆住{0}{1}", 英雄图标字符串(被攻击方.hero), 被攻击方));
			大字体信息(被攻击方, 自定义字符串("被{0}{1} 捆住", 英雄图标字符串(所用英雄(事件玩家)), 事件玩家));
			等待直到 (!按钮被按下(事件玩家, 按钮(技能1)) || 死亡(事件玩家) || 事件玩家.hero != 英雄(路霸) || 被攻击方.gou == 0 || 被攻击方.BT > 0, 99999);
			等待直到 (按钮被按下(事件玩家, 按钮(技能1)) || 死亡(事件玩家) || 事件玩家.hero != 英雄(路霸) || 被攻击方.gou == 0 || 被攻击方.BT > 0, 99999);
			根据条件跳过(被攻击方.SC != 0, 1);
			解除绑定(被攻击方);
			根据条件跳过((被攻击方.hero == 英雄(士兵：76) && 按钮被按下(被攻击方, 按钮(主要攻击模式)) && 正在使用终极技能(被攻击方) && !正在装填(被攻击方) && 已过滤的数组(所有存活玩家(对方队伍(所在队伍(被攻击方))),
				!具有状态(当前数组元素, 无敌) && !具有状态(当前数组元素, 相移) && !具有状态(当前数组元素, 无法杀死) && 在视线内(眼睛位置(被攻击方), 眼睛位置(当前数组元素), 屏障不会阻挡视线))
				!= 空数组 && 被攻击方.kong == 0) || (被攻击方.Rtt[1] == 1) || 已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 当前数组元素.SC == 被攻击方) != 空数组, 1);
			停止朝向(被攻击方);
			被攻击方.gou = 0;
			消除进度条地图文本(事件玩家.TX[4]);
			根据条件中止(死亡(被攻击方));
			小字体信息(事件玩家, 自定义字符串("   {0}{1} 挣脱", 英雄图标字符串(被攻击方.hero), 被攻击方));
			小字体信息(被攻击方, 自定义字符串("   已挣脱"));
		Else If(事件玩家.hero == 英雄(安娜));
			根据条件中止(事件技能 != 按钮(技能1) || (全局.map == 1 && 数组包含(所有重装英雄, 被攻击方.hero)) || 被攻击方.BT > 0);
			等待(0.016, 无视条件);
			设置状态(被攻击方, 事件玩家, 沉睡, 5.984);
		Else If(事件玩家.hero == 英雄(布丽吉塔));
			根据条件中止(事件技能 != 按钮(技能1) || !按钮被按下(事件玩家, 按钮(技能1)) || 被攻击方.BT + 被攻击方.BT2 > 0);
			等待(0.016, 无视条件);
			施加推力(被攻击方, 上, 正在空中(被攻击方) ? 0 : 1, 至地图, 取消相反运动);
			施加推力(被攻击方, 事件方向, 相距距离(被攻击方, 事件玩家) * -2, 至地图, 取消相反运动);
		Else;
			等待直到 (事件玩家.hero == 英雄(拉玛刹) || 事件玩家.hero == 英雄(查莉娅) || 事件玩家.hero == 英雄(渣客女王) || 事件玩家.hero == 英雄(回声) || 事件玩家.hero == 英雄(巴蒂斯特)
				|| 事件玩家.hero == 英雄(源氏) || 事件玩家.hero == 英雄(末日铁拳) || 事件玩家.hero == 英雄(路霸) || 事件玩家.hero == 英雄(安娜) || 事件玩家.hero == 英雄(布丽吉塔), 99999);
		End;
	}
}

规则("受伤")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	动作
	{
		根据条件跳过(攻击方.SHP[0] == 0 || 事件玩家 == 攻击方, 1);
		治疗(攻击方, 攻击方, 事件伤害 * 攻击方.SHP[0]);
		根据条件跳过(!数组包含(所有输出英雄, 攻击方.hero) || 事件玩家.DPShlup[0] != 0 || 事件玩家 == 攻击方, 1);
		事件玩家.DPShlup[0] = 1;
		根据条件跳过(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(拉玛刹)) == 空数组 || !数组包含(全局.omn, 所用英雄(事件玩家)), 2);
		已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(拉玛刹) && (正在使用技能 1(当前数组元素) || 正在使用终极技能(当前数组元素))).dam += 事件伤害 / 100;
		已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 当前数组元素.hero == 英雄(拉玛刹)).Pain[0] += 事件伤害 / 100;
		If(事件玩家.hero == 英雄(艾什));
			根据条件跳过(事件玩家 == 攻击方 || 正在使用终极技能(事件玩家) || 终极技能充能百分比(事件玩家) == 100, 1);
			设置终极技能充能(事件玩家, 终极技能充能百分比(事件玩家) + 事件伤害 / 24.500);
		Else If(事件玩家.hero == 英雄(奥丽莎));
			根据条件跳过(!正在使用技能 1(事件玩家) && !正在使用终极技能(事件玩家), 1);
			伤害(攻击方, 事件玩家, 事件伤害);
		Else If(事件玩家.hero == 英雄(末日铁拳));
			If(正在使用技能 2(事件玩家) && 事件玩家.ZT[0] == 1 && (((攻击方.hero == 英雄(黑百合) || 攻击方.hero == 英雄(艾什)) && 事件技能 == 按钮(技能2)) || (攻击方.hero == 英雄(黑影)
				&& 事件技能 == 按钮(技能1)) || (攻击方.hero == 英雄(伊拉锐) && 事件技能 == 0) || (攻击方.hero == 英雄(美) && 事件技能 == 按钮(终极技能))) == 假 && (矢量间夹角(面朝方向(事件玩家)
				* 矢量(1, 0, 1), 事件方向 * 矢量(1, 0, 1)) >= 126.880 || (事件技能 == 按钮(主要攻击模式) && ((攻击方.hero == 英雄(布丽吉塔) && 矢量间夹角(面朝方向(事件玩家) * 矢量(1, 0,
				1), 事件方向 * 矢量(1, 0, 1)) > 90) || (攻击方.hero == 英雄(莱因哈特) && 矢量间夹角(面朝方向(事件玩家) * 矢量(1, 0, 1), 方向(攻击方, 事件玩家) * 矢量(1, 0, 1))
				> 90)))));
				事件玩家.va += 事件伤害 * 4;
				If(事件玩家.va - 事件伤害 * 4 < 100);
					根据条件跳过(事件玩家.va >= 100, 3);
				Else;
					根据条件跳过(事件玩家.va < 200, 2);
					设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
					设置技能冷却(事件玩家, 按钮(技能1), 0);
					设置终极技能充能(事件玩家, 终极技能充能百分比(事件玩家) + 事件伤害 / 4);
				End;
			End;
		End;
		If(事件暴击);
			If(攻击方.hero == 英雄(伊拉锐) || (攻击方.hero == 英雄(路霸) && 事件技能 != 按钮(终极技能)) || (攻击方.hero == 英雄(索杰恩) && 事件技能 != 按钮(主要攻击模式)) || (
				全局.map == 1 && 数组包含(所有重装英雄, 事件玩家.hero) && ((攻击方.hero == 英雄(黑影) && 事件技能 == 按钮(技能1)) || (攻击方.hero == 英雄(毛加) && (事件技能 == 按钮(技能1)
				|| (具有状态(事件玩家, 燃烧) && 事件技能 == 0 && 按钮被按下(事件玩家, 按钮(辅助攻击模式))))) || 攻击方.hero == 英雄(莱因哈特)) == 假));
				根据条件跳过(生命值(事件玩家) > 事件伤害 / 3, 1);
				伤害(事件玩家, 攻击方, 100000);
				设置玩家生命值(事件玩家, 生命值(事件玩家) - 事件伤害 / 3);
