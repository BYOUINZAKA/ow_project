				设置技能冷却(攻击方, 按钮(技能2), 技能冷却时间(攻击方, 按钮(技能2)) - 1);
				设置技能冷却(攻击方, 按钮(辅助攻击模式), 技能冷却时间(攻击方, 按钮(辅助攻击模式)) - 1);
			Else If(事件技能 == 按钮(近身攻击) && 事件玩家.BT == 0);
				事件玩家.FLT[0] = 1;
			End;
		Else If(事件玩家.BT == 0);
			If(攻击方.hero == 英雄(温斯顿));
				If(攻击方.ZT[2] == 1 && (事件技能 == 按钮(主要攻击模式) || 事件技能 == 按钮(辅助攻击模式)));
					设置状态(事件玩家, 攻击方, 击晕, 事件技能 == 按钮(主要攻击模式) ? 0.040 : 攻击方.va2 * 0.500);
				Else If(正在使用终极技能(攻击方) && 事件技能 != 按钮(终极技能));
					设置状态(事件玩家, 攻击方, 击晕, 1);
				End;
			Else If(攻击方.hero == 英雄(安娜));
				根据条件中止(((事件技能 == 按钮(技能2) && 类型的生命值(事件玩家, 护甲) <= 0 && 类型的生命值(事件玩家, 护盾) <= 0) || (事件技能 == 按钮(主要攻击模式) && 标准化生命值(事件玩家) < 0.200))
					== 假 || (全局.map == 1 && 数组包含(所有重装英雄, 事件玩家.hero)));
				设置状态(事件玩家, 攻击方, 沉睡, 1.500);
			Else If(攻击方.hero == 英雄(士兵：76));
				根据条件中止(事件技能 != 按钮(近身攻击) || 攻击方.zt != 1);
				设置状态(事件玩家, 攻击方, 击倒, 1);
			Else If(攻击方.hero == 英雄(探奇));
				根据条件中止(攻击方.zt != 1 || 事件技能 != 0);
				事件玩家.Rtt[0] = 1;
			End;
		End;
	}
}

规则("移除c减疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.DPShlup[0] == 1;
	}

	动作
	{
		事件玩家.DPShlup[0] = 0;
		根据条件跳过(事件玩家.DPShlup[1] != 0, 2);
		事件玩家.DPShlup[1] = 事件玩家.hero;
		事件玩家.getheal += 数组包含(所有重装英雄, 事件玩家.DPShlup[1]) && 全局.map == 1 ? 300 / 17 : 300 / 7;
		等待直到 (具有状态(事件玩家, 相移) || 具有状态(事件玩家, 无敌) || 死亡(事件玩家) || 事件玩家.DPShlup[1] != 事件玩家.hero, 0.016);
		等待直到 (事件玩家.DPShlup[0] == 1 || 具有状态(事件玩家, 相移) || 具有状态(事件玩家, 无敌) || 死亡(事件玩家) || 事件玩家.DPShlup[1] != 事件玩家.hero, 2.984);
		如条件为“真”则循环;
		事件玩家.getheal -= 数组包含(所有重装英雄, 事件玩家.DPShlup[1]) && 全局.map == 1 ? 300 / 17 : 300 / 7;
		事件玩家.DPShlup[1] = 0;
	}
}

规则("堡垒榴弹/大招")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		攻击方.hero == 英雄(堡垒);
	}

	动作
	{
		根据条件中止(事件技能 != 按钮(辅助攻击模式) && 事件技能 != 按钮(终极技能));
		If(攻击方.ZT[1] == 1);
			根据条件中止(事件玩家 == 攻击方);
			停止持续伤害(事件玩家.CSdam[0]);
			开始持续伤害(事件玩家, 攻击方, 3, 攻击方.zt == 0 ? 20 : 10);
			事件玩家.CSdam[0] = 上一个持续伤害效果ID;
			设置状态(事件玩家, 攻击方, 燃烧, 3);
		Else If(攻击方.ZT[1] == 3);
			根据条件中止(事件技能 != 按钮(终极技能));
			根据条件跳过(生命值(事件玩家) > 事件伤害 * 0.300, 1);
			伤害(事件玩家, 攻击方, 10000);
			设置玩家生命值(事件玩家, 生命值(事件玩家) - 事件伤害 * 0.300);
		Else If(事件玩家.BT == 0);
			If(攻击方.ZT[1] == 0);
				根据条件中止(事件玩家 == 攻击方);
				设置状态(事件玩家, 攻击方, 击倒, 0.400);
			Else If(事件技能 == 按钮(辅助攻击模式));
				根据条件中止(事件玩家.BT2 > 0);
				施加推力(事件玩家, 事件方向, (攻击方 == 事件玩家 ? 0.175 : 0.105) * (100 + 攻击方.jitui), 至地图, 合并相反运动);
			End;
		End;
		等待(0.016, 无视条件);
	}
}

