规则("遗物")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.hero == 英雄(探奇);
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		根据条件中止(随机整数(0, 99) > 0);
		等待直到 (!正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(探奇), 随机实数(0, 4.700));
		根据条件中止(!在地面上(事件玩家) || !正在使用技能 1(事件玩家) || 事件玩家.hero != 英雄(探奇));
		事件玩家.va = 随机整数(0, 6);
		If(事件玩家.va == 0);
			设置玩家生命值(所有存活玩家(所有队伍), 1);
		Else If(事件玩家.va == 1);
			传送(所有玩家(所有队伍), 事件玩家);
			所有玩家(所有队伍).gou = 0;
			所有玩家(所有队伍).SC = 0;
			所有玩家(所有队伍).inseat = 0;
		Else If(事件玩家.va == 2);
			全局.Slow = 1;
		Else If(事件玩家.va == 3);
			所有玩家(所有队伍).GO = 1;
		Else If(事件玩家.va == 4);
			击杀(最后(已排序的数组(所有玩家(所有队伍), 玩家数据(当前数组元素, 最后一击))), 空);
		Else If(事件玩家.va == 5);
