			停止持续治疗(事件玩家.pd4);
			消除效果(事件玩家.TX[2]);
			取消主要动作(事件玩家);
		Else If(事件玩家.hero == 英雄(狂鼠));
			设置技能充能(事件玩家, 按钮(技能1), 技能充能(事件玩家, 按钮(技能1)) + 1);
