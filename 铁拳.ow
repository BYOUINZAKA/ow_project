		事件玩家.hack < 1;
	}

	动作
	{
		事件玩家.pd = 0;
		持续追踪玩家变量(事件玩家, pd, 200, 0.700, 无);
		等待直到 (!正在蹲下(事件玩家) || 事件玩家.hack > 0.500, 99999);
		停止追踪玩家变量(事件玩家, pd);
		等待直到 (正在跳跃(事件玩家) || 正在蹲下(事件玩家) || 事件玩家.hack > 0.500 || 具有状态(事件玩家, 定身) || 事件玩家.kong != 0 || 死亡(事件玩家) || 事件玩家.hero != 英雄(巴蒂斯特), 1);
		If(正在跳跃(事件玩家) && 事件玩家.hack < 1);
			创建效果(所有玩家(所在队伍(事件玩家)), 有害光环, 颜色(水绿色), 逐帧更新(所选位置(事件玩家)), 0.010, 位置和半径);
			事件玩家.TX[2] = 最后创建的实体;
			创建效果(所有玩家(对方队伍(所在队伍(事件玩家))), 有害光环, 颜色(红色), 逐帧更新(所选位置(事件玩家)), 0.010, 位置和半径);
			事件玩家.TX[3] = 最后创建的实体;
			等待直到 (在地面上(事件玩家) || 事件玩家.hack > 0.500 || 具有状态(事件玩家, 定身) || 事件玩家.kong != 0 || 死亡(事件玩家) || 事件玩家.hero != 英雄(巴蒂斯特), 99999);
			消除效果(事件玩家.TX[2]);
			消除效果(事件玩家.TX[3]);
			根据条件跳过(事件玩家.hack > 0.500 || 具有状态(事件玩家, 定身) || 事件玩家.kong != 0 || 死亡(事件玩家) || 事件玩家.hero != 英雄(巴蒂斯特), 2);
			创建弹道(球弹道, 事件玩家, 事件玩家, 下, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 事件玩家.pd, 2, 0, 有害爆炸, 爆炸声音, 0.100, 1000, 0.100, 0, 0, 0);
			创建弹道(球弹道, 事件玩家, 事件玩家, 下, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 事件玩家.pd / 4, 1, 3, 环状爆炸, 爆炸声音, 0, 1000, 0.100, 0, 0, 100);
			事件玩家.pd = 0;
			如条件为“真”则循环;
		Else;
			如条件为“真”则循环;
			事件玩家.pd = 0;
			等待直到 (!正在蹲下(事件玩家), 99999);
		End;
	}
