			&& 当前数组元素.seat == 0 && 当前数组元素 != 事件玩家 && 存活(当前数组元素) && 在视野内(事件玩家, 当前数组元素, 55)), 矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家), 当前数组元素))));
		事件玩家.DVA.seat = 1;
