规则("开始")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		玩家数量(所有队伍) > 7;
		数量(已过滤的数组(所有玩家(所有队伍), 当前数组元素.ready == 1)) >= 玩家数量(所有队伍) / 2;
		正在等待玩家 == 真;
	}

	动作
	{
		大字体信息(所有玩家(所有队伍), 自定义字符串("准备过半 即将开始"));
		等待(3, 当为“假”时中止);
		开始游戏模式;
	}
}

规则("换图")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		数量(已过滤的数组(所有玩家(所有队伍), 当前数组元素.cmap == 1)) >= 玩家数量(所有队伍) / 2;
		正在等待玩家 == 真;
		总计消耗时间 > 28;
		玩家数量(所有队伍) > 0;
	}

	动作
	{
		大字体信息(所有玩家(所有队伍), 自定义字符串("票数过半 即将换图"));
		等待(3, 当为“假”时中止);
		重新开始比赛;
	}
}

规则("重开")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		总计消耗时间 > 13800;
		正在等待玩家 == 真;
	}

	动作
	{
		大字体信息(所有玩家(所有队伍), 自定义字符串("突击过久 即将重开"));
		等待(3, 无视条件);
		重新开始比赛;
	}
}

规则("集结英雄")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		正在集结英雄 == 真;
	}

	动作
	{
		消除HUD文本(全局.HUD);
		显示游戏模式HUD(所有玩家(所有队伍));
		显示游戏模式地图UI(所有玩家(所有队伍));
		设置慢动作(100);
		设置比赛时间(15);
		消除所有效果;
		消除所有地图文本;
		消除所有进度条地图文本;
		停止定向阈值(所有玩家(所有队伍));
		等待(0.020, 无视条件);
		所有玩家(所有队伍).SHP[0] = 0;
		所有玩家(所有队伍).mga[0] = 0;
		所有玩家(所有队伍).ash[0] = 0;
		所有玩家(所有队伍).ball[0] = 0;
		所有玩家(所有队伍).dva[0] = 0;
		所有玩家(所有队伍).bri[0] = 0;
		所有玩家(所有队伍).tob[0] = 0;
		所有玩家(所有队伍).tob[1] = 0;
		所有玩家(所有队伍).tob[2] = 0;
		所有玩家(所有队伍).tob[3] = 0;
		所有玩家(所有队伍).tob[4] = 0;
		所有玩家(所有队伍).tob[5] = 0;
		所有玩家(所有队伍).WDkill[0] = 0;
		所有玩家(所有队伍).dansu = 0;
		所有玩家(所有队伍).RPkill[0] = 0;
		所有玩家(所有队伍).gene[0] = 0;
		所有玩家(所有队伍).gene[1] = 0;
		所有玩家(所有队伍).gene[2] = 0;
		所有玩家(所有队伍).Pain[0] = 0;
	}
}

规则("回合重置")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		处于回合之间 == 真;
	}

	动作
	{
		等待直到 (!处于回合之间, 99999);
		等待(0.016, 无视条件);
		全局.Map_Position = 空数组;
		调用子程序(Map);
	}
}

