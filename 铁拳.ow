	{
		子程序;
		KY;
	}

	动作
	{
		可用按钮(事件玩家, 按钮(跳跃));
		可用按钮(事件玩家, 按钮(主要攻击模式));
		可用按钮(事件玩家, 按钮(辅助攻击模式));
		可用按钮(事件玩家, 按钮(近身攻击));
		根据条件跳过(事件玩家.hero == 英雄(末日铁拳) && 事件玩家.ZT[0] == 0, 1);
		可用按钮(事件玩家, 按钮(技能2));
	}
}

