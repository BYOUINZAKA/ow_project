规则("=> Safe zone check Arena1   (A) = False")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		相距距离(事件玩家, 全局.A) >= 15.100;
		(全局.W[1] == 事件玩家 || 全局.W[2] == 事件玩家) == 真;
		全局.K[0] == 真;
		事件玩家.D == 假;
	}

	动作
	{
		事件玩家.A = 假;
		等待(0.100, 无视条件);
		如条件为“真”则循环;
