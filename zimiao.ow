		全局.M > 0;
	}

	动作
	{
		传送(事件玩家, 全局.U);
		大字体信息(事件玩家, 字符串("{0} {1}", 字符串("你"), 字符串("下一个")));
		播放效果(事件玩家, 环状爆炸声音, 颜色(白色), 事件玩家, 200);
		等待(0.500, 无视条件);
		设置朝向(事件玩家, 本地矢量(全局.F, 事件玩家, 旋转并转换), 至玩家);
	}
}

规则("=> Show HUD, Queue Arena 1: (D) = True, Player is in [W]")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.D == 真;
		数组包含(全局.W, 事件玩家) == 真;
		游戏正在进行中 == 真;
	}

	动作
	{
		消除HUD文本(事件玩家.H);
		创建HUD文本(事件玩家, 字符串("{0}：{1}", 自定义字符串("Position in Queue"), 绝对值(数组值的索引(全局.W, 事件玩家) - 2)), 自定义字符串("Score per kill: 3"), 自定义字符串(
			"Arena: 1"), 顶部, 2, 颜色(绿色), 颜色(白色), 颜色(绿色), 可见和字符串, 默认可见度);
		事件玩家.H = 上一个文本ID;
	}
}

规则("=> Show HUD, Queue Arena 2: (D) = True, Player is in [X]")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
