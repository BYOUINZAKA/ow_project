规则("//超级瞄准由亚洲图片制作，繁华提供技术指导与技术支持。欢迎关注bilibli直播间1149(原址作者亚洲图片)")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.W == 真;
	}

	动作
	{
		根据条件跳过(在视线内(事件玩家, 距离准星最近的玩家(事件玩家, 对方队伍(所在队伍(事件玩家))), 屏障不会阻挡视线) == 假, 1);
		事件玩家.V = 距离准星最近的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)));
		根据条件跳过(事件玩家.V != 事件玩家 && 事件玩家.V != 0 && 存活(事件玩家.V), 1);
		事件玩家.V = 首个(已排序的数组(已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 在视线内(事件玩家, 当前数组元素, 屏障不会阻挡视线)), 相距距离(当前数组元素, 事件玩家)));
		根据条件跳过(事件玩家.V == 事件玩家 || 事件玩家.V == 0, 1);
		开始朝向(事件玩家, 向量(眼睛位置(事件玩家), 眼睛位置(事件玩家.V) + 地图矢量(上, 事件玩家.V, 旋转) * 0.020 + 地图矢量(矢量(指定方向速度(事件玩家.V, 地图矢量(左, 事件玩家, 旋转)) / 32 / 1, 0, 0),
			事件玩家, 旋转)), 绝对值(9999999.000), 至地图, 方向及角速率);
		根据条件跳过(事件玩家.V != 事件玩家 && 事件玩家.V != 0 && 存活(事件玩家.V), 1);
		停止朝向(事件玩家);
		等待(0.010, 无视条件);
		如条件为“真”则循环;
	}
}

禁用 规则("自动扳机 By bruned")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		全局.Hacker == 事件玩家;
		按钮被按下(事件玩家, 按钮(互动)) == 真;
		在视线内(眼睛位置(事件玩家), 眼睛位置(距离准星最近的玩家(事件玩家, 所有队伍)), 敌方屏障阻挡视线) == 真;
	}

	动作
	{
		事件玩家.W = 真;
		等待(0.100, 无视条件);
		开始按下按钮(全局.Hacker, 按钮(主要攻击模式));
		等待(0.001, 无视条件);
		停止按下按钮(全局.Hacker, 按钮(主要攻击模式));
		如条件为“真”则循环;
	}
}

规则("自动接近战 By bruned")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		相距距离(事件玩家, 距离最近的玩家(事件玩家, 所有队伍)) <= 3;
		生命值(距离最近的玩家(事件玩家, 所有队伍)) <= 30;
		// 全局.Hacker == 事件玩家;
		距离准星最近的玩家(事件玩家, 所有队伍) == 真;
	}

	动作
	{
		开始朝向(事件玩家, 向量(事件玩家, 距离最近的玩家(事件玩家, 所有队伍)), 100000000, 至地图, 方向及角速率);
		等待(0.050, 无视条件);
		停止朝向(事件玩家);
		开始按下按钮(事件玩家, 按钮(近身攻击));
		等待(0.001, 无视条件);
		停止按下按钮(事件玩家, 按钮(近身攻击));
		如条件为“真”则循环;
	}
}

规则("Global By bruned")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		游戏正在进行中 == 真;
	}

	动作
	{
		全局.Hacker = 此栏位的玩家(0, 所有队伍);
	}
}