规则("=> Arena 1: Player dies: Event player is [W,1] or [W,2]: 1-3 Players")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	条件
	{
		数量(所有玩家(所有队伍)) < 4;
		事件玩家.E == 假;
		全局.R[1] == 3;
	}

	动作
	{
		根据条件跳过(全局.W[1] == 事件玩家, 1);
		根据条件跳过(全局.W[2] != 事件玩家, 30);
		修改全局变量(W, 根据值从数组中移除, 事件玩家);
		修改全局变量(W, 添加至数组, 事件玩家);
		事件玩家.E = 真;
		治疗(全局.W[1], 空, 300);
		全局.W[1].S += 3;
		设置玩家分数(全局.W[1], 全局.W[1].S);
		清除状态(事件玩家, 燃烧);
		清除状态(全局.W[1], 燃烧);
		全局.R[1] = 0;
		根据条件跳过(全局.W[1].AA == 真, 3);
		根据条件跳过(所用英雄(全局.W[1]) != 英雄(末日铁拳), 2);
		等待(0.500, 无视条件);
		伤害(全局.W[1], 空, 生命值(全局.W[1]) - 250);
		根据条件跳过(全局.W[1].AA != 真, 6);
		全局.W[1].U = 终极技能充能百分比(全局.W[1]);
		开始强制玩家选择英雄(全局.W[1], 英雄(秩序之光));
		等待(0.200, 无视条件);
		开始强制玩家选择英雄(全局.W[1], 全局.W[1].L[全局.W[1].N]);
		等待(0.050, 无视条件);
		设置终极技能充能(全局.W[1], 全局.W[1].U);
	}
}

规则("=> Arena 1: Player dies: Event player is [W,1] or [W,2]: 4-5 Players")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	条件
	{
