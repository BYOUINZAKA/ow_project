规则("=> Catch Ana debuff exception for being anti-naded in Arena 1, set (AA) to be true if currently anti naded")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		(所用英雄(攻击方) == 英雄(安娜) && (事件伤害 == 60 || 事件伤害 == 90)) == 真;
		事件玩家.D == 假;
		数组包含(全局.W, 事件玩家) == 真;
	}

	动作
	{
		事件玩家.AA = 真;
		等待(4, 无视条件);
		事件玩家.AA = 假;
	}
}

规则("=> General Death Event - Set (D)ead = True, Store (U)lt charge, (V)+1 for losing player, move to next hero from (L) hero counter")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	条件
	{
		游戏正在进行中 == 真;
	}

	动作
	{
		事件玩家.D = 真;
		事件玩家.U = 终极技能充能百分比(事件玩家);
		事件玩家.V += 1;
		事件玩家.N += 1;
		等待(0.250, 无视条件);
		开始强制玩家选择英雄(事件玩家, 事件玩家.L[事件玩家.N]);
		设置终极技能充能(事件玩家, 事件玩家.U);
	}
}

规则("=> Back in play: If the player is not (D)ead                       //  Allow buttons and movement")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.D == 假;
	}

	动作
	{
		设置引力(事件玩家, 100);
		设置移动速度(事件玩家, 100);
		设置状态(事件玩家, 空, 无法杀死, 0);
		设置不可见(事件玩家, 全部禁用);
		设置状态(事件玩家, 空, 相移, 0);
		设置状态(事件玩家, 空, 定身, 0);
		设置造成伤害(事件玩家, 100);
		停止限制阈值(事件玩家);
		可用按钮(事件玩家, 按钮(主要攻击模式));
		可用按钮(事件玩家, 按钮(辅助攻击模式));
		可用按钮(事件玩家, 按钮(技能1));
		可用按钮(事件玩家, 按钮(技能2));
		可用按钮(事件玩家, 按钮(终极技能));
	}
}

规则("=> Spectator: If the player is waiting for a free arena        //  Teleport[V], Facing[F], Disable all, Display queue pos (H)ud")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.D == 真;
		全局.M > 0;
		全局.K == 真;
	}

	动作
	{
		传送(事件玩家, 全局.V);
		开始限制阈值(事件玩家, 0, 0, 0, 0, 0, 0);
		设置引力(事件玩家, 绝对值(0));
		设置移动速度(事件玩家, 绝对值(0));
		禁用按钮(事件玩家, 按钮(主要攻击模式));
		禁用按钮(事件玩家, 按钮(辅助攻击模式));
		禁用按钮(事件玩家, 按钮(技能1));
		禁用按钮(事件玩家, 按钮(技能2));
		禁用按钮(事件玩家, 按钮(终极技能));
		设置状态(事件玩家, 空, 无法杀死, 9999);
		设置不可见(事件玩家, 全部);
		设置状态(事件玩家, 空, 相移, 9999);
		设置状态(事件玩家, 空, 定身, 9999);
		设置造成伤害(事件玩家, 0);
		等待(0.500, 无视条件);
		设置朝向(事件玩家, 本地矢量(全局.F, 事件玩家, 旋转并转换), 至玩家);
	}
}

规则("=> Spectator: If you are the next in line to play an arena  // Teleport[U], Facing[F], Disable everything, Message & Sound")
{
