禁用 规则("=> Set [M] on match start for correct ini method // [M] = currently necessary arenas /int 0-3/ -- MOVED TO Player joins")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		游戏正在进行中 == 真;
	}

	动作
	{
		根据条件跳过(数量(所有玩家(所有队伍)) > 5, 2);
		全局.M = 取整(数量(所有玩家(所有队伍)) / 2, 下);
		跳过(1);
		全局.M = 3;
	}
}

规则("=> Player leaves: Remove from [W], [X], [Y], reinstance arenas if necessary")
{
	事件
	{
		玩家离开比赛;
		双方;
		全部;
	}

	动作
	{
		根据条件跳过(数量(所有玩家(所有队伍)) > 5, 2);
		全局.M = 取整(数量(所有玩家(所有队伍)) / 2, 下);
		跳过(1);
		全局.M = 3;
		根据条件跳过(全局.Y[2] != 事件玩家, 3);
		全局.Y[1].D = 真;
		全局.T[1] = 0;
		跳过(14);
		根据条件跳过(全局.Y[1] != 事件玩家, 3);
		全局.Y[2].D = 真;
		全局.T[1] = 0;
		跳过(11);
		根据条件跳过(全局.X[2] != 事件玩家, 3);
		全局.X[1].D = 真;
		全局.S[1] = 0;
		跳过(8);
		根据条件跳过(全局.X[1] != 事件玩家, 3);
		全局.X[2].D = 真;
		全局.S[1] = 0;
		跳过(5);
		根据条件跳过(全局.W[2] != 事件玩家, 2);
		全局.R[1] = 0;
		跳过(2);
		根据条件跳过(全局.W[1] != 事件玩家, 2);
		全局.R[1] = 0;
		根据条件跳过(数量(所有玩家(所有队伍)) == 1, 1);
		跳过(2);
		所有玩家(所有队伍).D = 真;
		全局.K[0] = 0;
		修改全局变量(W, 根据值从数组中移除, 事件玩家);
		修改全局变量(X, 根据值从数组中移除, 事件玩家);
		修改全局变量(Y, 根据值从数组中移除, 事件玩家);
	}
}

