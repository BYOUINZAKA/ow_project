规则("=> Player joins, set Hero (L)ist, put into correct [W],[X],[Y], (D)ead, recently (J)oined")
{
	事件
	{
		玩家加入比赛;
		双方;
		全部;
	}

	动作
	{
		事件玩家.L = 英雄(安娜);
		// 修改玩家变量(事件玩家, L, 添加至数组, 英雄(末日铁拳));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(艾什));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(巴蒂斯特));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(源氏));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(半藏));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(卡西迪));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(禅雅塔));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(士兵：76));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(猎空));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(黑百合));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(黑影));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(索杰恩));
		修改玩家变量(事件玩家, L, 添加至数组, 英雄(弗蕾娅));
		// 修改玩家变量(事件玩家, L, 添加至数组, 英雄(伊拉锐));
		事件玩家.L = 随机数组(事件玩家.L);
		修改全局变量(L, 添加至数组, 全局.L[0]);
		事件玩家.N = 0;
		开始强制玩家选择英雄(事件玩家, 事件玩家.L[事件玩家.N]);
		根据条件跳过(游戏正在进行中, 2);
		修改全局变量(W, 添加至数组, 事件玩家);
		跳过(11);
		根据条件跳过(玩家数量(所有队伍) > 3, 2);
		修改全局变量(W, 添加至数组, 事件玩家);
		跳过(8);
		根据条件跳过(玩家数量(所有队伍) != 4, 2);
		修改全局变量(X, 添加至数组, 事件玩家);
		跳过(5);
		根据条件跳过(玩家数量(所有队伍) != 5, 2);
		修改全局变量(X, 添加至数组, 事件玩家);
		跳过(2);
		根据条件跳过(玩家数量(所有队伍) < 6, 1);
		修改全局变量(Y, 添加至数组, 事件玩家);
		事件玩家.D = 真;
		根据条件跳过(!数组包含(全局.W, 事件玩家), 2);
		创建HUD文本(事件玩家, 字符串("{0}：{1}", 自定义字符串("Position in Queue"), 绝对值(数组值的索引(全局.W, 事件玩家) - 2)), 自定义字符串("Score per kill: 3"), 自定义字符串(
			"Arena: 1"), 顶部, 2, 颜色(绿色), 颜色(白色), 颜色(绿色), 可见和字符串, 默认可见度);
		事件玩家.H = 上一个文本ID;
		根据条件跳过(!数组包含(全局.X, 事件玩家), 2);
		创建HUD文本(事件玩家, 字符串("{0}：{1}", 自定义字符串("Position in Queue"), 绝对值(数组值的索引(全局.X, 事件玩家) - 2)), 自定义字符串("Score per kill: 2"), 自定义字符串(
			"Arena: 2"), 顶部, 2, 颜色(红色), 颜色(白色), 颜色(红色), 可见和字符串, 默认可见度);
		事件玩家.H = 上一个文本ID;
		根据条件跳过(!数组包含(全局.Y, 事件玩家), 2);
		创建HUD文本(事件玩家, 字符串("{0}：{1}", 自定义字符串("Position in Queue"), 绝对值(数组值的索引(全局.Y, 事件玩家) - 2)), 自定义字符串("Score per kill: 1"), 自定义字符串(
			"Arena: 3"), 顶部, 2, 颜色(蓝色), 颜色(白色), 颜色(蓝色), 可见和字符串, 默认可见度);
		事件玩家.H = 上一个文本ID;
		根据条件跳过(数量(所有玩家(所有队伍)) > 5, 2);
		全局.M = 取整(数量(所有玩家(所有队伍)) / 2, 下);
		跳过(1);
		全局.M = 3;
		等待(0.300, 无视条件);
		根据条件跳过(事件玩家.D == 假, 1);
		事件玩家.J = 真;
	}
}

规则("=> Player (J)oins -> Spec")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.J == 真;
	}

	动作
	{
		传送(事件玩家, 全局.V);
		开始限制阈值(事件玩家, 0, 0, 0, 0, 0, 0);
		设置引力(事件玩家, 绝对值(0));
		设置移动速度(事件玩家, 绝对值(0));
		禁用按钮(事件玩家, 按钮(主要攻击模式));
		禁用按钮(事件玩家, 按钮(辅助攻击模式));
		禁用按钮(事件玩家, 按钮(技能1));
		禁用按钮(事件玩家, 按钮(技能2));
		禁用按钮(事件玩家, 按钮(终极技能));
		设置状态(事件玩家, 空, 无法杀死, 9999);
		设置不可见(事件玩家, 全部);
		设置状态(事件玩家, 空, 相移, 9999);
		设置状态(事件玩家, 空, 定身, 9999);
		设置造成伤害(事件玩家, 0);
		等待(0.500, 无视条件);
		根据条件跳过(事件玩家.D == 假, 1);
		设置朝向(事件玩家, 本地矢量(全局.F, 事件玩家, 旋转并转换), 至玩家);
	}
}

规则("=> Spread everyone from [W] to their correct [X] and [Y] spots when the game starts")
{
	事件
	{
		持续 - 全局;
