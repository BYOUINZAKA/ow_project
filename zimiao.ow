规则("=> ini for 1 arena ([M]=1, [K,0]=0):                        // Set Arena 1 Ready  Teleport[L,0], [L,1] Facing[F], Set [K,0] True")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		全局.M == 1;
		全局.K[0] == 0;
		游戏正在进行中 == 真;
	}

	动作
	{
		消除所有HUD文本;
		根据条件跳过(已重生(全局.W[2]), 2);
		等待(1, 无视条件);
		如条件为“真”则循环;
		传送(全局.W[1], 全局.L[0]);
		设置朝向(全局.W[1], 本地矢量(全局.F, 全局.W[1], 旋转并转换), 至玩家);
		传送(全局.W[2], 全局.L[1]);
		设置朝向(全局.W[2], 本地矢量(全局.F, 全局.W[2], 旋转并转换), 至玩家);
		全局.W[1].D = 0;
		全局.W[2].D = 0;
		全局.S[1] = 0;
		全局.K[0] = 真;
		全局.R[1] = 3;
		等待(0.600, 无视条件);
		治疗(所有玩家(所有队伍), 空, 300);
	}
}

