规则("系统-状态-复苏")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		死亡(事件玩家) == 真;
		事件玩家.a_sys_user_status[全局.t_enum_status_recover] > 0;
	}

	动作
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_recover] = 0;
		等待直到(!死亡(事件玩家), 1.5);

		If(死亡(事件玩家));
			复活(事件玩家);
			设置状态(事件玩家, 事件玩家, 相移, 0.5);
			设置玩家生命值(事件玩家, 最大生命值(事件玩家) * 0.5);

			创建效果(所有玩家(所有队伍), “回声”复制效果, 颜色(白色), 事件玩家, 0.5, 可见，位置和半径);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 0.5, 空, 自定义字符串("SYS_RECOVERED"));
		End;
	}
}

