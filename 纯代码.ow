			事件玩家.kiriko_heal_pos = 空;
			事件玩家.kiriko_heal_target = 已排序的数组(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 35, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素) && (最大生命值(当前数组元素) > 生命值(当前数组元素)) && (当前数组元素 != 事件玩家)), 生命值(当前数组元素));
			If(数量(事件玩家.kiriko_heal_target) > 0 && 事件玩家.kiriko_heal_target[0] != 空 && 存活(事件玩家.kiriko_heal_target[0]));
				// 创建追踪弹道(“回声”黏性炸弹, 事件玩家, 空, 方向(眼睛位置(事件玩家), 事件玩家.kiriko_heal_target[0]+随机实数(0.5, 1)*上), 至地图, 治疗, 所在队伍(事件玩家), 13, 0, 0, 有益爆炸, 爆炸声音, 0.0, 24, 1.5, 0, 事件玩家.kiriko_heal_target[0], 1);
				// 等待(0.1, 当为“假”时中止);
				// 创建追踪弹道(“回声”黏性炸弹, 事件玩家, 空, 方向(眼睛位置(事件玩家), 事件玩家.kiriko_heal_target[0]+随机实数(0.5, 1)*上), 至地图, 治疗, 所在队伍(事件玩家), 13, 0, 0, 有益爆炸, 爆炸声音, 0.0, 24, 1.5, 0, 事件玩家.kiriko_heal_target[0], 1);
				// 等待(0.1, 当为“假”时中止);
				// 创建追踪弹道(“回声”黏性炸弹, 事件玩家, 空, 方向(眼睛位置(事件玩家), 事件玩家.kiriko_heal_target[0]+随机实数(0.5, 1)*上), 至地图, 治疗, 所在队伍(事件玩家), 13, 0, 0, 有益爆炸, 爆炸声音, 0.0, 24, 1.5, 0, 事件玩家.kiriko_heal_target[0], 1);
				// 等待(0.1, 当为“假”时中止);
				// 创建追踪弹道(“回声”黏性炸弹, 事件玩家, 空, 方向(眼睛位置(事件玩家), 事件玩家.kiriko_heal_target[0]+随机实数(0.5, 1)*上) , 至地图, 治疗, 所在队伍(事件玩家), 13, 0, 0, 有益爆炸, 爆炸声音, 0.0, 24, 1.5, 0, 事件玩家.kiriko_heal_target[0], 1);
				// 等待(0.1, 当为“假”时中止);
				// 创建追踪弹道(“回声”黏性炸弹, 事件玩家, 空, 方向(眼睛位置(事件玩家), 事件玩家.kiriko_heal_target[0]+随机实数(0.5, 1)*上), 至地图, 治疗, 所在队伍(事件玩家), 13, 0, 0, 有益爆炸, 爆炸声音, 0.0, 24, 1.5, 0, 事件玩家.kiriko_heal_target[0], 1);

				事件玩家.kiriko_heal_pos = 眼睛位置(事件玩家);
				追踪玩家变量频率(事件玩家, kiriko_heal_pos, 眼睛位置(事件玩家.kiriko_heal_target[0]), 24, 速率及最终值);

				等待(1.5, 无视条件);
				停止追踪玩家变量(事件玩家, kiriko_heal_pos);
				事件玩家.kiriko_heal_pos = 空;
			Else;
				等待(0.1, 无视条件);
			End;
		End;
	}
}

