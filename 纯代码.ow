		双方;
		安娜;
	}

	条件
	{
		事件技能 == 按钮(技能2);
		全局.args_ana[6] > 0;
	}

	动作
	{
		开始伤害调整(被攻击方, 所有玩家(所在队伍(攻击方)), 100 + 全局.args_ana[6], 受伤害者，伤害者及伤害百分比);
		被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 全局.args_ana[7], 空, 自定义字符串("Ana Biotic Grenade Debuff"));
	}
}

规则("安娜-终极技能-群体激素")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		安娜;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		取消主要动作(事件玩家);
		所有玩家(所在队伍(事件玩家)).sys_softirq[2] = 事件玩家;

		治疗(所有玩家(所在队伍(事件玩家)), 事件玩家, 50);
		开始助攻(事件玩家, 所有玩家(所在队伍(事件玩家)), 助攻者和目标);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_assists, 上一个助攻ID, 总计消耗时间, 8, 英雄(安娜), 空);

		所有玩家(所在队伍(事件玩家)).i_sys_speed += 全局.args_ana[2];
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(所有玩家(所在队伍(事件玩家)), 全局.args_ana[2]), 总计消耗时间, 8, 英雄(安娜), 空);

		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 所有玩家(所在队伍(事件玩家)), 100 + 全局.args_ana[0], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 8, 英雄(安娜), 空);

		开始伤害调整(所有玩家(所在队伍(事件玩家)), 所有玩家(对方队伍(所在队伍(事件玩家))), 100 - 全局.args_ana[1], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 8, 英雄(安娜), 空);

		开始治疗调整(所有玩家(所有队伍), 所有玩家(所在队伍(事件玩家)), 100 + 全局.args_ana[3], 受治疗者，治疗者及治疗百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, 8, 英雄(安娜), 空);
	}
}

规则("安娜-终极技能-群体激素")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[2] != 空;
	}

	动作
	{
		创建效果(所有玩家(所有队伍), 安娜纳米激素强化效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_softirq[2].sys_default_status_pool[数量(事件玩家.sys_softirq[2].sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 8, 英雄(安娜), 空);

		事件玩家.sys_softirq[2] = 空;

		设置技能冷却(事件玩家, 按钮(主要攻击模式), 0);
		设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
		设置技能冷却(事件玩家, 按钮(技能1), 0);
		设置技能冷却(事件玩家, 按钮(技能2), 0);
		设置技能冷却(事件玩家, 按钮(跳跃), 0);
		设置技能冷却(事件玩家, 按钮(装填), 0);
		设置技能冷却(事件玩家, 按钮(蹲下), 0);
		设置技能冷却(事件玩家, 按钮(近身攻击), 0);
	}
}

规则("卡西迪")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卡西迪;
	}

	条件
	{
		正在装填(事件玩家) == 真;
		(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家)) != 真;
	}

	动作
	{
		等待(0.5, 当为“假”时中止);
		// 等待直到(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家) || !正在装填(事件玩家), 0.3);
		If(!正在使用技能 1(事件玩家) && !正在使用终极技能(事件玩家) && 正在装填(事件玩家));
			设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0));
			取消主要动作(事件玩家);
		End;
	}
}

规则("卡西迪-伤害")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

	条件
	{
		事件技能 == 按钮(技能2);
	}

	动作
	{
		为玩家添加生命池(攻击方, 生命值, 30, 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		等待(3.0, 无视条件);
	}
}

规则("卡西迪-伤害")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

	条件
	{
		(事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(终极技能) || 事件技能 == 按钮(近身攻击)) == 真;
	}

	动作
	{
		为玩家添加生命池(攻击方, 生命值, 事件伤害 * 0.10, 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
	}
}

规则("卡西迪-伤害衰减弥补")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		攻击方.cassidy_distance = 相距距离(攻击方, 被攻击方);
		If(攻击方.cassidy_distance >= 30);
			攻击方.cassidy_distance = 事件伤害 * (7.0/3.0);
			伤害(被攻击方, 攻击方, 攻击方.cassidy_distance);
		Else If(攻击方.cassidy_distance > 20);
			攻击方.cassidy_distance = 事件伤害 * (100/(240-7*攻击方.cassidy_distance)-1);
			伤害(被攻击方, 攻击方, 攻击方.cassidy_distance);
		Else;
			攻击方.cassidy_distance = 0.0;
		End;

		为玩家添加生命池(攻击方, 生命值, (事件伤害 + 攻击方.cassidy_distance) * 0.18, 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
	}
}

规则("卡西迪-屏障伤害")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卡西迪;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) != 空数组;
		存活(事件玩家) == 真;
		玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) > 事件玩家.cassidy_demage;
	}

	动作
	{
		为玩家添加生命池(事件玩家, 生命值, (玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) - 事件玩家.cassidy_demage) * 0.08, 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		事件玩家.cassidy_demage = 玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量);
	}
}

规则("末日铁拳-AI")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		事件玩家 != 主机玩家;
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(终极技能));
		禁用按钮(事件玩家, 按钮(辅助攻击模式));
		禁用按钮(事件玩家, 按钮(近身攻击));
		禁用按钮(事件玩家, 按钮(技能1));
		禁用按钮(事件玩家, 按钮(技能2));

		等待直到(!正在使用技能 1(事件玩家), 8);
		可用按钮(事件玩家, 按钮(终极技能));
		可用按钮(事件玩家, 按钮(辅助攻击模式));
		可用按钮(事件玩家, 按钮(近身攻击));
		可用按钮(事件玩家, 按钮(技能1));
		可用按钮(事件玩家, 按钮(技能2));
	}
}

规则("末日铁拳-AI")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		事件玩家 != 主机玩家;
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(终极技能));
		禁用按钮(事件玩家, 按钮(近身攻击));
		禁用按钮(事件玩家, 按钮(技能1));
		禁用按钮(事件玩家, 按钮(辅助攻击模式));

		等待直到(!正在使用技能 1(事件玩家), 8);
		可用按钮(事件玩家, 按钮(终极技能));
		可用按钮(事件玩家, 按钮(近身攻击));
		可用按钮(事件玩家, 按钮(技能1));
		可用按钮(事件玩家, 按钮(辅助攻击模式));
	}
}

规则("末日铁拳-AI-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		主机玩家 != 事件玩家;
		是否是机器人(事件玩家) != 真;
		终极技能充能百分比(事件玩家) >= 100;
		正在使用终极技能(事件玩家) != 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(终极技能));
		While(终极技能充能百分比(事件玩家) >= 100 && !正在使用终极技能(事件玩家));
			If(标准化生命值(事件玩家) < 随机实数(0.3, 0.6));
				可用按钮(事件玩家, 按钮(终极技能));
				开始按下按钮(事件玩家, 按钮(终极技能));
				等待(0.3, 无视条件);
				停止按下按钮(事件玩家, 按钮(终极技能));

				等待直到(!正在使用终极技能(事件玩家) || (标准化生命值(事件玩家) > 0.8), 随机实数(1, 4));
				If(正在使用终极技能(事件玩家));
					开始按下按钮(事件玩家, 按钮(主要攻击模式));
					等待(0.1, 无视条件);
					停止按下按钮(事件玩家, 按钮(主要攻击模式));
				End;
			End;
			禁用按钮(事件玩家, 按钮(终极技能));
			等待(0.5, 当为“假”时中止);
		End;
	}
}

禁用 规则("末日铁拳-AI-自动跳")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		主机玩家 != 事件玩家;
		是否是机器人(事件玩家) != 真;
		技能冷却时间(事件玩家, 按钮(辅助攻击模式)) <= 0;
		(正在使用技能 1(事件玩家) || 正在使用技能 2(事件玩家) || 正在使用终极技能(事件玩家)) != 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(辅助攻击模式));
		While(真);
			If(数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 30), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) <= 随机实数(15, 20) && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 屏障不会阻挡视线))) > 0);
				禁用按钮(事件玩家, 按钮(主要攻击模式));
				禁用按钮(事件玩家, 按钮(近身攻击));
				禁用按钮(事件玩家, 按钮(技能1));
				禁用按钮(事件玩家, 按钮(技能2));

				可用按钮(事件玩家, 按钮(辅助攻击模式));
				开始按下按钮(事件玩家, 按钮(辅助攻击模式));
				等待直到(!正在使用辅助武器(事件玩家), 随机实数(0.8, 2));
				停止按下按钮(事件玩家, 按钮(辅助攻击模式));

				禁用按钮(事件玩家, 按钮(辅助攻击模式));
				可用按钮(事件玩家, 按钮(主要攻击模式));
				可用按钮(事件玩家, 按钮(近身攻击));
				可用按钮(事件玩家, 按钮(技能1));
				可用按钮(事件玩家, 按钮(技能2));
			End;
			禁用按钮(事件玩家, 按钮(辅助攻击模式));
			等待(0.25, 当为“假”时中止);
		End;
	}
}

规则("末日铁拳-体积")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	动作
	{
		开始调整玩家大小(事件玩家, 所用英雄(事件玩家) == 英雄(末日铁拳) ? 0.925 : 1.0, 真);
	}
}

规则("末日铁拳-减速")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		(事件技能 == 按钮(技能1) || 事件技能 == 按钮(终极技能)) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
	}

	动作
	{
		施加推力(被攻击方, 上, 5, 至地图, 取消相反运动);
	}
}

规则("末日铁拳-增伤")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		具有状态(被攻击方, 击晕) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		伤害(被攻击方, 攻击方, 3);
	}
}

规则("末日铁拳-副武器-火箭拳")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		所用英雄(攻击方) == 英雄(末日铁拳);
		事件技能 == 按钮(辅助攻击模式);
	}

	动作
	{
		If(被攻击方.doomfist_count <= 0);
			// 创建效果(所有玩家(所有队伍), 球, 颜色(白色), 单次赋值(所选位置(被攻击方)), 1, 无);
			伤害(被攻击方, 攻击方, 45);
			If(被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0);
				被攻击方.doomfist_count = 1.0;
			End;
		Else;
			被攻击方.doomfist_count = 0;
			If(被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0);
				// 创建效果(所有玩家(所有队伍), 球体, 颜色(红色), 单次赋值(所选位置(被攻击方)), 1, 无);
				伤害(被攻击方, 攻击方, 65);
				等待直到(!具有状态(事件玩家, 击晕), 0.2);
				设置状态(被攻击方, 攻击方, 击晕, 0.45);
			End;
		End;
	}
}

规则("末日铁拳-被动-无损蓄力-副武器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
	}

	动作
	{
		事件玩家.doomfist_timer = 总计消耗时间;
		事件玩家.i_sys_speed += 50;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 50), 总计消耗时间, 8, 英雄(末日铁拳), 自定义字符串(
			"Doomfist Rocket Punch"));

		为玩家添加生命池(事件玩家, 护盾, 较大(0, 125 - 65 * (总计消耗时间 - 事件玩家.doomfist_timer)), 真, 真);
