规则("源氏-减伤")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		源氏;
	}

	条件
	{
		(在墙上(事件玩家) || 正在空中(事件玩家)) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Genji Dec"))) <= 0;
	}

	动作
	{
		// 开始伤害调整(事件玩家, 所有玩家(所有队伍), (在墙上(事件玩家) || 正在空中(事件玩家)) ? 90 : 100, 受伤害者，伤害者及伤害百分比);
		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, (在墙上(事件玩家) || 正在空中(事件玩家)) ? 110 : 100, 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(源氏), 自定义字符串("Genji Dec"));
	}
}

