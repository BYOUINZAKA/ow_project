{
	事件
	{
		持续 - 每名玩家;
		双方;
		莱因哈特;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
	}

	动作
	{
		While(真);
			等待(0.3, 当为“假”时中止);
			创建弹道(“天使”天使冲击枪, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(0, 0.011, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 7, 2, 0, 有益爆炸, 爆炸声音, 0, 75, 1, 0, 0, 0);
			创建弹道(“天使”天使冲击枪, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(0.0125, -0.011, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 7, 2, 0, 有益爆炸, 爆炸声音, 0, 75, 1, 0, 0, 0);
			创建弹道(“天使”天使冲击枪, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(-0.0125, -0.011, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 7, 2, 0, 有益爆炸, 爆炸声音, 0, 75, 1, 0, 0, 0);
		End;
	}
}

规则("莱因哈特-被动-守护-伤害累计")
{
	事件
	{
		玩家受到伤害;
		双方;
		莱因哈特;
	}

	动作
	{
		If(被攻击方.reinhardt_shield[1] + 事件伤害 > 生命值(被攻击方) * 0.300);
			被攻击方.reinhardt_shield = 数组(0, 0);
			为玩家添加生命池(被攻击方, 护甲, 12 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.020, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 1.00, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 12 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.020, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 1.50, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 12 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.020, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 2.00, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 12 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.020, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 2.50, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 12 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.020, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.00, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 12 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.020, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.50, 英雄(莱因哈特));
			等待(10, 当为“假”时中止);
		End;
			被攻击方.reinhardt_shield = 数组(3, 被攻击方.reinhardt_shield[1] + 事件伤害);
		Else;
	}
}

