规则("托比昂-护甲包")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		托比昂;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(托比昂), 对英雄造成伤害量) != 空数组;
		玩家英雄数据(事件玩家, 英雄(托比昂), 承受伤害量) != 空数组;
		数量(事件玩家.torbjorn_save) == 3;
		((玩家英雄数据(事件玩家, 英雄(托比昂), 对英雄造成伤害量) - 事件玩家.torbjorn_save[0]) + (玩家英雄数据(事件玩家, 英雄(托比昂), 承受伤害量) - 事件玩家.torbjorn_save[1])) > 600;
	}

	动作
