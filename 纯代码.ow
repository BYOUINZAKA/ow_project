	动作
	{
		If(弹药(事件玩家, 0) == 0 || 正在装填(事件玩家));
			设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0) + 25);
		Else;
			设置弹药(事件玩家, 0, 弹药(事件玩家, 0) + 25);
		End;
	}
}

规则("查莉娅-弹药恢复")
