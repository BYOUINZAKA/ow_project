		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 全局.args_junkerqueen[6], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, (所用英雄(事件玩家) == 英雄(渣客女王)) ? 5 : 3, 空, 空);
