	条件
	{
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		While(正在使用技能 2(事件玩家));
			事件玩家.genji_e_target = 已排序的数组(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 180), 存活(当前数组元素) && 在视线内(眼睛位置(事件玩家), 当前数组元素, 屏障不会阻挡视线)), 相距距离(眼睛位置(事件玩家), 当前数组元素) * 角度的正弦值(矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家), 当前数组元素))));
			创建弹道(源氏“镖”, 事件玩家, 空, (数量(事件玩家.genji_e_target) > 0) ? 方向(眼睛位置(事件玩家), 所选位置(事件玩家.genji_e_target[0]) + 上 * 随机实数(0.5, Y方向分量(眼睛位置(事件玩家.genji_e_target[0])) - Y方向分量(所选位置(事件玩家.genji_e_target[0])))) : 空, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 27, 2, 0, 有益爆炸, 爆炸声音, 0, 60, 1.0, 0, 0, 0);
			等待直到(!正在使用技能 2(事件玩家), 0.35);
		End;
		If(!正在使用技能 2(事件玩家));
			为玩家添加生命池(事件玩家, 护甲, 50, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5, 英雄(源氏));
		End;
	}
}

规则("布丽吉塔-鼓舞士气")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		布丽吉塔;
	}

	条件
	{
		存活(事件玩家) == 真;
		玩家英雄数据(事件玩家, 英雄(布丽吉塔), 阻挡伤害量) != 空数组;
	}

	动作
	{
		事件玩家.brigitte_demage_record = 玩家英雄数据(事件玩家, 英雄(布丽吉塔), 阻挡伤害量);
		While(真);
			等待直到((事件玩家.brigitte_demage_record != 空数组 && 事件玩家.brigitte_demage_record != 空 && 事件玩家.brigitte_demage_record != 玩家英雄数据(事件玩家, 英雄(布丽吉塔), 阻挡伤害量)) || 正在使用终极技能(事件玩家), 99999);

			创建弹道(“天使”天使冲击枪, 事件玩家, 所选位置(数组随机取值(已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), !在重生室中(当前数组元素) && !具有状态(当前数组元素, 相移) && !具有状态(当前数组元素, 沉睡)&& !具有状态(当前数组元素, 无敌) && 当前数组元素.a_sys_user_status[全局.t_enum_status_golden] <= 0))), 上, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 0.0001, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.1, 0, 0, 0);
			等待(1.5, 无视条件);
			事件玩家.brigitte_demage_record = 玩家英雄数据(事件玩家, 英雄(布丽吉塔), 阻挡伤害量);
		End;
	}
}

规则("布丽吉塔-鼓舞士气")
{
	事件
	{
