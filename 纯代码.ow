规则("路霸-被动-单打独斗-钩子标记")
{
	事件
	{
		玩家造成伤害;
		双方;
		路霸;
	}

	条件
	{
		事件技能 == 按钮(技能1);
	}

	动作
	{
		等待(0.2, 无视条件);
		设置弹药(攻击方, 0, 较小(弹药(攻击方, 0) + 2, 最大弹药(攻击方, 0)));
		设置技能资源(攻击方, 按钮(辅助攻击模式), 技能资源(攻击方, 按钮(辅助攻击模式)) + 30);
		伤害(被攻击方, 攻击方, 最大生命值(被攻击方) * (数量(已过滤的数组(所有玩家(所在队伍(攻击方)), 当前数组元素.roadhog_mates_flag == 真)) + 1) * 0.080);
	}
}

规则("伊拉锐-护盾发生器")
{
	事件
	{
		玩家造成治疗;
		双方;
		伊拉锐;
	}

	条件
	{
		事件技能 == 空;
	}

	动作
	{
		为玩家添加生命池(受治疗者, 生命值, 正在使用终极技能(治疗者) ? 300 : 50, 假, 真);
		治疗者.sys_default_status_pool[数量(治疗者.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4.5, 英雄(伊拉锐));
		受治疗者.illari_poison = 治疗者;
		等待(1.00, 无视条件);
	}
}

规则("伊拉锐-右键-护盾发生器")
{
	事件
	{
		玩家造成治疗;
		双方;
		伊拉锐;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		为玩家添加生命池(受治疗者, 生命值, 事件治疗 * 12.0, 假, 真);
		治疗者.sys_default_status_pool[数量(治疗者.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.00, 英雄(伊拉锐));
	}
}

规则("伊拉锐-烈日强化")
{
	事件
	{
		玩家造成伤害;
		双方;
		全部;
	}

	条件
	{
		攻击方.illari_poison != 空;
		事件伤害 > 3;
		事件技能 != 空;
		(事件技能 == 按钮(主要攻击模式) || 事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(近身攻击) || (数量(已过滤的数组(全局.ch_normal_attack_dist, 当前数组元素[0] == 所用英雄(事件玩家) && 当前数组元素[1] == 事件技能)) > 0)) == 真;
	}

	动作
	{
		伤害(被攻击方, 攻击方.illari_poison, 事件伤害 * 0.4);
		攻击方.illari_poison = 空;
	}
}

规则("拉玛刹-掌心雷")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家)) == 真;
		正在使用主要武器(事件玩家) == 真;
	}

	动作
	{
		创建弹道(“回声”黏性炸弹, 事件玩家, 空, 空, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 45, 0, 0, 有益爆炸, 爆炸声音, 0.1, 105, 0.2, 0, 0, 0);
	}
}

规则("拉玛刹-增加吸血")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		If(数量(事件玩家.ramattra_absorb) > 0);
			事件玩家.ramattra_absorb[0] = 全局.args_ramattra[0];
		Else;
			事件玩家.ramattra_absorb = 数组(全局.args_ramattra[0], 0.0, 空, 空, 0, 0.0, 0.0, 0.0);
		End;
	}
}

规则("拉玛刹-增加吸血")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		If(数量(事件玩家.ramattra_absorb) > 0);
			事件玩家.ramattra_absorb[0] = 全局.args_ramattra[1];
		Else;
			事件玩家.ramattra_absorb = 数组(全局.args_ramattra[1], 0.0, 空, 空, 0, 0.0, 0.0, 0.0);
		End;
	}
}

规则("拉玛刹-去除吸血")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		数量(事件玩家.ramattra_absorb) > 0;
		((!正在使用技能 1(事件玩家) && !正在使用终极技能(事件玩家) && 事件玩家.ramattra_absorb[1] <= 0) || (所用英雄(事件玩家) != 英雄(拉玛刹))) == 真;
	}

	动作
	{
		事件玩家.ramattra_absorb = 空;
	}
}

规则("拉玛刹-过度治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		数量(事件玩家.ramattra_absorb) > 0;
	}

	动作
	{
		While(数量(事件玩家.ramattra_absorb) > 0);
			等待直到(标准化生命值(事件玩家) >= 1.0 && 对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[0] == 全局.t_enum_heal_continued && 当前数组元素[6] == 10), 1.0);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, (当前数组元素[0] == 全局.t_enum_heal_continued && 当前数组元素[6] == 10) ? 数组(0-当前数组元素[0], 当前数组元素[1], 当前数组元素[2], 当前数组元素[3], 当前数组元素[4], 当前数组元素[5], 当前数组元素[6], 当前数组元素[7]) : 当前数组元素);
			等待(0.0, 无视条件);
		End;

		事件玩家.ramattra_absorb = 空;
	}
}

规则("拉玛刹-过度治疗-callback")
{
	事件
	{
		子程序;
		cb_ramattra_overheal;
	}

	动作
	{
		If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] != 0 - 全局.t_enum_heal_continued || 标准化生命值(事件玩家) < 1.0 || 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][7] <= 1 || 所用英雄(事件玩家) != 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][4]);
			中止;
		End;

		If(总计消耗时间 - 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2] >= 1.0);
			中止;
		End;

		为玩家添加生命池(事件玩家, 生命值, 0.8 * 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][7] * 较大(0, 1.0 - (总计消耗时间 - 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2])), 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 10.0, 所用英雄(事件玩家));
	}
}

规则("拉玛刹-吸血循环")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		数量(事件玩家.ramattra_absorb) > 0;
	}

	动作
	{
		While(数量(事件玩家.ramattra_absorb) > 0);
			If(事件玩家.ramattra_absorb[1] > 0);
				开始持续治疗(事件玩家, 事件玩家, 1.0, 事件玩家.ramattra_absorb[1]);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_continued, 上一个持续治疗效果ID, 总计消耗时间, 1.0, 英雄(拉玛刹), 空, 10, 事件玩家.ramattra_absorb[1]);
				事件玩家.ramattra_absorb[1] = 0.0;
			End;
			等待(全局.args_ramattra[2], 当为“假”时中止);
		End;
	}
}

规则("拉玛刹-吸血")
{
	事件
	{
		玩家造成伤害;
		双方;
		拉玛刹;
	}

	条件
	{
		数量(攻击方.ramattra_absorb) > 0;
		攻击方.ramattra_absorb[0] > 0;
		(事件技能 == 按钮(技能1) || 事件技能 == 按钮(终极技能) || 事件技能 == 按钮(近身攻击) || 事件技能 == 按钮(技能2) || 事件技能 == 空) == 真;
	}

	动作
	{
		攻击方.ramattra_absorb[1] += 事件伤害 * 攻击方.ramattra_absorb[0];
	}
}

