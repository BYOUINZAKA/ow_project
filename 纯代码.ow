		具有状态(攻击方, 相移) != 真;
		具有状态(攻击方, 沉睡) != 真;
		攻击方.a_sys_user_status[全局.t_enum_status_golden] <= 0;
	}

	动作
	{
		创建弹道(“天使”天使冲击枪, 被攻击方, 所选位置(攻击方), 上, 至地图, 伤害, 所在队伍(攻击方), 0.0001, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.1, 0, 0, 0);
		等待(1.5, 无视条件);
	}
}

规则("布丽吉塔-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		布丽吉塔;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
		设置技能冷却(事件玩家, 按钮(技能1), 0);
		设置技能冷却(事件玩家, 按钮(技能2), 0);
		设置技能充能(事件玩家, 按钮(技能2), 5);

		开始伤害调整(事件玩家, 所有玩家(所有队伍), 全局.args_brigitte[10], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 11, 英雄(布丽吉塔),
			自定义字符串("Brigitte Rally"));

		开始伤害调整(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 8.500, 所在队伍(事件玩家), 表面及敌方屏障), 当前数组元素 != 事件玩家), 所有玩家(所有队伍), 全局.args_brigitte[11], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 11, 英雄(布丽吉塔),
			自定义字符串("Brigitte Rally"));

		While(正在使用终极技能(事件玩家) == 真);
			事件玩家.buligita_players = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 8.500, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素));
			事件玩家.buligita_players.sys_softirq[17] += 1;

			事件玩家.buligita_players = 已过滤的数组(事件玩家.buligita_players, 当前数组元素 != 事件玩家);
			事件玩家.buligita_players.i_sys_speed += 全局.args_brigitte[12];
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家.buligita_players, 全局.args_brigitte[12]), 总计消耗时间, 1.00, 英雄(布丽吉塔), 自定义字符串("Brigitte Rally Speed"));
			// 等待直到 (正在使用终极技能(事件玩家) != 真, 1.00);
			等待直到 (!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Rally Speed")) || 正在使用终极技能(事件玩家) != 真, 1.00);
		End;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Rally") ? 数组分割(当前数组元素, 0, 2)
			: 当前数组元素);
		事件玩家.buligita_players = 空;
	}
}

