规则("")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_main_tank != 空;
		事件玩家 != 事件玩家.sys_main_tank;
		相距距离(事件玩家, 目标位置(对象索引)) > 全局.args_system[2];
		相距距离(事件玩家.sys_main_tank, 目标位置(对象索引)) > 全局.args_system[2];
		在目标点上(事件玩家) != 真;
		在目标点上(事件玩家.sys_main_tank) != 真;
		主机玩家 != 事件玩家;
		正在等待玩家 != 真;
		存活(事件玩家.sys_main_tank) == 真;
		存活(事件玩家) == 真;
	}

	动作
	{
		等待(8.0, 当为“假”时中止);
		If(数组包含(全局.sys_support, 所用英雄(事件玩家)));
			绑定玩家(事件玩家, 事件玩家.sys_main_tank, 矢量(随机实数(-2, 2), 0, -3));
		Else;
			绑定玩家(事件玩家, 事件玩家.sys_main_tank, 矢量(随机实数(-2, 2), 0, -1.5));
		End;
	}
}

规则("")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		((事件玩家.sys_main_tank == 空) || (相距距离(事件玩家, 目标位置(对象索引)) <= 全局.args_system[2]) || (相距距离(事件玩家.sys_main_tank, 目标位置(对象索引)) <= 全局.args_system[2]) || 在目标点上(事件玩家) || 在目标点上(事件玩家.sys_main_tank) || 主机玩家 == 事件玩家 || 正在使用终极技能(事件玩家.sys_main_tank) || !存活(事件玩家) || !存活(事件玩家.sys_main_tank)) == 真;
		// ((事件玩家.sys_main_tank == 空) || (相距距离(事件玩家, 目标位置(对象索引)) <= 全局.args_system[2]) || 在目标点上(事件玩家)  || 主机玩家 == 事件玩家) == 真;
		事件玩家 != 事件玩家.sys_main_tank;
	}

	动作
	{
		解除绑定(事件玩家);
		传送(事件玩家, 最近的可行走位置(事件玩家));
	}
}

规则("能量运营-HP循环")
{
	事件
	{
		子程序;
		do_energy_hp_loop;
	}

	动作
	{	
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+1] = 0;	// 遍历索引
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+2] = 0.0;	// 遍历总分
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+3] = 0;	// 遍历总数
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+4] = 空;	// 遍历的当前玩家
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] = 0;	// 当前权重
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+6] = 0;	// 超出有效范围的数量
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+7] = 所有玩家(所在队伍(事件玩家));
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+8] = 0.0;	// 支援事由总分
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+9] = 0.0;	// 威胁事由总分
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+10] = 所有玩家(对方队伍(所在队伍(事件玩家)));
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+11] = 空;	// 遍历的对方玩家
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+12] = 0;	// 玩家差值

		事件玩家.sys_ultra_score[全局.i_sys_score_offset+7].sys_softirq[6] += 1;
		事件玩家.sys_ultra_score[全局.i_sys_score_offset+10].sys_softirq[7] += 1;

		While(事件玩家.sys_ultra_score[全局.i_sys_score_offset+1] < 数量(事件玩家.sys_ultra_score[全局.i_sys_score_offset+7]));
			If(!存活(事件玩家));
				中断;
			End;

			事件玩家.sys_ultra_score[全局.i_sys_score_offset+4] = 事件玩家.sys_ultra_score[全局.i_sys_score_offset+7][事件玩家.sys_ultra_score[全局.i_sys_score_offset+1]];

			If(数组包含(全局.sys_tank, 所用英雄(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4])));
				If(标准化生命值(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) > 0.8 || 类型的生命值(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4], 护甲) > 0);
					事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] = 事件玩家.sys_ultra_score[4];
				Else;
					事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] = 事件玩家.sys_ultra_score[5];
				End;
			Else If(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4] == 事件玩家);
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] = 事件玩家.sys_ultra_score[3];
			Else;
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] = 1.0;
			End;

			If(存活(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) && 相距距离(事件玩家, 事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) <= 事件玩家.sys_ultra_score[0]);
				If(标准化生命值(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) <= 0.15);
					事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] *= 事件玩家.sys_ultra_score[8];
				Else If(标准化生命值(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) <= 0.3);
					事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] *= 事件玩家.sys_ultra_score[7];
				Else If(标准化生命值(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) <= 0.5);
					事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] *= 事件玩家.sys_ultra_score[6];
				End;
			End;

			If(!存活(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) || 相距距离(事件玩家, 事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) > 事件玩家.sys_ultra_score[0]);
				// 事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] += 事件玩家.sys_ultra_score[全局.i_sys_score_offset+6] * 事件玩家.sys_ultra_score[9];
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] *= 事件玩家.sys_ultra_score[全局.i_sys_score_offset+6] * 事件玩家.sys_ultra_score[9];
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+6] += 1;
			Else;
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+2] += 事件玩家.sys_ultra_score[全局.i_sys_score_offset+5] * (1.0 - 标准化生命值(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]));
			End;


			事件玩家.sys_ultra_score[全局.i_sys_score_offset+3] += 事件玩家.sys_ultra_score[全局.i_sys_score_offset+5];

			If(存活(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) && 相距距离(事件玩家, 事件玩家.sys_ultra_score[全局.i_sys_score_offset+4]) <= 事件玩家.sys_ultra_score[0]);
				等待直到(事件玩家.sys_ultra_score[全局.i_sys_score_offset+4].sys_softirq[6] <= 0, 99999);
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+8] += 事件玩家.sys_ultra_score[全局.i_sys_score_offset+4].sys_ultra_reasons[0];
			Else;
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+12] += 1;
			End;

			事件玩家.sys_ultra_score[全局.i_sys_score_offset+11] = 事件玩家.sys_ultra_score[全局.i_sys_score_offset+10][事件玩家.sys_ultra_score[全局.i_sys_score_offset+1]];
			If(事件玩家.sys_ultra_score[全局.i_sys_score_offset+11] != 空 && 存活(事件玩家.sys_ultra_score[全局.i_sys_score_offset+11]) && 相距距离(事件玩家, 事件玩家.sys_ultra_score[全局.i_sys_score_offset+11]) <= 事件玩家.sys_ultra_score[0]);
				等待直到(事件玩家.sys_ultra_score[全局.i_sys_score_offset+11].sys_softirq[7] <= 0, 99999);
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+9] += 事件玩家.sys_ultra_score[全局.i_sys_score_offset+11].sys_ultra_reasons[1];
			Else;
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+12] -= 1;
			End;

			事件玩家.sys_ultra_score[全局.i_sys_score_offset+1] += 1;
			等待(0.0, 无视条件);
		End;
	}
}

规则("能量运营子系统")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		主机玩家 != 事件玩家;
		终极技能充能百分比(事件玩家) >= 100;
		数组包含(数组(英雄(卢西奥), 英雄(禅雅塔), 英雄(布丽吉塔)), 所用英雄(事件玩家)) == 真;
		存活(事件玩家) == 真;
		正在使用终极技能(事件玩家) != 真;
		事件玩家.sys_ultra_score == 空;
		正在等待玩家 != 真;
	}

	动作
	{
		If(所用英雄(事件玩家) == 英雄(禅雅塔));
			事件玩家.sys_ultra_score = 数组(43, 30, 所用英雄(事件玩家), 1.4, 1.0, 1.2, 2.0, 2.5, 3.5, 0.15);
		Else If(所用英雄(事件玩家) == 英雄(布丽吉塔));
			事件玩家.sys_ultra_score = 数组(40, 25, 所用英雄(事件玩家), 1.1, 1.0, 1.2, 2.5, 2.5, 3.0, 0.15);
		Else If(所用英雄(事件玩家) == 英雄(卢西奥));
			事件玩家.sys_ultra_score = 数组(43, 35, 所用英雄(事件玩家), 1.7, 1.0, 1.2, 1.5, 3.0, 3.0, 0.15);
		End;

		While(终极技能充能百分比(事件玩家) >= 100 && !正在使用终极技能(事件玩家) && 所用英雄(事件玩家) == 事件玩家.sys_ultra_score[2] && 存活(事件玩家));
			禁用按钮(事件玩家, 按钮(终极技能));
			调用子程序(do_energy_hp_loop);

			事件玩家.sys_ultra_score[全局.i_sys_score_offset+12] = 绝对值(事件玩家.sys_ultra_score[全局.i_sys_score_offset+12]);

			事件玩家.sys_ultra_score[全局.i_sys_score_offset+0] = 
			(100.0 * 事件玩家.sys_ultra_score[全局.i_sys_score_offset+2] / 事件玩家.sys_ultra_score[全局.i_sys_score_offset+3]) + 
			(事件玩家.sys_ultra_score[全局.i_sys_score_offset+8] / 数量(事件玩家.sys_ultra_score[全局.i_sys_score_offset+7])) + 
			(事件玩家.sys_ultra_score[全局.i_sys_score_offset+9] / 数量(事件玩家.sys_ultra_score[全局.i_sys_score_offset+7])) -
			((事件玩家.sys_ultra_score[全局.i_sys_score_offset+12] >= 2) ? (事件玩家.sys_ultra_score[全局.i_sys_score_offset+12] * 随机实数(2, 10)): 0);

			If(事件玩家.sys_ultra_score[全局.i_sys_score_offset+0] > 随机实数(事件玩家.sys_ultra_score[0]-3, 事件玩家.sys_ultra_score[0]+3) && 终极技能充能百分比(事件玩家) >= 100);
				可用按钮(事件玩家, 按钮(终极技能));
				事件玩家.sys_ultra_score[全局.i_sys_score_offset+0] = 0.0;

				按下按键(事件玩家, 按钮(终极技能));
				等待直到(正在使用终极技能(事件玩家) || 终极技能充能百分比(事件玩家) < 100 || !存活(事件玩家), 1.0);
				停止按下按钮(事件玩家, 按钮(终极技能));
			End;

			等待直到(!(终极技能充能百分比(事件玩家) >= 100 && !正在使用终极技能(事件玩家) && 所用英雄(事件玩家) == 事件玩家.sys_ultra_score[2] && 存活(事件玩家)), 随机实数(0.1, 0.3));
		End;

		可用按钮(事件玩家, 按钮(终极技能));
		事件玩家.sys_ultra_score = 空;
	}
}

规则("能量运营-支援事由")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[6] > 0;
	}

	动作
	{
		事件玩家.sys_softirq[6] = -999;
		If(数组包含(数组(英雄(布丽吉塔), 英雄(禅雅塔), 英雄(卢西奥)), 所用英雄(事件玩家)) && 正在使用终极技能(事件玩家));
			事件玩家.sys_ultra_reasons[0] = -100;
		Else If(数组包含(数组(英雄(雾子), 英雄(天使), 英雄(朱诺)), 所用英雄(事件玩家)) && 正在使用终极技能(事件玩家));
			事件玩家.sys_ultra_reasons[0] = -75;
		Else If(所用英雄(事件玩家) == 英雄(美) && 事件玩家.mei_Q_center != 空);
			事件玩家.sys_ultra_reasons[0] = -50;
		Else;
			事件玩家.sys_ultra_reasons[0] = 0;
		End;

		If(所用英雄(事件玩家) == 英雄(布丽吉塔) && 技能冷却时间(事件玩家, 按钮(辅助攻击模式)) > 0);
			事件玩家.sys_ultra_reasons[0] += 30;
		End;

		If(具有状态(事件玩家, 击倒) || 具有状态(事件玩家, 定身) || 具有状态(事件玩家, 击晕));
			事件玩家.sys_ultra_reasons[0] += 30;
		End;

		If(具有状态(事件玩家, 燃烧) || 具有状态(事件玩家, 沉睡));
			事件玩家.sys_ultra_reasons[0] += 10;
		End;

		If(事件玩家.junkerqueen_effect != 空);
			事件玩家.sys_ultra_reasons[0] += 5;
		End;

		等待(0.10, 无视条件);
		事件玩家.sys_softirq[6] = 0;

		如条件为“真”则循环;
	}
}

规则("能量运营-威胁事由")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[7] > 0;
	}

	动作
	{
		事件玩家.sys_softirq[7] = -999;
		If(数组包含(数组(英雄(布丽吉塔), 英雄(禅雅塔), 英雄(卢西奥), 英雄(死神), 英雄(安娜), 英雄(奥丽莎), 英雄(探奇), 英雄(士兵：76), 英雄(渣客女王), 英雄(艾什), 英雄(伊拉锐)), 所用英雄(事件玩家)) && 正在使用终极技能(事件玩家));
			事件玩家.sys_ultra_reasons[1] = 50;
		Else If(数组包含(数组(英雄(索杰恩), 英雄(雾子)), 所用英雄(事件玩家)) && 正在使用终极技能(事件玩家));
			事件玩家.sys_ultra_reasons[1] = 80;
		Else If(所用英雄(事件玩家) == 英雄(美) && 事件玩家.mei_Q_center != 空);
			事件玩家.sys_ultra_reasons[1] = 70;
		Else If(数组包含(数组(英雄(源氏), 英雄(黑影), 英雄(拉玛刹), 英雄(法老之鹰)), 所用英雄(事件玩家)) && 正在使用终极技能(事件玩家));
			事件玩家.sys_ultra_reasons[1] = 80;
		Else;
			事件玩家.sys_ultra_reasons[1] = 0;
		End;
		If(所用英雄(事件玩家) == 英雄(卢西奥) && 正在使用技能 2(事件玩家));
			事件玩家.sys_ultra_reasons[1] += 15;
		End;
		等待(0.10, 无视条件);
		事件玩家.sys_softirq[7] = 0;

		如条件为“真”则循环;
	}
}

规则("状态显示文本")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		创建HUD文本(事件玩家.a_sys_user_status[全局.t_enum_status_thorns] > 0 ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("荆棘：{0}%", 事件玩家.a_sys_user_status[全局.t_enum_status_thorns] * 100.0), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(绿色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0 ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("免控"), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(绿色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(事件玩家.a_sys_user_status[全局.t_enum_status_golden] > 0 ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("金甲：{0}层", 事件玩家.a_sys_user_status[全局.t_enum_status_golden]), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(绿色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(事件玩家.a_sys_user_status[全局.t_enum_status_recover] > 0 ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("复生祈祷"), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(绿色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(具有状态(事件玩家, 定身) ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("定身"), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(红色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(具有状态(事件玩家, 相移) ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("相移"), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(绿色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(具有状态(事件玩家, 无敌) ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("无敌"), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(绿色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(具有状态(事件玩家, 无法杀死) ? 事件玩家 : 空, 自定义字符串(""), 自定义字符串("无法杀死"), 自定义字符串(""), 右边, 0, 颜色(白色), 颜色(绿色), 颜色(白色), 可见和字符串, 默认可见度);

		创建地图文本(事件玩家.sys_ultra_score != 空 ? 所有玩家(所有队伍) : 空, 事件玩家.sys_ultra_score[全局.i_sys_score_offset+0], 事件玩家, 1, 根据表面截取, 可见，位置和字符串, 颜色(白色), 默认可见度);
		// 创建地图文本(所有玩家(所有队伍), 数量(事件玩家.sys_default_status_pool), 事件玩家, 1, 根据表面截取, 可见，位置和字符串, 颜色(白色), 默认可见度);
	}
}

规则("系统-状态-荆棘")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		攻击方.a_sys_user_status[全局.t_enum_status_thorns] > 0.0;
		事件伤害 > 1.0;
		事件技能 != 空;
	}

	动作
	{
		伤害(攻击方, 被攻击方, 较小(被攻击方.a_sys_user_status[全局.t_enum_status_thorns], 1.0) * 事件伤害);
	}
}

规则("系统-状态-荆棘")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		攻击方.a_sys_user_status[全局.t_enum_status_thorns] <= 0.0;
		事件伤害 > 1.0;
	}

	动作
	{
		伤害(攻击方, 被攻击方, 较小(被攻击方.a_sys_user_status[全局.t_enum_status_thorns], 1.0) * 事件伤害);
	}
}

规则("系统-状态-免控")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0.0;
	}

	动作
	{
		设置受到的击退(事件玩家, 0);
		
		While(事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0.0);
			清除状态(事件玩家, 冰冻);
			清除状态(事件玩家, 沉睡);
			清除状态(事件玩家, 燃烧);
			清除状态(事件玩家, 击倒);
			清除状态(事件玩家, 击晕);
			清除状态(事件玩家, 被入侵);
			清除状态(事件玩家, 定身);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Debuff")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
			设置受到的击退(事件玩家, 0);
			等待(0.1, 无视条件);

			等待直到(事件玩家.a_sys_user_status[全局.t_enum_status_immunity] <= 0 || (具有状态(事件玩家, 冰冻) || 具有状态(事件玩家, 击倒) || 具有状态(事件玩家, 击晕) || 具有状态(事件玩家, 沉睡) || 具有状态(事件玩家, 燃烧) || 具有状态(事件玩家, 被入侵) || 具有状态(事件玩家, 定身) || 数量(已过滤的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Debuff")))) > 0), 1);
		End;

		设置受到的击退(事件玩家, 100);
	}
}

规则("系统-状态-金甲")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		被攻击方.a_sys_user_status[全局.t_enum_status_golden] > 0;
	}

	动作
	{
		被攻击方.a_sys_user_status[全局.t_enum_status_golden] -= 1;
		等待(0.02, 无视条件);
	}
}

规则("系统-状态-金甲")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_golden] > 0;
	}

	动作
	{
		While(事件玩家.a_sys_user_status[全局.t_enum_status_golden] > 0);
			If(!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Golden Armor")));
				开始伤害调整(事件玩家, 所有玩家(所有队伍), 0.1, 受伤害者和伤害者);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 空, 自定义字符串("Golden Armor"));
		
				创建效果(所有玩家(所有队伍), 巴蒂斯特维生力场保护效果, 颜色(橙色), 事件玩家, 1.0, 可见，位置和半径);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 空, 自定义字符串("Golden Armor"));
			End;
			等待直到(!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Golden Armor")) || 事件玩家.a_sys_user_status[全局.t_enum_status_golden] <= 0, 9999);
		End;

		事件玩家.a_sys_user_status[全局.t_enum_status_golden] = 0;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Golden Armor") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		等待直到(对全部为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] != 自定义字符串("Golden Armor")), 1.0);
	}
}

