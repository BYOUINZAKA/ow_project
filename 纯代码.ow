		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Block"))) <= 0;
	}

	动作
	{
		// 开始伤害调整(事件玩家, 视角中的玩家(事件玩家, 所有队伍, 53), (!正在使用终极技能(事件玩家) && (正在使用辅助武器(事件玩家) || 正在使用主要武器(事件玩家))) ? 50 : 100, 受伤害者，伤害者及伤害百分比);
		开始伤害调整((!正在使用终极技能(事件玩家) && (正在使用辅助武器(事件玩家) || 正在使用主要武器(事件玩家))) ? 事件玩家 : 空, 视角中的玩家(事件玩家, 所有队伍, 60), 70, 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(温斯顿), 自定义字符串("Winston Block"));
		创建效果((!正在使用终极技能(事件玩家) && (正在使用辅助武器(事件玩家) || 正在使用主要武器(事件玩家))) ? 添加至数组(视角中的玩家(事件玩家, 所有队伍, 60), 事件玩家) : 空, “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(温斯顿), 自定义字符串("Winston Block"));
	}
}

