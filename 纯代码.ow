{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		禁用查看器录制;
		全局.t_enum_hp_pool = 1;
		全局.t_enum_damage_adjust = 2;
		全局.t_enum_heal_adjust = 3;
		全局.t_enum_effect = 4;
		全局.t_enum_speed = 5;
