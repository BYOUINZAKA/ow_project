		毛加;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mauga Ring"))) <= 0;
	}

	动作
	{
		创建效果(存活(事件玩家) ? 所有玩家(所有队伍) : 空, 环, 颜色(红色), 事件玩家, 7, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(毛加), 自定义字符串("Mauga Ring"));
	}
}

规则("毛加-S-自动取消")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
		主机玩家 != 事件玩家;
		数量(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 7, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 存活(当前数组元素))) > 0;
	}

	动作
	{
		While(正在使用技能 1(事件玩家));
			开始按下按钮(事件玩家, 按钮(跳跃));
			等待直到(!正在使用技能 1(事件玩家), 3);
			停止按下按钮(事件玩家, 按钮(跳跃));
		End;
	}
}

规则("毛加-E-加速")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		存活(事件玩家) == 真;
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		While(存活(事件玩家) && 正在使用技能 2(事件玩家));
			事件玩家.mauga_s_players = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 10.5, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素) && !(当前数组元素 == 事件玩家 && 正在使用技能 1(当前数组元素)));
			事件玩家.mauga_s_players.i_sys_speed += 50;
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家.mauga_s_players, 50), 总计消耗时间, 0.5, 英雄(毛加), 自定义字符串("Mauga Cardiac Overdrive"));

			等待(0.5, 无视条件);
			等待直到 (!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mauga Cardiac Overdrive")), 0.5);
		End;
	}
}

规则("毛加-灼烧")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		存活(事件玩家) == 真;
	}

	动作
	{
		While(存活(事件玩家));
			已过滤的数组(范围内玩家(眼睛位置(事件玩家), 7, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素)).sys_softirq[13] = 事件玩家;
			等待(1.0, 当为“假”时中止);
		End;
	}
}

规则("毛加-S-灼烧")
{
	事件
	{
		玩家造成伤害;
		双方;
		毛加;
	}

	条件
	{
		事件技能 == 按钮(技能1);
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
		(被攻击方.mauga_flag == 空 || 总计消耗时间 - 被攻击方.mauga_flag[1] >= 4 || !具有状态(事件玩家, 燃烧)) == 真;
	}

	动作
	{
		设置状态(被攻击方, 攻击方, 燃烧, 4);
		停止持续伤害(被攻击方.mauga_flag);
		开始持续伤害(被攻击方, 攻击方, 4, 15);
		被攻击方.mauga_flag = 数组(上一个持续伤害效果ID, 总计消耗时间);
	}
}

规则("毛加-灼烧标")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[13] != 空;
	}

	动作
	{
		If(事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0.0);
			事件玩家.sys_softirq[13] = 空;
			中止;
		End;
		If(事件玩家.mauga_flag == 空);
			设置状态(事件玩家, 事件玩家.sys_softirq[13], 燃烧, 4);
			开始持续伤害(事件玩家, 事件玩家.sys_softirq[13], 4, 15);
			事件玩家.mauga_flag = 数组(上一个持续伤害效果ID, 总计消耗时间);
		Else If(总计消耗时间 - 事件玩家.mauga_flag[1] >= 4);
			设置状态(事件玩家, 事件玩家.sys_softirq[13], 燃烧, 4);
			停止持续伤害(事件玩家.mauga_flag);
			开始持续伤害(事件玩家, 事件玩家.sys_softirq[13], 4, 15);
			事件玩家.mauga_flag = 数组(上一个持续伤害效果ID, 总计消耗时间);
		End;
		事件玩家.sys_softirq[13] = 空;
	}
}

规则("毛加-灼烧标记")
{
