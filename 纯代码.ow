		全局.t_enum_hp_percent = 15;
		全局.t_enum_status_recover = 16;
		全局.t_enum_escape = 0;

		全局.sys_tank = 从数组中移除(所有重装英雄, 英雄(末日铁拳));
		全局.sys_damage = 添加至数组(所有输出英雄, 英雄(末日铁拳));
		全局.sys_support = 所有支援英雄;

		全局.a_sys_all_buttons = 数组(按钮(主要攻击模式), 按钮(互动), 按钮(技能1), 按钮(技能2), 按钮(终极技能), 按钮(装填), 按钮(跳跃), 按钮(蹲下), 按钮(辅助攻击模式), 按钮(近身攻击));
		全局.i_sys_score_offset = 15;

		全局.args_system[0] = 地图工坊设置整数(自定义字符串("系统"), 自定义字符串("资源回收-间隔（ms）"), 100, 1, 1000, 0) * 0.001;
		全局.args_system[1] = 地图工坊设置整数(自定义字符串("系统"), 自定义字符串("资源回收-调度间隔"), 1, 1, 20, 0);
		全局.args_system[2] = 地图工坊设置整数(自定义字符串("系统"), 自定义字符串("跟随系统-距离"), 20, 0, 100, 0);
		全局.args_system[3] = 地图工坊设置整数(自定义字符串("系统"), 自定义字符串("全局定时器-间隔（ms）"), 200, 1, 1000, 0) / 1000.0;

		全局.args_tracer[0] = 地图工坊设置整数(自定义字符串("猎空"), 自定义字符串("最大能量"), 50, 1, 200, 0);
		全局.args_tracer[1] = 地图工坊设置整数(自定义字符串("猎空"), 自定义字符串("伤害池大小"), 175, 1, 500, 0);
		全局.args_tracer[2] = 地图工坊设置实数(自定义字符串("猎空"), 自定义字符串("伤害池伤害百分比"), 1, 1, 100, 0) * 0.01;
		全局.args_tracer[3] = 地图工坊设置组合(自定义字符串("猎空"), 自定义字符串("伤害池计算方式"), 0, 数组(自定义字符串("最大生命值"), 自定义字符串("当前生命值"), 自定义字符串("已损生命值")), 0);
		全局.args_tracer[4] = 地图工坊设置整数(自定义字符串("猎空"), 自定义字符串("伤害池单发最大伤害"), 20, 1, 100, 0);

		全局.args_zenyata[0] = 地图工坊设置整数(自定义字符串("禅雅塔"), 自定义字符串("破-攻击间隔"), 2, 2, 5, 0);
		全局.args_zenyata[1] = 地图工坊设置整数(自定义字符串("禅雅塔"), 自定义字符串("圣-额外治疗"), 100, 0, 500, 0);
