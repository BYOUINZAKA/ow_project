			+ 随机实数(-0.010, 0.010)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 20, 0.250, 5, 有害爆炸, 爆炸声音, 0, 25, 60, 0.300, 0, 7);
		创建弹道(“法老之鹰”火箭, 事件玩家, 空, 矢量(X方向分量(面朝方向(事件玩家)) + 随机实数(-0.010, 0.010), Y方向分量(面朝方向(事件玩家)) + 随机实数(-0.010, 0.010), Z方向分量(面朝方向(事件玩家))
			+ 随机实数(-0.010, 0.010)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 20, 0.250, 5, 有害爆炸, 爆炸声音, 0, 25, 60, 0.300, 0, 7);
		创建弹道(“法老之鹰”火箭, 事件玩家, 空, 矢量(X方向分量(面朝方向(事件玩家)) + 随机实数(-0.010, 0.010), Y方向分量(面朝方向(事件玩家)) + 随机实数(-0.010, 0.010), Z方向分量(面朝方向(事件玩家))
			+ 随机实数(-0.010, 0.010)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 40, 0.250, 5, 有害爆炸, 爆炸声音, 0, 25, 60, 0.300, 0, 7);
	}
}

规则("美-shift")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		美;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		取消主要动作(事件玩家);

		创建效果(所有玩家(所有队伍), 环, 所在队伍(事件玩家), 最近的可行走位置(事件玩家), 全局.args_mei[3], 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[4] + 0.5, 英雄(美), 自定义字符串("Mei Cryo-Freeze Ring"));

		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze"))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze"))[0][1]);
			为玩家添加生命池(事件玩家, 生命值, 全局.args_mei[0] * 全局.args_mei[2], 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.0, 空, 自定义字符串("Mei Cryo-Freeze")) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze"))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 全局.args_mei[0] * 全局.args_mei[2], 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.0, 空, 自定义字符串("Mei Cryo-Freeze"));
		End;

		事件玩家.mei_s_begin_time = 总计消耗时间;
		While(存活(事件玩家) && 总计消耗时间 - 事件玩家.mei_s_begin_time < 全局.args_mei[4]);
			范围内玩家(眼睛位置(事件玩家), 全局.args_mei[3], 所在队伍(事件玩家), 关闭).sys_softirq[0] = 事件玩家;
			等待(1.0, 无视条件);
		End;

		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze Ring") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		事件玩家.mei_s_begin_time = 空;
	}
}

规则("美-E")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		美;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei E"))) <= 0;
	}

	动作
	{
		事件玩家.sys_button_list[数组值的索引(全局.a_sys_all_buttons, 按钮(技能2))] += 1;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_disable_button, 数组(事件玩家, 按钮(技能2)), 总计消耗时间, -1, 英雄(美), 自定义字符串("Mei E"));
	}
}

规则("美-E")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		美;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(技能2)) == 真;
		// 事件玩家.mei_e_pos == 空;
		技能冷却时间(事件玩家, 按钮(技能2)) <= 0;
	}

	动作
	{
		事件玩家.mei_e_pos = 射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 25, 所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 真);
		事件玩家.mei_e_begin = 总计消耗时间 + 全局.args_mei[9];
		设置技能冷却(事件玩家, 按钮(技能2), 15);

		创建效果(所有玩家(所有队伍), 烟雾声音, 所在队伍(事件玩家), 事件玩家.mei_e_pos, 999, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ice Wall Center"));

		创建效果(所有玩家(所有队伍), 有害光环, 所在队伍(事件玩家), 事件玩家.mei_e_pos, 全局.args_mei[8], 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ice Wall Ring"));

		While(事件玩家.mei_e_pos != 空 && 总计消耗时间 <= 事件玩家.mei_e_begin);
			已过滤的数组(范围内玩家(事件玩家.mei_e_pos, 全局.args_mei[8], 所在队伍(事件玩家), 关闭), 存活(当前数组元素)).sys_softirq[1] = 事件玩家;
			已过滤的数组(范围内玩家(事件玩家.mei_e_pos, 全局.args_mei[8], 对方队伍(所在队伍(事件玩家)), 关闭), 存活(当前数组元素)).sys_softirq[8] = 事件玩家;
			等待(1.0, 无视条件);
		End;

		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Ice Wall Center") || 当前数组元素[5] == 自定义字符串("Mei Ice Wall Ring") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		事件玩家.mei_e_pos = 空;
	}
}

规则("美-shift-过度治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[0] != 空;
		存活(事件玩家.sys_softirq[0]) == 真;
		事件玩家.mei_s_timer == 空;
	}

	动作
	{
		开始持续治疗(事件玩家, 事件玩家.sys_softirq[0], 全局.args_mei[1], 全局.args_mei[0] / 全局.args_mei[1]);
		事件玩家.mei_s_timer = 数组(总计消耗时间, 生命值(事件玩家), 上一个持续治疗效果ID, 空);
		事件玩家.sys_softirq[0] = 空;

		等待直到(标准化生命值(事件玩家) >= 1.0, 全局.args_mei[1]);
		停止持续治疗(事件玩家.mei_s_timer[2]);

		If(全局.args_mei[2] > 0 && 总计消耗时间 - 事件玩家.mei_s_timer[0] < 全局.args_mei[1] && 标准化生命值(事件玩家) >= 1.0 && 最大生命值(事件玩家) - 事件玩家.mei_s_timer[1] < 全局.args_mei[0]);
			If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze"))) == 1);
				移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze"))[0][1]);
				为玩家添加生命池(事件玩家, 生命值, 较小(全局.args_mei[0] - (最大生命值(事件玩家) - 事件玩家.mei_s_timer[1]), 全局.args_mei[0]) * 全局.args_mei[2], 假, 假);
				事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.0, 空, 自定义字符串("Mei Cryo-Freeze")) : 当前数组元素);
			Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Cryo-Freeze"))) == 0);
				为玩家添加生命池(事件玩家, 生命值, 较小(全局.args_mei[0] - (最大生命值(事件玩家) - 事件玩家.mei_s_timer[1]), 全局.args_mei[0]) * 全局.args_mei[2], 假, 假);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.0, 空, 自定义字符串("Mei Cryo-Freeze"));
			End;
		End;

		事件玩家.mei_s_timer = 空;
		如条件为“真”则循环;
	}
}

