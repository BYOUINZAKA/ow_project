规则("查莉娅-AI-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		主机玩家 != 事件玩家;
		存活(事件玩家) == 真;
		正在使用终极技能(事件玩家) != 真;
		终极技能充能百分比(事件玩家) >= 100;
	}

	动作
	{
		While(真);
			If(绝对值(数量(已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 相距距离(事件玩家, 当前数组元素) < 25)) - 数量(已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 相距距离(事件玩家, 当前数组元素) < 25))) < 3);
				If(
					数量(已过滤的数组(
						范围内玩家(
							射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 归一化(面朝方向(事件玩家) + 下 * 随机实数(0.04, 0.08)) * 25, 所有存活玩家(对方队伍(所在队伍(事件玩家))), 所有玩家(所在队伍(事件玩家)), 真),
							7, 
							对方队伍(所在队伍(事件玩家)), 
							关闭
						), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) <= 随机实数(3, 12)
					)) > 随机实数(0, 6)
				);
					开始按下按钮(事件玩家, 按钮(终极技能));
					等待(0.1, 无视条件);
					停止按下按钮(事件玩家, 按钮(终极技能));
				End;
				// If(数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 25), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) < 15)) > 随机实数(0, 6));
				// 	开始按下按钮(事件玩家, 按钮(终极技能));
				// 	等待(0.1, 无视条件);
				// 	停止按下按钮(事件玩家, 按钮(终极技能));
				// End;
			End;
			等待(随机实数(0.2, 0.8), 当为“假”时中止);
		End;
	}
}

规则("查莉娅-AI-S")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		主机玩家 != 事件玩家;
		存活(事件玩家) == 真;
		正在使用技能 1(事件玩家) != 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(技能1));
		While(真);
			If(随机实数(0.3, 0.8) >= (生命值(事件玩家) / 550.0));
				可用按钮(事件玩家, 按钮(技能1));
				开始按下按钮(事件玩家, 按钮(技能1));
				等待(0.1, 无视条件);
				停止按下按钮(事件玩家, 按钮(技能1));
				禁用按钮(事件玩家, 按钮(技能1));
				等待(2, 无视条件);
			End;
			禁用按钮(事件玩家, 按钮(技能1));
			等待(随机实数(0.2, 0.5), 当为“假”时中止);
		End;
	}
}

