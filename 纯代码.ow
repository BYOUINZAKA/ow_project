规则("all heros")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		主机玩家 == 事件玩家;
	}

	动作
	{
		设置玩家可选的英雄(事件玩家, 全部英雄);
	}
}

