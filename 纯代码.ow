		(所用英雄(攻击方) != 英雄(温斯顿) || 事件技能 != 按钮(技能1)) == 真;
	}

	动作
	{
		被攻击方.sys_default_status_pool = 映射的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Shift Debuff") ? 数组(当前数组元素[0], 当前数组元素[1], 总计消耗时间, 1, 当前数组元素[4], 当前数组元素[5]) : 当前数组元素);
	}
}

