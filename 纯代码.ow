规则("死神-E")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		死神;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(技能2)) == 真;
		技能冷却时间(事件玩家, 按钮(技能2)) <= 0;
		正在使用终极技能(事件玩家) != 真;
		具有状态(事件玩家, 沉睡) != 真;
		具有状态(事件玩家, 冰冻) != 真;
		具有状态(事件玩家, 击倒) != 真;
		具有状态(事件玩家, 击晕) != 真;
		具有状态(事件玩家, 定身) != 真;
		具有状态(事件玩家, 被入侵) != 真;
	}

	动作
	{
		// 取消主要动作(事件玩家);
		设置技能冷却(事件玩家, 按钮(技能2), 12);
		施加推力(事件玩家, 与此角度的相对方向(水平朝向角度(事件玩家), 较小(-25, 垂直朝向角度(事件玩家))), 20, 至地图, 取消相反运动);
		事件玩家.i_sys_speed += 30;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 30), 总计消耗时间, 0.5, 英雄(死神), 空);
		// 设置状态(事件玩家, 事件玩家, 相移, 0.5);
		// 取消主要动作(事件玩家);

		// 等待直到(正在空中(事件玩家) || !存活(事件玩家), 1.0);
		// If(正在空中(事件玩家) && 存活(事件玩家));
		// 	等待直到(!正在空中(事件玩家) || !存活(事件玩家), 8.0);
		// 	If(!正在空中(事件玩家) && 存活(事件玩家));
		// 		伤害(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 135), 存活(当前数组元素) && (相距距离(所选位置(事件玩家), 所选位置(当前数组元素)) <= 6) && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 敌方屏障阻挡视线)), 事件玩家, 50);
		// 		播放效果(所有玩家(所有队伍), 有害爆炸, 颜色(紫色), 事件玩家, 6);
		// 		播放效果(所有玩家(所有队伍), 爆炸声音, 颜色(紫色), 事件玩家, 9999);
		// 	End;
		// End;
	}
}

