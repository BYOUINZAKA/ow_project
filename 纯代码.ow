		全局.args_brigitte[12] = 地图工坊设置整数(自定义字符串("布丽吉塔"), 自定义字符串("集结号令-队友加速比例"), 15, 0, 100, 12);

		全局.args_sojourn[0] = 地图工坊设置整数(自定义字符串("索杰恩"), 自定义字符串("弹药量"), 45, 1, 100, 0);
		全局.args_sojourn[1] = 地图工坊设置整数(自定义字符串("索杰恩"), 自定义字符串("机体超频-护盾"), 100, 1, 200, 1);
		全局.args_sojourn[2] = 100 + 地图工坊设置整数(自定义字符串("索杰恩"), 自定义字符串("机体超频-增伤百分比"), 40, 0, 100, 2);
		全局.args_sojourn[3] = 地图工坊设置整数(自定义字符串("索杰恩"), 自定义字符串("暴击-触发伤害"), 0, 0, 180, 3) * 0.01;
		全局.args_sojourn[4] = 地图工坊设置整数(自定义字符串("索杰恩"), 自定义字符串("暴击-增幅比例"), 40, 0, 100, 4) * 0.01;

		全局.ch_normal_attack_dist = 数组(数组(英雄(拉玛刹), 按钮(技能1)), 数组(英雄(拉玛刹), 按钮(终极技能)), 数组(英雄(半藏), 按钮(技能1)), 数组(英雄(半藏), 按钮(技能2)), 数组(英雄(源氏), 按钮(终极技能)), 数组(英雄(索杰恩), 按钮(终极技能)));

		全局.ca_zenyata_armor_heros = 数组(英雄(伊拉锐), 英雄(半藏), 数组(英雄(卡西迪), 10), 数组(英雄(卢西奥), 10), 数组(英雄(回声), 20), 英雄(士兵：76), 数组(英雄(天使), 20), 数组(英雄(安娜), 50), 英雄(巴蒂斯特), 英雄(探奇), 数组(英雄(末日铁拳), 5), 英雄(朱诺), 英雄(查莉娅), 数组(英雄(死神), 5), 数组(英雄(法老之鹰), 20), 英雄(源氏), 英雄(狂鼠), 数组(英雄(猎空), 30), 英雄(生命之梭), 英雄(禅雅塔), 英雄(秩序之光), 英雄(索杰恩), 数组(英雄(美), 5), 英雄(艾什), 英雄(莫伊拉), 英雄(西格玛), 英雄(路霸), 英雄(雾子), 数组(英雄(黑影), 20), 数组(英雄(黑百合), 25));

		全局.ca_sys_global_hp = 数组(
			数组(英雄(渣客女王), 0, 45, 全局.args_junkerqueen[5]), 数组(英雄(温斯顿), 0, 0, 150), 数组(英雄(西格玛), -20, 150), 数组(英雄(路霸), 0, 0, 150), 数组(英雄(D.Va), 0, 150, 0), 数组(英雄(骇灾), 0, 150, 0), 数组(英雄(毛加), 0, 150, 0), 数组(英雄(奥丽莎), 0, 150, 25), 数组(英雄(拉玛刹), 0, 150, 0), 数组(英雄(莱因哈特), 0, 150, 0), 数组(英雄(破坏球), 0, 150, 0), 数组(英雄(查莉娅), 0, 150, 0),
			数组(英雄(雾子), 0, 0, 0, 25), 数组(英雄(莫伊拉), 0, 0, 0, 25), 数组(英雄(布丽吉塔), 20), 数组(英雄(末日铁拳), -26.6667)
		);
