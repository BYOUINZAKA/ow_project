变量
{
	全局:
		0: v_sys_point
        1: d_sys_point_radius
        2: a_sys_enemy
        3: a_rebot_distance
    
    玩家:
        0: a_robot_move_vector
        1: u_rebot_target
        2: a_rebot_distance
        100: debug_var
}

规则("初始化")
{
    事件
    {
        持续 - 全局;
    }

    动作
    {
        全局.a_rebot_distance = 数组(数组(英雄(卡西迪), 10, 20), 数组(英雄(渣客女王), 0, 3));
    }
}

规则("初始化")
{
    事件
    {
        持续 - 全局;
    }

    条件
    {
        目标位置(对象索引) != 空;
    }

    动作
    {
        等待(5.0, 无视条件);
        全局.v_sys_point = 目标位置(对象索引);
        全局.d_sys_point_radius = 15;

        生成机器人(英雄(卡西迪), 队伍2, -1, 最近的可行走位置(全局.v_sys_point) + 上, 矢量(0, 0, 0));
        生成机器人(英雄(渣客女王), 队伍2, -1, 最近的可行走位置(全局.v_sys_point) + 上, 矢量(0, 0, 0));
        全局.a_sys_enemy = 数组(最后创建的实体);
    }
}

// begin: 机器人子系统

规则("机器人-移动")
{
    事件
    {
        持续 - 每名玩家;
        队伍2;
        全部;
    }

    条件
    {
        是否是机器人(事件玩家) == 真;
        // 相距距离(事件玩家, 全局.v_sys_point) <= 全局.d_sys_point_radius;
    }

    动作
    {
        事件玩家.a_rebot_distance = 已过滤的数组(全局.a_rebot_distance, 当前数组元素[0] == 所用英雄(事件玩家))[0];
        开始定向阈值(事件玩家, 事件玩家.a_robot_move_vector[0], 事件玩家.a_robot_move_vector[1], 至地图, 替换现有阈值, 方向和幅度);
        开始朝向(事件玩家, 方向(眼睛位置(事件玩家), 眼睛位置(事件玩家.u_rebot_target)), 随机实数(180, 360), 至地图, 方向及角速率);
        创建光束效果(所有玩家(所有队伍), 查莉娅粒子光束, 所选位置(事件玩家) + 上 * 0.5, 所选位置(事件玩家) + 上 * 0.5 + 事件玩家.a_robot_move_vector[0] * 5.0, 颜色(白色), 可见，位置和半径);
    }
}

规则("机器人-索敌")
{
    事件
    {
        持续 - 每名玩家;
        队伍2;
        全部;
    }

    条件
    {
        是否是机器人(事件玩家) == 真;
        存活(事件玩家) == 真;
        // 相距距离(事件玩家, 全局.v_sys_point) <= 全局.d_sys_point_radius;
    }

    动作
    {
        While(真);
            事件玩家.u_rebot_target = 数组随机取值(已过滤的数组(范围内玩家(全局.v_sys_point, 全局.d_sys_point_radius * 2, 队伍1, 表面), 存活(当前数组元素) && !是否是机器人(当前数组元素)));
            等待(随机实数(0.1, 0.5), 当为“假”时中止);
        End;
    }
}

规则("机器人-移动")
{
    事件
    {
        持续 - 每名玩家;
        队伍2;
        全部;
    }

    条件
    {
        是否是机器人(事件玩家) == 真;
        存活(事件玩家) == 真;
        // 相距距离(事件玩家, 全局.v_sys_point) <= 全局.d_sys_point_radius;
    }

    动作
    {
        While(真);
            事件玩家.a_robot_move_vector[4] = 相距距离(事件玩家, 全局.v_sys_point);
            事件玩家.a_robot_move_vector[3] = 矢量(0, 0, 0);
            事件玩家.a_robot_move_vector[7] = 随机实数(0.1, 0.3);

            If(事件玩家.a_robot_move_vector[4] > 全局.d_sys_point_radius * 0.9);
                事件玩家.a_robot_move_vector[3] += 方向(事件玩家, 全局.v_sys_point) * 3 + 矢量(随机实数(-0.5, 0.5), 0, 随机实数(-0.5, 0.5));
            Else;
                If(事件玩家.a_robot_move_vector[4] <= 全局.d_sys_point_radius * 0.1);
                    事件玩家.a_robot_move_vector[3] += 方向(全局.v_sys_point, 事件玩家) * 随机实数(0, 1);
                End;

                事件玩家.a_robot_move_vector[3] += 矢量(随机实数(-0.5, 0.5), 0, 随机实数(-0.5, 0.5));

                If(实体存在(事件玩家.u_rebot_target) && 存活(事件玩家.u_rebot_target));
                    事件玩家.a_robot_move_vector[5] = 相距距离(事件玩家, 事件玩家.u_rebot_target);
                    If(事件玩家.a_robot_move_vector[5] > 事件玩家.a_rebot_distance[2]);
                        事件玩家.a_robot_move_vector[3] += 方向(事件玩家, 事件玩家.u_rebot_target);
                    Else If(事件玩家.a_robot_move_vector[5] <= 事件玩家.a_rebot_distance[1]);
                        事件玩家.a_robot_move_vector[3] += 方向(事件玩家.u_rebot_target, 事件玩家);
                    End;
                End;
            End;

            事件玩家.a_robot_move_vector[3] = 矢量(X方向分量(事件玩家.a_robot_move_vector[3]), 0, Z方向分量(事件玩家.a_robot_move_vector[3]));
            事件玩家.a_robot_move_vector[8] = 所选位置(事件玩家) + 上 * 随机实数(0.3, 0.8);
            
            事件玩家.a_robot_move_vector[6] = 射线命中位置(事件玩家.a_robot_move_vector[8], 事件玩家.a_robot_move_vector[8] + 归一化(事件玩家.a_robot_move_vector[3]) * 1.5, 空, 空, 假);
            事件玩家.a_robot_move_vector[7] = 相距距离(事件玩家.a_robot_move_vector[8], 事件玩家.a_robot_move_vector[6]);
            If(事件玩家.a_robot_move_vector[7] < 1.0);
                // 事件玩家.a_robot_move_vector[3] += 方向(事件玩家.a_robot_move_vector[6], 事件玩家) * 事件玩家.a_robot_move_vector[7] * 5;
                事件玩家.a_robot_move_vector[3] += 归一化(射线命中法线(事件玩家.a_robot_move_vector[8], 事件玩家.a_robot_move_vector[8] + 归一化(事件玩家.a_robot_move_vector[3]) * 1.5, 空, 空, 假)) * 5.0;
            End;

            事件玩家.a_robot_move_vector[9] = 最近的可行走位置(事件玩家.a_robot_move_vector[8] + 归一化(矢量(X方向分量(事件玩家.a_robot_move_vector[3]), 0, Z方向分量(事件玩家.a_robot_move_vector[3]))) * 随机实数(0.5, 1.5));

            // 事件玩家.a_robot_move_vector[0] = 矢量(X方向分量(事件玩家.a_robot_move_vector[3]), 0, Z方向分量(事件玩家.a_robot_move_vector[3]));
            事件玩家.a_robot_move_vector[0] = 方向(所选位置(事件玩家), 事件玩家.a_robot_move_vector[9]);
            事件玩家.a_robot_move_vector[1] = 1.0;

            等待(事件玩家.a_robot_move_vector[7], 当为“假”时中止);
        End;
    }
}

// end: 机器人子系统

规则("AI-卡西迪-主武器")
{
    事件
    {
        持续 - 每名玩家;
        队伍2;
        卡西迪;
    }

    条件
    {

        是否是机器人(事件玩家) == 真;
        存活(事件玩家) == 真;
        // 数量(已过滤的数组(视角中的玩家(事件玩家, 队伍1, 25), 存活(当前数组元素) && 在视线内(眼睛位置(事件玩家), 眼睛位置(当前数组元素), 屏障不会阻挡视线))) > 0;
        在视线内(眼睛位置(事件玩家), 眼睛位置(事件玩家.u_rebot_target), 屏障不会阻挡视线) == 真;
        存活(事件玩家.u_rebot_target) == 真;
        实体存在(事件玩家.u_rebot_target) == 真;
    }

    动作
    {
        开始按下按钮(事件玩家, 按钮(主要攻击模式));
        等待直到(!在视线内(眼睛位置(事件玩家), 眼睛位置(事件玩家.u_rebot_target), 屏障不会阻挡视线) || !实体存在(事件玩家.u_rebot_target) || !存活(事件玩家.u_rebot_target) || !存活(事件玩家), 9999);
        停止按下按钮(事件玩家, 按钮(主要攻击模式));
    }
}

禁用 规则("")
{
    事件
    {
        持续 - 每名玩家;
        双方;
        全部;
    }

    动作
    {
        创建光束效果(事件玩家, 智械切割者光束, 射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 20, 空, 空, 假), 射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 20, 空, 空, 假) + 射线命中法线(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 20, 空, 空, 假), 颜色(白色), 可见，位置和半径);
    }
}

规则("")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		创建效果(所有玩家(队伍1), 光柱, 颜色(白色), 全局.v_sys_point, 全局.d_sys_point_radius, 可见，位置和半径);
	}
}

规则("")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
        全部;
	}

	条件
	{
		相距距离(事件玩家, 全局.v_sys_point) > 全局.d_sys_point_radius;
	}

	动作
	{
        While(真);
            // 取消主要动作(事件玩家);
            // 开始转换阈值(事件玩家, 1, 1, 方向(事件玩家, 全局.v_sys_point));
            // 设置状态(事件玩家, 事件玩家, 击晕, 0.250);
            开始加速(事件玩家, 方向(事件玩家, 全局.v_sys_point), 999, 9999, 至地图, 方向，速率，及最大速度);
            等待直到 (相距距离(事件玩家, 全局.v_sys_point) < 全局.d_sys_point_radius, 99999);
            停止加速(事件玩家);
            // 停止转换阈值(事件玩家);
            等待(0.2, 当为“假”时中止);
        End;
	}
}