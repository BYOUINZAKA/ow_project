禁用 规则("规则 8")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		黑影;
	}

	条件
	{
		相距距离(事件玩家, 距离最近的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)))) <= 15;
		在视线内(事件玩家, 距离最近的玩家(事件玩家, 对方队伍(所在队伍(事件玩家))), 敌方屏障阻挡视线) == 真;
		终极技能充能百分比(事件玩家) == 100;
	}

	动作
	{
		While(真);
			按下按键(事件玩家, 按钮(终极技能));
			等待(0, 当为“假”时中止);
		End;
	}
}

规则("规则 11")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		全部;
	}

	条件
	{
		存活(事件玩家) == 真;
		主机玩家 != 事件玩家;
		是否是机器人(事件玩家) != 真;
		玩家数量(队伍2) <= 1;
	}

	动作
	{
		等待(1, 当为“假”时中止);
        开始按下按钮(事件玩家, 按钮(互动));
        等待(0.1, 无视条件);
        停止按下按钮(事件玩家, 按钮(互动));
	}
}