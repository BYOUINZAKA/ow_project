规则("规则 1")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		存活(事件玩家) == 真;
	}

	动作
	{
		While(真);
			事件玩家.A = 技能冷却时间(事件玩家, 按钮(技能1));
			事件玩家.B = 技能冷却时间(事件玩家, 按钮(技能2));
			事件玩家.C = 标准化生命值(事件玩家);
			等待(0, 当为“假”时中止);
		End;
	}
}

规则("规则 2")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		创建HUD文本(事件玩家, 字符串("{0} - {1} - {2}", 事件玩家.A, 事件玩家.B, 事件玩家.C), 空, 空, 左边, 0, 颜色(白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
	}
}

规则("规则 3")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		禁用 正在使用终极技能(事件玩家) == 真;
		已重生(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		生成机器人(英雄(天使), 所在队伍(事件玩家), -1, 所选位置(事件玩家), 矢量(0, 0, 0));
		事件玩家.Z = 最后创建的实体;
		设置状态(事件玩家.Z, 空, 无敌, 9999);
		设置状态(事件玩家.Z, 空, 相移, 9999);
		绑定玩家(事件玩家.Z, 事件玩家, 矢量(1, 0, -2.500));
		开始朝向(事件玩家.Z, 方向(眼睛位置(事件玩家.Z), 眼睛位置(事件玩家)), 10000, 至地图, 方向及角速率);
		While(存活(事件玩家));
			If(按钮被按下(事件玩家, 按钮(主要攻击模式)) || 标准化生命值(事件玩家) == 1);
				开始按下按钮(事件玩家.Z, 按钮(辅助攻击模式));
			Else;
				开始按下按钮(事件玩家.Z, 按钮(主要攻击模式));
			End;
			等待(0, 无视条件);
		End;
		移除机器人(所在队伍(事件玩家.Z), 栏位(事件玩家.Z));
	}
}

规则("规则 3")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		禁用 正在使用终极技能(事件玩家) == 真;
		已重生(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		生成机器人(英雄(安娜), 所在队伍(事件玩家), -1, 所选位置(事件玩家), 矢量(0, 0, 0));
		事件玩家.Y = 最后创建的实体;
		设置状态(事件玩家.Y, 空, 无敌, 9999);
		设置状态(事件玩家.Y, 空, 相移, 9999);
		绑定玩家(事件玩家.Y, 事件玩家, 矢量(1.5, 0, -2.500));
		开始朝向(事件玩家.Y, 方向(眼睛位置(事件玩家.Y), 眼睛位置(事件玩家)), 10000, 至地图, 方向及角速率);
		While(存活(事件玩家));
			If(标准化生命值(事件玩家) < 1);
				按下按键(事件玩家.Y, 按钮(主要攻击模式));
			End;
			If(!正在使用终极技能(事件玩家.Y) || 标准化生命值(事件玩家) < 1);
				设置终极技能充能(事件玩家.Y, 100);
				按下按键(事件玩家.Y, 按钮(终极技能));
			End;
			等待(0, 无视条件);
		End;
		移除机器人(所在队伍(事件玩家.Y), 栏位(事件玩家.Y));
	}
}

规则("规则 3")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		禁用 正在使用终极技能(事件玩家) == 真;
		已重生(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		生成机器人(英雄(朱诺), 所在队伍(事件玩家), -1, 所选位置(事件玩家), 矢量(0, 0, 0));
		事件玩家.U = 最后创建的实体;
		设置状态(事件玩家.U, 空, 无敌, 9999);
		设置状态(事件玩家.U, 空, 相移, 9999);
		绑定玩家(事件玩家.U, 事件玩家, 矢量(0, 0, -4.00));
		开始朝向(事件玩家.U, 方向(眼睛位置(事件玩家.U), 眼睛位置(事件玩家)), 10000, 至地图, 方向及角速率);
		开始按下按钮(事件玩家.U, 按钮(主要攻击模式));
		While(存活(事件玩家));
			If(技能冷却时间(事件玩家.U, 按钮(技能2)) <= 0);
				按下按键(事件玩家.U, 按钮(技能2));
			End;
			If(!正在使用终极技能(事件玩家.U) || 标准化生命值(事件玩家) < 1);
				设置终极技能充能(事件玩家.U, 100);
				按下按键(事件玩家.U, 按钮(终极技能));
			End;
			等待(0, 无视条件);
		End;
		移除机器人(所在队伍(事件玩家.U), 栏位(事件玩家.U));
	}
}

