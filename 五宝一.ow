规则("规则 3")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		禁用 正在使用终极技能(事件玩家) == 真;
		已重生(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		生成机器人(英雄(卢西奥), 所在队伍(事件玩家), -1, 所选位置(事件玩家), 矢量(0, 0, 0));
		事件玩家.W = 最后创建的实体;
		设置状态(事件玩家.W, 空, 无敌, 9999);
		设置状态(事件玩家.W, 空, 相移, 9999);
		按下按键(事件玩家.W, 按钮(技能1));
		绑定玩家(事件玩家.W, 事件玩家, 矢量(-1.500, 0, -2.500));
		While(存活(事件玩家));
			If(!正在使用终极技能(事件玩家.W));
				按下按键(事件玩家.W, 按钮(技能2));
				设置终极技能充能(事件玩家.W, 100);
				设置技能冷却(事件玩家.W, 按钮(技能2), 0);
				按下按键(事件玩家.W, 按钮(终极技能));
			End;
			等待(0, 无视条件);
		End;
		移除机器人(所在队伍(事件玩家.W), 栏位(事件玩家.W));
	}
}

规则("规则 3")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		禁用 正在使用终极技能(事件玩家) == 真;
		已重生(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		生成机器人(英雄(禅雅塔), 所在队伍(事件玩家), -1, 所选位置(事件玩家), 矢量(0, 0, 0));
		事件玩家.V = 最后创建的实体;
		设置状态(事件玩家.V, 空, 无敌, 9999);
		设置状态(事件玩家.V, 空, 相移, 9999);
		绑定玩家(事件玩家.V, 事件玩家, 矢量(2, 0, -2.500));
		While(存活(事件玩家));
			开始朝向(事件玩家.V, 方向(眼睛位置(事件玩家.V), 眼睛位置(距离准星最近的玩家(事件玩家, 对方队伍(所在队伍(事件玩家))))), 10000, 至地图, 方向及角速率);
			按下按键(事件玩家.V, 按钮(技能2));
			If(!正在使用技能 1(事件玩家.V));
				开始朝向(事件玩家.V, 方向(眼睛位置(事件玩家.V), 眼睛位置(事件玩家)), 10000, 至地图, 方向及角速率);
				按下按键(事件玩家.V, 按钮(技能1));
			End;
			等待(0, 无视条件);
		End;
		移除机器人(所在队伍(事件玩家.V), 栏位(事件玩家.V));
	}
}

禁用 规则("规则 8")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		禅雅塔;
	}

	条件
	{
		相距距离(事件玩家, 距离最近的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)))) <= 10;
		终极技能充能百分比(事件玩家) == 100;
	}

	动作
	{
		按下按键(事件玩家, 按钮(终极技能));
	}
}

