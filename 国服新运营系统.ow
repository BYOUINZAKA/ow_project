		莱因哈特;
	}

	条件
	{
		(事件技能 == 按钮(终极技能) || 事件技能 == 按钮(技能1)) == 真;
		(具有状态(被攻击方, 击倒) || 具有状态(被攻击方, 击晕) || 事件伤害 > 200) == 真;
	}

	动作
	{
		设置技能充能(攻击方, 按钮(技能2), 技能充能(攻击方, 按钮(技能2)) + 1);
		设置技能冷却(事件玩家, 按钮(技能2), 0);

