规则("系统-脱战")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		攻击方 != 空;
	}

	动作
	{
		事件玩家.a_sys_user_status[全局.t_enum_escape] = 7;
		等待(1.0, 无视条件);
	}
}

规则("系统-静态生命")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		处于回合之间 != 真;
		(所用英雄(事件玩家) == 英雄(D.Va) && 处于非初始状态(事件玩家)) != 真;
		数量(已过滤的数组(全局.ca_sys_global_hp, 当前数组元素[0] == 所用英雄(事件玩家))) == 1;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("STATIS_HP"))) <= 0;
	}

	动作
	{
		事件玩家.sys_global_hp_pos = 已过滤的数组(全局.ca_sys_global_hp, 当前数组元素[0] == 所用英雄(事件玩家))[0];
		If(事件玩家.sys_global_hp_pos[1] != 0);
			事件玩家.sys_hp_percent[0] += 事件玩家.sys_global_hp_pos[1];
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_percent, 数组(事件玩家, 事件玩家.sys_global_hp_pos[1]), 总计消耗时间, -1, 所用英雄(事件玩家), 自定义字符串("STATIS_HP"));
		End;
		等待(0.25, 无视条件);
		If(事件玩家.sys_global_hp_pos[2] > 0);
			为玩家添加生命池(事件玩家, 生命值, 单次赋值(事件玩家.sys_global_hp_pos[2]), 真, 真);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(事件玩家), 自定义字符串("STATIS_HP"));
		End;
		If(事件玩家.sys_global_hp_pos[3] > 0);
			为玩家添加生命池(事件玩家, 护甲, 单次赋值(事件玩家.sys_global_hp_pos[3]), 真, 真);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(事件玩家), 自定义字符串("STATIS_HP"));
		End;
		If(事件玩家.sys_global_hp_pos[4] > 0);
			为玩家添加生命池(事件玩家, 护盾, 单次赋值(事件玩家.sys_global_hp_pos[4]), 真, 真);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(事件玩家), 自定义字符串("STATIS_HP"));
		End;
		如条件为“真”则循环;
	}
}

