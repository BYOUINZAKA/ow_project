		设置技能冷却(事件玩家, 按钮(技能2), 0);
		设置技能充能(事件玩家, 按钮(技能2), 5);

		开始伤害调整(事件玩家, 所有玩家(所有队伍), 全局.args_brigitte[10], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 11, 英雄(布丽吉塔),
			自定义字符串("Brigitte Rally"));

		开始伤害调整(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 8.500, 所在队伍(事件玩家), 表面及敌方屏障), 当前数组元素 != 事件玩家), 所有玩家(所有队伍), 全局.args_brigitte[11], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 11, 英雄(布丽吉塔),
			自定义字符串("Brigitte Rally"));

		While(正在使用终极技能(事件玩家) == 真);
			事件玩家.buligita_players = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 8.500, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素));
			事件玩家.buligita_players.sys_softirq[17] += 1;

			事件玩家.buligita_players = 已过滤的数组(事件玩家.buligita_players, 当前数组元素 != 事件玩家);
			事件玩家.buligita_players.i_sys_speed += 全局.args_brigitte[12];
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家.buligita_players, 全局.args_brigitte[12]), 总计消耗时间, 1.00, 英雄(布丽吉塔), 自定义字符串("Brigitte Rally Speed"));
			// 等待直到 (正在使用终极技能(事件玩家) != 真, 1.00);
			等待直到 (!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Rally Speed")) || 正在使用终极技能(事件玩家) != 真, 1.00);
		End;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Rally") ? 数组分割(当前数组元素, 0, 2)
			: 当前数组元素);
		事件玩家.buligita_players = 空;
	}
}

规则("布丽吉塔-叠甲")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[17] > 0;
	}

	动作
	{
		事件玩家.sys_softirq[17] = -999;
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index))[0][1]);
			为玩家添加生命池(事件玩家, 护甲, 7, 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index) ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 空, 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index)) : 当前数组元素);
			事件玩家.brigitte_q_index = (事件玩家.brigitte_q_index + 1) % 5;
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index))) <= 0);
			为玩家添加生命池(事件玩家, 护甲, 7, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 空, 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index));
			事件玩家.brigitte_q_index = (事件玩家.brigitte_q_index + 1) % 5;
		Else;
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
			等待直到(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Brigitte Overheal {0}", 事件玩家.brigitte_q_index))) <= 0, 99999);
		End;
		
		等待(0.10, 无视条件);
		事件玩家.sys_softirq[17] = 0;

		如条件为“真”则循环;
	}
}

