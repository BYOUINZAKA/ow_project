规则("西格玛-Q-炮塔攻击")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		西格玛;
	}

	条件
	{
		事件玩家.sigma_battery_pos != 空;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sigma Q center"))) > 0;
	}

	动作
	{
		While(事件玩家.sigma_battery_pos != 空);
			事件玩家.sigma_battery_target = 已排序的数组(范围内玩家(事件玩家.sigma_battery_pos, 25, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素) && !具有状态(事件玩家, 无敌) && !具有状态(
				事件玩家, 相移) ? 标准化生命值(当前数组元素) - (正在空中(当前数组元素) && !正在跳跃(当前数组元素) ? (标准化生命值(当前数组元素) >= 0.500 ? 1 : -1) : 0) : 9999)[0];
			If(事件玩家.sigma_battery_target != 空 && 存活(事件玩家.sigma_battery_target));
				If(正在空中(事件玩家.sigma_battery_target) && !正在跳跃(事件玩家.sigma_battery_target));
					创建弹道(西格玛超能之球, 事件玩家, 事件玩家.sigma_battery_pos, 方向(事件玩家.sigma_battery_pos, 眼睛位置(事件玩家.sigma_battery_target)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)),
						55, 0.218, 3, 有害爆炸, 爆炸声音, 0, 96, 0.2292, 0, 2, 0);
					等待(0.335, 当为“假”时中止);
				Else;
					创建弹道(西格玛超能之球, 事件玩家, 事件玩家.sigma_battery_pos, 方向(事件玩家.sigma_battery_pos, 眼睛位置(事件玩家.sigma_battery_target)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)),
						55, 0.218, 3, 有害爆炸, 爆炸声音, 0, 48, 0.4583, 0, 2, 0);
					等待(0.670, 当为“假”时中止);
				End;
			Else;
				等待(0.050, 当为“假”时中止);
			End;
		End;
	}
}

规则("安娜-弹药恢复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		安娜;
	}

	条件
	{
		(正在使用主要武器(事件玩家) || 正在装填(事件玩家)) != 真;
		弹药(事件玩家, 0) < 最大弹药(事件玩家, 0);
		弹药(事件玩家, 0) > 0;
	}

	动作
	{
		While(真);
			等待(1.0, 当为“假”时中止);
			设置弹药(事件玩家, 0, 较小(最大弹药(事件玩家, 0), 弹药(事件玩家, 0) + 1));
		End;
	}
}

规则("安娜-治疗链")
{
	事件
	{
		玩家造成治疗;
		双方;
		安娜;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		治疗者.ana_ring[0] = 已排序的数组(已过滤的数组(范围内玩家(所选位置(受治疗者), 10, 所在队伍(受治疗者), 表面及敌方屏障), 存活(当前数组元素) && 标准化生命值(当前数组元素) < 1.0 && 当前数组元素 != 治疗者 && 当前数组元素 != 受治疗者), 生命值(当前数组元素))[0];
		If (实体存在(治疗者.ana_ring[0]));
			治疗者.ana_ring[1] = 归一化(方向(所选位置(受治疗者) + 上 * 随机实数(0.5, 0.8), 所选位置(治疗者.ana_ring[0]) + 上 * 随机实数(0.5, 0.8)));
			创建弹道(“天使”天使冲击枪, 治疗者, 所选位置(受治疗者) + 上 * 随机实数(0.5, 0.8) + 治疗者.ana_ring[1] * 1, 治疗者.ana_ring[1], 至地图, 治疗, 所在队伍(受治疗者), 75, 1, 0, 有益爆炸, 爆炸声音, 0.01, 125, 1, 0, 0, 0);
		End;
		等待(0.6, 无视条件);
	}
}

规则("安娜-伤害链")
{
	事件
	{
		玩家造成伤害;
		双方;
		安娜;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		攻击方.ana_ring[0] = 已排序的数组(已过滤的数组(范围内玩家(所选位置(被攻击方), 10, 所在队伍(被攻击方), 表面), 存活(当前数组元素) && 当前数组元素 != 被攻击方), 生命值(当前数组元素))[0];
		If (实体存在(攻击方.ana_ring[0]));
			攻击方.ana_ring[1] = 归一化(方向(所选位置(被攻击方) + 上 * 随机实数(0.5, 0.8), 所选位置(攻击方.ana_ring[0]) + 上 * 随机实数(0.5, 0.8)));
			创建弹道(“天使”天使冲击枪, 攻击方, 所选位置(被攻击方) + 上 * 随机实数(0.5, 0.8) + 攻击方.ana_ring[1] * 1, 攻击方.ana_ring[1], 至地图, 伤害, 所在队伍(被攻击方), 75, 1, 0, 有益爆炸, 爆炸声音, 0.01, 125, 1, 0, 0, 0);
		End;
		等待(0.6, 无视条件);
	}
}

