	动作
	{
		创建进度条地图文本(
			事件玩家, 较大(0, 全局.args_sojourn[0] - 事件玩家.sojourn_bullet_count) / 全局.args_sojourn[0] * 100, 自定义字符串("{0}", 技能图标字符串(英雄(索杰恩), 按钮(主要攻击模式))),
			逐帧更新(眼睛位置(事件玩家) + 80 * (-1.000 * 与此角度的相对方向(与此方向的水平角度(面朝方向(事件玩家)), 与此方向的垂直角度(面朝方向(事件玩家)) - 90) + 3 * 面朝方向(事件玩家))),
			0.850, 不要截取, 颜色(白色), 颜色(白色), 可见，位置和值, 默认可见度);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_map_line_text, 上一个文本ID, 总计消耗时间, -1, 英雄(索杰恩), 自定义字符串("Sojourn Text"));
	}
}

