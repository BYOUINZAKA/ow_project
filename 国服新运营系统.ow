		While(正在使用辅助武器(事件玩家));
			取消主要动作(事件玩家);
			按下按键(事件玩家, 按钮(辅助攻击模式));
			// 等待(0.016, 当为“假”时中止);
			等待(0.032, 当为“假”时中止);
