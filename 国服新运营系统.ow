			事件玩家.i_sys_speed += 35;
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 35), 事件玩家.sys_softirq[11][0], 3.00, 空, 自定义字符串("Lucio Enhance"));
			开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 115, 受伤害者和伤害者);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 事件玩家.sys_softirq[11][0], 3.00, 空, 自定义字符串("Lucio Enhance"));
			开始助攻(事件玩家.sys_softirq[11][1], 事件玩家, 无);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_assists, 上一个助攻ID, 事件玩家.sys_softirq[11][0], 3.00, 空, 自定义字符串("Lucio Enhance"));
		End;
		事件玩家.sys_softirq[11] = 空;
		// 等待(0.25, 无视条件);
		// 如条件为“真”则循环;
	}
}

规则("卢西奥-光环一体")
{
	事件
	{
		持续 - 每名玩家;
