规则("芙蕾雅-增伤")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		弗蕾娅;
	}

	条件
	{
		事件玩家.freja_attack[2][0] > 0;
	}

	动作
	{
		While(事件玩家.freja_attack[2] > 0);
			创建弹道(“天使”天使冲击枪, 事件玩家, 眼睛位置(事件玩家)+下*0.5, 方向(眼睛位置(事件玩家)+下*0.5, 眼睛位置(事件玩家.freja_attack[2][1])+下*随机实数(0, 0.5)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 30, 2, 0, 有益爆炸, 爆炸声音, 0.008, 125, 1.0, 0, 0, 0);
			事件玩家.freja_attack[2] = 数组(事件玩家.freja_attack[2][0]-1, 事件玩家.freja_attack[2][1]);
			等待(0.2, 无视条件);
		End;
		事件玩家.freja_attack[2] = 空;
	}
}

规则("芙蕾雅-增伤")
{
	事件
	{
		玩家造成伤害;
		双方;
		弗蕾娅;
	}

	条件
	{
		(事件技能 == 按钮(主要攻击模式) || 事件技能 == 按钮(辅助攻击模式)) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
		攻击方.freja_attack[0] > 0;
	}

	动作
	{
		攻击方.freja_attack[0] = 0.0;
		被攻击方.i_sys_speed -= 20;
		被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(被攻击方, -20), 总计消耗时间, 3, 空, 自定义字符串("FrejaSpeed Debuff"));

		开始伤害调整(攻击方, 被攻击方, 80, 无);
		被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3, 空, 自定义字符串("FrejaSpeed Debuff"));

		播放效果(所有玩家(所有队伍), 有益爆炸, 颜色(天蓝色), 被攻击方, 1.25);

		// 等待(0.2, 无视条件);
	}
}

规则("芙蕾雅-减疗")
{
	事件
	{
		玩家造成伤害;
		双方;
		弗蕾娅;
	}

	条件
	{
		事件技能 == 按钮(终极技能);
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
	}

	动作
	{
		If(数量(已过滤的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("FrejaReduce Debuff"))) == 1);
			被攻击方.freja_attack[1] = 被攻击方.freja_attack[1] + 1;
			被攻击方.sys_default_status_pool = 映射的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("FrejaReduce Debuff") ? 数组(当前数组元素[0], 当前数组元素[1], 总计消耗时间, 3.5, 当前数组元素[4], 当前数组元素[5]) : 当前数组元素);
		Else If(数量(已过滤的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("FrejaReduce Debuff"))) == 0);
			被攻击方.freja_attack[1] = 1;
			开始治疗调整(被攻击方, 所有玩家(所有队伍), 较大(25, 100-被攻击方.freja_attack[1]*5), 受治疗者，治疗者及治疗百分比);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, 3.5, 空, 自定义字符串("FrejaReduce Debuff"));
		End;
	}
}

规则("芙蕾雅-减疗")
{
	事件
	{
