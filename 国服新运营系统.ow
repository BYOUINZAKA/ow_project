规则("探奇-连发")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		探奇;
	}

	条件
	{
		正在使用主要武器(事件玩家) == 真;
		事件玩家.venture_skill_record[0] > 0;
	}

	动作
	{
		// 等待(0.08, 无视条件);
		事件玩家.venture_skill_record[0] = 0;
		创建弹道(“秩序之光”光子发射器, 事件玩家, 眼睛位置(事件玩家) + 下 * 0.15 + 右 * 0.10, 空, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 75, 0.627, 2, 有益爆炸, 爆炸声音, 0.015, 50, 正在使用技能 2(事件玩家) ? 0.64 : 0.32, 1.5, 0, 0);
	}
}

规则("探奇-生命钻头")
{
	事件
	{
		玩家造成伤害;
		双方;
		探奇;
	}

	条件
	{
		(事件技能 == 按钮(技能1) || 事件技能 == 按钮(近身攻击) || 事件技能 == 按钮(辅助攻击模式)) == 真;
		类型的生命值(攻击方, 护盾) > 0;
	}

	动作
	{
		伤害(被攻击方, 攻击方, 类型的生命值(攻击方, 护盾)  / 3.0);
	}
}

规则("探奇-生命钻头")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		探奇;
	}

	条件
	{
		类型的生命值(事件玩家, 护盾) > 0;
	}

	动作
	{
		While(类型的生命值(事件玩家, 护盾) > 0);
			开始持续治疗(事件玩家, 事件玩家, 1.0, 类型的生命值(事件玩家, 护盾) * 0.25);
			事件玩家.venture_skill_record[1] = 上一个持续治疗效果ID;
			等待(0.2, 无视条件);
			停止持续治疗(事件玩家.venture_skill_record[1]);
		End;
	}
}

