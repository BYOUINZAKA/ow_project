规则("布丽吉塔-s-护甲链枷")
{
	事件
	{
		玩家造成伤害;
		双方;
		布丽吉塔;
	}

	条件
	{
		事件技能 == 按钮(技能1);
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
		((所用英雄(被攻击方) != 英雄(奥丽莎)) || (所用英雄(被攻击方) == 英雄(奥丽莎) && !正在使用终极技能(被攻击方) && !正在使用技能 1(被攻击方))) == 真;
		全局.args_brigitte[1] + 全局.args_brigitte[2] > 0;
	}

	动作
	{
		等待(全局.args_brigitte[3], 无视条件);
		范围内玩家(眼睛位置(攻击方), 全局.args_brigitte[2], 所在队伍(攻击方), 表面及敌方屏障).sys_softirq[17] += 15;
	}
}

禁用 规则("死神-被动-暗影")
{
	事件
	{
		玩家受到伤害;
		双方;
		死神;
	}

	条件
	{
		具有状态(事件玩家, 相移) != 真;
