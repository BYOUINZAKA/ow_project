规则("终极AI-卢西奥")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卢西奥;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		终极技能充能百分比(事件玩家) >= 100;
		正在使用终极技能(事件玩家) != 真;
		存活(事件玩家) == 真;
	}

	动作
	{
		While(真);
			If(
				事件玩家.sys_ultra_lock[0] != 真 &&
				数量(
					已过滤的数组(
						范围内玩家(眼睛位置(事件玩家), 30, 所在队伍(事件玩家), 表面),
						存活(当前数组元素) &&
						((生命值(当前数组元素) / 当前数组元素.sys_static_max_hp) < (随机实数(0.30, 0.50) + (具有状态(当前数组元素, 定身)?0.1:0.0) + (具有状态(当前数组元素, 被入侵)?0.1:0.0) + (具有状态(当前数组元素, 击倒)?0.1:0.0) + ((具有状态(当前数组元素, 燃烧)?0.03:0.0))))
					)
				) > 0
				// && 数量(已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 正在使用终极技能(当前数组元素) && 数组包含(数组(英雄(布丽吉塔), 英雄(禅雅塔), 英雄(卢西奥)), 所用英雄(当前数组元素)))) <= 0
			);
				开始按下按钮(事件玩家, 按钮(终极技能));
				等待(0.1, 无视条件);
				停止按下按钮(事件玩家, 按钮(终极技能));
			End;
			等待(随机实数(0.1, 0.5), 当为“假”时中止);
		End;
	}
}

