规则("朱诺-增伤")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.juno_count[0] > 0;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Juno Inc"))) <= 0;
	}

	动作
	{
		开始伤害调整(所有玩家(所有队伍), 事件玩家, 100 + 事件玩家.juno_count[0], 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 所用英雄(事件玩家), 自定义字符串("Juno Inc"));
		创建效果(事件玩家.juno_count[0] >= 5 ? 所有玩家(所有队伍) : 空, “天使”伤害强化效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 所用英雄(事件玩家), 自定义字符串("Juno Inc"));
	}
}

规则("朱诺-增伤清理")
