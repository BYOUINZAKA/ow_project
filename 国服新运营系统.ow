{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.mauga_flag[2] <= 0;
		事件玩家.mauga_flag[0] > 0;
	}

	动作
	{
		事件玩家.mauga_flag[0] = 0;
		事件玩家.mauga_flag[1] = 空;
		事件玩家.mauga_flag[2] = 0;
	}
}

规则("莫伊拉-治疗")
{
	事件
	{
		玩家受到治疗;
		双方;
		全部;
	}

	条件
	{
		所用英雄(治疗者) == 英雄(莫伊拉);
		事件技能 != 空;
	}

	动作
	{
		If(受治疗者.moira_heal == 空 || 数量(受治疗者.moira_heal) == 0);
			受治疗者.moira_heal = 数组(1, 1);
		Else If(受治疗者.moira_heal[0] >= 30);
			受治疗者.moira_heal[1] = 1;
		Else;
			受治疗者.moira_heal = 数组(受治疗者.moira_heal[0]+1, 1);
		End;
		等待(0.1, 无视条件);
	}
}

规则("莫伊拉-治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		莫伊拉;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		事件玩家.moira_heal = 数组(30, 1);
	}
}

规则("莫伊拉-治疗消失")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.moira_heal[0] > 0;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Moira Def"))) <= 0;
	}

	动作
	{
		开始伤害调整(
			事件玩家, 所有玩家(对方队伍(所在队伍(事件玩家))),
			较小(100, 100 - 事件玩家.moira_heal[0] * (数组包含(全局.sys_tank, 所用英雄(事件玩家)) ? 0.8 : 1.2)),
			受伤害者，伤害者及伤害百分比
		);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 空, 自定义字符串("Moira Def"));

		创建效果(事件玩家.moira_heal[0] >= 15 ? 所有玩家(所有队伍) : 空, 治疗目标激活效果, 所在队伍(事件玩家), 事件玩家, 1, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 空, 自定义字符串("Moira Def"));

		While(事件玩家.moira_heal != 空 && 事件玩家.moira_heal[0] > 0);
			等待直到(事件玩家.moira_heal == 空 || 事件玩家.moira_heal[1] == 1, 9999);
			If(事件玩家.moira_heal[1] == 1);
				事件玩家.moira_heal[1] = 0;
				等待直到(事件玩家.moira_heal[1] == 1, 1.0);
				If(事件玩家.moira_heal[1] <= 0);
					为玩家添加生命池(事件玩家, 生命值, 事件玩家.moira_heal[0] + 5, 假, 假);
					事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 空, 空);
					事件玩家.moira_heal = 数组(较大(0, 事件玩家.moira_heal[0]-5), 1);
				End;
			End;
		End;

		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, (当前数组元素[5] == 自定义字符串("Moira Def")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		事件玩家.moira_heal = 空;
	}
}

规则("法老之鹰-瞬间弹幕")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		法老之鹰;
	}

	条件
	{
		正在使用终极技能(事件玩家) != 真;
		按钮被按下(事件玩家, 按钮(终极技能)) == 真;
	}

	动作
	{
		根据条件中止(正在使用终极技能(事件玩家) || 终极技能充能百分比(事件玩家) == 0);
		事件玩家.pharah_timer[1] = 终极技能充能百分比(事件玩家);
		设置终极技能充能(事件玩家, 100);
		按下按键(事件玩家, 按钮(终极技能));
		等待直到 (!正在使用终极技能(事件玩家), 0.025 * 事件玩家.pharah_timer[1]);
		设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0));
		取消主要动作(事件玩家);
	}
}

规则("法老之鹰-计时")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		法老之鹰;
	}

	条件
	{
		事件玩家.pharah_timer[0] <= 0;
	}

	动作
	{
		事件玩家.pharah_timer[0] = 2;
		开始持续治疗(事件玩家, 事件玩家, 1.0, 50);
	}
}

规则("法老之鹰-切换")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		法老之鹰;
	}

	条件
	{
		存活(事件玩家) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Pharah Effect"))) <= 0;
	}

	动作
	{
		创建效果((事件玩家.pharah_timer[0] > 1 && 存活(事件玩家)) ? 所有玩家(所有队伍) : 空, 治疗目标激活效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(法老之鹰), 自定义字符串("Pharah Effect"));
		创建效果((事件玩家.pharah_timer[0] <= 1 && 存活(事件玩家)) ? 所有玩家(所有队伍) : 空, “天使”伤害强化效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(法老之鹰), 自定义字符串("Pharah Effect"));

		开始伤害调整(所有玩家(所有队伍), 事件玩家.pharah_timer[0] <= 1 ? 事件玩家 : 空, 130, 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(法老之鹰), 自定义字符串("Pharah Effect"));
	}
}

