				事件玩家.sys_ultra_lock[1] = 100;
			Else If(占领要点模式得分百分比(对方队伍(所在队伍(事件玩家))) - 占领要点模式得分百分比(所在队伍(事件玩家)) >= 50);
				事件玩家.sys_ultra_lock[1] += (占领要点模式得分百分比(对方队伍(所在队伍(事件玩家))) - 占领要点模式得分百分比(所在队伍(事件玩家))) * 0.25;
			End;
			If(相距距离(重生点(所在队伍(事件玩家)), 事件玩家) < 相距距离(重生点(所在队伍(事件玩家)), 目标位置(对象索引)) * 0.5 && !在目标点上(事件玩家));
