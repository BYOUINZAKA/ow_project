规则("雾子-铃-加速")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[19] > 0;
	}

	动作
	{
		// 事件玩家.sys_softirq[19] = -999;
		事件玩家.sys_softirq[19] = 0;

		事件玩家.i_sys_speed += 35;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 35), 总计消耗时间, 4.0);

		创建弹道(“天使”天使冲击枪, 已过滤的数组(所有玩家(所在队伍(事件玩家)), 所用英雄(当前数组元素) == 英雄(雾子))[0], 所选位置(事件玩家), 上, 至地图, 治疗, 所在队伍(事件玩家), 最大生命值(事件玩家) * 0.20, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.2, 0, 0, 0);

		// 等待(1.0, 无视条件);

		// 事件玩家.sys_softirq[19] = 0;
		// 如条件为“真”则循环;
	}
}

