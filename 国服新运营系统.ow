		受治疗者.sys_default_status_pool[数量(受治疗者.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 1.00, 空);
	}
}

规则("安娜-E-禁疗状态")
{
	事件
	{
		玩家造成伤害;
		双方;
		安娜;
	}

	条件
	{
		事件技能 == 按钮(技能2);
		全局.args_ana[6] > 0;
	}

	动作
	{
		开始伤害调整(被攻击方, 所有玩家(所在队伍(攻击方)), 100 + 全局.args_ana[6], 受伤害者，伤害者及伤害百分比);
		被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 全局.args_ana[7], 空, 自定义字符串("Ana Biotic Grenade Debuff"));
	}
}

规则("安娜-终极技能-群体激素")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		安娜;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		取消主要动作(事件玩家);
		所有玩家(所在队伍(事件玩家)).sys_softirq[2] = 事件玩家;

		治疗(所有玩家(所在队伍(事件玩家)), 事件玩家, 50);
		开始助攻(事件玩家, 所有玩家(所在队伍(事件玩家)), 助攻者和目标);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_assists, 上一个助攻ID, 总计消耗时间, 8, 英雄(安娜), 空);

		所有玩家(所在队伍(事件玩家)).i_sys_speed += 全局.args_ana[2];
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(所有玩家(所在队伍(事件玩家)), 全局.args_ana[2]), 总计消耗时间, 8, 英雄(安娜), 空);

		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 所有玩家(所在队伍(事件玩家)), 100 + 全局.args_ana[0], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 8, 英雄(安娜), 空);

		开始伤害调整(所有玩家(所在队伍(事件玩家)), 所有玩家(对方队伍(所在队伍(事件玩家))), 100 - 全局.args_ana[1], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 8, 英雄(安娜), 空);

		开始治疗调整(所有玩家(所有队伍), 所有玩家(所在队伍(事件玩家)), 100 + 全局.args_ana[3], 受治疗者，治疗者及治疗百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, 8, 英雄(安娜), 空);
	}
}

规则("安娜-终极技能-群体激素")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[2] != 空;
	}

	动作
	{
		创建效果(所有玩家(所有队伍), 安娜纳米激素强化效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_softirq[2].sys_default_status_pool[数量(事件玩家.sys_softirq[2].sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 8, 英雄(安娜), 空);

		事件玩家.sys_softirq[2] = 空;

		设置技能冷却(事件玩家, 按钮(主要攻击模式), 0);
		设置技能冷却(事件玩家, 按钮(辅助攻击模式), 0);
		设置技能冷却(事件玩家, 按钮(技能1), 0);
		设置技能冷却(事件玩家, 按钮(技能2), 0);
		设置技能冷却(事件玩家, 按钮(跳跃), 0);
		设置技能冷却(事件玩家, 按钮(装填), 0);
		设置技能冷却(事件玩家, 按钮(蹲下), 0);
		设置技能冷却(事件玩家, 按钮(近身攻击), 0);
	}
}

禁用 规则("卡西迪")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卡西迪;
	}

	条件
	{
		正在装填(事件玩家) == 真;
		(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家)) != 真;
	}

	动作
	{
		等待(0.65, 当为“假”时中止);
		// 等待直到(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家) || !正在装填(事件玩家), 0.3);
		If(!正在使用技能 1(事件玩家) && !正在使用终极技能(事件玩家) && 正在装填(事件玩家));
			设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0));
			取消主要动作(事件玩家);
		End;
	}
}

规则("卡西迪-伤害")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

