		双方;
		禅雅塔;
	}

	条件
	{
		正在使用技能 1(事件玩家) != 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zenyata Shift"))) > 0;
	}

	动作
	{
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zenyata Shift") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("索杰恩-秒杀")
{
	事件
	{
		玩家造成伤害;
		双方;
		索杰恩;
	}

	条件
	{
		(事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(终极技能)) == 真;
		事件暴击 == 真;
		// 标准化生命值(被攻击方) <= 全局.args_sojourn[3];
		事件伤害 > 全局.args_sojourn[3];
	}

	动作
	{
		伤害(被攻击方, 攻击方, 较小(事件伤害, 180) * 全局.args_sojourn[4]);
		播放效果(所有玩家(所有队伍), 有害爆炸, 所在队伍(攻击方), 被攻击方, 较小(事件伤害 / 180 * 3.0, 3.0));
	}
}

