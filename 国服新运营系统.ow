规则("末日铁拳-AI-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		是否是机器人(事件玩家) != 真;
		终极技能充能百分比(事件玩家) >= 100;
		// 正在使用终极技能(事件玩家) != 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(终极技能));
		While(终极技能充能百分比(事件玩家) >= 100 && !正在使用终极技能(事件玩家));
			If(标准化生命值(事件玩家) < 随机实数(0.3, 0.6));
				可用按钮(事件玩家, 按钮(终极技能));
				开始按下按钮(事件玩家, 按钮(终极技能));
				等待(0.1, 无视条件);
				停止按下按钮(事件玩家, 按钮(终极技能));

				// 等待直到(!正在使用终极技能(事件玩家) || (标准化生命值(事件玩家) > 0.8), 随机实数(1, 4));
				// If(正在使用终极技能(事件玩家));
				// 	开始按下按钮(事件玩家, 按钮(主要攻击模式));
				// 	等待(0.1, 无视条件);
				// 	停止按下按钮(事件玩家, 按钮(主要攻击模式));
				// End;
			End;
			禁用按钮(事件玩家, 按钮(终极技能));
			等待(随机实数(0.1, 0.5), 当为“假”时中止);
		End;
	}
}

规则("末日铁拳-体积")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	动作
	{
		开始调整玩家大小(事件玩家, (全局.args_system[4] && 所用英雄(事件玩家) == 英雄(末日铁拳)) ? 0.9 : 1.0, 真);
	}
}

规则("末日铁拳-减速")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		(事件技能 == 按钮(技能1) || 事件技能 == 按钮(终极技能)) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
	}

	动作
	{
		被攻击方.i_sys_speed -= 30;
		被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(被攻击方, -30), 总计消耗时间, 1.5, 空, 自定义字符串("Doomfist Debuff"));
		施加推力(被攻击方, 上, 5, 至地图, 取消相反运动);
	}
}

规则("末日铁拳-增伤")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		// 具有状态(被攻击方, 击晕) == 真;
		// 被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
		(正在空中(被攻击方) || 具有状态(被攻击方, 击晕)) == 真;
		(事件技能 == 按钮(主要攻击模式) || 事件技能 == 按钮(近身攻击)) == 真;
	}

	动作
	{
		If(全局.args_system[4]);
			伤害(被攻击方, 攻击方, 5.0);
		Else;
			伤害(被攻击方, 攻击方, 事件技能 == 按钮(近身攻击) ? 15 : 5.0);
			治疗(攻击方, 攻击方, 事件技能 == 按钮(近身攻击) ? 40 : 5.0);
		End;
	}
}

规则("末日铁拳-副武器-火箭拳")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		事件技能 == 按钮(辅助攻击模式);
		(攻击方.doomfistr_only <= 0 || 被攻击方.doomfist_count > 0) == 真;
	}

	动作
	{
		If(被攻击方.doomfist_count <= 0);
			If(全局.args_system[4]);
				伤害(被攻击方, 攻击方, 45);
			Else;
				伤害(被攻击方, 攻击方, 较小(75-事件伤害, 50));
			End;
			攻击方.doomfistr_only = 1.0;
			If(被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0);
				被攻击方.doomfist_count = 1.0;
			End;
		Else;
			被攻击方.doomfist_count = 0;
			攻击方.doomfistr_only = 0;
			If(被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0);
				If(全局.args_system[4]);
					伤害(被攻击方, 攻击方, 较大(60, 较小(事件伤害 * 2.25, 90)));
				Else;
					伤害(被攻击方, 攻击方, 较小(40-事件伤害, 30));
					设置弹药(攻击方, 0, 6);
					等待直到(!具有状态(被攻击方, 击晕), 0.2);
					设置状态(被攻击方, 攻击方, 击晕, 1.0);
				End;
			End;
		End;
	}
}

规则("末日铁拳-被动-无损蓄力-副武器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
	}

	动作
	{
		事件玩家.i_sys_speed += 100;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 100), 总计消耗时间, 8, 英雄(末日铁拳), 自定义字符串(
			"Doomfist Rocket Punch"));

		If(全局.args_system[4]);
			事件玩家.doomfist_timer[0] = 总计消耗时间;
			为玩家添加生命池(事件玩家, 护盾, 较大(0, 125 - 50 * (总计消耗时间 - 事件玩家.doomfist_timer[0])), 真, 真);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 2, 英雄(末日铁拳), 自定义字符串("Doomfist Rocket Punch"));
		Else;
			为玩家添加生命池(事件玩家, 生命值, 300, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5, 英雄(末日铁拳), 自定义字符串("Doomfist Rocket Punch"));
		End;

		// 等待直到(!正在使用辅助武器(事件玩家) || !按钮被按下(事件玩家, 按钮(辅助攻击模式)), 5);
		// If(正在使用辅助武器(事件玩家) && !按钮被按下(事件玩家, 按钮(辅助攻击模式)));
		// 	施加推力(事件玩家, 与此角度的相对方向(水平朝向角度(事件玩家), 0), 99999, 至地图, 合并相反运动);
		// End;

		等待直到(正在使用辅助武器(事件玩家) != 真, 5);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Doomfist Rocket Punch") ? 数组分割(当前数组元素, 0,
			2) : 当前数组元素);
	}
}

