		事件玩家.symmetra_Q_inedx = 0;
	}
}

规则("秩序之光-护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		// 玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) != 空数组;
		// 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量) != 空数组;
		(玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) + 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量)) >= 事件玩家.symmetra_demage + 50;
	}

	动作
	{
		// If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))) == 1);
		// 	移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))[0][1]);
		// 	为玩家添加生命池(范围内玩家(眼睛位置(事件玩家), 5, 所在队伍(事件玩家), 表面及敌方屏障), 护盾, ((玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) + 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量)) - 事件玩家.symmetra_demage) * 0.1, 假, 假);
		// 	事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect) ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 空, 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect)) : 当前数组元素);
		// Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))) == 0);
		// 	为玩家添加生命池(范围内玩家(眼睛位置(事件玩家), 5, 所在队伍(事件玩家), 表面及敌方屏障), 护盾, ((玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) + 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量)) - 事件玩家.symmetra_demage) * 0.1, 假, 假);
		// 	事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 空, 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect));
		// End;

		已过滤的数组(范围内玩家(眼睛位置(事件玩家), 5, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素)).sys_softirq[1] = ((玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) + 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量)) - 事件玩家.symmetra_demage) * 0.1;
		事件玩家.symmetra_demage = (玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) + 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量));
		// 事件玩家.symmetra_Q_effect = (事件玩家.symmetra_Q_effect + 1) % 10;

		等待(0.20, 无视条件);
		如条件为“真”则循环;
	}
}

规则("秩序之光-叠盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[1] > 0;
	}

	动作
	{
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))[0][1]);
			为玩家添加生命池(事件玩家, 生命值, 事件玩家.sys_softirq[1], 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect) ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 空, 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect)) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 事件玩家.sys_softirq[1], 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 空, 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect));
		End;
		事件玩家.symmetra_Q_effect = (事件玩家.symmetra_Q_effect + 1) % 5;
		事件玩家.sys_softirq[1] = 0;
		等待(0.10, 无视条件);
		如条件为“真”则循环;
	}
}

规则("渣客女王-被动-标记")
{
	事件
	{
		玩家造成伤害;
		双方;
		渣客女王;
	}

	条件
	{
		(事件技能 == 按钮(技能2) || 事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(近身攻击) || 事件技能 == 按钮(终极技能)) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
	}

	动作
	{
		被攻击方.junkerqueen_timer = 0.400;
		If(被攻击方.junkerqueen_effect != 空 && 攻击方 != 被攻击方.junkerqueen_effect[0]);
			停止伤害调整(事件玩家.junkerqueen_effect[1]);
			停止治疗调整(事件玩家.junkerqueen_effect[2]);
			// 消除效果(事件玩家.junkerqueen_effect[3]);
			事件玩家.junkerqueen_effect = 空;
		End;
		If(被攻击方.junkerqueen_effect == 空);
			被攻击方.junkerqueen_effect = 数组(攻击方);
			开始伤害调整(所有玩家(所在队伍(攻击方)), 被攻击方, 100 - 全局.args_junkerqueen[0], 受伤害者和伤害者);
			被攻击方.junkerqueen_effect = 添加至数组(被攻击方.junkerqueen_effect, 上一个伤害调整ID);
			开始治疗调整(被攻击方, 所有玩家(所有队伍), 100 - 全局.args_junkerqueen[1], 受治疗者和治疗者);
			被攻击方.junkerqueen_effect = 添加至数组(被攻击方.junkerqueen_effect, 上一个治疗调整ID);
			// 创建效果(所有玩家(所有队伍), 温斯顿特斯拉炮目标效果, 所在队伍(攻击方), 被攻击方, 1, 可见，位置和半径);
			// 被攻击方.junkerqueen_effect = 添加至数组(被攻击方.junkerqueen_effect, 最后创建的实体);
		End;
	}
}

规则("渣客女王-被动-标记-清理")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		((事件玩家.junkerqueen_timer <= 0) || (事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0) || 具有状态(事件玩家, 相移) || 具有状态(事件玩家, 无敌)) == 真;
		事件玩家.junkerqueen_effect != 空;
	}

	动作
	{
		停止伤害调整(事件玩家.junkerqueen_effect[1]);
		停止治疗调整(事件玩家.junkerqueen_effect[2]);
		// 消除效果(事件玩家.junkerqueen_effect[3]);
		事件玩家.junkerqueen_effect = 空;
	}
}

规则("渣客女王-Q")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		所用英雄(攻击方) == 英雄(渣客女王);
		事件技能 == 按钮(终极技能);
		事件伤害 > 5;
	}

	动作
	{
		施加推力(被攻击方, 上, 10, 至地图, 取消相反运动);
		等待(5.0, 无视条件);
	}
}

规则("渣客女王-shift")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		渣客女王;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		事件玩家.junkerqueen_players = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 15, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素));

		事件玩家.junkerqueen_players.a_sys_user_status[全局.t_enum_status_thorns] += 全局.args_junkerqueen[2];
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_thorns, 数组(事件玩家.junkerqueen_players, 全局.args_junkerqueen[2]), 总计消耗时间, 4.0, 英雄(渣客女王));

		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家.junkerqueen_players, 全局.args_junkerqueen[6], 无);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 4.0, 英雄(渣客女王));

		// 事件玩家.junkerqueen_players = 数组(范围内玩家(眼睛位置(事件玩家), 15, 所在队伍(事件玩家), 表面及敌方屏障), 总计消耗时间);
		// 事件玩家.junkerqueen_players[0].junkerqueen_flag = 真;

		// 为玩家添加生命池(事件玩家.junkerqueen_players[0], 生命值, 30, 假, 假);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5, 英雄(渣客女王), 自定义字符串("Junker Queen Back"));
	}
}

规则("渣客女王-E-荆棘")
