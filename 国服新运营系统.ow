{
	事件
	{
		玩家造成伤害;
		双方;
		黑百合;
	}

	条件
	{
		正在使用终极技能(攻击方) == 真;
		正在使用辅助武器(攻击方) == 真;
		事件技能 == 按钮(主要攻击模式);
