		Else;
			可用按钮(事件玩家, 按钮(终极技能));
			事件玩家.sys_ultra_lock[0] = 假;
			事件玩家.sys_softirq[7] = -9999;
			等待(60.0, 无视条件);
		End;
		事件玩家.sys_softirq[7] = 0;
