{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		存活(事件玩家) != 真;
		事件玩家.mauga_flag != 空;
	}

	动作
	{
		事件玩家.mauga_flag = 空;
	}
}

规则("毛加-灼烧标记")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.mauga_flag != 空;
		事件玩家.mauga_flag[3] != 空;
		事件玩家.mauga_flag[4] != 空;
		(!具有状态(事件玩家, 燃烧) || 事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0 || !存活(事件玩家)) == 真;
	}

	动作
	{
        If(事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0 || !存活(事件玩家));
            事件玩家.mauga_flag[2] = 0;
        End;
        清除状态(事件玩家, 燃烧);
		停止持续伤害(事件玩家.mauga_flag[3]);
		事件玩家.mauga_flag[3] = 空;
		事件玩家.mauga_flag[4] = 空;
	}
}

规则("毛加-灼烧标记")
{
    事件
    {
        玩家受到治疗;
        双方;
        全部;
    }

    条件
	{
        事件为急救包 == 真;
		事件玩家.mauga_flag != 空;
		事件玩家.mauga_flag[3] != 空;
		事件玩家.mauga_flag[4] != 空;
        具有状态(事件玩家, 燃烧) == 真;
	}

	动作
	{
        事件玩家.mauga_flag[2] = 0;
        清除状态(事件玩家, 燃烧);
		停止持续伤害(事件玩家.mauga_flag[3]);
		事件玩家.mauga_flag[3] = 空;
		事件玩家.mauga_flag[4] = 空;
	}
}

