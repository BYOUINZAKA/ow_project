		数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 30), 存活(当前数组元素) && 在目标点上(当前数组元素) && 在视线内(事件玩家, 当前数组元素, 屏障不会阻挡视线) && 相距距离(事件玩家, 当前数组元素) < 20)) > 0;
	}

	动作
	{
		开始按下按钮(事件玩家, 按钮(技能1));
		等待(0.1, 无视条件);
		停止按下按钮(事件玩家, 按钮(技能1));
	}
}

