规则("源氏-AI-自动Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		源氏;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
		存活(事件玩家) == 真;
		事件玩家.sys_is_ai == 真;
	}

	动作
	{
		While(正在使用终极技能(事件玩家) && 存活(事件玩家) && 所用英雄(事件玩家) == 英雄(源氏));
			开始按下按钮(事件玩家, 按钮(主要攻击模式));
			等待(0.2, 无视条件);
		End;
		停止按下按钮(事件玩家, 按钮(主要攻击模式));
	}
}

规则("源氏-自动跳跃")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		源氏;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		存活(事件玩家) == 真;
	}

	动作
	{
		While(真);
			等待((在目标点上(事件玩家) || 正在等待玩家) ? 随机实数(0.5, 3.5) : 随机实数(1.0, 5.0), 当为“假”时中止);
			If(正在等待玩家 || (数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 90), 存活(当前数组元素) && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 屏障不会阻挡视线))) > 0));
				按下按键(事件玩家, 按钮(跳跃));
			End;
		End;
	}
}

