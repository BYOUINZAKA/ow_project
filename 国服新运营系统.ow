	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_button_list[数组值的索引(全局.a_sys_all_buttons, 按钮(跳跃))] > 0;
	}

	动作
	{
		While(真);
			可用按钮(事件玩家, 按钮(跳跃));
			If(事件玩家.sys_button_list[数组值的索引(全局.a_sys_all_buttons, 按钮(跳跃))] <= 0);
				中止;
			End;
			禁用按钮(事件玩家, 按钮(跳跃));
			等待直到(事件玩家.sys_button_list[数组值的索引(全局.a_sys_all_buttons, 按钮(跳跃))] <= 0, 99999);
		End;
	}
}

