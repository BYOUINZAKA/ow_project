		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		开始伤害调整(被攻击方, 所有玩家(所有队伍), 125, 受伤害者和伤害者);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3, 英雄(卡西迪), 自定义字符串("Debuff"));
		等待(3.0, 无视条件);
	}
}

规则("卡西迪-伤害")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

	条件
	{
		(事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(终极技能) || 事件技能 == 按钮(近身攻击)) == 真;
	}

	动作
	{
		为玩家添加生命池(攻击方, 生命值, 事件伤害 * 0.10, 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		等待(0.1, 无视条件);
	}
}

规则("卡西迪-伤害衰减弥补")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		攻击方.cassidy_distance = 相距距离(眼睛位置(攻击方), 被攻击方);
		If(攻击方.cassidy_distance >= 35);
			攻击方.cassidy_distance = 事件伤害 * (49 / 21);
			伤害(被攻击方, 攻击方, 攻击方.cassidy_distance);
		Else If(攻击方.cassidy_distance > 25);
			// 攻击方.cassidy_distance = 事件伤害 * (100/(240-7*攻击方.cassidy_distance)-1);
			攻击方.cassidy_distance = 事件伤害 * ((4.9*攻击方.cassidy_distance-122.5) / (192.5-4.9*攻击方.cassidy_distance));
			伤害(被攻击方, 攻击方, 攻击方.cassidy_distance);
		Else;
			攻击方.cassidy_distance = 0.0;
		End;

		If(事件暴击);
			设置技能冷却(攻击方, 按钮(技能1), 技能冷却时间(攻击方, 按钮(技能1)) - 3);
		End;

		为玩家添加生命池(攻击方, 生命值, (事件伤害 + 攻击方.cassidy_distance) * 0.15, 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 事件暴击 ? 6 : 3, 英雄(卡西迪));
		等待(0.45, 无视条件);
	}
}

规则("卡西迪-屏障伤害")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卡西迪;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) != 空数组;
		存活(事件玩家) == 真;
		玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) > 事件玩家.cassidy_demage;
	}

	动作
	{
		为玩家添加生命池(事件玩家, 生命值, (玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) - 事件玩家.cassidy_demage) * 0.075, 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		事件玩家.cassidy_demage = 玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量);
	}
}

规则("末日铁拳-AI")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		事件玩家 != 主机玩家;
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(终极技能));
		禁用按钮(事件玩家, 按钮(辅助攻击模式));
		禁用按钮(事件玩家, 按钮(近身攻击));
		禁用按钮(事件玩家, 按钮(技能1));
		禁用按钮(事件玩家, 按钮(技能2));

		等待直到(!正在使用技能 1(事件玩家), 8);
		可用按钮(事件玩家, 按钮(终极技能));
		可用按钮(事件玩家, 按钮(辅助攻击模式));
		可用按钮(事件玩家, 按钮(近身攻击));
		可用按钮(事件玩家, 按钮(技能1));
		可用按钮(事件玩家, 按钮(技能2));
	}
}

