			开始伤害调整(被攻击方, 所有玩家(所在队伍(攻击方)), 被攻击方.zarya_hurt > 0 ? 130 : 100, 受伤害者，伤害者及伤害百分比);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 4, 空, 自定义字符串("Zarya Graviton Surge Debuff"));
		End;
		被攻击方.zarya_hurt = 0.6;
		等待(0.4, 无视条件);
