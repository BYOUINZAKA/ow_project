规则("西格玛-盾炮")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		西格玛;
	}

	条件
	{
		事件玩家.sigma_r_pos != 空;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sigma Light"))) <= 0;
	}

	动作
	{
		创建效果(事件玩家.sigma_r_pos != 空 ? 所有玩家(所有队伍) : 空, “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家.sigma_r_pos[4], 100, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 10, 英雄(西格玛), 自定义字符串("Sigma Light"));
	}
}

规则("西格玛-盾炮")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		西格玛;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
		技能冷却时间(事件玩家, 按钮(辅助攻击模式)) <= 0;
	}

	动作
	{
		事件玩家.sigma_r_pos = 数组(眼睛位置(事件玩家), 面朝方向(事件玩家), 总计消耗时间, 空, 空, 空);
		等待直到(!正在使用辅助武器(事件玩家), 99999);
		If(技能冷却时间(事件玩家, 按钮(辅助攻击模式)) > 0 || !存活(事件玩家));
			事件玩家.sigma_r_pos = 空;
			中止;
		End;

		事件玩家.sigma_r_pos[3] = 射线命中位置(事件玩家.sigma_r_pos[0], 事件玩家.sigma_r_pos[0] + 较大(0, 单次赋值(总计消耗时间) - 事件玩家.sigma_r_pos[2]) * 20 * 事件玩家.sigma_r_pos[1], 空, 空, 假);
		事件玩家.sigma_r_pos[4] = 射线命中位置(事件玩家.sigma_r_pos[3], 事件玩家.sigma_r_pos[3] + 200 * 事件玩家.sigma_r_pos[1], 事件玩家, 空, 真);
		等待(0.25, 无视条件);
		While(技能冷却时间(事件玩家, 按钮(辅助攻击模式)) <= 0 && 事件玩家.sigma_r_pos != 空 && 存活(事件玩家));
			事件玩家.sigma_r_pos[5] = 已排序的数组(已过滤的数组(范围内玩家(事件玩家.sigma_r_pos[4], 20, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素)), 标准化生命值(当前数组元素) < 1.0 ? 生命值(当前数组元素) : (9999 * 当前数组元素.sigma_has_barrier))[0];
			If(事件玩家.sigma_r_pos[5] != 空);
				事件玩家.sigma_r_pos[5].sys_softirq[15] = 真;

				创建光束效果(所有玩家(所有队伍), 有益光束, 事件玩家.sigma_r_pos[4], 所选位置(事件玩家.sigma_r_pos[5]) + 上, 所在队伍(事件玩家), 可见，位置和半径);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 0.2, 英雄(西格玛));

				创建效果(所有玩家(所有队伍), “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家.sigma_r_pos[5], 0, 可见，位置和半径);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 0.2, 英雄(西格玛));
			End;
			等待直到(技能冷却时间(事件玩家, 按钮(辅助攻击模式)) > 0 || 事件玩家.sigma_r_pos == 空 || !存活(事件玩家), 1.5);
		End;
	}
}

规则("西格玛-盾炮-中断")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[15] != 空;
	}

	动作
	{
		事件玩家.sys_softirq[15] = 空;
		等待(0.1, 无视条件);
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sigma Experimental Barrier"))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sigma Experimental Barrier"))[0][1]);
			为玩家添加生命池(事件玩家, 生命值, 30, 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sigma Experimental Barrier") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 空, 自定义字符串("Sigma Experimental Barrier")) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sigma Experimental Barrier"))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 30, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 空, 自定义字符串("Sigma Experimental Barrier"));
		End;
		如条件为“真”则循环;
	}
}

规则("西格玛-盾炮-判断")
