规则("英雄被动-保护辅")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		数组包含(全局.a_sys_herotype[1], 所用英雄(事件玩家)) == 真;
		数量(已过滤的数组(所有玩家(所在队伍(事件玩家)), 数组包含(全局.a_sys_herotype[1], 所用英雄(当前数组元素)))) == 1;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SYSTEM HERO TYPE"))) <= 0;
	}

	动作
	{
		开始治疗调整(
			所有玩家(所在队伍(事件玩家)),
			事件玩家,
			105,
			受治疗者和治疗者
		);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, -1, 所用英雄(事件玩家), 自定义字符串("SYSTEM HERO TYPE"));
	}
}

