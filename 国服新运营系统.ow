禁用 规则("死神-E")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		死神;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		取消主要动作(事件玩家);
	}
}

规则("死神-自动跳")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		死神;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		是否是机器人(事件玩家) != 真;
		技能冷却时间(事件玩家, 按钮(技能2)) <= 0;
		正在使用终极技能(事件玩家) != 真;
	}

	动作
	{
		While(真);
			If(数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 30), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) <= 随机实数(13, 18) && 相距距离(事件玩家, 当前数组元素) > 5 && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 屏障不会阻挡视线))) > 0);
				开始按下按钮(事件玩家, 按钮(技能2));
				等待(0.25, 无视条件);
				停止按下按钮(事件玩家, 按钮(技能2));
			End;
			等待(0.25, 当为“假”时中止);
		End;
	}
}

规则("死神-幽灵形态")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		死神;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
		技能冷却时间(事件玩家, 按钮(技能1)) <= 0;
	}

	动作
	{
		取消主要动作(事件玩家);

		设置技能冷却(事件玩家, 按钮(技能1), 全局.args_reaper[1]);

		设置状态(事件玩家, 事件玩家, 相移, 0.5);
		创建效果(具有状态(事件玩家, 相移) ? 所有玩家(所有队伍) : 空, “死神”幽灵形态效果, 所在队伍(事件玩家), 事件玩家, 1.500, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 0.5, 英雄(死神), 自定义字符串("Reaper Shadow"));

		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] += 1;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_immunity, 事件玩家, 总计消耗时间, 全局.args_reaper[0], 英雄(死神), 自定义字符串("Reaper Wraith Form"));

		事件玩家.i_sys_speed += 全局.args_reaper[2];
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 全局.args_reaper[2]), 总计消耗时间, 全局.args_reaper[0], 英雄(死神), 自定义字符串("Reaper Wraith Form"));

		开始伤害调整(事件玩家, 所有玩家(所有队伍), 全局.args_reaper[3], 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 全局.args_reaper[0], 英雄(死神), 自定义字符串("Reaper Wraith Form"));

		设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0));

		创建效果(所有玩家(所有队伍), 美冰冻效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_reaper[0], 英雄(死神), 自定义字符串("Reaper Wraith Form"));

		创建效果(所有玩家(所有队伍), “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_reaper[0], 英雄(死神), 自定义字符串("Reaper Wraith Form"));
	}
}

规则("死神-终极技能-计时")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		死神;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		事件玩家.reaper_q_begin[0] = 总计消耗时间;
		设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0));
		等待直到(!正在使用终极技能(事件玩家), 3.0);
		事件玩家.reaper_q_begin[1] = 总计消耗时间 - 事件玩家.reaper_q_begin[0];
		If(事件玩家.reaper_q_begin[1] < 3.0);
			设置终极技能充能(事件玩家, 100 * (3.0 - 事件玩家.reaper_q_begin[1]) / 3.0 - 15);
		End;
	}
}

规则("死神-终极技能-取消")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		死神;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(终极技能)) != 真;
	}

	动作
	{
		等待直到(!正在使用终极技能(事件玩家), 0.5);
		等待直到(!正在使用终极技能(事件玩家) || 按钮被按下(事件玩家, 按钮(终极技能)), 3);
		If(正在使用终极技能(事件玩家) && 按钮被按下(事件玩家, 按钮(终极技能)));
			取消主要动作(事件玩家);
		End;
	}
}

规则("死神-AI-大招取消")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		死神;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		正在使用终极技能(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(终极技能)) != 真;
		数量(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 8.5, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素))) <= 0;
	}

	动作
	{
		开始按下按钮(事件玩家, 按钮(终极技能));
		等待(0.1, 无视条件);
		停止按下按钮(事件玩家, 按钮(终极技能));
	}
}

规则("DVA-冲撞")
{
	事件
	{
		玩家造成伤害;
		双方;
		D.Va;
	}

	条件
	{
		事件技能 == 按钮(技能1);
		数量(已过滤的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("DVA Debuff"))) <= 0;
	}

	动作
	{
		伤害(被攻击方, 攻击方, 最大生命值(被攻击方) * 0.1);
		开始治疗调整(被攻击方, 所有玩家(所有队伍), 75, 全部禁用);
		被攻击方.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, 3, 空, 自定义字符串("DVA Debuff"));
	}
}

规则("DVA-被暴击")
{
	事件
	{
		玩家受到伤害;
		双方;
		D.Va;
	}

	条件
	{
		事件暴击 == 真;
		处于非初始状态(事件玩家) != 真;
	}

	动作
	{
		为玩家添加生命池(事件玩家, 护甲, 较大(事件伤害 * 0.500, 10), 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.00, 英雄(D.Va));
	}
}

规则("DVA-被动-飞行矩阵回复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		D.Va;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		等待直到 (正在使用技能 1(事件玩家) != 真, 0.100);
		While(正在使用技能 1(事件玩家) == 真);
			设置技能资源(事件玩家, 按钮(辅助攻击模式), 3 + 技能资源(事件玩家, 按钮(辅助攻击模式)));
			等待直到 (正在使用技能 1(事件玩家) != 真, 0.100);
		End;
	}
}

规则("DVA-被动-护甲回复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		D.Va;
	}

	条件
	{
		// 事件玩家.dva_armor_recover == 空;
		正在使用辅助武器(事件玩家) == 真;
		处于非初始状态(事件玩家) != 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("DVA continued heal"))) <= 0;
	}

	动作
	{
		开始持续治疗(事件玩家, 事件玩家, 9999999.000, 30);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_continued, 上一个持续治疗效果ID, 总计消耗时间, -1, 英雄(D.Va), 自定义字符串("DVA continued heal"));
	}
}

规则("DVA-被动-护甲回复-清理")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		D.Va;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("DVA continued heal"))) > 0;
		(处于非初始状态(事件玩家) || 正在使用辅助武器(事件玩家) != 真) == 真;
	}

	动作
	{
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("DVA continued heal") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("DVA-被动-护甲回复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		D.Va;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(D.Va), 阻挡伤害量) - 事件玩家.dva_armor_recover[0] > 1;
	}

	动作
	{
		治疗(事件玩家, 事件玩家, (玩家英雄数据(事件玩家, 英雄(D.Va), 阻挡伤害量) - 事件玩家.dva_armor_recover[0]) * 0.4);
		事件玩家.dva_armor_recover[0] = 玩家英雄数据(事件玩家, 英雄(D.Va), 阻挡伤害量);
		// 等待(0.25, 无视条件);
		// 如条件为“真”则循环;
	}
}

规则("DVA-被动-护甲回复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		D.Va;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(D.Va), 阻挡伤害量) - 事件玩家.dva_armor_recover[1] > 25;
	}

	动作
	{
		创建弹道(“法老之鹰”火箭, 事件玩家, 空, 方向(眼睛位置(事件玩家), 眼睛位置(数组随机取值(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 30), 存活(当前数组元素)))) + 下 * 随机实数(0, 0.5)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 8.5, 0.16, 1.4, 有益爆炸, 爆炸声音, 0, 1000, 1.0, 0, 0, 0);
		事件玩家.dva_armor_recover[1] = 玩家英雄数据(事件玩家, 英雄(D.Va), 阻挡伤害量);
		// 等待(0.25, 无视条件);
		// 如条件为“真”则循环;
	}
}

规则("巴蒂斯特-S-临时生命")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		巴蒂斯特;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		// 设置状态(范围内玩家(事件玩家, 12, 所在队伍(事件玩家), 表面及敌方屏障), 事件玩家, 无法杀死, 1);

		// 为玩家添加生命池(事件玩家, 生命值, (最大生命值(事件玩家) - 生命值(事件玩家)) * 0.400, 假, 假);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5.00, 英雄(巴蒂斯特));
		范围内玩家(眼睛位置(事件玩家), 12, 所在队伍(事件玩家), 表面及敌方屏障).sys_softirq[20] = 数组(事件玩家, 0.10);
	}
}

规则("巴蒂斯特-S-临时生命")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[20] != 空;
	}

	动作
	{
		事件玩家.baptiste_shift_hp = 3.0;
		设置状态(事件玩家, 事件玩家.sys_softirq[20][0], 无法杀死, 3.0);

		// If(事件玩家 == 事件玩家.sys_softirq[20][0]);
		// 	为玩家添加生命池(事件玩家, 生命值, (最大生命值(事件玩家) - 生命值(事件玩家)) * 事件玩家.sys_softirq[20][1] * 2, 假, 假);
		// 	事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5.00);
		// Else;
		// 	为玩家添加生命池(事件玩家, 生命值, (最大生命值(事件玩家) - 生命值(事件玩家)) * 事件玩家.sys_softirq[20][1], 假, 假);
		// 	事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5.00);
		// End;

		事件玩家.sys_softirq[20] = 空;
	}
}

规则("巴蒂斯特-自动跳跃")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		巴蒂斯特;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		存活(事件玩家) == 真;
	}

	动作
	{
		While(真);
			等待((在目标点上(事件玩家) || 正在等待玩家) ? 随机实数(0.5, 3.5) : 随机实数(1.0, 5.0), 当为“假”时中止);
			If((数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 90), 存活(当前数组元素) && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 屏障不会阻挡视线))) > 0));
				开始按下按钮(事件玩家, 按钮(蹲下));
				等待(随机实数(0.05, 0.75), 无视条件);
				停止按下按钮(事件玩家, 按钮(蹲下));
				按下按键(事件玩家, 按钮(跳跃));
			End;
		End;
	}
}

