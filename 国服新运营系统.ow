规则("温斯顿-AI-禁用跳")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		相距距离(重生点(所在队伍(事件玩家)), 事件玩家.sys_main_tank) <= 相距距离(重生点(所在队伍(事件玩家)), 目标位置(对象索引)) * 0.6;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(技能1));
		禁用按钮(事件玩家, 按钮(技能2));
	}
}

