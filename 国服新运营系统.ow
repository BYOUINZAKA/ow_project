	}
}

规则("卡西迪-伤害")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

	条件
	{
		(事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(终极技能) || 事件技能 == 按钮(近身攻击)) == 真;
	}

	动作
	{
		为玩家添加生命池(攻击方, 生命值, 较小(5, 事件伤害 * 0.20), 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		等待(0.1, 无视条件);
	}
}

规则("卡西迪-伤害衰减弥补")
{
	事件
	{
		玩家造成伤害;
		双方;
		卡西迪;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		攻击方.cassidy_distance[0] = 相距距离(眼睛位置(攻击方), 被攻击方);

		If(攻击方.cassidy_distance[0] >= 35);
			攻击方.cassidy_distance[1] = 事件伤害 * (49 / 21);
		Else If(攻击方.cassidy_distance[0] > 25);
			// 攻击方.cassidy_distance = 事件伤害 * (100/(240-7*攻击方.cassidy_distance)-1);
			攻击方.cassidy_distance[1] = 事件伤害 * ((4.9*攻击方.cassidy_distance[0]-122.5) / (192.5-4.9*攻击方.cassidy_distance[0]));
		Else;
			攻击方.cassidy_distance[1] = 0.0;
		End;

		If(事件暴击);
			攻击方.cassidy_distance[1] = 事件伤害*攻击方.cassidy_distance[2] + 攻击方.cassidy_distance[1]*(1+攻击方.cassidy_distance[2]);
			攻击方.cassidy_distance[2] = 较小(攻击方.cassidy_distance[2]+0.015, 0.40);
			设置技能冷却(攻击方, 按钮(技能1), 0);
		End;

		If(攻击方.cassidy_distance[1] > 0);
			伤害(被攻击方, 攻击方, 攻击方.cassidy_distance[1]);
		End;

		为玩家添加生命池(攻击方, 生命值, (事件伤害 + 攻击方.cassidy_distance[1]) * 0.15, 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 事件暴击 ? 6 : 3, 英雄(卡西迪));
		等待(0.25, 无视条件);
	}
}

规则("卡西迪-屏障伤害")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卡西迪;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) != 空数组;
		存活(事件玩家) == 真;
		玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) > 事件玩家.cassidy_demage;
	}

	动作
	{
		为玩家添加生命池(事件玩家, 生命值, (玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量) - 事件玩家.cassidy_demage) * 0.075, 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		事件玩家.cassidy_demage = 玩家英雄数据(事件玩家, 英雄(卡西迪), 对屏障造成伤害量);
	}
}

规则("卡西迪-文字")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卡西迪;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("CassidyPower"))) <= 0;
	}

	动作
	{
		创建HUD文本(事件玩家, 自定义字符串(""), 自定义字符串("暴击倍率：{0}%", (2+事件玩家.cassidy_distance[2]*2)*100), 自定义字符串(""), 顶部, 0, 颜色(白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_uhd_text, 上一个文本ID, 总计消耗时间, -1, 英雄(卡西迪), 自定义字符串("CassidyPower"));

		创建效果((事件玩家.cassidy_distance[2] >= 0.2) ? 对方队伍(所在队伍(事件玩家)) : 空, “天使”伤害强化效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(卡西迪), 自定义字符串("CassidyPower"));
	}
}

规则("末日铁拳-AI")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(终极技能));
		禁用按钮(事件玩家, 按钮(辅助攻击模式));
		禁用按钮(事件玩家, 按钮(近身攻击));
		禁用按钮(事件玩家, 按钮(技能1));
		禁用按钮(事件玩家, 按钮(技能2));

		等待直到(!正在使用技能 1(事件玩家), 8);
		可用按钮(事件玩家, 按钮(终极技能));
		可用按钮(事件玩家, 按钮(辅助攻击模式));
		可用按钮(事件玩家, 按钮(近身攻击));
		可用按钮(事件玩家, 按钮(技能1));
		可用按钮(事件玩家, 按钮(技能2));
	}
}

