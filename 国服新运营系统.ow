	{
		设置最大弹药(事件玩家, 0, 70);
		设置弹药(事件玩家, 0, 弹药(事件玩家, 0) + 35);
		等待直到 (正在使用终极技能(事件玩家) != 真, 20);
		设置最大弹药(事件玩家, 0, 35);
	}
}

