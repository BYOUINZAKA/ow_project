规则("猎空-脉冲炸弹")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		// 事件玩家.tracer_energy[5] = 眼睛位置(事件玩家);
		// 事件玩家.tracer_energy[6] = 面朝方向(事件玩家);
		// 等待(0.144, 无视条件);
		// 事件玩家.tracer_energy[7] = 总计消耗时间;
		// 创建效果(事件玩家, 球体, 颜色(绿色), 射线命中位置(事件玩家.tracer_energy[5], 事件玩家.tracer_energy[5] + 事件玩家.tracer_energy[6]*15*(总计消耗时间-事件玩家.tracer_energy[7]) + 下 * 5 * (总计消耗时间-事件玩家.tracer_energy[7])^2, 所有玩家(所有队伍), 事件玩家, 假), 3, 可见，位置和半径);
		// 创建效果(事件玩家, 球体, 颜色(绿色), 事件玩家.tracer_energy[5] + 事件玩家.tracer_energy[6]*15*(总计消耗时间-事件玩家.tracer_energy[7]) + 下*5*(总计消耗时间-事件玩家.tracer_energy[7])^2, 2, 可见，位置和半径);

		事件玩家.tracer_energy[5] = 眼睛位置(事件玩家) + 面朝方向(事件玩家)*15*0.25 + 下*5*0.25^2;
		等待(0.25, 无视条件);
		设置状态(范围内玩家(事件玩家.tracer_energy[5], 4.0, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 击晕, 0.5);
		// 设置状态(已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 在视野内(事件玩家, 眼睛位置(当前数组元素), 90) && 相距距离(眼睛位置(事件玩家), 眼睛位置(当前数组元素)) <= 6.0), 事件玩家, 击晕, 0.5);
	}
}

规则("源氏-减伤")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		源氏;
	}

	条件
	{
		(在墙上(事件玩家) || 正在空中(事件玩家)) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Genji Dec"))) <= 0;
	}

	动作
	{
		// 开始伤害调整(事件玩家, 所有玩家(所有队伍), (在墙上(事件玩家) || 正在空中(事件玩家)) ? 90 : 100, 受伤害者，伤害者及伤害百分比);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(源氏), 自定义字符串("Genji Dec"));

		// 开始伤害调整(所有玩家(所有队伍), 事件玩家, (在墙上(事件玩家) || 正在空中(事件玩家)) ? 110 : 100, 受伤害者，伤害者及伤害百分比);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(源氏), 自定义字符串("Genji Dec"));

		开始治疗调整(事件玩家, 所有玩家(所有队伍), (在墙上(事件玩家) || 正在空中(事件玩家)) ? 120 : 100, 受治疗者，治疗者及治疗百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, -1, 英雄(源氏), 自定义字符串("Genji Dec"));
	}
}

