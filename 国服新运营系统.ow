{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			等待直到(事件玩家.sys_projectile_speed[0] != 事件玩家.sys_projectile_speed[1], 99999);
			设置弹道速度(事件玩家, 100 + 事件玩家.sys_projectile_speed[0]);
			事件玩家.sys_projectile_speed[1] = 事件玩家.sys_projectile_speed[0];
