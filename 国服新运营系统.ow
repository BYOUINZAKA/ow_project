	}
}

规则("安娜-被动-治疗持续")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		安娜;
	}

	条件
	{
		// 事件玩家.ana_ring != 空;
		// 存活(事件玩家.ana_ring) == 真;
		// 实体存在(事件玩家.ana_ring) == 真;
		(
			(事件玩家.ana_ring[0] != 空 && 存活(事件玩家.ana_ring[0]) && 实体存在(事件玩家.ana_ring[0])) ||
			(事件玩家.ana_ring[1] != 空 && 存活(事件玩家.ana_ring[1]) && 实体存在(事件玩家.ana_ring[1]))
		) == 真;
	}

	动作
	{
		While(真);
			等待(0.4, 当为“假”时中止);
			If(事件玩家.ana_ring[0] != 空 && 存活(事件玩家.ana_ring[0]) && 实体存在(事件玩家.ana_ring[0]));
				创建弹道(“天使”天使冲击枪, 事件玩家, 所选位置(事件玩家.ana_ring[0]), 上, 至地图, 治疗, 所在队伍(事件玩家), 10, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.2, 0, 0, 0);
			End;
			If(事件玩家.ana_ring[1] != 空 && 存活(事件玩家.ana_ring[1]) && 实体存在(事件玩家.ana_ring[1]));
				创建弹道(“天使”天使冲击枪, 事件玩家, 所选位置(事件玩家.ana_ring[1]), 上, 至地图, 治疗, 所在队伍(事件玩家), 10, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.2, 0, 0, 0);
			End;
		End;
	}
}

