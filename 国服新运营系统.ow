规则("")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[14] != 空;
	}

	动作
	{
		等待直到 (具有状态(事件玩家, 击倒), 5);
		If(具有状态(事件玩家, 击倒));
