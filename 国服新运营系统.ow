规则("能量运营-日志")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		按钮被按下(事件玩家, 按钮(终极技能)) == 真;
	}

	动作
	{
		If(事件玩家.sys_ultra_lock[0]);
			启用查看器录制;
			记入查看器(自定义字符串("Block: {0},{1},{2}", 事件玩家, 事件玩家.sys_ultra_lock[0], 事件玩家.sys_ultra_lock[1]));
			禁用查看器录制;
		Else;
			启用查看器录制;
			记入查看器(自定义字符串("Allow: {0},{1},{2}", 事件玩家, 事件玩家.sys_ultra_lock[0], 事件玩家.sys_ultra_lock[1]));
			禁用查看器录制;
		End;
	}
}

