}

规则("安娜-弹药恢复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		安娜;
	}

	条件
	{
		(正在使用主要武器(事件玩家) || 正在装填(事件玩家)) != 真;
		弹药(事件玩家, 0) < 最大弹药(事件玩家, 0);
		弹药(事件玩家, 0) > 0;
	}

	动作
	{
		While(真);
			等待(1.0, 当为“假”时中止);
			设置弹药(事件玩家, 0, 较小(最大弹药(事件玩家, 0), 弹药(事件玩家, 0) + 1));
		End;
	}
}

禁用 规则("安娜-治疗链")
{
	事件
	{
		玩家造成治疗;
		双方;
		安娜;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		治疗者.ana_ring[0] = 已排序的数组(已过滤的数组(范围内玩家(所选位置(受治疗者), 10, 所在队伍(受治疗者), 表面及敌方屏障), 存活(当前数组元素) && 标准化生命值(当前数组元素) < 1.0 && 当前数组元素 != 治疗者 && 当前数组元素 != 受治疗者), 生命值(当前数组元素))[0];
		If (实体存在(治疗者.ana_ring[0]));
			治疗者.ana_ring[1] = 归一化(方向(眼睛位置(受治疗者) + 下 * 随机实数(0, 0.5), 眼睛位置(治疗者.ana_ring[0]) + 下 * 随机实数(0, 0.5)));
			创建弹道(“天使”天使冲击枪, 治疗者, 眼睛位置(受治疗者) + 下 * 随机实数(0, 0.5) + 治疗者.ana_ring[1] * 1, 治疗者.ana_ring[1], 至地图, 治疗, 所在队伍(受治疗者), 75, 1, 0, 有益爆炸, 爆炸声音, 0.01, 125, 1, 0, 0, 0);
		End;
		等待(0.6, 无视条件);
	}
}

