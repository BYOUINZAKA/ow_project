		If (实体存在(攻击方.ana_ring[0]));
			攻击方.ana_ring[1] = 归一化(方向(眼睛位置(被攻击方) + 下 * 随机实数(0, 0.5), 眼睛位置(攻击方.ana_ring[0]) + 下 * 随机实数(0, 0.5)));
			创建弹道(“天使”天使冲击枪, 攻击方, 眼睛位置(被攻击方) + 下 * 随机实数(0, 0.5) + 攻击方.ana_ring[1] * 1, 攻击方.ana_ring[1], 至地图, 伤害, 所在队伍(被攻击方), 75, 1, 0, 有益爆炸, 爆炸声音, 0.01, 125, 1, 0, 0, 0);
		End;
		等待(0.6, 无视条件);
	}
}

