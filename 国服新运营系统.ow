规则("温斯顿-自动跳")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		是否是机器人(事件玩家) != 真;
		技能冷却时间(事件玩家, 按钮(技能1)) <= 0;
		正在使用技能 1(事件玩家) != 真;
		(正在使用终极技能(事件玩家) || !正在使用主要武器(事件玩家)) == 真;
	}

	动作
	{
		While(真);
			If(数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 10), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) <= 随机实数(15, 20) && 相距距离(事件玩家, 当前数组元素) >= 随机实数(8, 10) && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 屏障不会阻挡视线))) > 0);
				开始按下按钮(事件玩家, 按钮(技能1));
				等待(0.1, 无视条件);
				停止按下按钮(事件玩家, 按钮(技能1));
			End;
			等待(0.25, 当为“假”时中止);
		End;
	}
}

规则("温斯顿-副武器-抱头")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		(!正在使用终极技能(事件玩家) && (正在使用辅助武器(事件玩家) || 正在使用主要武器(事件玩家))) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Block"))) <= 0;
	}

	动作
	{
		// 开始伤害调整(事件玩家, 视角中的玩家(事件玩家, 所有队伍, 53), (!正在使用终极技能(事件玩家) && (正在使用辅助武器(事件玩家) || 正在使用主要武器(事件玩家))) ? 50 : 100, 受伤害者，伤害者及伤害百分比);
		开始伤害调整((!正在使用终极技能(事件玩家) && (正在使用辅助武器(事件玩家) || 正在使用主要武器(事件玩家))) ? 事件玩家 : 空, 视角中的玩家(事件玩家, 所有队伍, 100), 40, 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(温斯顿), 自定义字符串("Winston Block"));
		创建效果((!正在使用终极技能(事件玩家) && (正在使用辅助武器(事件玩家) || 正在使用主要武器(事件玩家))) ? 添加至数组(视角中的玩家(事件玩家, 所有队伍, 100), 事件玩家) : 空, “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(温斯顿), 自定义字符串("Winston Block"));
	}
}

规则("温斯顿-副武器-蓄力")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(辅助攻击模式)) == 真;
	}

	动作
	{
		While((正在使用辅助武器(事件玩家) && 按钮被按下(事件玩家, 按钮(辅助攻击模式))) == 真);
			等待直到 ((正在使用辅助武器(事件玩家) && 按钮被按下(事件玩家, 按钮(辅助攻击模式))) != 真, 0.100);
			事件玩家.winston_power += 3;
		End;

		等待(0.2500, 无视条件);
		事件玩家.winston_power = 0;
	}
}

规则("温斯顿-副武器-击退")
{
	事件
	{
		玩家造成伤害;
		双方;
		温斯顿;
	}

	条件
	{
		事件技能 == 按钮(辅助攻击模式);
		攻击方.winston_power > 0;
	}

	动作
	{
		// 施加推力(被攻击方, 与此角度的相对方向(与此方向的水平角度(方向(攻击方, 被攻击方)), 较小(-25, 与此方向的垂直角度(方向(攻击方, 被攻击方)))), 攻击方.winston_power < 10 ? 攻击方.winston_power * 2 : 攻击方.winston_power + 10, 至地图, 合并相反运动);
		If(被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0);
			施加推力(被攻击方, 与此角度的相对方向(与此方向的水平角度(方向(攻击方, 被攻击方)), 较小(-25, 与此方向的垂直角度(方向(攻击方, 被攻击方)))), 较小(25.7, 攻击方.winston_power), 至地图, 合并相反运动);
			设置地形消灭者玩家(被攻击方, 攻击方);
		End;
		事件玩家.winston_power = 0;
	}
}

规则("温斯顿-S")
{
	事件
	{
		玩家造成伤害;
		双方;
		温斯顿;
	}

	条件
	{
		(事件技能 == 按钮(技能1) || 事件技能 == 按钮(辅助攻击模式)) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
	}

	动作
	{
		If(数量(已过滤的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Shift Debuff"))) <= 0);
			创建效果(所有玩家(所有队伍), 温斯顿特斯拉炮目标效果, 所在队伍(攻击方), 被攻击方, 0, 可见，位置和半径);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 5, 空, 自定义字符串("Winston Shift Debuff"));
			开始伤害调整(被攻击方, 所有玩家(所在队伍(攻击方)), 125, 受伤害者和伤害者);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 5, 空, 自定义字符串("Winston Shift Debuff"));
		Else;
			被攻击方.sys_default_status_pool = 映射的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Shift Debuff") ? 数组(当前数组元素[0], 当前数组元素[1], 总计消耗时间, 5, 当前数组元素[4], 当前数组元素[5]) : 当前数组元素);
		End;

		If(事件技能 == 按钮(技能1) && 事件伤害 >= 5);
			施加推力(被攻击方, 上, 5, 至地图, 取消相反运动);
			If(相距距离(所选位置(攻击方), 所选位置(被攻击方)) <= 2.0);
				设置状态(被攻击方, 攻击方, 击倒, (正在使用终极技能(攻击方) ? 2.0 : 1.0) * (数组包含(全局.sys_tank, 所用英雄(被攻击方)) ? 0.75 : 1.0));
			End;
		End;
	}
}

规则("温斯顿-S-引爆")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		数量(已过滤的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Shift Debuff") && 当前数组元素[3] > 1)) > 0;
		(所用英雄(攻击方) != 英雄(温斯顿) || (事件技能 != 按钮(技能1) && 事件技能 != 按钮(辅助攻击模式))) == 真;
		攻击方 != 被攻击方;
	}

	动作
	{
		被攻击方.sys_default_status_pool = 映射的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Shift Debuff") ? 数组(当前数组元素[0], 当前数组元素[1], 总计消耗时间, 1, 当前数组元素[4], 当前数组元素[5]) : 当前数组元素);
		为玩家添加生命池(攻击方, 生命值, 25, 假, 假);
		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5);
	}
}

规则("温斯顿-护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		事件玩家.winston_block[1] = 所选位置(事件玩家);
		事件玩家.winston_block[2] = 总计消耗时间;
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Winston Heal"))) <= 0);
			创建效果(事件玩家.winston_block[3] > 0 ? 所有玩家(所有队伍) : 空, 云, 颜色(黄色), 射线命中位置(事件玩家.winston_block[1], 事件玩家.winston_block[1] + 下 * 5 * (0.13+总计消耗时间-事件玩家.winston_block[2])^2, 空, 空, 假), 8, 可见，位置和半径);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 5, 英雄(温斯顿), 自定义字符串("Winston Heal"));
		End;
	}
}

规则("温斯顿-护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(温斯顿), 阻挡伤害量) - 事件玩家.winston_block[0] > 1;
	}

	动作
	{
		事件玩家.winston_block[3] = 1;
		治疗(
			添加至数组(范围内玩家(射线命中位置(事件玩家.winston_block[1], 事件玩家.winston_block[1] + 下 * 5 * (0.13+总计消耗时间-事件玩家.winston_block[2])^2, 空, 空, 假), 8.5, 所在队伍(事件玩家), 关闭), 事件玩家),
			事件玩家,
			(玩家英雄数据(事件玩家, 英雄(温斯顿), 阻挡伤害量) - 事件玩家.winston_block[0]) * 0.5
		);
		事件玩家.winston_block[0] = 玩家英雄数据(事件玩家, 英雄(温斯顿), 阻挡伤害量);
		等待(0.1, 无视条件);
		如条件为“真”则循环;
	}
}

规则("温斯顿-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		// While(正在使用终极技能(事件玩家));
		// 	开始持续伤害(范围内玩家(眼睛位置(事件玩家), 5, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 1.0, 生命值(事件玩家) * 0.05);
		// 	等待直到(!正在使用终极技能(事件玩家), 1.0);
		// End;

		为玩家添加生命池(事件玩家, 生命值, 1000, 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 10, 英雄(温斯顿));

		等待直到(!正在使用终极技能(事件玩家), 20);
		If (存活(事件玩家) && !正在使用终极技能(事件玩家));
			设置玩家生命值(事件玩家, 最大生命值(事件玩家));
		End;
	}
}

