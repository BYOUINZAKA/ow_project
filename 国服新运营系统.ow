规则("毛加-E-加速")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		存活(事件玩家) == 真;
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		事件玩家.mauga_range[2] = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 35, 对方队伍(所在队伍(事件玩家)), 表面及全部屏障), 存活(当前数组元素));
		事件玩家.mauga_range[2].mauga_flag[0] += 10;
		事件玩家.mauga_range[2].mauga_flag[1] = 事件玩家;
		事件玩家.mauga_range[2].mauga_flag[2] = 2.0;

		开始伤害调整(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 10.5, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素) && 事件玩家 != 当前数组元素), 所有玩家(所有队伍), 60, 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3, 英雄(毛加), 自定义字符串("Mauga Cardiac Overdrive Heal"));

		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] += 1;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_immunity, 事件玩家, 总计消耗时间, 3, 英雄(毛加), 自定义字符串("Mauga Cardiac Overdrive Heal"));

		While(存活(事件玩家) && 正在使用技能 2(事件玩家));
			事件玩家.mauga_s_players = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 10.5, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素));
			事件玩家.mauga_s_players.sys_softirq[13] = 事件玩家;
	
			事件玩家.mauga_s_players = 已过滤的数组(事件玩家.mauga_s_players, 存活(当前数组元素) && !(当前数组元素 == 事件玩家 && 正在使用技能 1(当前数组元素)));
			事件玩家.mauga_s_players.i_sys_speed += 35;
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家.mauga_s_players, 35), 总计消耗时间, 0.5, 英雄(毛加), 自定义字符串("Mauga Cardiac Overdrive"));

			// 等待(0.5, 无视条件);
			// 等待直到 (!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mauga Cardiac Overdrive")), 0.5);
			等待直到(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mauga Cardiac Overdrive"))) <= 0, 0.5);
		End;

		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, (当前数组元素[5] == 自定义字符串("Mauga Cardiac Overdrive Heal")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

