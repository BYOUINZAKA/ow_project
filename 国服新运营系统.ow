规则("AI-自动跳跃")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		在重生室中(事件玩家) == 真;
		存活(事件玩家) == 真;
	}

	动作
	{
		While(主机玩家 != 事件玩家 && 在重生室中(事件玩家) && 存活(事件玩家));
			按下按键(事件玩家, 按钮(跳跃));
			等待直到(主机玩家 == 事件玩家 || !在重生室中(事件玩家) || !存活(事件玩家), 随机实数(10, 30));
		End;
	}
}

规则("西格玛-AI")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		西格玛;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		存活(事件玩家) == 真;
		正在使用终极技能(事件玩家) != 真;
	}

	动作
	{
		While(真);
			If(技能冷却时间(事件玩家, 按钮(技能2)) <= 0 && (!正在使用技能 1(事件玩家) || 标准化生命值(事件玩家) >= 0.95) && 数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 30), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) < 15 && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 敌方屏障阻挡视线))) > 0);
				开始按下按钮(事件玩家, 按钮(技能2));
				等待(0.1, 无视条件);
				停止按下按钮(事件玩家, 按钮(技能2));
			Else If(数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 30), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) < 28 && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 屏障不会阻挡视线))) > 0);
				开始按下按钮(事件玩家, 按钮(主要攻击模式));
				等待(0.1, 无视条件);
				停止按下按钮(事件玩家, 按钮(主要攻击模式));
			End;
			等待(0.2, 当为“假”时中止);
		End;
	}
}

规则("生命之梭-爆炸")
{
	事件
	{
		玩家受到治疗;
		双方;
		全部;
	}

	条件
	{
		所用英雄(治疗者) == 英雄(生命之梭);
	}

	动作
	{
		伤害(范围内玩家(眼睛位置(受治疗者), 随机实数(3, 6), 对方队伍(所在队伍(受治疗者)), 表面及敌方屏障), 治疗者, 45);
		If(事件技能 == 按钮(技能1) && 治疗者 == 受治疗者);
			为玩家添加生命池(受治疗者, 生命值, 1000, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, 1.0, 英雄(生命之梭));
		End;
		If(正在使用终极技能(治疗者) && 数量(已过滤的数组(受治疗者.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("LifeweaverHP"))) == 1);
			移除玩家的生命池(已过滤的数组(受治疗者.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("LifeweaverHP"))[0][1]);
			为玩家添加生命池(受治疗者, 护盾, 25, 真, 真);
			受治疗者.sys_default_status_pool = 映射的数组(受治疗者.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("LifeweaverHP") ? 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(受治疗者), 自定义字符串("LifeweaverHP")) : 当前数组元素);
		End;
		等待(0.3, 无视条件);
	}
}

