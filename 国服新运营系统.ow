			数组(英雄(布丽吉塔), 0.8, 1.2, 2.2, 4.0, 60, 40, 24.0),
			数组(英雄(巴蒂斯特), 0.8, 1.2, 0.5, 0.5, 80, 20),
			数组(英雄(禅雅塔), 0.8, 1.2, 2.0, 4.5, 20, 80, 25.0),
			数组(英雄(雾子), 0.8, 1.2, 2.8, 1.2, 75, 25, 24.0)
		);

		全局.sys_touch_attacks = 数组(
			数组(英雄(D.Va), 按钮(技能1)),
			数组(英雄(奥丽莎), 按钮(技能2), 按钮(辅助攻击模式)),
			数组(英雄(布丽吉塔), 按钮(主要攻击模式), 按钮(技能1)),
			数组(英雄(探奇), 按钮(辅助攻击模式), 按钮(技能1)),
			数组(英雄(末日铁拳), 按钮(辅助攻击模式)),
			数组(英雄(毛加), 按钮(技能1)),
			数组(英雄(渣客女王), 按钮(技能2), 按钮(终极技能)),
			数组(英雄(温斯顿), 按钮(技能1)),
			数组(英雄(源氏), 按钮(技能1), 按钮(终极技能)),
			数组(英雄(莱因哈特), 按钮(主要攻击模式), 按钮(技能1)),
			数组(英雄(骇灾), 按钮(技能1))
		);
	}
}

禁用 规则("随机数")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(真);
			全局.random = 随机实数(0, 1);
			等待(0, 无视条件);
		End;
	}
}

规则("回合重置")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		比赛结束 == 真;
	}

	动作
	{
		等待(21, 无视条件);
		重新开始比赛;
	}
}

规则("回合之间释放资源")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		处于回合之间 == 真;
	}

	动作
	{
		停止所有助攻;
		消除所有图标;
		// 消除所有效果;
		停止所有伤害调整;
		停止所有治疗调整;
		停止所有持续伤害(事件玩家);
		停止所有持续治疗(事件玩家);
		移除玩家的所有生命值(事件玩家);
		消除所有地图文本;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 数组(当前数组元素[0], 当前数组元素[1]));
	}
}

规则("用户名")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		是否是机器人(事件玩家) == 真;
		自定义字符串("{0}", 事件玩家) != 自定义字符串("{0}-{1}", 所用英雄(事件玩家), (所在队伍(事件玩家) == 队伍2) ? (栏位数量(所在队伍(事件玩家)) + 栏位(事件玩家)) : 栏位(事件玩家));
	}

	动作
	{
		停止为机器人强制设置名称(事件玩家);
		开始为机器人强制设置名称(事件玩家, 自定义字符串("{0}-{1}", 所用英雄(事件玩家), (所在队伍(事件玩家) == 队伍2) ? (栏位数量(所在队伍(事件玩家)) + 栏位(事件玩家)) : 栏位(事件玩家)));
		等待(1.0, 当为“真”时重新开始);
	}
}

规则("系统-判断AI")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_is_ai != 字符串包含(自定义字符串("{0}", 事件玩家), 自定义字符串("{0}", 所用英雄(事件玩家)));
	}

	动作
	{
		事件玩家.sys_is_ai = 字符串包含(自定义字符串("{0}", 事件玩家), 自定义字符串("{0}", 所用英雄(事件玩家)));
	}
}

规则("资源回收执行")
{
	事件
	{
		子程序;
		remove_default_status;
	}

	动作
	{
		If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_hp_pool && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1] > 0);
			移除玩家的生命池(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1]);
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_damage_adjust && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1] > 0);
			停止伤害调整(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1]);
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_heal_adjust && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1] > 0);
			停止治疗调整(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1]);
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_effect && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1] > 0);
			消除效果(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1]);
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_speed);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].i_sys_speed -= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1];
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_move_cd);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].d_sys_cd -= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1];
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_map_text && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1] > 0);
			消除地图文本(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1]);
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_status_thorns);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].a_sys_user_status[全局.t_enum_status_thorns] -= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1];
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_assists && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1] > 0);
			停止助攻(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1]);
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_disable_button);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].sys_button_list[数组值的索引(全局.a_sys_all_buttons, 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1])] -= 1;
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_status_immunity);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1].a_sys_user_status[全局.t_enum_status_immunity] -= 1;
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_status_golden);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].a_sys_user_status[全局.t_enum_status_golden] -= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1];
		Else If(绝对值(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0]) == 全局.t_enum_heal_continued && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1] > 0);
			停止持续治疗(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1]);
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_hp_percent);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].sys_hp_percent[0] -= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1];
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_status_recover);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].a_sys_user_status[全局.t_enum_status_recover] -= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1];
		Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 全局.t_enum_projectile_speed);
			事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][0].sys_projectile_speed[0] -= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][1][1];
		End;

		If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][6] == 10);
			调用子程序(cb_ramattra_overheal);
		End;

		事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i] = 空;
	}
}

禁用 规则("系统资源回收")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			等待直到 (数量(事件玩家.sys_default_status_pool) > 0, 99999);
			等待(全局.args_system[0], 无视条件);
			For 玩家变量(事件玩家, sys_default_status_pool_i, 数量(事件玩家.sys_default_status_pool) - 1, -1, -1);
				If(数量(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i]) == 2);
					调用子程序(remove_default_status);
				Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 空 || 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] < 0);
					调用子程序(remove_default_status);
				Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][4] == 空 || 所用英雄(事件玩家)
						== 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][4]);
					If(
						事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2] >= 0 && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][3] >= 0 && 总计消耗时间 - 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2] > 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][3]);
						调用子程序(remove_default_status);
					End;
				Else;
					调用子程序(remove_default_status);
				End;
				If(事件玩家.sys_default_status_pool_i % 全局.args_system[1] == 0);
					等待(0.0, 无视条件);
				End;
			End;
			事件玩家.sys_default_status_pool = 已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素 != 空 && 数量(当前数组元素) > 1);
		End;
	}
}

规则("系统资源回收")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			等待直到 (数量(事件玩家.sys_default_status_pool) > 0, 99999);
			// 等待直到 ((数量(事件玩家.sys_default_status_pool) > 0) && 对任意为“真”(事件玩家.sys_default_status_pool, 数量(当前数组元素) == 2 || 当前数组元素[0] == 空 || 当前数组元素[0] < 0 || (当前数组元素[4] != 空 && 所用英雄(事件玩家) != 当前数组元素[4]) || (当前数组元素[2] >= 0 && 当前数组元素[3] >= 0 && (总计消耗时间 - 当前数组元素[2]) > 当前数组元素[3])), 99999);
			等待(全局.args_system[0], 无视条件);

			For 玩家变量(事件玩家, sys_default_status_pool_i, 数量(事件玩家.sys_default_status_pool) - 1, -1, -1);
				If(数量(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i]) == 2);
					调用子程序(remove_default_status);
				Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] == 空 || 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] < 0);
					调用子程序(remove_default_status);
				Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][4] != 空 && 所用英雄(事件玩家)
						!= 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][4]);
					调用子程序(remove_default_status);
				Else If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2] >= 0 && 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][3] >= 0 && 总计消耗时间 - 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2] > 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][3]);
					调用子程序(remove_default_status);
				End;
				If(事件玩家.sys_default_status_pool_i % 全局.args_system[1] == 0);
					等待(0.0, 无视条件);
				End;
			End;
			事件玩家.sys_default_status_pool = 已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素 != 空 && 数量(当前数组元素) > 1);
		End;
	}
}

规则("全局定时器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	// 条件
	// {
	// 	(
	// 		(事件玩家.a_sys_user_status[全局.t_enum_escape] > 0) || 
	// 		(事件玩家.junkerqueen_timer > 0) ||
	// 		(事件玩家.widowmaker_hp_pool_timer > 0) ||
	// 		(事件玩家.reinhardt_shield != 空 && 事件玩家.reinhardt_shield[0] > 0) ||
	// 		(事件玩家.pharah_timer > 0) ||
	// 		(事件玩家.doomfist_count > 0) ||
	// 		(事件玩家.doomfistr_only > 0) ||
	// 		(事件玩家.zarya_hurt > 0) ||
	// 		(事件玩家.mauga_flag[2] > 0) ||
	// 		(事件玩家.mei_freeze[1] > 0) ||
	// 		(事件玩家.freja_attack[0] > 0) ||
	// 		(事件玩家.baptiste_shift_hp > 0) ||
	// 		(事件玩家.winston_block[3] > 0)
	// 	) == 真;
	// }

	动作
	{
		While(真);
			If(事件玩家.d_sys_ability_timer > 0);
				事件玩家.d_sys_ability_timer -= 全局.args_system[3];
			End;

			If(事件玩家.a_sys_user_status[全局.t_enum_escape] > 0);
				事件玩家.a_sys_user_status[全局.t_enum_escape] -= 全局.args_system[3];
			Else;
				事件玩家.a_sys_user_status[全局.t_enum_escape] = 0;
			End;
			If(事件玩家.junkerqueen_timer > 0);
				事件玩家.junkerqueen_timer -= 全局.args_system[3];
			Else;
				事件玩家.junkerqueen_timer = 0;
			End;
			If(事件玩家.widowmaker_hp_pool_timer > 0);
				事件玩家.widowmaker_hp_pool_timer -= 全局.args_system[3];
			Else;
				事件玩家.widowmaker_hp_pool_timer = 0;
			End;
			If(事件玩家.reinhardt_shield != 空 && 事件玩家.reinhardt_shield[0] > 0);
				事件玩家.reinhardt_shield[0] -= 全局.args_system[3];
			End;
			If(事件玩家.pharah_timer > 0);
				事件玩家.pharah_timer -= 全局.args_system[3];
			Else;
				事件玩家.pharah_timer = 0;
			End;
			If(事件玩家.doomfist_count > 0);
				事件玩家.doomfist_count -= 全局.args_system[3];
			Else;
				事件玩家.doomfist_count = 0;
			End;
			If(事件玩家.doomfistr_only > 0);
				事件玩家.doomfistr_only -= 全局.args_system[3];
			Else;
				事件玩家.doomfistr_only = 0;
			End;
			If(事件玩家.zarya_hurt > 0);
				事件玩家.zarya_hurt -= 全局.args_system[3];
			Else;
				事件玩家.zarya_hurt = 0;
			End;
			If(事件玩家.mauga_flag[2] > 0);
				事件玩家.mauga_flag[2] -= 全局.args_system[3];
			End;
			If(事件玩家.mei_freeze[1] > 0);
				事件玩家.mei_freeze[1] -= 全局.args_system[3];
			End;
			If(事件玩家.freja_attack[0] > 0);
				事件玩家.freja_attack[0] = 事件玩家.freja_attack[0] - 全局.args_system[3];
			End;
			If(事件玩家.baptiste_shift_hp > 0);
				事件玩家.baptiste_shift_hp -= 全局.args_system[3];
			End;
			If(事件玩家.winston_block[3] > 0);
				事件玩家.winston_block[3] -= 全局.args_system[3];
			End;
			If(事件玩家.venture_skill_record > 0);
				事件玩家.venture_skill_record -= 全局.args_system[3];
			End;
			等待(全局.args_system[3], 当为“假”时中止);
		End;
	}
}

规则("个人文本烂")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			等待(0.500, 无视条件);
			If(事件玩家.sys_self_text != 空 && 所用英雄(事件玩家) != 事件玩家.sys_self_text[0]);
				消除HUD文本(事件玩家.sys_self_text[1]);
				事件玩家.sys_self_text = 空;
			End;
		End;
	}
}

规则("系统-最大生命值")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		所用英雄(事件玩家) != 空;
		所用英雄(事件玩家) != 空数组;
		数量(已过滤的数组(全局.sys_hero_hp, 当前数组元素[0] == 所用英雄(事件玩家))) == 1;
		((事件玩家.sys_static_max_hp <= 0) || 已过滤的数组(全局.sys_hero_hp, 当前数组元素[0] == 所用英雄(事件玩家))[0][1] != 事件玩家.sys_static_max_hp) == 真;
	}

	动作
	{
		事件玩家.sys_static_max_hp = 已过滤的数组(全局.sys_hero_hp, 当前数组元素[0] == 所用英雄(事件玩家))[0][1];
	}
}

规则("系统-大招计时")
{
