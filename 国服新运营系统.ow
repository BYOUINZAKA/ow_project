规则("美-AI-寒冰盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		美;
	}

	条件
	{
		存活(事件玩家) == 真;
		事件玩家.sys_is_ai == 真;
		数量(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 20, 所在队伍(事件玩家), 关闭), 当前数组元素 != 事件玩家 && 存活(当前数组元素) && (生命值(当前数组元素) / 当前数组元素.sys_static_max_hp) < 0.5 && 当前数组元素.a_sys_user_status[全局.t_enum_escape] > 0)) > 0;
		技能冷却时间(事件玩家, 按钮(技能1)) <= 0;
	}

	动作
	{
		开始按下按钮(事件玩家, 按钮(技能1));
		等待(0.1, 无视条件);
		停止按下按钮(事件玩家, 按钮(技能1));
		等待(1.0, 无视条件);
	}
}

规则("猎空-隐藏")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		存活(事件玩家) == 真;
	}

	动作
	{
		While(真);
			等待(0.25, 当为“假”时中止);
			If(随机实数(0, 1) <= 0.15);
				设置状态(事件玩家, 事件玩家, 相移, 0.25);
			End;
		End;
	}
}

规则("猎空-闪A")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		// 事件玩家.tracer_energy[4] = 1.5;

		// 事件玩家.tracer_energy[8] = 射线命中玩家(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 与此角度的相对方向(水平朝向角度(事件玩家), 0) * 8.5, 所有存活玩家(对方队伍(所在队伍(事件玩家))), 空, 假);
		事件玩家.tracer_energy[8] = 所选位置(事件玩家) + 0.5 * 上;
		等待直到(逐帧更新(!正在使用技能 1(事件玩家)), 0.1);
		事件玩家.tracer_energy[9] = 射线命中玩家(事件玩家.tracer_energy[8], 所选位置(事件玩家) + 0.5 * 上 + 方向(事件玩家.tracer_energy[8], 所选位置(事件玩家) + 0.5 * 上) * 2.5 , 所有存活玩家(对方队伍(所在队伍(事件玩家))), 空, 假);
		伤害(事件玩家.tracer_energy[9], 事件玩家, 40);
	}
}

