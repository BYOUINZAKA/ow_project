		技能冷却时间(事件玩家, 按钮(技能1)) > 0;
	}

	动作
	{
		While(事件玩家.d_sys_cd > 0 && 技能冷却时间(事件玩家, 按钮(技能1)) > 0);
			等待(1 - 较小(事件玩家.d_sys_cd, 1), 当为“假”时中止);
			设置技能冷却(事件玩家, 按钮(技能1), 技能冷却时间(事件玩家, 按钮(技能1)) - 较小(事件玩家.d_sys_cd, 1));
		End;
	}
}

