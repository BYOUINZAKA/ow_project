		If(实体存在(事件玩家.torbjorn_save[2]));
			If(数量(已过滤的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package"))) == 1);
				移除玩家的生命池(已过滤的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package"))[0][1]);
				为玩家添加生命池(事件玩家.torbjorn_save[2], 护甲, 45, 假, 假);
				事件玩家.torbjorn_save[2].sys_default_status_pool = 映射的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(事件玩家.torbjorn_save[2]), 自定义字符串("Torbjorn Package")) : 当前数组元素);
			Else If(数量(已过滤的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package"))) == 0);
				为玩家添加生命池(事件玩家.torbjorn_save[2], 护甲, 45, 假, 假);
				事件玩家.torbjorn_save[2].sys_default_status_pool[数量(事件玩家.torbjorn_save[2].sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(事件玩家.torbjorn_save[2]), 自定义字符串("Torbjorn Package"));
			End;
		End;
	}
}

