规则("索杰恩-AI-补枪")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		索杰恩;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		生命值(事件玩家) <= 200;
		数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 10), 存活(当前数组元素) && 在视线内(眼睛位置(事件玩家), 眼睛位置(当前数组元素), 敌方屏障阻挡视线))) >= 1;
		正在使用主要武器(事件玩家) == 真;
		正在使用终极技能(事件玩家) != 真;
		事件玩家.sojourn_Q_demage_count <= 0;
	}

	动作
	{
		If(生命值(事件玩家) <= 随机实数(0, 200));
			开始按下按钮(事件玩家, 按钮(辅助攻击模式));
			等待(0.1, 无视条件);
			停止按下按钮(事件玩家, 按钮(辅助攻击模式));
		End;
	}
}

规则("索杰恩-伤害")
{
	事件
	{
		玩家造成伤害;
		双方;
		索杰恩;
	}

	条件
	{
		事件技能 != 空;
	}

	动作
	{
		If((事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(终极技能)) && 事件暴击);
			伤害(被攻击方, 攻击方, 较小(事件伤害, 180) * 全局.args_sojourn[4]);
			播放效果(所有玩家(所有队伍), 有害爆炸, 所在队伍(攻击方), 被攻击方, 较小(事件伤害 / 180 * 3.0, 3.0));
		Else If(事件技能 == 按钮(主要攻击模式) && !正在使用终极技能(攻击方) && 攻击方.sojourn_bullet_count < 全局.args_sojourn[0]);
			攻击方.sojourn_bullet_count += 1;
		Else If(事件技能 == 按钮(技能2) && 被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0 && 数量(已过滤的数组(被攻击方.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SojournSpeed Debuff"))) <= 0);
			被攻击方.i_sys_speed -= 25;
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(被攻击方, -25), 总计消耗时间, 0.5, 空, 自定义字符串("SojournSpeed Debuff"));
		End;
	}
}

规则("索杰恩-增伤")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		索杰恩;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		事件玩家.sojourn_bullet_count = 0;
		设置弹药(事件玩家, 0, 45);
		设置技能资源(事件玩家, 按钮(技能1), 2);
		设置技能冷却(事件玩家, 按钮(技能1), 0);
		设置技能冷却(事件玩家, 按钮(技能2), 0);
        事件玩家.d_sys_cd += 0.5;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_move_cd, 数组(事件玩家, 0.500), 总计消耗时间, 8, 英雄(索杰恩), 自定义字符串("Sojourn Q cd"));
		开始持续治疗(事件玩家, 事件玩家, 8, 50);
		为玩家添加生命池(事件玩家, 护盾, 全局.args_sojourn[1], 真, 真);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 8, 英雄(索杰恩), 自定义字符串(
			"Sojourn Q hp pool"));
		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 全局.args_sojourn[2], 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 8, 英雄(索杰恩), 自定义字符串(
			"Sojourn Q adjust"));
		// 开始伤害调整(事件玩家, 所有玩家(对方队伍(所在队伍(事件玩家))), 50, 受伤害者，伤害者及伤害百分比);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 8, 英雄(索杰恩), 自定义字符串(
		// 	"Sojourn Q adjust"));
	}
}

