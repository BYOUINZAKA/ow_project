		事件玩家.symmetra_Q_inedx + 事件玩家.symmetra_Q_players > 0;
		终极技能充能百分比(事件玩家) < 100;
	}

	动作
	{
		设置终极技能充能(事件玩家, 终极技能充能百分比(事件玩家) + 事件玩家.symmetra_Q_inedx + 事件玩家.symmetra_Q_players);
		事件玩家.symmetra_Q_inedx = 0;
		事件玩家.symmetra_Q_players = 0;
	}
}

规则("秩序之光-Q-大招增幅-标记存储")
