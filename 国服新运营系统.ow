规则("托比昂-数据保存")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		托比昂;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(托比昂), 对英雄造成伤害量) != 空数组;
		玩家英雄数据(事件玩家, 英雄(托比昂), 承受伤害量) != 空数组;
	}

	动作
	{
		事件玩家.torbjorn_save = 数组(
			玩家英雄数据(事件玩家, 英雄(托比昂), 对英雄造成伤害量),
			玩家英雄数据(事件玩家, 英雄(托比昂), 承受伤害量),
			空
		);
	}
}

规则("托比昂-护甲包")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		托比昂;
	}

	条件
	{
		// 玩家英雄数据(事件玩家, 英雄(托比昂), 对英雄造成伤害量) != 空数组;
		// 玩家英雄数据(事件玩家, 英雄(托比昂), 承受伤害量) != 空数组;
		// 数量(事件玩家.torbjorn_save) == 3;
		((玩家英雄数据(事件玩家, 英雄(托比昂), 对英雄造成伤害量) - 事件玩家.torbjorn_save[0]) + (玩家英雄数据(事件玩家, 英雄(托比昂), 承受伤害量) - 事件玩家.torbjorn_save[1])) > 300;
	}

	动作
	{
		事件玩家.torbjorn_save = 数组(玩家英雄数据(事件玩家, 英雄(托比昂), 对英雄造成伤害量), 玩家英雄数据(事件玩家, 英雄(托比昂), 承受伤害量), 已排序的数组(所有存活玩家(所在队伍(事件玩家)), 标准化生命值(当前数组元素) < 1.0 ? 生命值(当前数组元素) : 类型的生命值(当前数组元素, 护甲) * 100)[0]);
		If(实体存在(事件玩家.torbjorn_save[2]) && 存活(事件玩家.torbjorn_save[2]));
			If(数量(已过滤的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package"))) == 1);
				播放效果(事件玩家.torbjorn_save[2], 正面状态施加声音, 颜色(白色), 事件玩家, 100);
				移除玩家的生命池(已过滤的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package"))[0][1]);
				为玩家添加生命池(事件玩家.torbjorn_save[2], 护甲, 50, 假, 假);
				事件玩家.torbjorn_save[2].sys_default_status_pool = 映射的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(事件玩家.torbjorn_save[2]), 自定义字符串("Torbjorn Package")) : 当前数组元素);
			Else If(数量(已过滤的数组(事件玩家.torbjorn_save[2].sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Torbjorn Package"))) == 0);
				播放效果(事件玩家.torbjorn_save[2], 正面状态施加声音, 颜色(白色), 事件玩家, 100);
				为玩家添加生命池(事件玩家.torbjorn_save[2], 护甲, 50, 假, 假);
				事件玩家.torbjorn_save[2].sys_default_status_pool[数量(事件玩家.torbjorn_save[2].sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 所用英雄(事件玩家.torbjorn_save[2]), 自定义字符串("Torbjorn Package"));
			End;
		End;
	}
}

规则("托比昂-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		托比昂;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		取消主要动作(事件玩家);
		等待直到(!正在使用终极技能(事件玩家), 3.0);
		If(!正在使用终极技能(事件玩家) && 存活(事件玩家));
			范围内玩家(眼睛位置(事件玩家), 30, 所在队伍(事件玩家), 表面及敌方屏障).sys_softirq[23] = 总计消耗时间;
		End;
	}
}

规则("托比昂-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[23] != 空;
	}

	动作
	{
		If(总计消耗时间 <= 事件玩家.sys_softirq[23]+5.0);
			为玩家添加生命池(事件玩家, 护甲, 较大(0, 500 - 100 * (总计消耗时间 - 事件玩家.sys_softirq[23])), 真, 真);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, 5.0);
			创建效果(所有玩家(所有队伍), 卢西奥音障保护效果, 颜色(橙色), 事件玩家, 0, 可见，位置和半径);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 5.0);
			创建效果(所有玩家(所有队伍), 托比昂热力过载效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 5.0);
			等待(5.0, 无视条件);
		End;
		事件玩家.sys_softirq[23] = 空;
	}
}

规则("骇灾-反伤")
{
	事件
	{
		玩家受到伤害;
		双方;
		骇灾;
	}

	条件
	{
		事件伤害 >= 5;
		事件技能 != 空;
		((事件技能 == 按钮(近身攻击)) || (数量(已过滤的数组(全局.sys_touch_attacks, 当前数组元素[0] == 所用英雄(攻击方) && 数组包含(当前数组元素, 事件技能))) > 0)) == 真;
	}

	动作
	{
		开始持续治疗(被攻击方, 被攻击方, 1.0, 事件伤害 * 0.5);
		伤害(攻击方, 被攻击方, 事件伤害 * 0.5);
		等待(0.25, 无视条件);
	}
}

规则("骇灾-回复")
{
	事件
	{
		玩家造成伤害;
		双方;
		骇灾;
	}

	条件
	{
		(事件技能 == 按钮(主要攻击模式) || 事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(终极技能)) == 真;
	}

	动作
	{
		攻击方.vars_hazard[0] = 攻击方.vars_hazard[0] + ((事件技能 == 按钮(终极技能)) ? 5 : 1);
	}
}

规则("骇灾-回复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		骇灾;
	}

	条件
	{
		事件玩家.vars_hazard[0] > 0;
	}

	动作
	{
		事件玩家.vars_hazard[0] = 较大(0, 事件玩家.vars_hazard[0] - 1);
		等待(0.2, 无视条件);
		治疗(事件玩家, 事件玩家, 较大((最大生命值(事件玩家) - 生命值(事件玩家)) * 0.01, 1));
		如条件为“真”则循环;
	}
}

