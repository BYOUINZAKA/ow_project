			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SYS_DEMAGE_SUPPORT") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 空, 自定义字符串("SYS_DEMAGE_SUPPORT")) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SYS_DEMAGE_SUPPORT"))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 25, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 空, 自定义字符串("SYS_DEMAGE_SUPPORT"));
		End;
	}
}

