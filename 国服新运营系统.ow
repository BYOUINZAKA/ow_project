		开始伤害调整(逐帧更新(已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 类型的生命值(当前数组元素, 护甲) > 0)), 事件玩家, 200, 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(拉玛刹), 自定义字符串("Ramattra Inc"));
		等待直到(!(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家)), 99999);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Ramattra Inc") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("拉玛刹-炮台")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		// 正在使用辅助武器(事件玩家) == 真;
		// 按钮被按下(事件玩家, 按钮(辅助攻击模式)) == 真;
		正在使用终极技能(事件玩家) != 真;
		正在使用技能 1(事件玩家) != 真;
		正在使用辅助武器(事件玩家) != 真;
		事件玩家.ramattra_turret[1] == 空;
	}

	动作
	{
		// 等待直到(!按钮被按下(事件玩家, 按钮(辅助攻击模式)) || 正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家) || !正在使用辅助武器(事件玩家), 99999);
		// If(!正在使用终极技能(事件玩家) && !正在使用技能 1(事件玩家));
		// 	事件玩家.ramattra_turret[4] = 面朝方向(事件玩家);
		// 	事件玩家.ramattra_turret[0] = 眼睛位置(事件玩家);
		// End;
		事件玩家.ramattra_turret[4] = 面朝方向(事件玩家);
		事件玩家.ramattra_turret[0] = 眼睛位置(事件玩家);
	}
}

规则("拉玛刹-炮台")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		正在使用辅助武器(事件玩家) != 真;
		正在使用终极技能(事件玩家) != 真;
		正在使用技能 1(事件玩家) != 真;
		技能冷却时间(事件玩家, 按钮(辅助攻击模式)) > 12;
	}

	动作
	{
		If(事件玩家.ramattra_turret[4] == 空 || 事件玩家.ramattra_turret[0] == 空);
			事件玩家.ramattra_turret[4] = 面朝方向(事件玩家);
			事件玩家.ramattra_turret[0] = 眼睛位置(事件玩家);
			事件玩家.ramattra_turret[1] = 射线命中位置(事件玩家.ramattra_turret[0] + 事件玩家.ramattra_turret[4] * 3.0, 事件玩家.ramattra_turret[0] + 事件玩家.ramattra_turret[4] * 35, 事件玩家, 空, 真);
		Else;
			事件玩家.ramattra_turret[1] = 射线命中位置(事件玩家.ramattra_turret[0] + 事件玩家.ramattra_turret[4] * 3.0, 事件玩家.ramattra_turret[0] + 事件玩家.ramattra_turret[4] * 35, 事件玩家, 空, 真) + 2.5 * 上;
		End;
		创建弹道效果(所有玩家(所有队伍), 拉玛刹吞噬漩涡能量球, 所有玩家(所在队伍(事件玩家)), 事件玩家.ramattra_turret[1], 矢量(0, 0, 0), 0.05, 可见，友善，位置，方向和大小);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 3.5, 英雄(拉玛刹), 自定义字符串("Ramattra turret"));
		等待(3.5, 无视条件);
		事件玩家.ramattra_turret = 空;
	}
}

规则("拉玛刹-炮台")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		事件玩家.ramattra_turret[1] != 空;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Ramattra turret"))) > 0;
	}

	动作
	{
		While(真);
			事件玩家.ramattra_turret[2] = 已排序的数组(已过滤的数组(范围内玩家(事件玩家.ramattra_turret[1], 35, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素)), 生命值(当前数组元素))[0];
			事件玩家.ramattra_turret[3] = 0;
			While(事件玩家.ramattra_turret[2] != 空 && 实体存在(事件玩家.ramattra_turret[2]) && 事件玩家.ramattra_turret[3] < 10);
				创建弹道(拉玛刹吞噬漩涡能量球, 事件玩家, 事件玩家.ramattra_turret[1], 方向(事件玩家.ramattra_turret[1], 所选位置(事件玩家.ramattra_turret[2]) + 上 * 随机实数(0.5, 1.5)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 5, 2, 0, 有益爆炸, 爆炸声音, 0, 80, 1.0, 0, 0, 0);
				等待(0.04, 当为“假”时中止);
				事件玩家.ramattra_turret[3] += 1;
			End;
			等待(0.5, 当为“假”时中止);
		End;
	}
}

