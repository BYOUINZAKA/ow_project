						60, 0.534, 3, 有害爆炸, 爆炸声音, 0, 96, 0.2292, 0, 2, 0);
					等待(0.335, 当为“假”时中止);
				Else;
					创建弹道(西格玛超能之球, 事件玩家, 事件玩家.sigma_battery_pos, 方向(事件玩家.sigma_battery_pos, 眼睛位置(事件玩家.sigma_battery_target)), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)),
						60, 0.534, 3, 有害爆炸, 爆炸声音, 0, 48, 0.4583, 0, 2, 0);
					等待(0.670, 当为“假”时中止);
				End;
			Else;
				等待(0.050, 当为“假”时中止);
			End;
		End;
