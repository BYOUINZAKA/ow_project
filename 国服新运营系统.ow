		被攻击方.mauga_flag[2] = 2.5;
		If(事件暴击);
			被攻击方.mauga_flag[5] = 真;
		End;
	}
}

规则("毛加-灼烧")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		正在使用主要武器(事件玩家) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mauga main"))) <= 0;
	}

	动作
	{
		创建光束效果(正在使用主要武器(事件玩家) ? 所有玩家(所有队伍) : 空, 有害光束, 眼睛位置(事件玩家), 射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 50, 所有存活玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 真), 颜色(红色), 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 5, 英雄(毛加), 自定义字符串("Mauga main"));
	}
}

规则("毛加-灼烧标记")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.mauga_flag[0] >= 10;
		实体存在(事件玩家.mauga_flag[1]) == 真;
		存活(事件玩家) == 真;
        事件玩家.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
	}

	动作
	{
		While(真);
			// If(事件玩家.mauga_flag == 空 || 事件玩家.mauga_flag[3] == 空 || 事件玩家.mauga_flag[4] == 空);
			// 	设置状态(事件玩家, 事件玩家.mauga_flag[1], 燃烧, 4);
			// 	开始持续伤害(事件玩家, 事件玩家.mauga_flag[1], 4, 15);
			// 	事件玩家.mauga_flag[3] = 上一个持续伤害效果ID;
			// 	事件玩家.mauga_flag[4] = 总计消耗时间;
			// Else If((总计消耗时间 - 事件玩家.mauga_flag[4] >= 4) || 正在使用技能 2(事件玩家.mauga_flag[1]) || 正在使用终极技能(事件玩家.mauga_flag[1]));
			// 	设置状态(事件玩家, 事件玩家.mauga_flag[1], 燃烧, 4);
			// 	停止持续伤害(事件玩家.mauga_flag[3]);
			// 	开始持续伤害(事件玩家, 事件玩家.mauga_flag[1], 4, (正在使用技能 2(事件玩家.mauga_flag[1]) || 正在使用终极技能(事件玩家.mauga_flag[1])) ? 30 : 15);
			// 	事件玩家.mauga_flag[3] = 上一个持续伤害效果ID;
			// 	事件玩家.mauga_flag[4] = 总计消耗时间;
			// End;
			// 等待(1.0, 当为“假”时中止);
			If(事件玩家.mauga_flag[3] == 空 || 事件玩家.mauga_flag[4] == 空 || (总计消耗时间 - 事件玩家.mauga_flag[4] >= 4) || !具有状态(事件玩家, 燃烧) || 正在使用技能 2(事件玩家.mauga_flag[1]) || 正在使用终极技能(事件玩家.mauga_flag[1]) || 事件玩家.mauga_flag[5] == 真);
				设置状态(事件玩家, 事件玩家.mauga_flag[1], 燃烧, 4);
				停止持续伤害(事件玩家.mauga_flag[3]);
				开始持续伤害(事件玩家, 事件玩家.mauga_flag[1], 4, (正在使用技能 2(事件玩家.mauga_flag[1]) || 正在使用终极技能(事件玩家.mauga_flag[1]) || 事件玩家.mauga_flag[5] == 真) ? 20 : 15);
				事件玩家.mauga_flag[3] = 上一个持续伤害效果ID;
				事件玩家.mauga_flag[4] = 总计消耗时间;
				事件玩家.mauga_flag[5] = 空;
				If(正在使用技能 2(事件玩家.mauga_flag[1]) || 正在使用终极技能(事件玩家.mauga_flag[1]) || 事件玩家.mauga_flag[5] == 真);
					等待(1.0, 当为“假”时中止);
                Else;
                    等待(0.25, 当为“假”时中止);
				End;
			End;
			等待直到(事件玩家.mauga_flag[3] == 空 || 事件玩家.mauga_flag[4] == 空 || (总计消耗时间 - 事件玩家.mauga_flag[4] >= 4) || !具有状态(事件玩家, 燃烧) || 正在使用技能 2(事件玩家.mauga_flag[1]) || 正在使用终极技能(事件玩家.mauga_flag[1]) || 事件玩家.mauga_flag[5] == 真, 99999);
            等待(0.0, 当为“假”时中止);
		End;

		// 事件玩家.mauga_flag[1] = 空;
		// 事件玩家.mauga_flag[2] = 0;
		// 事件玩家.mauga_flag[0] = 0;
	}
}

