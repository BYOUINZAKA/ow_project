规则("雾子-暴击护盾")
{
	事件
	{
		玩家造成伤害;
		双方;
		全部;
	}

	条件
	{
		事件暴击 == 真;
		事件玩家.kiriko_headshots != 空;
		实体存在(事件玩家.kiriko_headshots[0]) == 真;
	}

	动作
	{
		事件玩家.kiriko_headshots[1] += 事件伤害;
	}
}

规则("雾子-暴击护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.kiriko_headshots != 空;
		实体存在(事件玩家.kiriko_headshots[0]) == 真;
		事件玩家.kiriko_headshots[1] > 0;
	}

	动作
	{
		等待(0.25, 当为“假”时中止);
		While(事件玩家.kiriko_headshots != 空 && 实体存在(事件玩家.kiriko_headshots[0]) && 事件玩家.kiriko_headshots[1] > 0);
            If(事件玩家 == 事件玩家.kiriko_headshots[0] || 标准化生命值(事件玩家) >= 1.0);
                为玩家添加生命池(事件玩家, 生命值, 事件玩家.kiriko_headshots[1] * 0.15, 假, 假);
                事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5);
            Else;
			    创建弹道(“天使”天使冲击枪, 事件玩家.kiriko_headshots[0], 所选位置(事件玩家), 上, 至地图, 治疗, 所在队伍(事件玩家), 事件玩家.kiriko_headshots[1] * 0.15, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.2, 0, 0, 0);
            End;
            事件玩家.kiriko_headshots[1] = 0;
			等待(1.0, 当为“假”时中止);
		End;
	}
}

规则("雾子-s-护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		雾子;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		等待直到(!正在使用技能 1(事件玩家), 1.0);
		等待(0.36, 无视条件);
		
		If(存活(事件玩家));
			为玩家添加生命池(事件玩家, 生命值, 75, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4.00, 英雄(雾子));

			为玩家添加生命池(已排序的数组(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 8.0, 所在队伍(事件玩家), 关闭), 存活(当前数组元素) && 当前数组元素 != 事件玩家), 生命值(当前数组元素))[0], 生命值, 75, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4.00, 英雄(雾子));
		End;
	}
}

规则("雾子-自动治疗")
{
	
	事件
	{
		持续 - 每名玩家;
		双方;
		雾子;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Kiriko Heal"))) <= 0;
	}

	动作
	{
		创建弹道效果((事件玩家.kiriko_heal_pos == 空) ? 空 : 所有玩家(所有队伍), 巴蒂斯特生化榴弹枪, 所有玩家(所在队伍(事件玩家)), 事件玩家.kiriko_heal_pos, 方向(事件玩家.kiriko_heal_pos, 眼睛位置(事件玩家.kiriko_heal_target[0])), 0, 可见，友善，位置，方向和大小);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(雾子), 自定义字符串("Kiriko Heal"));
	}
}

规则("雾子-自动治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		雾子;
	}

	条件
	{
		存活(事件玩家) == 真;
	}

	动作
	{
		While(存活(事件玩家));
			事件玩家.kiriko_heal_pos = 空;
			事件玩家.kiriko_heal_target = 已排序的数组(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 35, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素) && (最大生命值(当前数组元素) > 生命值(当前数组元素)) && (当前数组元素 != 事件玩家)), 较小(生命值(当前数组元素) / 当前数组元素.sys_static_max_hp, 1));
			If(数量(事件玩家.kiriko_heal_target) > 0 && 事件玩家.kiriko_heal_target[0] != 空 && 存活(事件玩家.kiriko_heal_target[0]));
				事件玩家.kiriko_heal_pos = 眼睛位置(事件玩家);
				追踪玩家变量频率(事件玩家, kiriko_heal_pos, 眼睛位置(事件玩家.kiriko_heal_target[0]), 26, 速率及最终值);

				等待(1.35, 无视条件);
				停止追踪玩家变量(事件玩家, kiriko_heal_pos);
				事件玩家.kiriko_heal_pos = 空;
			Else;
				等待(0.1, 无视条件);
			End;
		End;
	}
}

规则("雾子-自动治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		雾子;
	}

	条件
	{
		事件玩家.kiriko_heal_target != 空;
		事件玩家.kiriko_heal_target[0] != 空;
		事件玩家.kiriko_heal_pos != 空;
		((相距距离(事件玩家.kiriko_heal_pos, 眼睛位置(事件玩家.kiriko_heal_target[0])) < 0.5) || (!存活(事件玩家.kiriko_heal_target[0]))) == 真;
	}

	动作
	{
		停止追踪玩家变量(事件玩家, kiriko_heal_pos);
		事件玩家.kiriko_heal_pos = 空;

		If(存活(事件玩家.kiriko_heal_target[0]));
			创建弹道(“天使”天使冲击枪, 事件玩家, 所选位置(事件玩家.kiriko_heal_target[0]), 上, 至地图, 治疗, 所在队伍(事件玩家), 60, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.2, 0, 0, 0);
		End;
	}
}

