规则("末日铁拳-AI-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		主机玩家 != 事件玩家;
		是否是机器人(事件玩家) != 真;
		终极技能充能百分比(事件玩家) >= 100;
		正在使用终极技能(事件玩家) != 真;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(终极技能));
		While(终极技能充能百分比(事件玩家) >= 100 && !正在使用终极技能(事件玩家));
			If(标准化生命值(事件玩家) < 随机实数(0.3, 0.6));
				可用按钮(事件玩家, 按钮(终极技能));
				开始按下按钮(事件玩家, 按钮(终极技能));
				等待(0.3, 无视条件);
				停止按下按钮(事件玩家, 按钮(终极技能));

				等待直到(!正在使用终极技能(事件玩家) || (标准化生命值(事件玩家) > 0.8), 随机实数(1, 4));
				If(正在使用终极技能(事件玩家));
					开始按下按钮(事件玩家, 按钮(主要攻击模式));
					等待(0.1, 无视条件);
					停止按下按钮(事件玩家, 按钮(主要攻击模式));
				End;
			End;
			禁用按钮(事件玩家, 按钮(终极技能));
			等待(0.5, 当为“假”时中止);
		End;
	}
}

规则("末日铁拳-体积")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
