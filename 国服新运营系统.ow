规则("终极AI-温斯顿")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		温斯顿;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		终极技能充能百分比(事件玩家) >= 100;
		正在使用终极技能(事件玩家) != 真;
		存活(事件玩家) == 真;
	}

	动作
	{
		// 禁用按钮(事件玩家, 按钮(终极技能));
		While(终极技能充能百分比(事件玩家) >= 100 && !正在使用终极技能(事件玩家));
			// If(标准化生命值(事件玩家) < 随机实数(0.1, 0.5) && 数量(已过滤的数组(范围内玩家(目标位置(对象索引), 30, 所在队伍(事件玩家), 关闭), 存活(当前数组元素))) + 3 >= 数量(已过滤的数组(范围内玩家(目标位置(对象索引), 30, 对方队伍(所在队伍(事件玩家)), 关闭), 存活(当前数组元素))));
			If(标准化生命值(事件玩家) < 随机实数(0.1, 0.5) && 事件玩家.sys_ultra_lock[0] != 真);
				// 可用按钮(事件玩家, 按钮(终极技能));
				开始按下按钮(事件玩家, 按钮(终极技能));
				等待(0.1, 无视条件);
				停止按下按钮(事件玩家, 按钮(终极技能));
			End;
			等待直到(终极技能充能百分比(事件玩家) < 100 || 正在使用终极技能(事件玩家), 0.5);
		End;
		// 可用按钮(事件玩家, 按钮(终极技能));
	}
}

