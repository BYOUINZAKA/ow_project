	}
}

规则("美-冰冻")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		(数组包含(全局.sys_tank, 所用英雄(事件玩家)) ? (事件玩家.mei_freeze[0] >= 46) : (事件玩家.mei_freeze[0] >= 30)) == 真;
		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
		实体存在(事件玩家.mei_freeze[2]) == 真;
	}

	动作
	{
		设置状态(事件玩家, 事件玩家.mei_freeze[2], 冰冻, 数组包含(全局.sys_tank, 所用英雄(事件玩家)) ? 1.5 : 2);
		事件玩家.mei_freeze = 空;
	}
}

