		创建地图文本(事件玩家.ana_ring[1] == 空 ? 空 : 所有玩家(所在队伍(事件玩家)), 技能图标字符串(英雄(无漾), 按钮(辅助攻击模式)), 事件玩家.ana_ring[1], 2.5, 不要截取, 可见，位置，字符串和颜色, 所在队伍(事件玩家), 默认可见度);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_map_text, 上一个文本ID, 总计消耗时间, -1, 英雄(安娜), 自定义字符串("AnaHelp"));
