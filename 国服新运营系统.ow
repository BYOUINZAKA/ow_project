规则("查莉娅-超级护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		事件玩家.zarya_e_target = 数组(
			射线命中玩家(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 30, 所有存活玩家(所在队伍(事件玩家)), 事件玩家, 假),
			已排序的数组(已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 相距距离(眼睛位置(事件玩家), 当前数组元素) <= 30 && 事件玩家 != 当前数组元素), 相距距离(眼睛位置(事件玩家), 当前数组元素) * 角度的正弦值(矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家), 当前数组元素))))[0]
		);
		事件玩家.zarya_e_target[2] = 实体存在(事件玩家.zarya_e_target[0]) ? 事件玩家.zarya_e_target[0] : 事件玩家.zarya_e_target[1];
		事件玩家.zarya_e_target[2] = 具有状态(事件玩家.zarya_e_target[2], 无敌) ? 事件玩家.zarya_e_target[2] : 已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 具有状态(当前数组元素, 无敌) && 当前数组元素.sys_softirq[22][0] == 空)[0];

		// 为玩家添加生命池(事件玩家.zarya_e_target[3], 生命值, 50, 假, 假);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5, 英雄(查莉娅));

		事件玩家.i_sys_speed += 25;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 25), 总计消耗时间, 3, 英雄(查莉娅));

		事件玩家.zarya_e_target[2].sys_softirq[22] = 数组(事件玩家);

		// 创建弹道(“天使”天使冲击枪, 事件玩家, 所选位置(事件玩家.zarya_e_target[2]), 上, 至地图, 治疗, 所在队伍(事件玩家), 5, 1, 0, 有益爆炸, 爆炸声音, 1, 1000, 0.2, 0, 0, 0);
	}
}

规则("查莉娅-超级护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[22] != 空;
	}

	动作
	{
		If(实体存在(事件玩家.sys_softirq[22][0]) && 具有状态(事件玩家, 无敌));
			事件玩家.sys_softirq[22] = 数组(事件玩家.sys_softirq[22][0], 总计消耗时间);

			// 开始伤害调整(范围内玩家(眼睛位置(事件玩家), 8.0, 对方队伍(所在队伍(事件玩家)), 表面), 事件玩家, 120 + 事件玩家.sys_softirq[22][0].zarya_energy[0] / 4.0, 受伤害者，伤害者及伤害百分比);
			// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3.0, 空, 自定义字符串("Zarya attack inc"));

			开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 105 + 较小(事件玩家.sys_softirq[22][0].zarya_energy[0],100) / 5.0, 受伤害者，伤害者及伤害百分比);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3.0, 空, 自定义字符串("Zarya attack inc"));

			创建效果(所有玩家(所有队伍), “天使”伤害强化效果, 所在队伍(事件玩家), 事件玩家, 1.0, 位置和半径);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 3.0, 空, 自定义字符串("Zarya attack inc"));

			事件玩家.i_sys_speed += 25;
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 25), 总计消耗时间, 3.0, 空, 自定义字符串("Zarya attack inc"));

			开始助攻(事件玩家.sys_softirq[22][0], 事件玩家, 无);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_assists, 上一个助攻ID, 总计消耗时间, 3.0, 空, 自定义字符串("Zarya attack inc"));

			事件玩家.sys_softirq[25] = 0;

			While(具有状态(事件玩家, 无敌) && 总计消耗时间 <= 事件玩家.sys_softirq[22][1] + 2.5);
				If(标准化生命值(事件玩家) >= 1.0);
					事件玩家.sys_softirq[25] += (较小(事件玩家.sys_softirq[22][0].zarya_energy[0],100) / 20.0 + 1);
				Else;
					创建弹道(“天使”天使冲击枪, 事件玩家.sys_softirq[22][0], 所选位置(事件玩家), 上, 至地图, 治疗, 所在队伍(事件玩家.sys_softirq[22][0]), 较小(事件玩家.sys_softirq[22][0].zarya_energy[0],100) / 20.0 + 1, 1, 1.0, 有益爆炸, 爆炸声音, 1, 1000, 0.2, 0, 0, 0);
				End;
				等待(0.1, 无视条件);
			End;

			为玩家添加生命池(事件玩家, 生命值, 事件玩家.sys_softirq[25] * 0.5, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5);

			等待(0.25, 无视条件);

			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zarya attack inc") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		End;
		事件玩家.sys_softirq[22] = 空;
	}
}

规则("查莉娅-弹药恢复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		(正在使用主要武器(事件玩家) || 正在使用辅助武器(事件玩家) || 正在装填(事件玩家)) != 真;
		弹药(事件玩家, 0) < 最大弹药(事件玩家, 0);
		弹药(事件玩家, 0) > 0;
	}

	动作
	{
		While(弹药(事件玩家, 0) < 最大弹药(事件玩家, 0) && 弹药(事件玩家, 0) > 0 && !(正在使用主要武器(事件玩家) || 正在使用辅助武器(事件玩家) || 正在装填(事件玩家)));
			设置弹药(事件玩家, 0, 较小(最大弹药(事件玩家, 0), 弹药(事件玩家, 0) + 1));
			等待(0.1, 无视条件);
		End;
	}
}

规则("查莉娅-弹药恢复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		If(弹药(事件玩家, 0) == 0 || 正在装填(事件玩家));
			设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0) + 25);
		Else;
			设置弹药(事件玩家, 0, 弹药(事件玩家, 0) + 25);
		End;
	}
}

规则("查莉娅-弹药恢复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		If(弹药(事件玩家, 0) == 0 || 正在装填(事件玩家));
			设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0) + 25);
		Else;
			设置弹药(事件玩家, 0, 弹药(事件玩家, 0) + 25);
		End;
	}
}

规则("查莉娅-能量")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		玩家英雄数据(事件玩家, 英雄(查莉娅), 阻挡伤害量) - 事件玩家.zarya_energy[2] >= 5;
		游戏正在进行中 == 真;
	}

	动作
	{
		治疗(事件玩家, 事件玩家, (玩家英雄数据(事件玩家, 英雄(查莉娅), 阻挡伤害量) - 事件玩家.zarya_energy[2])/2.5);
		事件玩家.zarya_energy[0] = 较小(100, 事件玩家.zarya_energy[0]+(玩家英雄数据(事件玩家, 英雄(查莉娅), 阻挡伤害量) - 事件玩家.zarya_energy[2])/5.0);
		事件玩家.zarya_energy[1] = 2.0;
		事件玩家.zarya_energy[2] = 玩家英雄数据(事件玩家, 英雄(查莉娅), 阻挡伤害量);
	}
}

规则("查莉娅-能量")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.zarya_energy[0] > 0;
		(死亡(事件玩家) || 所用英雄(事件玩家) != 英雄(查莉娅) || 处于回合之间 || !游戏正在进行中) == 真;
	}

	动作
	{
		事件玩家.zarya_energy[0] = 0;
		事件玩家.zarya_energy[1] = 0;
		事件玩家.zarya_energy[2] = 玩家英雄数据(事件玩家, 英雄(查莉娅), 阻挡伤害量);
	}
}

规则("查莉娅-能量")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		事件玩家.zarya_energy[0] > 0;
		事件玩家.zarya_energy[1] <= 0;
	}

	动作
	{
		While(真);
			事件玩家.zarya_energy[0] = 较大(0, 事件玩家.zarya_energy[0]-1);
			等待(0.4, 当为“假”时中止);
		End;
	}
}

规则("查莉娅-能量护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		查莉娅;
	}

	条件
	{
		// 事件玩家.zarya_energy[0] > 0;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zarya Energy HP"))) <= 0;
	}

	动作
	{
		为玩家添加生命池(事件玩家, 护盾, 较大(1, 较小(事件玩家.zarya_energy[0],100)*1.25), 真, 真);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 英雄(查莉娅), 自定义字符串("Zarya Energy HP"));
		开始伤害调整(事件玩家, 所有玩家(对方队伍(所在队伍(事件玩家))), 100 - 较小(事件玩家.zarya_energy[0],100)*0.15, 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(查莉娅), 自定义字符串("Zarya Energy HP"));
		开始治疗调整(事件玩家, 所有玩家(所有队伍), 100 + 较小(事件玩家.zarya_energy[0],100)*0.15, 受治疗者，治疗者及治疗百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, -1, 英雄(查莉娅), 自定义字符串("Zarya Energy HP"));
	}
}

规则("秩序之光-记录传送门")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
		按钮被按下(事件玩家, 按钮(主要攻击模式)) == 真;
		技能冷却时间(事件玩家, 按钮(技能2)) <= 0;
	}

	动作
	{
		取消主要动作(事件玩家);

		事件玩家.symmetra_demage[3] = 所选位置(事件玩家);
		事件玩家.symmetra_demage[6] = 射线命中位置(
			射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 下 * 1.0 + 面朝方向(事件玩家) * 30, 空, 空, 假),
			射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 下 * 1.0 + 面朝方向(事件玩家) * 30, 空, 空, 假) + 下 * 1.5,
			空, 空, 假
		);
	}
}

规则("秩序之光-记录传送门")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
		技能冷却时间(事件玩家, 按钮(技能2)) > 0;
	}

	动作
	{
		事件玩家.symmetra_demage[4] = 最近的可行走位置(事件玩家.symmetra_demage[3]);
		// 创建效果(事件玩家, 球体, 颜色(白色), 事件玩家.symmetra_demage[4], 1.5, 可见，位置和半径);

		事件玩家.symmetra_demage[5] = 范围内玩家(事件玩家.symmetra_demage[4], 8.0, 所在队伍(事件玩家), 关闭);
		事件玩家.symmetra_demage[5].i_sys_speed += 50;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家.symmetra_demage[5], 50), 总计消耗时间, 6.0, 英雄(秩序之光), 自定义字符串("SymmetraE"));

		开始持续治疗(事件玩家.symmetra_demage[5], 事件玩家, 6, 30);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_continued, 上一个持续治疗效果ID, 总计消耗时间, 6.0, 英雄(秩序之光), 自定义字符串("SymmetraE"));

		事件玩家.symmetra_demage[2] = 6.0;
	}
}

规则("秩序之光-传送门")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		正在使用技能 2(事件玩家) != 真;
		(事件玩家.symmetra_demage[2] > 0 || 数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SymmetraE"))) > 0) == 真;
	}

	动作
	{
		事件玩家.symmetra_demage[2] = 0;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("SymmetraE")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("秩序之光-AI")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		在重生室中(事件玩家) != 真;
		技能冷却时间(事件玩家, 按钮(技能2)) <= 0;
		正在使用技能 2(事件玩家) != 真;
		// 事件玩家.symmetra_demage[7] == 自定义字符串("S_Unused");
		// 数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 15), 存活(当前数组元素) && 相距距离(事件玩家, 当前数组元素) <= 25 && 在视线内(眼睛位置(事件玩家), 眼睛位置(当前数组元素), 屏障不会阻挡视线))) > 0;
		已过滤的数组(范围内玩家(射线命中位置(
			射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 下 * 全局.random + 面朝方向(事件玩家) * 30, 空, 空, 假),
			射线命中位置(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 下 * 全局.random + 面朝方向(事件玩家) * 30, 空, 空, 假) + 下 * 1.5,
			空, 空, 假
		), 全局.random * 5 + 5, 对方队伍(所在队伍(事件玩家)), 关闭), 存活(当前数组元素) && 在视线内(眼睛位置(事件玩家), 眼睛位置(当前数组元素), 屏障不会阻挡视线)) > 0;
	}

	动作
	{
		开始按下按钮(事件玩家, 按钮(技能2));
		等待(0.05, 无视条件);
		停止按下按钮(事件玩家, 按钮(技能2));

		开始按下按钮(事件玩家, 按钮(主要攻击模式));
		等待(0.05, 无视条件);
		停止按下按钮(事件玩家, 按钮(主要攻击模式));

		// 等待(1.0, 无视条件);
		// 如条件为“真”则循环;
	}
}

禁用 规则("秩序之光-AI-传送")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		数量(
			已过滤的数组(
				所有玩家(所在队伍(事件玩家)),
				所用英雄(当前数组元素) == 英雄(秩序之光) && 事件玩家.symmetra_demage[7] == 自定义字符串("S_Completed") && 相距距离(所选位置(事件玩家), 当前数组元素.symmetra_demage[4]) <= 3.0 && 在视线内(眼睛位置(事件玩家), 当前数组元素.symmetra_demage[4], 屏障不会阻挡视线)
			)
		) > 0;
	}

	动作
	{
		事件玩家.symmetra_demage[8] = 已过滤的数组(
			所有玩家(所在队伍(事件玩家)),
			所用英雄(当前数组元素) == 英雄(秩序之光) && 事件玩家.symmetra_demage[7] == 自定义字符串("S_Completed") && 相距距离(所选位置(事件玩家), 当前数组元素.symmetra_demage[4]) <= 3.0 && 在视线内(眼睛位置(事件玩家), 当前数组元素.symmetra_demage[4], 屏障不会阻挡视线)
		)[0];
		If(事件玩家.symmetra_demage[8] == 空 || !实体存在(事件玩家.symmetra_demage[8]));
			中止;
		End;

		开始按下按钮(事件玩家, 按钮(互动));
		等待直到(相距距离(所选位置(事件玩家), 事件玩家.symmetra_demage[8].symmetra_demage[4]) > 3.0, 3);
		停止按下按钮(事件玩家, 按钮(互动));

		等待(1.0, 无视条件);
		如条件为“真”则循环;
	}
}

禁用 规则("秩序之光-AI-状态机")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		技能冷却时间(事件玩家, 按钮(技能2)) <= 0;
		正在使用技能 2(事件玩家) != 真;
		事件玩家.symmetra_demage[7] == 空;
	}

	动作
	{
		// 创建地图文本(所有玩家(所有队伍), 自定义字符串("{0} {1} {2}", 事件玩家.symmetra_demage[7], 技能冷却时间(事件玩家, 按钮(技能2)), 正在使用技能 2(事件玩家)), 事件玩家, 1, 根据表面截取, 可见，位置，字符串和颜色, 颜色(白色), 默认可见度);
		事件玩家.symmetra_demage[7] = 自定义字符串("S_Unused");

		While(事件玩家.symmetra_demage[7] != 空);
			If(事件玩家.symmetra_demage[7] == 自定义字符串("S_Unused"));
				等待直到(技能冷却时间(事件玩家, 按钮(技能2)) <= 0 && 正在使用技能 2(事件玩家), 99999);
				等待(0.1, 无视条件);
				事件玩家.symmetra_demage[7] = 自定义字符串("S_Inuse");
			Else If(事件玩家.symmetra_demage[7] == 自定义字符串("S_Inuse"));
				等待直到(技能冷却时间(事件玩家, 按钮(技能2)) > 0 || !正在使用技能 2(事件玩家), 99999);
				等待(0.1, 无视条件);
				If(技能冷却时间(事件玩家, 按钮(技能2)) <= 0 && !正在使用技能 2(事件玩家));
					事件玩家.symmetra_demage[7] = 自定义字符串("S_Unused");
				Else If(技能冷却时间(事件玩家, 按钮(技能2)) > 0 && 正在使用技能 2(事件玩家));
					事件玩家.symmetra_demage[7] = 自定义字符串("S_Completed");
				End;
			Else If(事件玩家.symmetra_demage[7] == 自定义字符串("S_Completed"));
				等待直到(技能冷却时间(事件玩家, 按钮(技能2)) <= 0 || !正在使用技能 2(事件玩家), 99999);
				等待(0.1, 无视条件);
				If(技能冷却时间(事件玩家, 按钮(技能2)) > 0 && !正在使用技能 2(事件玩家));
					事件玩家.symmetra_demage[7] = 自定义字符串("S_Unavailable");
				Else If(技能冷却时间(事件玩家, 按钮(技能2)) <= 0 && 正在使用技能 2(事件玩家));
					事件玩家.symmetra_demage[7] = 自定义字符串("S_Updatable");
				End;
			Else;
				等待直到(技能冷却时间(事件玩家, 按钮(技能2)) <= 0 && !正在使用技能 2(事件玩家), 99999);
				等待(0.1, 无视条件);
				事件玩家.symmetra_demage[7] = 自定义字符串("S_Unused");
			End;
			等待(0.0, 无视条件);
		End;
	}
}

规则("秩序之光-Q-大招增幅")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		存活(事件玩家) == 真;
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		// 创建效果(事件玩家, 火花, 颜色(天蓝色), 事件玩家, 15, 可见，位置和半径);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 8, 英雄(秩序之光), 自定义字符串("Symmetra Q Effect"));
		While(真);
			已过滤的数组(范围内玩家(事件玩家, 15, 所在队伍(事件玩家), 表面及敌方屏障), 当前数组元素 != 事件玩家 && 存活(当前数组元素)).symmetra_Q_inedx += 1;
			等待(0.50, 当为“假”时中止);
		End;
		// 事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Q Effect") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("秩序之光-Q-大招增幅-标记")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		存活(事件玩家) != 真;
		事件玩家.symmetra_Q_inedx > 0;
	}

	动作
	{
		事件玩家.symmetra_Q_inedx = 0;
	}
}

规则("秩序之光-Q-大招增幅-标记")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		存活(事件玩家) == 真;
		事件玩家.symmetra_Q_inedx + 事件玩家.symmetra_Q_players > 0;
		终极技能充能百分比(事件玩家) < 100;
	}

	动作
	{
		设置终极技能充能(事件玩家, 终极技能充能百分比(事件玩家) + 事件玩家.symmetra_Q_inedx + 事件玩家.symmetra_Q_players);
		事件玩家.symmetra_Q_inedx = 0;
		事件玩家.symmetra_Q_players = 0;
	}
}

规则("秩序之光-Q-大招增幅-标记存储")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.symmetra_Q_inedx > 0;
		终极技能充能百分比(事件玩家) >= 100;
	}

	动作
	{
		事件玩家.symmetra_Q_players += 事件玩家.symmetra_Q_inedx;
		事件玩家.symmetra_Q_inedx = 0;
	}
}

规则("秩序之光-护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		秩序之光;
	}

	条件
	{
		// 玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) != 空数组;
		// 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量) != 空数组;
		(玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) + 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量)) - (事件玩家.symmetra_demage[0] + 事件玩家.symmetra_demage[1]) >= 30;
	}

	动作
	{
		// 已过滤的数组(范围内玩家(眼睛位置(事件玩家), (事件玩家.symmetra_demage[1] > 0 ? 12 : 5), 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素)).sys_softirq[1]= ((玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量) + 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量)) - 事件玩家.symmetra_demage[0]) * (事件玩家.symmetra_demage[1] > 0 ? 0.5 : 0.15);
		已过滤的数组(范围内玩家(眼睛位置(事件玩家), (事件玩家.symmetra_demage[2] > 0 ? 10 : 5), 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素)).sys_softirq[1] = (
			(玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量)-事件玩家.symmetra_demage[0])*0.15+(玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量)-事件玩家.symmetra_demage[1])*0.10
		) * (事件玩家.symmetra_demage[1] > 0 ? 2.0 : 1.0);
		事件玩家.symmetra_demage[0] = 玩家英雄数据(事件玩家, 英雄(秩序之光), 对英雄造成伤害量);
		事件玩家.symmetra_demage[1] = 玩家英雄数据(事件玩家, 英雄(秩序之光), 对屏障造成伤害量);

		等待(0.10, 无视条件);
		如条件为“真”则循环;
	}
}

规则("秩序之光-叠盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[1] > 0;
	}

	动作
	{
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))[0][1]);
			为玩家添加生命池(事件玩家, 生命值, 事件玩家.sys_softirq[1], 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect) ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 空, 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect)) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 事件玩家.sys_softirq[1], 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 空, 自定义字符串("Symmetra Main {0}", 事件玩家.symmetra_Q_effect));
		End;
		事件玩家.symmetra_Q_effect = (事件玩家.symmetra_Q_effect + 1) % 5;
		事件玩家.sys_softirq[1] = 0;
		等待(0.10, 无视条件);
		如条件为“真”则循环;
	}
}

规则("渣客女王-被动-标记")
{
	事件
	{
		玩家造成伤害;
		双方;
		渣客女王;
	}

	条件
	{
		(事件技能 == 按钮(技能2) || 事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(近身攻击) || 事件技能 == 按钮(终极技能)) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
	}

	动作
	{
		被攻击方.junkerqueen_timer = 0.400;
		If(被攻击方.junkerqueen_effect != 空 && 攻击方 != 被攻击方.junkerqueen_effect[0]);
			停止伤害调整(事件玩家.junkerqueen_effect[1]);
			停止治疗调整(事件玩家.junkerqueen_effect[2]);
			// 消除效果(事件玩家.junkerqueen_effect[3]);
			事件玩家.junkerqueen_effect = 空;
		End;
		If(被攻击方.junkerqueen_effect == 空);
			被攻击方.junkerqueen_effect = 数组(攻击方);
			开始伤害调整(所有玩家(所在队伍(攻击方)), 被攻击方, 100 - 全局.args_junkerqueen[0], 受伤害者和伤害者);
			被攻击方.junkerqueen_effect = 添加至数组(被攻击方.junkerqueen_effect, 上一个伤害调整ID);
			开始治疗调整(被攻击方, 所有玩家(所有队伍), 100 - 全局.args_junkerqueen[1], 受治疗者和治疗者);
			被攻击方.junkerqueen_effect = 添加至数组(被攻击方.junkerqueen_effect, 上一个治疗调整ID);
			// 创建效果(所有玩家(所有队伍), 温斯顿特斯拉炮目标效果, 所在队伍(攻击方), 被攻击方, 1, 可见，位置和半径);
			// 被攻击方.junkerqueen_effect = 添加至数组(被攻击方.junkerqueen_effect, 最后创建的实体);
		End;
	}
}

规则("渣客女王-被动-标记-清理")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		((事件玩家.junkerqueen_timer <= 0) || (事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0) || 具有状态(事件玩家, 相移) || 具有状态(事件玩家, 无敌)) == 真;
		事件玩家.junkerqueen_effect != 空;
	}

	动作
	{
		停止伤害调整(事件玩家.junkerqueen_effect[1]);
		停止治疗调整(事件玩家.junkerqueen_effect[2]);
		// 消除效果(事件玩家.junkerqueen_effect[3]);
		事件玩家.junkerqueen_effect = 空;
	}
}

规则("渣客女王-Q")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		所用英雄(攻击方) == 英雄(渣客女王);
		事件技能 == 按钮(终极技能);
		事件伤害 > 5;
	}

	动作
	{
		施加推力(被攻击方, 上, 10, 至地图, 取消相反运动);
		等待(5.0, 无视条件);
	}
}

规则("渣客女王-shift")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		渣客女王;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		事件玩家.junkerqueen_players = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 15, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素));

		事件玩家.junkerqueen_players.a_sys_user_status[全局.t_enum_status_thorns] += 全局.args_junkerqueen[2];
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_thorns, 数组(事件玩家.junkerqueen_players, 全局.args_junkerqueen[2]), 总计消耗时间, 4.0, 英雄(渣客女王));

		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家.junkerqueen_players, 全局.args_junkerqueen[6], 无);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 4.0, 英雄(渣客女王));

		事件玩家.junkerqueen_players.sys_softirq[24] = 真;

		// 事件玩家.junkerqueen_players = 数组(范围内玩家(眼睛位置(事件玩家), 15, 所在队伍(事件玩家), 表面及敌方屏障), 总计消耗时间);
		// 事件玩家.junkerqueen_players[0].junkerqueen_flag = 真;

		// 为玩家添加生命池(事件玩家.junkerqueen_players[0], 生命值, 30, 假, 假);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5, 英雄(渣客女王), 自定义字符串("Junker Queen Back"));
	}
}

规则("渣客女王-shift-换弹")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[24] != 空;
	}

	动作
	{
		事件玩家.sys_softirq[24] = 空;
		设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0));
		设置弹药(事件玩家, 1, 最大弹药(事件玩家, 1));
		If(事件玩家.tracer_energy[0] > 0);
			事件玩家.tracer_energy[0] = 0;
		End;
		If(事件玩家.sojourn_bullet_count > 0);
			事件玩家.sojourn_bullet_count = 0;
		End;
		If(正在装填(事件玩家));
			取消主要动作(事件玩家);
		End;
	}
}

规则("渣客女王-E-荆棘")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		渣客女王;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
		全局.args_junkerqueen[3] > 0;
	}

	动作
	{
		事件玩家.i_sys_speed += 50;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 50), 总计消耗时间, 3.0, 英雄(渣客女王), 自定义字符串("Junker Queen Carnage Thorns"));

		事件玩家.a_sys_user_status[全局.t_enum_status_thorns] += 全局.args_junkerqueen[3];
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_thorns, 数组(事件玩家, 全局.args_junkerqueen[3]), 总计消耗时间, 3.0, 英雄(渣客女王), 自定义字符串("Junker Queen Carnage Thorns"));

		等待直到(!正在使用技能 2(事件玩家), 3.0);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Junker Queen Carnage Thorns") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("渣客女王-终极技能-荆棘")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		渣客女王;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
		全局.args_junkerqueen[4] > 0;
	}

	动作
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_thorns] += 全局.args_junkerqueen[4];
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_thorns, 数组(事件玩家, 全局.args_junkerqueen[4]), 总计消耗时间, 6.0, 英雄(渣客女王), 自定义字符串("Junker Queen Rampage Thorns"));
		等待直到(!正在使用终极技能(事件玩家), 6.0);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Junker Queen Rampage Thorns") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("黑百合-副武器-开镜-护盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑百合;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Widowmaker HP"))) <= 0;
		事件玩家.widowmaker_hp_pool_timer <= 0;
	}

	动作
	{
		等待(0.200, 当为“假”时中止);
		事件玩家.widowmaker_hp_pool = 最大生命值(事件玩家) - 生命值(事件玩家);
		治疗(事件玩家, 事件玩家, 事件玩家.widowmaker_hp_pool);
		If(事件玩家.widowmaker_hp_pool < 300);
			为玩家添加生命池(事件玩家, 生命值, 300 - 事件玩家.widowmaker_hp_pool, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, -1, 英雄(黑百合), 自定义字符串("Widowmaker HP"));
		End;
	}
}

规则("黑百合-副武器-开镜-护盾破碎")
{
	事件
	{
		玩家受到伤害;
		双方;
		黑百合;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Widowmaker HP"))) > 0;
	}

	动作
	{
		等待(0.300, 当为“假”时中止);
		播放效果(攻击方, 状态爆炸声音, 颜色(白色), 攻击方, 9999);
		播放效果(被攻击方, 状态爆炸声音, 颜色(白色), 被攻击方, 9999);
		事件玩家.widowmaker_hp_pool_timer = 正在使用终极技能(事件玩家) ? 2 : 6;
	}
}

规则("黑百合-副武器-开镜-护盾清除")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Widowmaker HP"))) > 0;
		(所用英雄(事件玩家) != 英雄(黑百合) || 正在使用辅助武器(事件玩家) != 真 || 事件玩家.widowmaker_hp_pool_timer > 0) == 真;
	}

	动作
	{
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Widowmaker HP") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("黑百合-Q-弹匣拓展")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑百合;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		设置最大弹药(事件玩家, 0, 70);
		设置弹药(事件玩家, 0, 弹药(事件玩家, 0) + 35);
		等待直到 (正在使用终极技能(事件玩家) != 真, 20);
		设置最大弹药(事件玩家, 0, 35);
	}
}

