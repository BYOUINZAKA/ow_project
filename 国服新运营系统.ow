}

规则("布丽吉塔-被动-宁")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		实体存在(选择英雄的玩家(英雄(布丽吉塔), 所在队伍(事件玩家))) == 真;
		((事件玩家.a_sys_user_status[全局.t_enum_escape] <= 2) || 在重生室中(事件玩家)) == 真;
	}

	动作
	{
		While(真);
			等待(1.0, 当为“假”时中止);
			事件玩家.sys_softirq[17] += 1;
		End;
	}
}

规则("禅雅塔-谐-CD")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		禅雅塔;
	}

	条件
	{
		正在使用技能 1(事件玩家) != 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zenyatta S cd"))) > 0;
	}

	动作
	{
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zenyatta S cd") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		事件玩家.zarya_e_target[2] = 空;
	}
}

规则("禅雅塔-谐-CD")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		禅雅塔;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zenyatta S cd") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);

		事件玩家.zarya_e_target = 数组(
			射线命中玩家(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 30, 所有存活玩家(所在队伍(事件玩家)), 事件玩家, 假),
			已排序的数组(已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 相距距离(眼睛位置(事件玩家), 当前数组元素) <= 30 && 事件玩家 != 当前数组元素), 相距距离(眼睛位置(事件玩家), 当前数组元素) * 角度的正弦值(矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家), 当前数组元素))))[0]
		);
		事件玩家.zarya_e_target[2] = 实体存在(事件玩家.zarya_e_target[0]) ? 事件玩家.zarya_e_target[0] : 事件玩家.zarya_e_target[1];

		事件玩家.zarya_e_target[2].d_sys_cd += 0.10;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_move_cd, 数组(事件玩家.zarya_e_target[2], 0.10), 总计消耗时间, -1, 英雄(禅雅塔), 自定义字符串("Zenyatta S cd"));
	}
}

规则("禅雅塔-谐-CD")
{
	事件
	{
		玩家造成治疗;
		双方;
		禅雅塔;
	}

	条件
	{
		事件技能 == 按钮(技能1);
		正在使用技能 1(治疗者) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zenyatta S cd"))) > 0;
		治疗者.zarya_e_target[2] != 受治疗者;
	}

	动作
	{
		治疗者.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Zenyatta S cd") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);

		治疗者.zarya_e_target[2] = 受治疗者;
		治疗者.zarya_e_target[2].d_sys_cd += 0.10;
		治疗者.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_move_cd, 数组(治疗者.zarya_e_target[2], 0.10), 总计消耗时间, -1, 英雄(禅雅塔), 自定义字符串("Zenyatta S cd"));

		等待(0.5, 无视条件);
	}
}

