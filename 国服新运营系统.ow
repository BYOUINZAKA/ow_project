规则("debug")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		正在等待玩家 == 真;
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		事件玩家.d_sys_cd = 0.500;
		设置终极技能充能(事件玩家, 100);
		If(数量(已过滤的数组(所有玩家(所有队伍), 是否是机器人(当前数组元素))) <= 0);
			设置玩家可选的英雄(事件玩家, 全部英雄);
			创建HUD文本(事件玩家, 自定义字符串("[{0}] - {1} - {2}", 事件玩家.debug_2, 自定义字符串("({0},{1}))", 全局.sys_ultra_tmp[4][0], 全局.sys_ultra_tmp[4][1]), 自定义字符串("({0},{1}))", 全局.sys_ultra_tmp[5][0], 全局.sys_ultra_tmp[5][1])), 自定义字符串("shift：{0} E：{1} Q：{2}", 正在使用技能 1(事件玩家), 正在使用技能 2(事件玩家), 正在使用终极技能(事件玩家)), 自定义字符串("主武器：{0} 副武器：{1} {2}", 正在使用主要武器(事件玩家), 正在使用辅助武器(事件玩家), 自定义字符串("{0} - {1} - {2}", 速度(事件玩家),
				技能充能(事件玩家, 按钮(技能1)), 技能充能(事件玩家, 按钮(技能2)))), 左边, 0, 颜色(白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
			生成机器人(英雄(卡西迪), 队伍1, -1, 事件玩家, 矢量(0, 0, 0));
			生成机器人(英雄(布丽吉塔), 队伍1, -1, 事件玩家, 矢量(0, 0, 0));
			生成机器人(英雄(卢西奥), 队伍1, -1, 事件玩家, 矢量(0, 0, 0));

			生成机器人(英雄(卡西迪), 队伍2, -1, 事件玩家, 矢量(0, 0, 0));
			生成机器人(英雄(西格玛), 队伍2, -1, 事件玩家, 矢量(0, 0, 0));
			生成机器人(英雄(禅雅塔), 队伍2, -1, 事件玩家, 矢量(0, 0, 0));
			生成机器人(英雄(巴蒂斯特), 队伍2, -1, 事件玩家, 矢量(0, 0, 0));
			// 开始持续伤害(所有玩家(所在队伍(事件玩家)), 此栏位的玩家(0, 对方队伍(所在队伍(事件玩家))), 99999, 100);
			// 开始持续伤害(所有玩家(所在队伍(事件玩家)), 所有玩家(对方队伍(所在队伍(事件玩家)))[0], 99999, 10);
			// 等待(1.0, 无视条件);
			// 设置最大生命值(所有玩家(对方队伍(所在队伍(事件玩家))), 1000);
		Else;
			传送(所有玩家(所有队伍), 事件玩家);
		End;
		设置朝向(已过滤的数组(所有玩家(所有队伍), 当前数组元素 != 事件玩家), 面朝方向(事件玩家), 至地图);
		// 开始定向阈值(已过滤的数组(所有玩家(所有队伍), 当前数组元素 != 事件玩家), 面朝方向(事件玩家), 0.3, 至地图, 替换现有阈值, 无);
		等待(0.5, 无视条件);
		// 设置终极技能充能(所有玩家(所有队伍), 100);
		设置技能冷却(所有玩家(所有队伍), 按钮(技能2), 0);
		设置技能冷却(所有玩家(所有队伍), 按钮(技能1), 0);
		设置终极技能充能(所有玩家(所有队伍), 100);
		等待(3, 无视条件);
		// 开始按下按钮(已过滤的数组(所有玩家(所有队伍), (所用英雄(当前数组元素) == 英雄(美) || 所用英雄(当前数组元素) == 英雄(布丽吉塔)) && 当前数组元素 != 事件玩家), 按钮(终极技能));
		// 开始按下按钮(已过滤的数组(所有玩家(队伍2), (所用英雄(当前数组元素) == 英雄(雾子)) && 当前数组元素 != 事件玩家), 按钮(技能2));
		// 开始按下按钮(已过滤的数组(所有玩家(所有队伍), (所用英雄(当前数组元素) == 英雄(布丽吉塔)) && 当前数组元素 != 事件玩家), 按钮(终极技能));
		// 开始按下按钮(已过滤的数组(所有玩家(队伍2), (所用英雄(当前数组元素) == 英雄(禅雅塔)) && 当前数组元素 != 事件玩家), 按钮(终极技能));
		// 等待(0.5, 无视条件);
		// 开始按下按钮(已过滤的数组(所有玩家(队伍1), (所用英雄(当前数组元素) == 英雄(布丽吉塔)) && 当前数组元素 != 事件玩家), 按钮(终极技能));
		// 开始按下按钮(已过滤的数组(所有玩家(队伍2), (所用英雄(当前数组元素) == 英雄(美) || 所用英雄(当前数组元素) == 英雄(奥丽莎) || 所用英雄(当前数组元素) == 英雄(黑影) || 所用英雄(当前数组元素) == 英雄(死神)) && 当前数组元素 != 事件玩家), 按钮(终极技能));
		// 开始按下按钮(已过滤的数组(所有玩家(队伍2), (所用英雄(当前数组元素) == 英雄(奥丽莎) || 所用英雄(当前数组元素) == 英雄(死神)) && 当前数组元素 != 事件玩家), 按钮(技能1));
		// 伤害(所有玩家(所在队伍(事件玩家)), 数组随机取值(所有玩家(对方队伍(所在队伍(事件玩家)))), 2000);

		// 等待(1, 无视条件);
	}
}

