	动作
	{
		开始调整玩家大小(事件玩家, 所用英雄(事件玩家) == 英雄(末日铁拳) ? 0.90 : 1.0, 真);
	}
}

规则("末日铁拳-减速")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		(事件技能 == 按钮(技能1) || 事件技能 == 按钮(终极技能)) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
	}

	动作
	{
		施加推力(被攻击方, 上, 5, 至地图, 取消相反运动);
	}
}

规则("末日铁拳-增伤")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		具有状态(被攻击方, 击晕) == 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0;
		事件技能 == 按钮(主要攻击模式);
	}

	动作
	{
		伤害(被攻击方, 攻击方, 3);
	}
}

规则("末日铁拳-副武器-火箭拳")
{
	事件
	{
		玩家造成伤害;
		双方;
		末日铁拳;
	}

	条件
	{
		事件技能 == 按钮(辅助攻击模式);
		(攻击方.doomfistr_only <= 0 || 被攻击方.doomfist_count > 0) == 真;
	}

	动作
	{
		If(被攻击方.doomfist_count <= 0);
			// 创建效果(所有玩家(所有队伍), 球, 颜色(白色), 单次赋值(所选位置(被攻击方)), 1, 无);
			伤害(被攻击方, 攻击方, 45);
			攻击方.doomfistr_only = 1.0;
			If(被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0);
				被攻击方.doomfist_count = 1.0;
			End;
		Else;
			被攻击方.doomfist_count = 0;
			攻击方.doomfistr_only = 0;
			If(被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0.0);
				// 创建效果(所有玩家(所有队伍), 球体, 颜色(红色), 单次赋值(所选位置(被攻击方)), 1, 无);
				// 伤害(被攻击方, 攻击方, 90);
				开始持续伤害(被攻击方, 攻击方, 0.5, 较大(120, 较小(事件伤害 * 5, 200)));
				等待直到(!具有状态(事件玩家, 击晕), 0.2);
				设置状态(被攻击方, 攻击方, 击晕, 0.45);
			End;
		End;
	}
}

规则("末日铁拳-被动-无损蓄力-副武器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
	}

	动作
	{
		事件玩家.doomfist_timer = 总计消耗时间;
		// 事件玩家.i_sys_speed += 50;
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 50), 总计消耗时间, 8, 英雄(末日铁拳), 自定义字符串(
		// 	"Doomfist Rocket Punch"));

		为玩家添加生命池(事件玩家, 护盾, 较大(0, 125 - 75 * (总计消耗时间 - 事件玩家.doomfist_timer)), 真, 真);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 2, 英雄(末日铁拳), 自定义字符串(
			"Doomfist Rocket Punch"));

		等待直到(!正在使用辅助武器(事件玩家) || !按钮被按下(事件玩家, 按钮(辅助攻击模式)), 5);
		If(正在使用辅助武器(事件玩家) && !按钮被按下(事件玩家, 按钮(辅助攻击模式)));
			施加推力(事件玩家, 与此角度的相对方向(水平朝向角度(事件玩家), 0), 99999, 至地图, 合并相反运动);
		End;

		等待直到(正在使用辅助武器(事件玩家) != 真, 5);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Doomfist Rocket Punch") ? 数组分割(当前数组元素, 0,
			2) : 当前数组元素);
	}
}

