规则("布丽吉塔-AI-发甲")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		布丽吉塔;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		技能充能(事件玩家, 按钮(技能2)) > 0;
		正在使用技能 2(事件玩家) != 真;
		数量(已过滤的数组(视角中的玩家(事件玩家, 所在队伍(事件玩家), 25), 存活(当前数组元素) && (标准化生命值(当前数组元素) <= 0.9) && 相距距离(眼睛位置(事件玩家), 眼睛位置(当前数组元素)) <= 25 && 在视线内(眼睛位置(事件玩家), 眼睛位置(当前数组元素), 屏障不会阻挡视线))) > 0;
	}

	动作
	{
		开始按下按钮(事件玩家, 按钮(技能2));
		等待(0.1, 无视条件);
		停止按下按钮(事件玩家, 按钮(技能2));

		等待(随机实数(0.25, 0.75), 无视条件);
		如条件为“真”则循环;
	}
}

