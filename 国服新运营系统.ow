		End;
		播放效果(所有玩家(所有队伍), 有害爆炸, 所在队伍(事件玩家), 眼睛位置(事件玩家), 全局.args_mei[8]);
		已过滤的数组(范围内玩家(眼睛位置(事件玩家), 全局.args_mei[8], 对方队伍(所在队伍(事件玩家)), 表面及全部屏障), 存活(当前数组元素)).sys_softirq[8] = 数组(事件玩家, 全局.args_mei[10], 全局.args_mei[11], 15);
	}
