		// 攻击方.tracer_energy[4] > 0;
		攻击方.tracer_energy[1] == 0;
	}

	动作
	{
		// 攻击方.tracer_energy[4] = 0;
		伤害(被攻击方, 攻击方, (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.15);
		播放效果(所有玩家(所有队伍), 有害爆炸, 所在队伍(攻击方), 被攻击方, 2.5);

		攻击方.tracer_energy[0] = 较大(0, 攻击方.tracer_energy[0] - 25);
	}
}

规则("猎空-能量")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Tracer Text"))) <= 0;
	}

	动作
	{
		创建进度条地图文本(
			事件玩家, 较大(0, 全局.args_tracer[0] - 事件玩家.tracer_energy[0]) / 全局.args_tracer[0] * 100, 空,
			逐帧更新(眼睛位置(事件玩家) + 100 * (-1.200 * 与此角度的相对方向(与此方向的水平角度(面朝方向(事件玩家)), 与此方向的垂直角度(面朝方向(事件玩家)) - 90) + 3 * 面朝方向(事件玩家))),
			0.800, 不要截取, 颜色(白色), 颜色(白色), 可见，位置和值, 默认可见度);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_map_line_text, 上一个文本ID, 总计消耗时间, -1, 英雄(猎空), 自定义字符串("Tracer Text"));

		创建进度条地图文本(
			事件玩家, 较大(0, 全局.args_tracer[1] - 事件玩家.tracer_energy[2]) / 全局.args_tracer[1] * 100, 自定义字符串("{0}", 技能图标字符串(英雄(猎空), 按钮(主要攻击模式))),
			逐帧更新(眼睛位置(事件玩家) + 100 * (-1.250 * 与此角度的相对方向(与此方向的水平角度(面朝方向(事件玩家)), 与此方向的垂直角度(面朝方向(事件玩家)) - 90) + 3 * 面朝方向(事件玩家))),
			0.800, 不要截取, 颜色(白色), 颜色(白色), 可见，位置和值, 默认可见度);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_map_line_text, 上一个文本ID, 总计消耗时间, -1, 英雄(猎空), 自定义字符串("Tracer Text"));
	}
}

规则("猎空-左键")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		正在使用主要武器(事件玩家) == 真;
		事件玩家.tracer_energy[0] < 全局.args_tracer[0];
		事件玩家.tracer_energy[1] == 0;
	}

	动作
	{
		While(正在使用主要武器(事件玩家) == 真 && 事件玩家.tracer_energy[0] < 全局.args_tracer[0]);
			事件玩家.tracer_energy[0] += 1;
			// 创建弹道(“天使”天使冲击枪, 事件玩家, 空, 
			// 	与此角度的相对方向(与此方向的水平角度(面朝方向(事件玩家)) + 随机实数(-3.0, 3.0), 与此方向的垂直角度(面朝方向(事件玩家)) + 随机实数(-3.0, 3.0)),
			// 	至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 3.0, 2, 0, 有益爆炸, 爆炸声音, 0, 1000, 0.01, 0, 0, 0);
			// 创建弹道(“天使”天使冲击枪, 事件玩家, 空, 
			// 	与此角度的相对方向(与此方向的水平角度(面朝方向(事件玩家)) + 随机实数(-3.0, 3.0), 与此方向的垂直角度(面朝方向(事件玩家)) + 随机实数(-3.0, 3.0)),
			// 	至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 3.0, 2, 0, 有益爆炸, 爆炸声音, 0, 1000, 0.01, 0, 0, 0);
			等待(0.050, 无视条件);
		End;
	}
}

规则("猎空-左键-冷却")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		正在使用主要武器(事件玩家) != 真;
		事件玩家.tracer_energy[0] < 全局.args_tracer[0];
		事件玩家.tracer_energy[1] == 0;
		(事件玩家.tracer_energy[0] > 0 || 事件玩家.tracer_energy[2] > 0) == 真;
	}

	动作
	{
		等待(1.0, 当为“假”时中止);
		While(正在使用主要武器(事件玩家) != 真 && 事件玩家.tracer_energy[0] < 全局.args_tracer[0] && (事件玩家.tracer_energy[0] > 0 || 事件玩家.tracer_energy[2] > 0));
			事件玩家.tracer_energy[0] = 较大(0, 事件玩家.tracer_energy[0] - 1);
			事件玩家.tracer_energy[2] = 较大(0, 事件玩家.tracer_energy[2] - 2);
			等待(0.250, 当为“假”时中止);
		End;
	}
}

规则("猎空-左键-过热")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		事件玩家.tracer_energy[0] >= 全局.args_tracer[0];
	}

	动作
	{
		设置弹药(事件玩家, 0, 0);
		事件玩家.tracer_energy[1] = 总计消耗时间;
		While(
			事件玩家.tracer_energy[0] >= 全局.args_tracer[0] && 事件玩家.tracer_energy[1] != 0 && 总计消耗时间 - 事件玩家.tracer_energy[1] < 0.500);
			等待(0.250, 无视条件);
			设置弹药(事件玩家, 0, 0);
		End;
		事件玩家.tracer_energy[0] = 0;
		事件玩家.tracer_energy[2] = 0;
		事件玩家.tracer_energy[1] = 0;
	}
}

规则("猎空-E")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		猎空;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		事件玩家.tracer_energy[3] = 总计消耗时间;
		为玩家添加生命池(范围内玩家(眼睛位置(事件玩家), 8.0, 所在队伍(事件玩家), 表面及敌方屏障), 护盾, (总计消耗时间 - 事件玩家.tracer_energy[3] >= 1.0) ? (75 - (总计消耗时间 - 事件玩家.tracer_energy[3]) * 15) : 75, 真, 真);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_real_hp_pool, 最后创建的生命池, 总计消耗时间, 6.0, 英雄(猎空));
		事件玩家.tracer_energy[0] = 0;

		// 等待直到(!正在使用技能 2(事件玩家), 3);
		// If(存活(事件玩家));
		// 	事件玩家.tracer_energy[0] = 0;
		// 	// 为玩家添加生命池(事件玩家, 护盾, 50 - (总计消耗时间 - 事件玩家.tracer_energy[3]) * 8.34, 真, 真);
		// End;
	}
}

规则("猎空-左键-伤害")
{
	事件
	{
		玩家造成伤害;
		双方;
		猎空;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
		// 事件玩家.tracer_energy[2] < 全局.args_tracer[1];
		攻击方.tracer_energy[0] < 全局.args_tracer[0];
	}

	动作
	{
		伤害(
			被攻击方,
			攻击方,
			最大生命值(被攻击方) * 0.0175 * ((全局.args_tracer[0]-攻击方.tracer_energy[0])/全局.args_tracer[0]) * (较小(1.0, 较大(0.3, 11.7-0.07*相距距离(眼睛位置(攻击方), 眼睛位置(被攻击方)))))
		);

		// 伤害(被攻击方, 攻击方, (事件暴击 ? 1.5 : 1) * 较小(全局.args_tracer[4], 最大生命值(被攻击方) * 全局.args_tracer[2]));
		// If((具有状态(被攻击方, 沉睡) || 具有状态(被攻击方, 冰冻) || 具有状态(被攻击方, 击倒) || 具有状态(被攻击方, 击晕) || 具有状态(被攻击方, 被入侵)) == 真);
		// 	中止;
		// End;
		// 事件玩家.tracer_energy[2] = 较小(全局.args_tracer[1], 事件玩家.tracer_energy[2] + (事件暴击 ? 2 : 1) * 较小(全局.args_tracer[4], 最大生命值(被攻击方) * 全局.args_tracer[2]));
	}
}

