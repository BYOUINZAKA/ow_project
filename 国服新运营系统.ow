规则("")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_main_tank != 空;
		事件玩家 != 事件玩家.sys_main_tank;
		// 相距距离(事件玩家, 目标位置(对象索引)) > 全局.args_system[2];
		// 相距距离(事件玩家.sys_main_tank, 目标位置(对象索引)) > 全局.args_system[2];
		相距距离(重生点(所在队伍(事件玩家)), 事件玩家) <= 相距距离(重生点(所在队伍(事件玩家)), 目标位置(对象索引)) * 0.8;
		相距距离(重生点(所在队伍(事件玩家)), 事件玩家.sys_main_tank) <= 相距距离(重生点(所在队伍(事件玩家)), 目标位置(对象索引)) * 0.8;
		在目标点上(事件玩家) != 真;
		在目标点上(事件玩家.sys_main_tank) != 真;
		事件玩家.sys_is_ai == 真;
		// 正在等待玩家 != 真;
		存活(事件玩家.sys_main_tank) == 真;
		存活(事件玩家) == 真;
		占领要点模式得分百分比(对方队伍(所在队伍(事件玩家))) < 85;
	}

	动作
	{
		等待(7.0, 当为“假”时中止);
		If(数组包含(全局.sys_support, 所用英雄(事件玩家)));
			绑定玩家(事件玩家, 事件玩家.sys_main_tank, 矢量(随机实数(-2, 2), 0, -2));
		Else;
			绑定玩家(事件玩家, 事件玩家.sys_main_tank, 矢量(随机实数(-2, 2), 0, -1));
		End;
	}
}

规则("")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		// ((事件玩家.sys_main_tank == 空) || (相距距离(事件玩家, 目标位置(对象索引)) <= 全局.args_system[2]) || (相距距离(事件玩家.sys_main_tank, 目标位置(对象索引)) <= 全局.args_system[2]) || 在目标点上(事件玩家) || 在目标点上(事件玩家.sys_main_tank) || 主机玩家 == 事件玩家 || 正在使用终极技能(事件玩家.sys_main_tank) || !存活(事件玩家) || !存活(事件玩家.sys_main_tank)) == 真;
		((事件玩家.sys_main_tank == 空) || (相距距离(重生点(所在队伍(事件玩家)), 事件玩家) > 相距距离(重生点(所在队伍(事件玩家)), 目标位置(对象索引)) * 0.8) || 在目标点上(事件玩家) || 在目标点上(事件玩家.sys_main_tank) || !事件玩家.sys_is_ai || 正在使用终极技能(事件玩家.sys_main_tank) || !存活(事件玩家) || !存活(事件玩家.sys_main_tank)) == 真;
		// ((事件玩家.sys_main_tank == 空) || (相距距离(事件玩家, 目标位置(对象索引)) <= 全局.args_system[2]) || 在目标点上(事件玩家)  || 主机玩家 == 事件玩家) == 真;
		事件玩家 != 事件玩家.sys_main_tank;
	}

	动作
	{
		解除绑定(事件玩家);
		等待(随机实数(0.05, 0.25), 无视条件);
		传送(事件玩家, 最近的可行走位置(事件玩家));

		事件玩家.sys_temp = 总计消耗时间;

		While(总计消耗时间 - 事件玩家.sys_temp <= 5.0);
			等待直到(正在空中(事件玩家) && (相距距离(所选位置(事件玩家), 射线命中位置(所选位置(事件玩家), 所选位置(事件玩家) + 下*20, 空, 空, 假)) > 8.0), 1.0);
			If(正在空中(事件玩家) && (相距距离(所选位置(事件玩家), 射线命中位置(所选位置(事件玩家), 所选位置(事件玩家) + 下*20, 空, 空, 假)) > 8.0));
				传送(事件玩家, 最近的可行走位置(事件玩家));
			End;
			等待(0.0, 当为“假”时中止);
		End;
	}
}

规则("能量运营-主循环")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(5.0, 无视条件);

		While(真);
			全局.sys_ultra_tmp[0] = 所有玩家(所有队伍);
			全局.sys_ultra_tmp[1] = 数量(全局.sys_ultra_tmp[0]);
			全局.sys_ultra_tmp[2] = 0;
			全局.sys_ultra_tmp[3] = 空;
			全局.sys_ultra_tmp[4] = 数组(0, 0);
			全局.sys_ultra_tmp[5] = 数组(0, 0);

			全局.sys_ultra_tmp[0].sys_softirq[6] += 1;
			等待直到(全局.sys_ultra_tmp[0].sys_softirq[6] <= 0, 99999);

			While(全局.sys_ultra_tmp[2] < 全局.sys_ultra_tmp[1]);
				全局.sys_ultra_tmp[3] = 全局.sys_ultra_tmp[0][全局.sys_ultra_tmp[2]];
				If(全局.sys_ultra_tmp[3] != 空 && 实体存在(全局.sys_ultra_tmp[3]));
					If(所在队伍(全局.sys_ultra_tmp[3]) == 队伍1);
						全局.sys_ultra_tmp[4] = 数组(
							全局.sys_ultra_tmp[4][0] + 全局.sys_ultra_tmp[3].sys_ultra_reasons[0],
							全局.sys_ultra_tmp[4][1] + 全局.sys_ultra_tmp[3].sys_ultra_reasons[1]
						);
					Else If(所在队伍(全局.sys_ultra_tmp[3]) == 队伍2);
						全局.sys_ultra_tmp[5] = 数组(
							全局.sys_ultra_tmp[5][0] + 全局.sys_ultra_tmp[3].sys_ultra_reasons[0],
							全局.sys_ultra_tmp[5][1] + 全局.sys_ultra_tmp[3].sys_ultra_reasons[1]
						);
					End;
				End;
				全局.sys_ultra_tmp[2] += 1;
			End;

			全局.sys_ultra_tmp[0].sys_softirq[7] += 1;
			等待直到(全局.sys_ultra_tmp[0].sys_softirq[7] <= 0, 99999);

			等待(0.1, 无视条件);
		End;
	}
}

规则("能量运营-分数中断")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[6] > 0;
	}

	动作
	{
		If(事件玩家.sys_ultra_score == 空 || 事件玩家.sys_ultra_score[0] != 所用英雄(事件玩家));
			事件玩家.sys_ultra_score = 已过滤的数组(全局.sys_ultra_rating, 当前数组元素[0] == 所用英雄(事件玩家))[0];
			If(事件玩家.sys_ultra_score == 空 || 所用英雄(事件玩家) != 事件玩家.sys_ultra_score[0]);
				事件玩家.sys_ultra_score = 数组(
					所用英雄(事件玩家),
					数组包含(全局.sys_tank, 所用英雄(事件玩家)) ? 1.5 : (数组包含(全局.sys_damage, 所用英雄(事件玩家)) ? 1.2 : 0.8),
					数组包含(全局.sys_tank, 所用英雄(事件玩家)) ? 1.5 : (数组包含(全局.sys_support, 所用英雄(事件玩家)) ? 1.2 : 0.8),
					0, 0, 100, 100, 0
				);
			End;
		End;

		If(!存活(事件玩家) || 相距距离(重生点(所在队伍(事件玩家)), 事件玩家) <= 相距距离(重生点(所在队伍(事件玩家)), 目标位置(对象索引)) * 0.8);
			事件玩家.sys_ultra_reasons = 数组(0, 0);
		Else;
			事件玩家.sys_ultra_reasons = 数组(事件玩家.sys_ultra_score[1], 事件玩家.sys_ultra_score[2]);
			If(
				正在使用终极技能(事件玩家) || 正在人格复制(事件玩家) ||
				(事件玩家.sys_ultra_score[7] > 0 && 事件玩家.d_sys_ability_timer >= 事件玩家.sys_ultra_score[7])
			);
				事件玩家.sys_ultra_reasons[0] += 事件玩家.sys_ultra_score[3];
				事件玩家.sys_ultra_reasons[1] += 事件玩家.sys_ultra_score[4];
			End;
		End;

		事件玩家.sys_softirq[6] = -9999;
		等待(0.1, 无视条件);

		事件玩家.sys_softirq[6] = 0;
		如条件为“真”则循环;
	}
}

规则("能量运营-队伍1-禁用中断")
{
	事件
	{
		持续 - 每名玩家;
		队伍1;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[7] > 0;
	}

	动作
	{
		事件玩家.sys_ultra_lock[1] = 0;

		If(事件玩家.sys_is_ai && (事件玩家.sys_ultra_score[5] + 事件玩家.sys_ultra_score[6]) < 200);
			If(全局.sys_ultra_tmp[4][0] - 全局.sys_ultra_tmp[5][1] <= 随机实数(2, 3.5));
				事件玩家.sys_ultra_lock[1] += 事件玩家.sys_ultra_score[5];
			End;
			If(全局.sys_ultra_tmp[4][1] - 全局.sys_ultra_tmp[5][0] <= 随机实数(1.5, 3));
				事件玩家.sys_ultra_lock[1] += 事件玩家.sys_ultra_score[6];
			End;
			If(占领要点模式得分百分比(对方队伍(所在队伍(事件玩家))) >= 85);
				事件玩家.sys_ultra_lock[1] = 100;
			Else If(占领要点模式得分百分比(对方队伍(所在队伍(事件玩家))) - 占领要点模式得分百分比(所在队伍(事件玩家)) >= 50);
				事件玩家.sys_ultra_lock[1] += (占领要点模式得分百分比(对方队伍(所在队伍(事件玩家))) - 占领要点模式得分百分比(所在队伍(事件玩家))) * 0.25;
			End;
			If(相距距离(重生点(所在队伍(事件玩家)), 事件玩家) < 相距距离(重生点(所在队伍(事件玩家)), 目标位置(对象索引)) * 0.5 && !在目标点上(事件玩家));
				事件玩家.sys_ultra_lock[1] = 0;
			End;
			If(随机实数(1, 100) <= 事件玩家.sys_ultra_lock[1]);
				可用按钮(事件玩家, 按钮(终极技能));
				事件玩家.sys_ultra_lock[0] = 假;
			Else;
				禁用按钮(事件玩家, 按钮(终极技能));
				事件玩家.sys_ultra_lock[0] = 真;
			End;
			事件玩家.sys_softirq[7] = -9999;
			等待(0.1, 无视条件);
		Else;
			可用按钮(事件玩家, 按钮(终极技能));
			事件玩家.sys_ultra_lock[0] = 假;
			事件玩家.sys_softirq[7] = -9999;
			等待(60.0, 无视条件);
		End;

		事件玩家.sys_softirq[7] = 0;
		如条件为“真”则循环;
	}
}

