		攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3, 英雄(卡西迪));
		// 开始伤害调整(被攻击方, 所有玩家(所有队伍), 125, 受伤害者和伤害者);
		// 攻击方.sys_default_status_pool[数量(攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3, 英雄(卡西迪), 自定义字符串("Debuff"));
		等待(3.0, 无视条件);
