	{
		持续 - 每名玩家;
		双方;
		布丽吉塔;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
		正在使用主要武器(事件玩家) == 真;
	}

	动作
	{
		范围内玩家(眼睛位置(事件玩家), 全局.args_brigitte[2], 所在队伍(事件玩家), 表面及敌方屏障).sys_softirq[17] += 15;
	}
}

规则("布丽吉塔-副武器-盾击")
{
	事件
	{
		玩家造成伤害;
		双方;
		布丽吉塔;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
		正在使用辅助武器(攻击方) == 真;
		// 正在使用终极技能(攻击方) != 真;
		全局.args_brigitte[4] > 0;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
	}

