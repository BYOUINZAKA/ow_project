		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[4]+0.3, 英雄(美), 自定义字符串("Mei Ice Wall Ring"));
		等待(0.1, 无视条件);
		事件玩家.mei_ice_pos[2] = 0.115;
		事件玩家.mei_ice_pos[0] = 事件玩家.mei_ice_pos[1];
		等待(0.1, 无视条件);
		事件玩家.mei_ice_pos[2] = 0.23;

		等待(全局.args_mei[4], 无视条件);
		事件玩家.mei_ice_pos = 空;
	}
}

规则("美-E-反弹")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		数量(已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 所用英雄(当前数组元素) == 英雄(美) && 当前数组元素.mei_ice_pos[0] != 空 && 相距距离(事件玩家, 当前数组元素.mei_ice_pos[0]) <= 3.5)) > 0;
	}

	动作
	{
		事件玩家.mei_s_timer[0] = 已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 所用英雄(当前数组元素) == 英雄(美) && 当前数组元素.mei_ice_pos[0] != 空 && 相距距离(事件玩家, 当前数组元素.mei_ice_pos[0]) <= 3.5)[0];
		施加推力(事件玩家, 方向(事件玩家.mei_s_timer[0].mei_ice_pos[0], 眼睛位置(事件玩家)), 7.5, 至地图, 取消相反运动XYZ);
		If(事件玩家.mei_s_timer[1] == 空 || (总计消耗时间 - 事件玩家.mei_s_timer[1]) >= 1.5);
			伤害(事件玩家, 事件玩家.mei_s_timer[0], 50);
			治疗(事件玩家.mei_s_timer[0], 事件玩家.mei_s_timer[0], 10);
			事件玩家.mei_freeze = 数组(事件玩家.mei_freeze[0]+5, 1.0, 事件玩家.mei_s_timer[0]);
			事件玩家.mei_s_timer[1] = 总计消耗时间;
			If(技能冷却时间(事件玩家.mei_s_timer[0], 按钮(技能1)) > 0);
				设置技能冷却(事件玩家.mei_s_timer[0], 按钮(技能1), 技能冷却时间(事件玩家.mei_s_timer[0], 按钮(技能1)) - 1.0);
			End;
		End;
		等待(0.5, 无视条件);
		如条件为“真”则循环;
	}
}

规则("美-E-寒冰盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		美;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
		// 事件玩家.mei_e_pos == 空;
	}

	动作
	{
		取消主要动作(事件玩家);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Ics Guard") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);

		事件玩家.zarya_e_target = 数组(
			射线命中玩家(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 30, 所有存活玩家(所在队伍(事件玩家)), 事件玩家, 假),
			已排序的数组(已过滤的数组(所有存活玩家(所在队伍(事件玩家)), 相距距离(眼睛位置(事件玩家), 当前数组元素) <= 30 && 事件玩家 != 当前数组元素), 相距距离(眼睛位置(事件玩家), 当前数组元素) * 角度的正弦值(矢量间夹角(面朝方向(事件玩家), 方向(眼睛位置(事件玩家), 当前数组元素))))[0]
		);
		事件玩家.mei_e_pos[0] = 实体存在(事件玩家.zarya_e_target[0]) ? 事件玩家.zarya_e_target[0] : 事件玩家.zarya_e_target[1];

		// 事件玩家.mei_e_pos[0] = 已排序的数组(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 25, 所在队伍(事件玩家), 关闭), 存活(当前数组元素) && 当前数组元素 != 事件玩家), 生命值(当前数组元素) / 当前数组元素.sys_static_max_hp)[0];
		
		事件玩家.mei_e_pos[1] = 总计消耗时间 + 全局.args_mei[9];

		创建效果(所有玩家(所有队伍), “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家.mei_e_pos[0], 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ics Guard"));

		创建效果(所有玩家(所有队伍), 有益光环, 所在队伍(事件玩家), 事件玩家.mei_e_pos[0], 1.5, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ics Guard"));

		开始助攻(事件玩家, 事件玩家.mei_e_pos[0], 无);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_assists, 上一个助攻ID, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ics Guard"));

		开始持续治疗(数组(事件玩家.mei_e_pos[0], 事件玩家), 事件玩家, 全局.args_mei[9], 全局.args_mei[5]);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_continued, 上一个持续治疗效果ID, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ics Guard"));

		// 开始伤害调整(数组(事件玩家.mei_e_pos[0], 事件玩家), 所有玩家(所有队伍), 70, 受伤害者，伤害者及伤害百分比);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 全局.args_mei[9] / 2, 英雄(美), 自定义字符串("Mei Ics Guard"));

		创建效果(所有玩家(所有队伍), “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ics Guard"));

		创建效果(所有玩家(所有队伍), 有益光环, 所在队伍(事件玩家), 事件玩家, 1.5, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[9], 英雄(美), 自定义字符串("Mei Ics Guard"));
	}
}

规则("美-E-寒冰盾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		美;
	}

	条件
	{
		事件玩家.mei_e_pos != 空;
		存活(事件玩家.mei_e_pos[0]) == 真;
		总计消耗时间 <= 事件玩家.mei_e_pos[1];
	}

	动作
	{
		While(存活(事件玩家.mei_e_pos[0]) && 总计消耗时间 <= 事件玩家.mei_e_pos[1]);
			If(标准化生命值(事件玩家) >= 1.0);
				事件玩家.mei_e_pos[0].sys_softirq[0] = 真;
			End;
			等待直到(!(存活(事件玩家.mei_e_pos[0]) && 总计消耗时间 <= 事件玩家.mei_e_pos[1]), 1.0);
			等待直到(!(存活(事件玩家.mei_e_pos[0]) && 总计消耗时间 <= 事件玩家.mei_e_pos[1]) || (标准化生命值(事件玩家.mei_e_pos[0]) >= 1.0), 事件玩家.mei_e_pos[1]);
		End;

		播放效果(所有玩家(所有队伍), 有害爆炸, 所在队伍(事件玩家), 眼睛位置(事件玩家.mei_e_pos[0]), 全局.args_mei[8]);
		已过滤的数组(范围内玩家(眼睛位置(事件玩家.mei_e_pos[0]), 全局.args_mei[8], 对方队伍(所在队伍(事件玩家)), 表面及全部屏障), 存活(当前数组元素)).sys_softirq[8] = 数组(事件玩家, 全局.args_mei[10], 全局.args_mei[11], 15);
	}
}

