	{
		开始伤害调整(事件玩家, 所有玩家(对方队伍(所在队伍(事件玩家))), 50, 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(斩仇));
	}
}

规则("斩仇-减伤")
{
	事件
	{
		玩家受到伤害;
		双方;
		斩仇;
	}

	条件
	{
		攻击方 != 空;
		攻击方 != 被攻击方;
	}

	动作
	{
		被攻击方.vendetta_vars[3] = 被攻击方.vendetta_vars[3] + 事件伤害;
	}
}

规则("斩仇-减伤")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		斩仇;
	}

	条件
	{
		事件玩家.vendetta_vars[3] > 0;
	}

	动作
	{
		/*
		 * vendetta_vars
		 * [0]: 
		 * [1]:
		 */

		While((事件玩家.vendetta_vars[3] > 0) || (事件玩家.vendetta_vars[0] > 事件玩家.vendetta_vars[1]));
			If(事件玩家.vendetta_vars[3] > 0);
				事件玩家.vendetta_vars[0] = 较大(0, 事件玩家.vendetta_vars[0] - 事件玩家.vendetta_vars[1]) + 事件玩家.vendetta_vars[3];
				事件玩家.vendetta_vars[1] = 0;
				事件玩家.vendetta_vars[3] = 0;
			End;

			事件玩家.vendetta_vars[4] = 较小(事件玩家.vendetta_vars[0] - 事件玩家.vendetta_vars[1], 事件玩家.vendetta_vars[0] * 0.1);

			// If(正在使用技能 1(事件玩家) || 正在使用技能 2(事件玩家) || 正在使用终极技能(事件玩家));
			// 	等待(0.2, 无视条件);
			// Else;
			// 	开始持续伤害(事件玩家, 事件玩家, 1.0, 事件玩家.vendetta_vars[4] * 5);
			// 	事件玩家.vendetta_vars[2] = 上一个持续伤害效果ID;
			// 	等待(0.2, 无视条件);
			// 	停止持续伤害(事件玩家.vendetta_vars[2]);
			// End;
			// 事件玩家.vendetta_vars[2] = 空;

			开始持续伤害(事件玩家, 事件玩家, 1.0, 事件玩家.vendetta_vars[4] * ((正在使用技能 1(事件玩家)||正在使用技能 2(事件玩家)||正在使用终极技能(事件玩家)) ? 1.25 : 5));
			事件玩家.vendetta_vars[2] = 上一个持续伤害效果ID;
			等待(0.2, 无视条件);
			停止持续伤害(事件玩家.vendetta_vars[2]);
			事件玩家.vendetta_vars[2] = 空;

			事件玩家.vendetta_vars[1] += 事件玩家.vendetta_vars[4];
		End;

		事件玩家.vendetta_vars[0] = 0;
		事件玩家.vendetta_vars[1] = 0;
		事件玩家.vendetta_vars[3] = 0;
	}
}

规则("斩仇-减伤")
{
	事件
	{
        玩家受到治疗;
        双方;
		斩仇;
	}

	条件
	{
