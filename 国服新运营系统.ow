		创建弹道效果(事件玩家.mei_ice_pos[0] != 空 ? 所有玩家(所有队伍) : 空, 美冰锥, 所有玩家(所在队伍(事件玩家)), 事件玩家.mei_ice_pos[1] + 矢量(0, 1.27, 1.27), 矢量(0, -1, -1), 事件玩家.mei_ice_pos[2], 可见，友善，位置，方向和大小);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 英雄(美), 自定义字符串("Mei E"));
	}
}

规则("美-shift-过度治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[0] != 空;
	}

	动作
	{
		事件玩家.sys_softirq[0] = 空;
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Ice Wall"))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Ice Wall"))[0][1]);
			为玩家添加生命池(事件玩家, 生命值, 全局.args_mei[5] * 全局.args_mei[7], 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Ice Wall") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6.0, 空, 自定义字符串("Mei Ice Wall")) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Ice Wall"))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 全局.args_mei[5] * 全局.args_mei[7], 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6.0, 空, 自定义字符串("Mei Ice Wall"));
		End;
	}
}

规则("美-e-伤害")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[8] != 空;
	}

	动作
	{
		// 开始持续伤害(事件玩家, 事件玩家.sys_softirq[8][0], 事件玩家.sys_softirq[8][2], 事件玩家.sys_softirq[8][1]/事件玩家.sys_softirq[8][2]);
		伤害(事件玩家, 事件玩家.sys_softirq[8][0], 事件玩家.sys_softirq[8][1]);

		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Speed Down"))) == 1);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Speed Down") ? 数组(全局.t_enum_speed, 数组(事件玩家, -30), 总计消耗时间, 3.0, 空, 自定义字符串("Mei Speed Down")) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Speed Down"))) == 0);
			事件玩家.i_sys_speed -= 30;
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, -30), 总计消耗时间, 3.0, 空, 自定义字符串("Mei Speed Down"));
		End;

		If(事件玩家.sys_softirq[8][3] > 0);
			事件玩家.mei_freeze = 数组(事件玩家.mei_freeze[0]+事件玩家.sys_softirq[8][3], 1.0, 事件玩家.sys_softirq[8][0]);
		End;

		事件玩家.sys_softirq[8] = 空;
	}
}

规则("美-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		所用英雄(事件玩家) == 英雄(美);
		正在使用终极技能(事件玩家) == 真;
		事件玩家.mei_Q_vec == 空;
		事件玩家.mei_Q_center == 空;
	}

	动作
	{
		取消主要动作(事件玩家);
		设置启用终极技能(事件玩家, 假);

		// 事件玩家.mei_Q_vec = 数组(归一化(矢量(X方向分量(面朝方向(事件玩家)), 0, Z方向分量(面朝方向(事件玩家)))), 假, 0);
		// 事件玩家.mei_Q_vec = 矢量(X方向分量(事件玩家.mei_Q_vec[0]) * 全局.args_mei[18], 0, Z方向分量(事件玩家.mei_Q_vec[0]) * 全局.args_mei[18]);
		事件玩家.mei_Q_vec = 与此角度的相对方向(水平朝向角度(事件玩家), 0) * 全局.args_mei[18];
		// 事件玩家.mei_Q_vec = 与此角度的相对方向(水平朝向角度(事件玩家), 0);

		// 事件玩家.mei_Q_center = 眼睛位置(事件玩家) + 事件玩家.mei_Q_vec[0] + 上 * 1.5;
		事件玩家.mei_Q_center = 眼睛位置(事件玩家) + 上 * 1.5;
		等待(0.5, 无视条件);
		事件玩家.mei_Q_vec[2] = 总计消耗时间;

		持续追踪玩家变量(事件玩家, mei_Q_center, 事件玩家.mei_Q_center + 事件玩家.mei_Q_vec[0] * 全局.args_mei[17], 全局.args_mei[17], 全部禁用);

		// 播放效果(所有玩家(所有队伍), 环状爆炸, 所在队伍(事件玩家), 事件玩家.mei_Q_center, 全局.args_mei[16]);
		// 播放效果(所有玩家(所有队伍), 环状爆炸声音, 所在队伍(事件玩家), 事件玩家.mei_Q_center, 9999);
	
		创建效果(所有玩家(所有队伍), 光柱, 所在队伍(事件玩家), 射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 1.5, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[17], 英雄(美), 自定义字符串("Mei Orbital Ray"));

		创建效果(所有玩家(所有队伍), 有益光环, 所在队伍(事件玩家), 射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 全局.args_mei[16], 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[17], 英雄(美), 自定义字符串("Mei Orbital Ray"));
		创建效果(所有玩家(所有队伍), 有益光环, 所在队伍(事件玩家), 射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 全局.args_mei[16]*0.3, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[17], 英雄(美), 自定义字符串("Mei Orbital Ray"));

		创建效果(所有玩家(所有队伍), 有益光环声音, 所在队伍(事件玩家), 射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 9999, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[17], 英雄(美), 自定义字符串("Mei Orbital Ray"));

		创建效果(所有玩家(所有队伍), 环, 所在队伍(事件玩家), 射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 全局.args_mei[16], 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 全局.args_mei[17], 英雄(美), 自定义字符串("Mei Orbital Ray"));

		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 已过滤的数组(范围内玩家(射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 全局.args_mei[16], 所在队伍(事件玩家), 关闭), 存活(当前数组元素)), 100 + 全局.args_mei[19], 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 全局.args_mei[17], 英雄(美), 自定义字符串("Mei Orbital Ray"));

		开始助攻(事件玩家, 已过滤的数组(范围内玩家(射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 全局.args_mei[16], 所在队伍(事件玩家), 关闭), 存活(当前数组元素)), 助攻者和目标);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_assists, 上一个助攻ID, 总计消耗时间, 全局.args_mei[17], 英雄(美), 自定义字符串("Mei Orbital Ray"));

		While(事件玩家.mei_Q_center != 空 && 事件玩家.mei_Q_vec != 空 && 总计消耗时间 - 事件玩家.mei_Q_vec[2] <= 全局.args_mei[17] && 所用英雄(事件玩家) == 英雄(美));
			已过滤的数组(范围内玩家(射线命中位置(事件玩家.mei_Q_center, 事件玩家.mei_Q_center + 下 * 20, 空, 所有玩家(所有队伍), 假), 全局.args_mei[16], 所在队伍(事件玩家), 关闭), 存活(当前数组元素)).sys_softirq[3] = 事件玩家;
			等待直到(所用英雄(事件玩家) != 英雄(美), 1.0);
		End;

		停止追踪玩家变量(事件玩家, mei_Q_center);
		事件玩家.mei_Q_center = 空;
		事件玩家.mei_Q_vec = 空;

		设置启用终极技能(事件玩家, 真);
	}
}

规则("美-Q-治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[3] != 空;
	}

	动作
	{
		开始持续治疗(事件玩家, 事件玩家.sys_softirq[3], 全局.args_mei[14], 全局.args_mei[13] / 全局.args_mei[14]);
		事件玩家.mei_Q_overheal = 数组(总计消耗时间, 生命值(事件玩家), 上一个持续治疗效果ID);
		事件玩家.sys_softirq[3] = 空;

		创建效果(所有玩家(所有队伍), “天使”伤害强化效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 1.00, 空, 自定义字符串("Mei Orbital Ray"));

		等待直到(标准化生命值(事件玩家) >= 1.0, 全局.args_mei[14]);

		If(全局.args_mei[15] > 0 && 标准化生命值(事件玩家) >= 1.0 && 总计消耗时间 - 事件玩家.mei_Q_overheal[0] < 全局.args_mei[14] && 最大生命值(事件玩家) - 事件玩家.mei_Q_overheal[1] < 全局.args_mei[13]);
			If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Orbital Ray Heal"))) == 1);
				移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Orbital Ray Heal"))[0][1]);
				为玩家添加生命池(事件玩家, 生命值, 较小(全局.args_mei[13] - (最大生命值(事件玩家) - 事件玩家.mei_Q_overheal[1]), 全局.args_mei[13]) * 全局.args_mei[15], 假, 假);
				事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Orbital Ray Heal") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 全局.args_mei[17], 空, 自定义字符串("Mei Orbital Ray Heal")) : 当前数组元素);
			Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Orbital Ray Heal"))) == 0);
				为玩家添加生命池(事件玩家, 生命值, 较小(全局.args_mei[13] - (最大生命值(事件玩家) - 事件玩家.mei_Q_overheal[1]), 全局.args_mei[13]) * 全局.args_mei[15], 假, 假);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 全局.args_mei[17], 空, 自定义字符串("Mei Orbital Ray Heal"));
			End;
		End;

		事件玩家.mei_Q_overheal = 空;
		如条件为“真”则循环;
	}
}

