}

规则("系统-终极技能效率")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		// 创建HUD文本(所有玩家(所有队伍), 自定义字符串(""), 自定义字符串("{0}: {1}s, {2}", 事件玩家, 事件玩家.a_sys_ultimate_efficiency[1]/事件玩家.a_sys_ultimate_efficiency[2], 玩家数据(事件玩家, 阻挡伤害量)), 自定义字符串(""), 左边, 栏位(事件玩家), 颜色(白色), 颜色(白色), 颜色(白色), 可见性，排序规则和字符串, 默认可见度);
		// 创建HUD文本(所有玩家(所有队伍), 自定义字符串(""), 自定义字符串("{0}({1}): {2}", 事件玩家, 所用英雄(事件玩家), 自定义字符串("{0}, {1}, {2}", 数量(事件玩家.sys_default_status_pool), 取整(玩家数据(事件玩家, 对英雄造成伤害量), 上), 自定义字符串("{0}, {1}, {2}", 取整(玩家数据(事件玩家, 治疗量), 上), 取整(玩家数据(事件玩家, 承受伤害量), 上), 自定义字符串("{0}, {1}", 玩家数据(事件玩家, 获得终极技能), (玩家数据(事件玩家, 消灭) + 玩家数据(事件玩家, 协助进攻) + 玩家数据(事件玩家, 协助防守)) / 玩家数据(事件玩家, 阵亡), 空)))), 空, 左边, (所在队伍(事件玩家) == 队伍2) ? (栏位数量(所在队伍(事件玩家)) + 栏位(事件玩家)) : 栏位(事件玩家), 颜色(白色), 所在队伍(事件玩家), 颜色(白色), 可见性，排序规则和字符串, 默认可见度);
		创建HUD文本(
			所有玩家(所有队伍),
			自定义字符串(""),
			自定义字符串(
				"{0}({1}): {2}",
				事件玩家,
				所用英雄(事件玩家),
				自定义字符串(
					"{0}, {1}, {2}",
					玩家数据(事件玩家, 对英雄造成伤害量),
					玩家数据(事件玩家, 治疗量),
					自定义字符串(
						"{0}, {1}, {2}",
						玩家数据(事件玩家, 承受伤害量),
						玩家数据(事件玩家, 阻挡伤害量),
						自定义字符串(
							"{0}, {1}",
							玩家数据(事件玩家, 获得终极技能),
							(玩家数据(事件玩家, 消灭) + 玩家数据(事件玩家, 协助进攻) + 玩家数据(事件玩家, 协助防守)) / 玩家数据(事件玩家, 阵亡)
						)
					)
				)
			),
			自定义字符串(""), 左边, 
			(所在队伍(事件玩家) == 队伍2) ? (栏位数量(所在队伍(事件玩家)) + 栏位(事件玩家)) : 栏位(事件玩家),
			颜色(白色), 所在队伍(事件玩家), 颜色(白色), 可见性，排序规则和字符串, 默认可见度);
	}
}

