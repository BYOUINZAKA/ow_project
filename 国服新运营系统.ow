		// (数量(已过滤的数组(所有玩家(所在队伍(事件玩家)), 所用英雄(当前数组元素) == 英雄(布丽吉塔))) <= 0 || 全局.args_brigitte[0] <= 0) == 真;
		实体存在(选择英雄的玩家(英雄(布丽吉塔), 所在队伍(事件玩家))) != 真;
	}

	动作
	{
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Brigitte Overheal")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
