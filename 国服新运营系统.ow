规则("伊拉锐-护盾发生器")
{
	事件
	{
		玩家造成治疗;
		双方;
		伊拉锐;
	}

	条件
	{
		事件技能 == 空;
	}

	动作
	{
		受治疗者.illari_poison = 治疗者;
		If(数量(已过滤的数组(受治疗者.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Heal"))) == 1);
			移除玩家的生命池(已过滤的数组(受治疗者.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Heal"))[0][1]);
			为玩家添加生命池(受治疗者, 生命值, 25, 假, 假);
			受治疗者.sys_default_status_pool = 映射的数组(受治疗者.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Heal") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 空, 自定义字符串("Illari Heal")) : 当前数组元素);
		Else If(数量(已过滤的数组(受治疗者.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Heal"))) == 0);
			为玩家添加生命池(受治疗者, 生命值, 25, 假, 假);
			受治疗者.sys_default_status_pool[数量(受治疗者.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 空, 自定义字符串("Illari Heal"));
		End;
		等待(1.25, 无视条件);
	}
}

规则("伊拉锐-右键-护盾发生器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		伊拉锐;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
	}

	动作
	{
		While(真);
			等待(0.1, 当为“假”时中止);
			事件玩家.illari_i[0] = 射线命中玩家(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 20, 所有存活玩家(所在队伍(事件玩家)), 事件玩家, 假);
			If(实体存在(事件玩家.illari_i[0]));
				为玩家添加生命池(事件玩家.illari_i[0], 生命值, 10, 假, 假);
				事件玩家.illari_i[0].sys_default_status_pool[数量(事件玩家.illari_i[0].sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.00);
			End;
		End;
	}
}

规则("伊拉锐-烈日强化")
{
	事件
	{
		玩家造成伤害;
		双方;
		全部;
	}

	条件
	{
		攻击方.illari_poison != 空;
		事件伤害 > 10;
		事件技能 != 空;
		// (事件技能 == 按钮(主要攻击模式) || 事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(近身攻击) || (数量(已过滤的数组(全局.ch_normal_attack_dist, 当前数组元素[0] == 所用英雄(事件玩家) && 当前数组元素[1] == 事件技能)) > 0)) == 真;
		(
			事件技能 == 按钮(近身攻击) ||
			数量(已过滤的数组(全局.ch_normal_attack_dist, 当前数组元素[0] == 所用英雄(攻击方) && (当前数组元素[1] == 空 || 数组包含(当前数组元素, 事件技能)))) > 0
		) == 真;
	}

	动作
	{
		伤害(被攻击方, 攻击方.illari_poison, 较小(事件伤害 * 0.5, 100));
		攻击方.illari_poison = 空;
	}
}

规则("伊拉锐-桎梏灼日")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		伊拉锐;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		事件玩家.illari_i[1] = 总计消耗时间;
		While(存活(事件玩家) && (总计消耗时间 - 事件玩家.illari_i[1] <= 6.0));
			播放效果(所有玩家(所有队伍), 环状爆炸, 颜色(黄色), 所选位置(事件玩家) + 上 * 1, 10);
			// 范围内玩家(眼睛位置(事件玩家), 25, 所在队伍(事件玩家), 表面及敌方屏障).sys_softirq[21] = 事件玩家;
			已过滤的数组(
				所有存活玩家(所在队伍(事件玩家)),
				相距距离(矢量(X方向分量(眼睛位置(事件玩家)), 0, Z方向分量(眼睛位置(事件玩家))), 矢量(X方向分量(所选位置(当前数组元素)), 0, Z方向分量(所选位置(当前数组元素)))) <= 10.0 && 在视线内(眼睛位置(事件玩家), 所选位置(当前数组元素), 敌方屏障阻挡视线)
			).sys_softirq[21] = 事件玩家;
			等待(1.0, 无视条件);
		End;
	}
}

规则("伊拉锐-桎梏灼日")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[21] != 空;
	}

	动作
	{
		事件玩家.sys_softirq[21] = 空;
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Captive Sun"))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Captive Sun"))[0][1]);
			为玩家添加生命池(事件玩家, 生命值, 100, 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Captive Sun") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 空, 自定义字符串("Illari Captive Sun")) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Illari Captive Sun"))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 100, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 空, 自定义字符串("Illari Captive Sun"));
		End;
	}
}

规则("拉玛刹-坦克杀手")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家)) == 真;
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Ramattra Inc"))) <= 0;
	}

	动作
	{
		// 开始伤害调整(逐帧更新(已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 类型的生命值(当前数组元素, 护甲) > 0 && 类型的生命值(当前数组元素, 护盾) <= 0)), 事件玩家, 145, 受伤害者和伤害者);
		开始伤害调整(逐帧更新(已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 类型的生命值(当前数组元素, 护盾) > 0)), 事件玩家, 115, 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(拉玛刹), 自定义字符串("Ramattra Inc"));
		等待直到(!(正在使用技能 1(事件玩家) || 正在使用终极技能(事件玩家)), 99999);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Ramattra Inc") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("拉玛刹-回复引擎")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("LamaText"))) <= 0;
	}

	动作
	{
		创建进度条地图文本(
			事件玩家, 事件玩家.ramattra_absorb[0] / 1.25, 自定义字符串("{0}", 技能图标字符串(英雄(禅雅塔), 按钮(技能1))),
			逐帧更新(眼睛位置(事件玩家) + 100 * (-1.000 * 与此角度的相对方向(与此方向的水平角度(面朝方向(事件玩家)), 与此方向的垂直角度(面朝方向(事件玩家)) - 90) + 3 * 面朝方向(事件玩家))),
			1.0, 不要截取, 颜色(白色), 颜色(白色), 可见，位置和值, 默认可见度);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_map_line_text, 上一个文本ID, 总计消耗时间, -1, 英雄(拉玛刹), 自定义字符串("LamaText"));
	}
}

规则("拉玛刹-回复引擎-吸血")
{
	事件
	{
		玩家造成伤害;
		双方;
		拉玛刹;
	}

	条件
	{
		(正在使用终极技能(攻击方) || 正在使用技能 1(攻击方) || (事件技能 == 按钮(技能2))) == 真;
	}

	动作
	{
		攻击方.ramattra_absorb[0] = 较小(125, 攻击方.ramattra_absorb[0] + 事件伤害 * 0.75);
	}
}

规则("拉玛刹-回复引擎-回血")
{
	事件
	{
		子程序;
		cb_ramattra_overheal;
	}

	动作
	{
		If(事件玩家.ramattra_absorb[2] != 空);
			停止持续治疗(事件玩家.ramattra_absorb[2]);
			事件玩家.ramattra_absorb[2] = 空;
		End;

		If(事件玩家.ramattra_absorb[0] <= 0);
			中止;
		End;

		事件玩家.ramattra_absorb[1] = 较大(5, 较小(25, 事件玩家.ramattra_absorb[0] * 0.2));
		事件玩家.ramattra_absorb[0] = 较大(0, 事件玩家.ramattra_absorb[0]-事件玩家.ramattra_absorb[1]);

		// 治疗(事件玩家, 事件玩家, 事件玩家.ramattra_absorb[1]);
		开始持续治疗(事件玩家, 事件玩家, 0.5, 事件玩家.ramattra_absorb[1] / 0.2);
		事件玩家.ramattra_absorb[2] = 上一个持续治疗效果ID;

		If(标准化生命值(事件玩家) >= 1.0 && (正在使用终极技能(事件玩家) || 正在使用技能 1(事件玩家)));
			If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("RamattraOH {0}", 事件玩家.ramattra_absorb[3]))) == 1);
				移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("RamattraOH {0}", 事件玩家.ramattra_absorb[3]))[0][1]);
				为玩家添加生命池(事件玩家, 生命值, 事件玩家.ramattra_absorb[1], 假, 假);
				事件玩家.sys_default_status_pool = 映射的数组(
					事件玩家.sys_default_status_pool,
					当前数组元素[5] == 自定义字符串("RamattraOH {0}", 事件玩家.ramattra_absorb[3]) ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 英雄(拉玛刹), 自定义字符串("RamattraOH {0}", 事件玩家.ramattra_absorb[3])) : 当前数组元素
				);
			Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("RamattraOH {0}", 事件玩家.ramattra_absorb[3]))) == 0);
				为玩家添加生命池(事件玩家, 生命值, 事件玩家.ramattra_absorb[1], 假, 假);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 6, 英雄(拉玛刹), 自定义字符串("RamattraOH {0}", 事件玩家.ramattra_absorb[3]));
			End;
			事件玩家.ramattra_absorb[3] = (事件玩家.ramattra_absorb[3] + 1) % 15;
		End;
	}
}

规则("拉玛刹-回复引擎")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		存活(事件玩家) == 真;
	}

	动作
	{
		While(真);
			If(事件玩家.ramattra_absorb[0] < 25);
				事件玩家.ramattra_absorb[0] = 25;
			End;
			调用子程序(cb_ramattra_overheal);
			等待(0.2, 当为“假”时中止);
			调用子程序(cb_ramattra_overheal);
			等待(0.2, 当为“假”时中止);
			调用子程序(cb_ramattra_overheal);
			等待(0.2, 当为“假”时中止);
			调用子程序(cb_ramattra_overheal);
			等待(0.2, 当为“假”时中止);
			调用子程序(cb_ramattra_overheal);
			等待(0.2, 当为“假”时中止);
		End;
	}
}

规则("莱因哈特-被动-守护-伤害累计")
{
	事件
	{
		玩家受到伤害;
		双方;
		莱因哈特;
	}

	动作
	{
		If(被攻击方.reinhardt_shield[1] + 事件伤害 > 生命值(被攻击方) * 0.300);
			被攻击方.reinhardt_shield = 数组(0, 0);

			事件玩家.i_sys_speed += 30;
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 30), 总计消耗时间, 5.00, 英雄(莱因哈特), 空);

			为玩家添加生命池(被攻击方, 护甲, 15 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.02, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 2.50, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 15 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.02, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.00, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 15 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.02, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 3.50, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 15 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.02, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4.00, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 15 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.02, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4.50, 英雄(莱因哈特));
			为玩家添加生命池(被攻击方, 护甲, 15 + (最大生命值(被攻击方) - 生命值(被攻击方)) * 0.02, 假, 假);
			被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5.00, 英雄(莱因哈特));

			等待(10, 当为“假”时中止);
		End;
			被攻击方.reinhardt_shield = 数组(3, 被攻击方.reinhardt_shield[1] + 事件伤害);
		Else;
	}
}

