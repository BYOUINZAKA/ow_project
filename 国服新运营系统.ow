规则("卢西奥-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卢西奥;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		开始伤害调整(事件玩家, 所有玩家(所有队伍), 50, 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 1, 英雄(卢西奥), 空);

		等待直到(具有状态(事件玩家, 定身) || 在地面上(事件玩家) || !正在使用终极技能(事件玩家) || !存活(事件玩家), 999);
		If(存活(事件玩家) && (在地面上(事件玩家) || 具有状态(事件玩家, 定身)) && 正在使用终极技能(事件玩家));
			等待(0.5, 无视条件);
			If(存活(事件玩家) && 正在使用终极技能(事件玩家));
				事件玩家.lucio_debuff_clear = 已过滤的数组(范围内玩家(事件玩家, 30, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素));
				事件玩家.lucio_debuff_clear.a_sys_user_status[全局.t_enum_status_immunity] += 1;
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_immunity, 事件玩家.lucio_debuff_clear, 总计消耗时间, 6.00, 英雄(卢西奥), 自定义字符串("Lucio Sound Barrier"));

				等待直到(!正在使用技能 2(事件玩家), 5.0);
				设置技能冷却(事件玩家, 按钮(技能2), 0);
			End;
		End;
	}
}

