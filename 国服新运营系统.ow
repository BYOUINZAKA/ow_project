规则("堡垒-坦克炮弹")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		堡垒;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
		正在使用主要武器(事件玩家) == 真;
	}

	动作
	{
		While(正在使用技能 1(事件玩家) && 正在使用主要武器(事件玩家));
			If(随机实数(0, 1) < 水平速度(事件玩家) * 0.160);
				创建弹道(“法老之鹰”火箭, 事件玩家, 眼睛位置(事件玩家), 面朝方向(事件玩家), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 25 + 最大生命值(事件玩家) * 0.080, 0.500, 3, 有害爆炸, 爆炸声音, 0, 60, 3, 0, 0, 0);
			End;
			等待(0.550, 无视条件);
		End;
	}
}

规则("路霸-文字")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		路霸;
	}

	动作
	{
		创建HUD文本(事件玩家, 自定义字符串(""), 自定义字符串("单打独斗 强化：{0}% 强化近身攻击：{1}%", 数量(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.roadhog_mates_flag == 真)) * 8, (数量(
			已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.roadhog_mates_flag == 真)) + 1) * 5), 自定义字符串(""), 顶部, 0, 颜色(白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
		事件玩家.sys_self_text = 数组(所用英雄(事件玩家), 上一个文本ID);
	}
}

规则("路霸-呼吸机")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		路霸;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
	}

	动作
	{
		事件玩家.i_sys_speed += 30;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 30), 总计消耗时间, -1, 英雄(路霸), 自定义字符串("Roadhog Speed"));

		While(正在使用辅助武器(事件玩家));
            等待直到(!正在使用辅助武器(事件玩家), 0.5);
			设置弹药(事件玩家, 0, 较小(弹药(事件玩家, 0) + 1, 最大弹药(事件玩家, 0)));
			已过滤的数组(范围内玩家(眼睛位置(事件玩家), 8.00, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素)).sys_softirq[18] = 真;
		End;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Roadhog Speed") ? 数组分割(当前数组元素, 0,
			2) : 当前数组元素);
	}
}

规则("路霸-叠甲")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[18] != 空;
	}

	动作
	{
		事件玩家.sys_softirq[18] = 空;
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Roadhog Overheal {0}", 事件玩家.roadhog_index))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Roadhog Overheal {0}", 事件玩家.roadhog_index))[0][1]);
			为玩家添加生命池(事件玩家, 生命值, 20, 假, 假);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Roadhog Overheal {0}", 事件玩家.roadhog_index) ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5, 空, 自定义字符串("Roadhog Overheal {0}", 事件玩家.roadhog_index)) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Roadhog Overheal {0}", 事件玩家.roadhog_index))) == 0);
			为玩家添加生命池(事件玩家, 生命值, 20, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5, 空, 自定义字符串("Roadhog Overheal {0}", 事件玩家.roadhog_index));
		End;
		事件玩家.roadhog_index = (事件玩家.roadhog_index + 1) % 5;
	}
}

规则("路霸-被动-单打独斗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		路霸;
	}

	条件
	{
		数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Roadhog Alone"))) <= 0;
	}

	动作
	{
		开始伤害调整(所有玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 100 + 数量(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.roadhog_mates_flag == 真)) * 8, 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(路霸), 自定义字符串(
			"Roadhog Alone"));

		开始伤害调整(事件玩家, 所有玩家(所有队伍), 100 - 数量(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.roadhog_mates_flag == 真)) * 8, 受伤害者，伤害者及伤害百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 英雄(路霸), 自定义字符串(
			"Roadhog Alone"));

		开始治疗调整(事件玩家, 所有玩家(所有队伍), 100 + 数量(已过滤的数组(所有玩家(所在队伍(事件玩家)), 当前数组元素.roadhog_mates_flag == 真)) * 8, 受治疗者，治疗者及治疗百分比);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, -1, 英雄(路霸), 自定义字符串(
			"Roadhog Alone"));
	}
}

