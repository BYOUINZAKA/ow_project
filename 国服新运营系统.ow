	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		事件玩家.d_sys_ability_timer = 30;
	}
}

规则("易伤清理")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		具有状态(事件玩家, 相移) == 真;
		在重生室中(事件玩家) != 真;
	}

	动作
	{
		事件玩家.sys_no_effect_cnt = 总计消耗时间;
        等待直到(!具有状态(事件玩家, 相移), 0.51);
        If(存活(事件玩家) && 具有状态(事件玩家, 相移));
            事件玩家.a_sys_user_status[全局.t_enum_status_immunity] += 1;
            // 事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Debuff")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
            // 清除状态(事件玩家, 沉睡);
            // 清除状态(事件玩家, 击倒);
            // 清除状态(事件玩家, 击晕);
            // 清除状态(事件玩家, 定身);
            // 清除状态(事件玩家, 燃烧);
            // 清除状态(事件玩家, 被入侵);
            等待直到(!具有状态(事件玩家, 相移), 99999);
			If(数量(已过滤的数组(所有玩家(所在队伍(事件玩家)), 所用英雄(当前数组元素) == 英雄(雾子))) && (总计消耗时间 - 事件玩家.sys_no_effect_cnt) > 0.62 && (总计消耗时间 - 事件玩家.sys_no_effect_cnt) < 0.68);
				事件玩家.sys_softirq[19] += 1;
			End;
            事件玩家.a_sys_user_status[全局.t_enum_status_immunity] -= 1;
        End;
	}
}

规则("sys_speed")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			等待直到 (事件玩家.i_sys_pre_speed != 事件玩家.i_sys_speed, 9999);
			设置移动速度(事件玩家, 100 + 较小(事件玩家.i_sys_speed, 125));
			事件玩家.i_sys_pre_speed = 事件玩家.i_sys_speed;
			// 等待(0.0, 无视条件);
			// 等待直到(服务器负载平均值 <= 250, 3.0);
		End;
	}
}

