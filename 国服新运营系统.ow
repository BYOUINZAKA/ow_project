规则("拉玛刹-过度治疗")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		数量(事件玩家.ramattra_absorb) > 0;
	}

	动作
	{
		While(数量(事件玩家.ramattra_absorb) > 0);
			等待直到(标准化生命值(事件玩家) >= 1.0 && 对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[0] == 全局.t_enum_heal_continued && 当前数组元素[6] == 10), 1.0);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, (当前数组元素[0] == 全局.t_enum_heal_continued && 当前数组元素[6] == 10) ? 数组(0-当前数组元素[0], 当前数组元素[1], 当前数组元素[2], 当前数组元素[3], 当前数组元素[4], 当前数组元素[5], 当前数组元素[6], 当前数组元素[7]) : 当前数组元素);
			等待(0.0, 无视条件);
		End;

		事件玩家.ramattra_absorb = 空;
	}
}

规则("拉玛刹-过度治疗-callback")
{
	事件
	{
		子程序;
		cb_ramattra_overheal;
	}

	动作
	{
		If(事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][0] != 0 - 全局.t_enum_heal_continued || 标准化生命值(事件玩家) < 1.0 || 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][7] <= 1 || 所用英雄(事件玩家) != 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][4]);
			中止;
		End;

		If(总计消耗时间 - 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2] >= 1.0);
			中止;
		End;

		为玩家添加生命池(事件玩家, 生命值, 0.5 * 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][7] * 较大(0, 1.0 - (总计消耗时间 - 事件玩家.sys_default_status_pool[事件玩家.sys_default_status_pool_i][2])), 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5.0, 所用英雄(事件玩家));
	}
}

规则("拉玛刹-吸血循环")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		拉玛刹;
	}

	条件
	{
		数量(事件玩家.ramattra_absorb) > 0;
	}

	动作
	{
		While(数量(事件玩家.ramattra_absorb) > 0);
			等待直到(!(正在使用终极技能(事件玩家) || 正在使用技能 1(事件玩家)) || 正在使用主要武器(事件玩家), 5.0);
			等待(0.15, 无视条件);
			If(事件玩家.ramattra_absorb[1] > 0);
				开始持续治疗(事件玩家, 事件玩家, 1.0, 事件玩家.ramattra_absorb[1]);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_continued, 上一个持续治疗效果ID, 总计消耗时间, 1.0, 英雄(拉玛刹), 空, 10, 事件玩家.ramattra_absorb[1]);
				事件玩家.ramattra_absorb[1] = 0.0;
			End;
			// 等待(全局.args_ramattra[2], 当为“假”时中止);
		End;
	}
}

规则("拉玛刹-吸血")
