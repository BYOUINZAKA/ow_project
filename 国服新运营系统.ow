规则("末日铁拳-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		末日铁拳;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		While(正在使用终极技能(事件玩家));
			取消主要动作(事件玩家);
			设置终极技能充能(事件玩家, 0);
			施加推力(事件玩家, 下, 1.0, 至地图, 取消相反运动);
			// 传送(事件玩家, 最近的可行走位置(事件玩家));
			等待直到(!正在使用终极技能(事件玩家), 0.1);
		End;

		设置启用终极技能(事件玩家, 假);

		If(全局.args_system[4]);
			为玩家添加生命池(事件玩家, 护盾, 500, 真, 真);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));
		Else;
			为玩家添加生命池(事件玩家, 生命值, 500, 假, 假);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));
		End;

		事件玩家.d_sys_cd += 0.5;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_move_cd, 数组(事件玩家, 0.5), 总计消耗时间, 4, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));

		事件玩家.i_sys_speed += 30;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 20), 总计消耗时间, 3.00, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 10), 总计消耗时间, 3.50, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));

		创建效果(所有玩家(所有队伍), 有益光环, 颜色(天蓝色), 事件玩家, 3.0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 4, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));

		创建效果(事件玩家, 有益光环声音, 颜色(天蓝色), 事件玩家, 100, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 4, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));

		创建效果(所有玩家(所有队伍), 环, 颜色(天蓝色), 最近的可行走位置(事件玩家), 10.0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 4, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));

		创建效果(类型的生命值(事件玩家, 护盾) > 0 ? 所有玩家(所有队伍) : 空, “破坏球”感应护盾目标效果, 所在队伍(事件玩家), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 4, 英雄(末日铁拳), 自定义字符串("DoomfistQ"));

		等待(全局.args_system[4] ? 3.5 : 4.0, 无视条件);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, (当前数组元素[5] == 自定义字符串("DoomfistQ")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);

		设置启用终极技能(事件玩家, 真);

		If(存活(事件玩家));
			治疗(事件玩家, 事件玩家, 600);
			伤害(范围内玩家(眼睛位置(事件玩家), 10.0, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 100);
			设置状态(范围内玩家(眼睛位置(事件玩家), 10.0, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 击倒, 1.0);
			伤害(范围内玩家(眼睛位置(事件玩家), 3.0, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 300);
			设置状态(范围内玩家(眼睛位置(事件玩家), 3.0, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 击倒, 2.5);
		End;
	}
}

规则("回声-Q")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		回声;
	}

	条件
	{
		正在人格复制(事件玩家) == 真;
	}

	动作
	{
		为玩家添加生命池(事件玩家, 生命值, 400, 假, 假);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 4, 英雄(回声), 自定义字符串("Echo Q"));

		事件玩家.i_sys_speed += 30;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 30), 总计消耗时间, 3.00, 英雄(回声), 自定义字符串("Echo Q"));

		事件玩家.i_sys_speed += 20;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 20), 总计消耗时间, 3.50, 英雄(回声), 自定义字符串("Echo Q"));

		创建效果(所有玩家(所有队伍), “破坏球”感应护盾目标效果, 颜色(天蓝色), 事件玩家, 0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 4, 英雄(回声), 自定义字符串("Echo Q"));

		创建效果(事件玩家, 有益光环声音, 颜色(天蓝色), 事件玩家, 100, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 4, 英雄(回声), 自定义字符串("Echo Q"));

		创建效果(所有玩家(所有队伍), 环, 颜色(天蓝色), 最近的可行走位置(事件玩家), 8.0, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 4, 英雄(回声), 自定义字符串("Echo Q"));

		等待(3.5, 无视条件);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, (当前数组元素[5] == 自定义字符串("Echo Q")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);

		If(存活(事件玩家));
			治疗(事件玩家, 事件玩家, 250);
			伤害(范围内玩家(眼睛位置(事件玩家), 8.0, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 100);
			设置状态(范围内玩家(眼睛位置(事件玩家), 8.0, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 事件玩家, 击倒, 1.5);
		End;

		等待直到(!正在人格复制(事件玩家), 18);
		If(存活(事件玩家) && !正在人格复制(事件玩家));
			等待(0.9, 无视条件);
			治疗(事件玩家, 事件玩家, 250);
		End;
	}
}

规则("回声-标记")
{
	事件
	{
		玩家造成伤害;
		双方;
		回声;
	}

	条件
	{
		(事件技能 == 按钮(主要攻击模式) || 事件技能 == 按钮(辅助攻击模式) || 事件技能 == 按钮(近身攻击) || 事件技能 == 按钮(技能2)) == 真;
		攻击方 != 被攻击方;
	}

	动作
	{
		// 被攻击方.echo_target = 数组(被攻击方.echo_target[0]+((事件技能 == 按钮(主要攻击模式) || 正在人格复制(事件玩家)) ? 0.5 : 1.0), 被攻击方.echo_target[1]+事件伤害);
		被攻击方.echo_target = 数组(被攻击方.echo_target[0]+1.0, 被攻击方.echo_target[1]+事件伤害);
		If(被攻击方.echo_target[0] >= 3 && 被攻击方.echo_target[1] > 0);
			伤害(被攻击方, 攻击方, (被攻击方.echo_target[1]) * 0.5);
			被攻击方.echo_target = 数组(0, 0);
		End;
	}
}

规则("回声-回复")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		回声;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
		正在人格复制(事件玩家) != 真;
	}

	动作
	{
		开始持续治疗(事件玩家, 事件玩家, 2.0, 30);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_heal_continued, 上一个持续治疗效果ID, 总计消耗时间, 2.0, 英雄(回声), 自定义字符串("Echo Recover"));
		等待直到(!正在使用技能 2(事件玩家), 2.0);
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Echo Recover") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

