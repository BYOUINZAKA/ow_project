			设置启用技能 1(事件玩家, 真);
			开始按下按钮(事件玩家, 按钮(技能1));
			等待直到(正在使用技能 1(事件玩家) != 真, 0.5);
		End;

		等待直到(所用英雄(事件玩家) != 英雄(卢西奥) || !存活(事件玩家) || 正在使用技能 1(事件玩家) == 真, 99999);
		停止按下按钮(事件玩家, 按钮(技能1));
		设置启用技能 1(事件玩家, 真);
		如条件为“真”则循环;
	}
}

