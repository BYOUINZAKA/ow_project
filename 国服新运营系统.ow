		(事件玩家.kiriko_headshots == 空) == 真;
	}

	动作
	{
		事件玩家.kiriko_headshots = 数组(已过滤的数组(所有玩家(所在队伍(事件玩家)), 所用英雄(当前数组元素) == 英雄(雾子))[0], 0);
	}
}

