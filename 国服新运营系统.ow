规则("路霸-AI-出勾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		路霸;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		// 数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 12), 存活(当前数组元素) && 相距距离(眼睛位置(事件玩家), 眼睛位置(当前数组元素)) <= 20 && 在视线内(眼睛位置(事件玩家), 眼睛位置(当前数组元素), 敌方屏障阻挡视线))) > 0;
		数量(已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 在视野内(事件玩家, 所选位置(当前数组元素) + 上 * 0.5 + 速率(当前数组元素) * (相距距离(眼睛位置(事件玩家), 所选位置(当前数组元素) + 上 * 0.5) / 62), 12) && 相距距离(眼睛位置(事件玩家), 眼睛位置(当前数组元素)) <= 20 && 在视线内(眼睛位置(事件玩家), 眼睛位置(当前数组元素), 敌方屏障阻挡视线))) > 0;
		正在装填(事件玩家) != 真;
		按钮被按下(事件玩家, 按钮(技能2)) != 真;
		弹药(事件玩家, 0) > 0;
		技能冷却时间(事件玩家, 按钮(技能1)) <= 0;
	}

	动作
	{
		禁用按钮(事件玩家, 按钮(技能2));
		可用按钮(事件玩家, 按钮(技能1));
		开始按下按钮(事件玩家, 按钮(技能1));
		等待(0.1, 无视条件);
		停止按下按钮(事件玩家, 按钮(技能1));
		等待直到(!正在使用技能 1(事件玩家), 1.0);
		开始按下按钮(事件玩家, 按钮(主要攻击模式));
		等待(0.1, 无视条件);
		停止按下按钮(事件玩家, 按钮(主要攻击模式));
		等待直到(!正在使用主要武器(事件玩家), 0.5);
		开始按下按钮(事件玩家, 按钮(近身攻击));
		等待(0.1, 无视条件);
		停止按下按钮(事件玩家, 按钮(近身攻击));
		等待(0.6, 无视条件);
		可用按钮(事件玩家, 按钮(技能2));
		禁用按钮(事件玩家, 按钮(技能1));
		如条件为“真”则循环;
	}
}

禁用 规则("路霸-AI-出勾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		路霸;
	}

	条件
	{
		事件玩家.sys_is_ai == 真;
		数量(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 12), 存活(当前数组元素) && 相距距离(眼睛位置(事件玩家), 眼睛位置(当前数组元素)) <= 20)) > 0;
		正在装填(事件玩家) != 真;
		按钮被按下(事件玩家, 按钮(技能2)) != 真;
		弹药(事件玩家, 0) > 0;
	}

	动作
	{
		事件玩家.W = 已排序的数组(已过滤的数组(视角中的玩家(事件玩家, 对方队伍(所在队伍(事件玩家)), 10), 存活(当前数组元素) && 相距距离(眼睛位置(事件玩家), 眼睛位置(当前数组元素)) <= 20), 相距距离(眼睛位置(事件玩家), 眼睛位置(当前数组元素)))[0];
		If(事件玩家.W == 空 || !实体存在(事件玩家.W) || !存活(事件玩家.W));
			等待(0.1, 无视条件);
			如条件为“真”则循环;
		End;

		If(技能冷却时间(事件玩家, 按钮(技能1)) <= 0 && 在视线内(眼睛位置(事件玩家), 眼睛位置(事件玩家.W), 敌方屏障阻挡视线) && 相距距离(眼睛位置(事件玩家), 眼睛位置(事件玩家.W)) <= 20);
			禁用按钮(事件玩家, 按钮(技能2));
			开始按下按钮(事件玩家, 按钮(技能1));
			等待(0.1, 无视条件);
			停止按下按钮(事件玩家, 按钮(技能1));
			等待直到(!正在使用技能 1(事件玩家), 1.0);
			开始按下按钮(事件玩家, 按钮(主要攻击模式));
			等待(0.1, 无视条件);
			停止按下按钮(事件玩家, 按钮(主要攻击模式));
			等待直到(!正在使用主要武器(事件玩家), 0.5);
			开始按下按钮(事件玩家, 按钮(近身攻击));
			等待(0.1, 无视条件);
			停止按下按钮(事件玩家, 按钮(近身攻击));
			等待(0.6, 无视条件);
			可用按钮(事件玩家, 按钮(技能2));
			如条件为“真”则循环;
		Else If(!正在使用终极技能(事件玩家) && 相距距离(眼睛位置(事件玩家), 眼睛位置(事件玩家.W)) > 8);
			禁用按钮(事件玩家, 按钮(技能2));
			禁用按钮(事件玩家, 按钮(主要攻击模式));
			开始按下按钮(事件玩家, 按钮(辅助攻击模式));
			等待(0.1, 无视条件);
			停止按下按钮(事件玩家, 按钮(辅助攻击模式));
			等待(0.6, 无视条件);
			可用按钮(事件玩家, 按钮(主要攻击模式));
			可用按钮(事件玩家, 按钮(技能2));
			如条件为“真”则循环;
		End;
	}
}

