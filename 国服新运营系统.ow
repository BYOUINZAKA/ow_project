规则("毛加-E-加速")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		存活(事件玩家) == 真;
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		事件玩家.mauga_range[2] = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 35, 对方队伍(所在队伍(事件玩家)), 表面及全部屏障), 存活(当前数组元素));
		事件玩家.mauga_range[2].mauga_flag[0] += 10;
		事件玩家.mauga_range[2].mauga_flag[1] = 事件玩家;
		事件玩家.mauga_range[2].mauga_flag[2] = 2.5;

		开始伤害调整(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 10.5, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素) && 事件玩家 != 当前数组元素), 所有玩家(所有队伍), 70, 受伤害者和伤害者);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3, 英雄(毛加), 自定义字符串("Mauga Cardiac Overdrive Heal"));

		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] += 1;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_immunity, 事件玩家, 总计消耗时间, 3, 英雄(毛加), 自定义字符串("Mauga Cardiac Overdrive Heal"));

		While(存活(事件玩家) && 正在使用技能 2(事件玩家));
			事件玩家.mauga_s_players = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 10.5, 所在队伍(事件玩家), 表面及敌方屏障), 存活(当前数组元素));
			事件玩家.mauga_s_players.sys_softirq[13] = 事件玩家;
	
			// 事件玩家.mauga_s_players = 已过滤的数组(事件玩家.mauga_s_players, 存活(当前数组元素) && !(当前数组元素 == 事件玩家 && 正在使用技能 1(当前数组元素)));
			事件玩家.mauga_s_players.i_sys_speed += 25;
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家.mauga_s_players, 25), 总计消耗时间, 0.5, 英雄(毛加), 自定义字符串("Mauga Cardiac Overdrive"));

			// 等待(0.5, 无视条件);
			// 等待直到 (!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mauga Cardiac Overdrive")), 0.5);
			等待直到(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mauga Cardiac Overdrive"))) <= 0, 0.5);
		End;

		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, (当前数组元素[5] == 自定义字符串("Mauga Cardiac Overdrive Heal")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("毛加-E-残留")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sys_softirq[13] != 空;
	}

	动作
	{
		If(事件玩家.mauga_e_record == 空);
			事件玩家.mauga_e_record = 数组(事件玩家.sys_softirq[13], 玩家数据(事件玩家, 承受伤害量));
			// 事件玩家.mauga_e_record = 数组(事件玩家.sys_softirq[13], 0);
		End;
		事件玩家.sys_softirq[13] = 空;
		等待(3.0, 无视条件);
		如条件为“真”则循环;
	}
}

规则("毛加-E-残留")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.mauga_e_record[0] != 空;
		实体存在(事件玩家.mauga_e_record[0]) == 真;
		正在使用技能 2(事件玩家.mauga_e_record[0]) != 真;
	}

	动作
	{
		If(玩家数据(事件玩家, 承受伤害量) != 空数组 && (玩家数据(事件玩家, 承受伤害量) - 事件玩家.mauga_e_record[1]) > 0);
			开始持续治疗(事件玩家, 事件玩家.mauga_e_record[0], 3.0, (玩家数据(事件玩家, 承受伤害量) - 事件玩家.mauga_e_record[1]) * 0.50 / 3.0);
			创建效果(所有玩家(所有队伍), 治疗目标激活效果, 颜色(白色), 事件玩家, 0, 可见，位置和半径);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 3.0, 空, 空);
		End;
		事件玩家.mauga_e_record = 空;
	}
}

规则("毛加-灼烧")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		存活(事件玩家) == 真;
		具有状态(事件玩家, 沉睡) != 真;
		具有状态(事件玩家, 被入侵) != 真;
		具有状态(事件玩家, 击倒) != 真;
		具有状态(事件玩家, 冰冻) != 真;
	}

	动作
	{
		While(真);
			事件玩家.mauga_range[0] = 已过滤的数组(范围内玩家(眼睛位置(事件玩家), 7.5, 对方队伍(所在队伍(事件玩家)), 表面及敌方屏障), 存活(当前数组元素));
			事件玩家.mauga_range[0].mauga_flag[0] += 2;
			事件玩家.mauga_range[0].mauga_flag[1] = 事件玩家;
			事件玩家.mauga_range[0].mauga_flag[2] = 2.5;
			等待(1.0, 当为“假”时中止);
			// 等待直到((数量(已过滤的数组(范围内玩家(眼睛位置(事件玩家), 10.5, 对方队伍(所在队伍(事件玩家)), 表面), 存活(当前数组元素))) > 0) || (!存活(事件玩家)), 99999);
		End;
	}
}

规则("毛加-灼烧")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		毛加;
	}

	条件
	{
		正在使用主要武器(事件玩家) == 真;
	}

	动作
	{
		While(存活(事件玩家));
			事件玩家.mauga_range[1] = 射线命中玩家(眼睛位置(事件玩家), 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 50, 所有存活玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 真);
			If(实体存在(事件玩家.mauga_range[1]));
				事件玩家.mauga_range[1].mauga_flag[0] += 2;
				事件玩家.mauga_range[1].mauga_flag[1] = 事件玩家;
				事件玩家.mauga_range[1].mauga_flag[2] = 2.5;
				// If(!具有状态(事件玩家.mauga_range[1], 燃烧));
				// 	伤害(事件玩家.mauga_range[1], 事件玩家, 5);
				// End;
			End;
			等待(0.2, 当为“假”时中止);
		End;
	}
}

