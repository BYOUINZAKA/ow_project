规则("系统-状态-复苏")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		死亡(事件玩家) == 真;
		事件玩家.a_sys_user_status[全局.t_enum_status_recover] > 0;
	}

	动作
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_recover] = 0;
		创建效果(所有玩家(所有队伍), 有害光环, 颜色(黄色), 事件玩家, 1.5, 可见，位置和半径);
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 1.5, 空, 自定义字符串("SYS_RECOVERED"));

		等待直到(!死亡(事件玩家), 1.5);

		If(死亡(事件玩家));
			传送(事件玩家, 最近的可行走位置(所选位置(事件玩家)));
			复活(事件玩家);
			设置状态(事件玩家, 事件玩家, 相移, 0.5);
			设置玩家生命值(事件玩家, 最大生命值(事件玩家) * 0.5);
		End;
	}
}

规则("系统-状态-复苏")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_recover] > 0;
	}

	动作
	{
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SYS_RECOVER_EFFECT"))) <= 0);
			创建效果(事件玩家.a_sys_user_status[全局.t_enum_status_recover] > 0 ? 所有玩家(所有队伍) : 空, “回声”复制效果, 颜色(白色), 事件玩家, 1.0, 可见，位置和半径);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 空, 自定义字符串("SYS_RECOVER_EFFECT"));
		End;
		等待(0.5, 无视条件);
		等待直到(
			数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SYS_RECOVER_EFFECT"))) <= 0 || 事件玩家.a_sys_user_status[全局.t_enum_status_recover] <= 0,
			9999
		);

		事件玩家.a_sys_user_status[全局.t_enum_status_recover] = 0;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SYS_RECOVER_EFFECT") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		等待直到(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("SYS_RECOVER_EFFECT"))) <= 0, 1.0);
		事件玩家.a_sys_user_status[全局.t_enum_status_recover] = 0;
	}
}

