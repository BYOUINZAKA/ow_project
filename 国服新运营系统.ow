规则("黑影-S")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑影;
	}

	条件
	{
		正在使用技能 1(事件玩家) == 真;
	}

	动作
	{
		取消主要动作(事件玩家);
		设置技能冷却(事件玩家, 按钮(技能1), 8.0);

		// 创建光束效果(所有玩家(所有队伍), 有害光束, 眼睛位置(事件玩家) + 下 * 0.5, 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 50, 颜色(紫色), 颜色);
		// 事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, 0.1, 英雄(黑影));
		// 伤害(射线命中玩家(眼睛位置(事件玩家) + 下 * 0.5, 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 50, 所有存活玩家(对方队伍(所在队伍(事件玩家))), 事件玩家, 假), 事件玩家, 100);

		// 创建弹道(查莉娅粒子炮, 事件玩家, 眼睛位置(事件玩家), 面朝方向(事件玩家), 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 100, 1.0, 0, 有益爆炸, 爆炸声音, 0.1, 200, 1.0, 0, 0, 0);

		创建弹道(查莉娅粒子炮, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(0, 0.010, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 35, 1.0, 0, 有益爆炸, 爆炸声音, 0.05, 200, 1.0, 0, 0, 0);
		创建弹道(查莉娅粒子炮, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(0.01137, -0.010, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 35, 1.0, 0, 有益爆炸, 爆炸声音, 0.05, 200, 1.0, 0, 0, 0);
		创建弹道(查莉娅粒子炮, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(-0.01137, -0.010, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 35, 1.0, 0, 有益爆炸, 爆炸声音, 0.05, 200, 1.0, 0, 0, 0);
	}
}

规则("黑影-伤害")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		所用英雄(攻击方) == 英雄(黑影);
		// (事件技能 == 按钮(技能1) || 事件技能 == 按钮(主要攻击模式)) == 真;
		事件玩家.sombra_hacked != 真;
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
	}

	动作
	{
		If(事件玩家.sombra_player == 空);
			事件玩家.sombra_player = 攻击方;
			事件玩家.sombra_demage = 事件技能 == 空 ? 事件伤害 * 0.75 : 事件伤害;
			事件玩家.sombra_timer = 3;
		Else If(事件玩家.sombra_player == 攻击方);
			事件玩家.sombra_demage += 事件技能 == 空 ? 事件伤害 * 0.75 : 事件伤害;
			事件玩家.sombra_timer = 3;
		Else;
			中止;
		End;
		// If(事件玩家.sombra_demage > 较大(最大生命值(事件玩家) * 0.4, 150));
		If(事件玩家.sombra_demage > 150);
			设置状态(事件玩家, 事件玩家.sombra_player, 被入侵, 数组包含(全局.sys_tank, 所用英雄(事件玩家)) ? 1.875 : 2.5);
			设置技能冷却(攻击方, 按钮(技能1), 0);
			事件玩家.sombra_hacked = 真;
			事件玩家.sombra_timer = 0;
			事件玩家.sombra_player = 空;
			事件玩家.sombra_demage = 0;
			等待(8, 无视条件);
			事件玩家.sombra_hacked = 假;
		End;
	}
}

规则("黑影-计时")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.sombra_player != 空;
		事件玩家.sombra_demage > 0;
		事件玩家.sombra_timer > 0;
		事件玩家.sombra_hacked != 真;
	}

	动作
	{
		While(事件玩家.sombra_timer > 0);
			等待直到 (事件玩家.sombra_timer <= 0, 1);
			事件玩家.sombra_timer -= 1;
		End;
		事件玩家.sombra_player = 空;
		事件玩家.sombra_demage = 0;
	}
}

规则("黑影-病毒装甲")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑影;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
	}

	动作
	{
		事件玩家.sys_softirq[10] = 所选位置(事件玩家);
		If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sombra Translocator"))) == 1);
			移除玩家的生命池(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sombra Translocator"))[0][1]);
			为玩家添加生命池(事件玩家, 护盾, 50, 真, 真);
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sombra Translocator") ? 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5.0, 英雄(黑影), 自定义字符串("Sombra Translocator")) : 当前数组元素);
		Else If(数量(已过滤的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Sombra Translocator"))) == 0);
			为玩家添加生命池(事件玩家, 护盾, 50, 真, 真);
			事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_hp_pool, 最后创建的生命池, 总计消耗时间, 5.0, 英雄(黑影), 自定义字符串("Sombra Translocator"));
		End;

		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] += 1;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_status_immunity, 事件玩家, 总计消耗时间, 1.0, 英雄(黑影));

		等待直到(!正在使用技能 2(事件玩家), 1.0);
		// 传送(事件玩家, 事件玩家.sys_softirq[10]);
		创建弹道(查莉娅粒子炮, 事件玩家, 空, 下, 至地图, 伤害, 对方队伍(所在队伍(事件玩家)), 50, 1.0, 5.0, 有益爆炸, 爆炸声音, 0.5, 50, 1.0, 0, 0, 0);
		设置弹药(事件玩家, 0, 最大弹药(事件玩家, 0));
	}
}

规则("黑影-电磁脉冲-清理")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑影;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
	}

	动作
	{
		事件玩家.sombra_emp_temp = 已过滤的数组(所有玩家(对方队伍(所在队伍(事件玩家))), 所用英雄(当前数组元素) == 英雄(美) && 当前数组元素.mei_Q_center != 空 && 当前数组元素.mei_Q_vec != 空)[0];

		If(事件玩家.sombra_emp_temp != 空 && 相距距离(事件玩家, 事件玩家.sombra_emp_temp.mei_Q_center) < 15);
			事件玩家.sombra_emp_temp.sys_default_status_pool = 映射的数组(事件玩家.sombra_emp_temp.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Mei Orbital Ray") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
			事件玩家.sombra_emp_temp.mei_Q_center = 空;
			事件玩家.sombra_emp_temp.mei_Q_vec = 空;
		End;
	}
}

规则("黑影-电磁脉冲")
{
	事件
	{
		玩家造成伤害;
		双方;
		黑影;
	}

	条件
	{
		事件技能 == 按钮(终极技能);
		被攻击方.a_sys_user_status[全局.t_enum_status_immunity] <= 0;
	}

	动作
	{
		设置状态(范围内玩家(眼睛位置(被攻击方), 5, 所在队伍(被攻击方), 表面), 攻击方, 被入侵, 2.5);

		开始伤害调整(被攻击方, 所有玩家(所有队伍), 120, 无);
		被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, 3.0, 空, 自定义字符串("Sombra EMP Debuff"));

		开始治疗调整(被攻击方, 所有玩家(所有队伍), 80, 全部禁用);
		被攻击方.sys_default_status_pool[数量(被攻击方.sys_default_status_pool)] = 数组(全局.t_enum_heal_adjust, 上一个治疗调整ID, 总计消耗时间, 3.0, 空, 自定义字符串("Sombra EMP Debuff"));

		被攻击方.sys_default_status_pool = 映射的数组(被攻击方.sys_default_status_pool, 当前数组元素[0] == 全局.t_enum_status_recover ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);

		伤害(范围内玩家(眼睛位置(被攻击方), 5, 所在队伍(被攻击方), 表面), 攻击方, 事件伤害 * 0.25);
	}
}

规则("黑影-主武器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑影;
	}

	条件
	{
		正在使用主要武器(事件玩家) == 真;
	}

	动作
	{
		While(真);
			创建弹道(拉玛刹吞噬漩涡能量球, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(0, 0.010, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 6.0, 2, 0, 有益爆炸, 爆炸声音, 0, 75, 0.26, 0, 0, 0);
			创建弹道(拉玛刹吞噬漩涡能量球, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(0.01137, -0.010, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 6.0, 2, 0, 有益爆炸, 爆炸声音, 0, 75, 0.26, 0, 0, 0);
			创建弹道(拉玛刹吞噬漩涡能量球, 事件玩家, 空, 本地矢量(面朝方向(事件玩家), 事件玩家, 旋转) + 矢量(-0.01137, -0.010, 0), 至玩家, 伤害, 对方队伍(所在队伍(事件玩家)), 6.0, 2, 0, 有益爆炸, 爆炸声音, 0, 75, 0.26, 0, 0, 0);

			等待(0.3, 当为“假”时中止);
		End;
	}
}

规则("黑影-副武器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑影;
	}

	条件
	{
		正在使用辅助武器(事件玩家) == 真;
	}

	动作
	{
		设置状态(事件玩家, 事件玩家, 相移, 0.5);
		事件玩家.i_sys_speed += 45;
		事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_speed, 数组(事件玩家, 45), 总计消耗时间, 1.5, 英雄(黑影), 空);

		等待直到(!正在使用辅助武器(事件玩家) || !按钮被按下(事件玩家, 按钮(辅助攻击模式)), 99999);
		If(技能冷却时间(事件玩家, 按钮(辅助攻击模式)) <= 0);
			设置技能冷却(事件玩家, 按钮(辅助攻击模式), 5);
		End;
		清除状态(事件玩家, 相移);
	}
}

规则("黑影-副武器")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		黑影;
	}

	条件
	{
