规则("卢西奥-被动-冷静光环")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		卢西奥;
	}

	条件
	{
		存活(事件玩家) == 真;
		正在使用技能 1(事件玩家) != 真;
