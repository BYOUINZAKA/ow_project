		启用查看器录制;
		记入查看器(自定义字符串("Ultra: {0},{1},{2}", 事件玩家, 事件玩家.sys_ultra_lock[0], 事件玩家.sys_ultra_lock[1]));
		禁用查看器录制;
	}
}

规则("系统-状态-荆棘")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		被攻击方.a_sys_user_status[全局.t_enum_status_thorns] > 0;
		(攻击方.a_sys_user_status[全局.t_enum_status_thorns] <= 0.0 || 事件技能 != 空) == 真;
		事件伤害 > 1.0;
	}

	动作
	{
		伤害(攻击方, 被攻击方, 较小(被攻击方.a_sys_user_status[全局.t_enum_status_thorns], 1.0) * 事件伤害);
	}
}

规则("系统-状态-免控")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		(
			具有状态(事件玩家, 无敌) ||
			(正在使用技能 1(事件玩家) && 数组包含(数组(英雄(奥丽莎), 英雄(毛加), 英雄(查莉娅), 英雄(探奇)), 所用英雄(事件玩家))) ||
			(正在使用终极技能(事件玩家) && 数组包含(数组(英雄(奥丽莎)), 所用英雄(事件玩家)))
		) == 真;
	}

	动作
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] += 1;
		等待直到(
			!(
				具有状态(事件玩家, 无敌) ||
				(正在使用技能 1(事件玩家) && 数组包含(数组(英雄(奥丽莎), 英雄(毛加), 英雄(查莉娅), 英雄(探奇)), 所用英雄(事件玩家))) ||
				(正在使用终极技能(事件玩家) && 数组包含(数组(英雄(奥丽莎)), 所用英雄(事件玩家)))
			), 99999);
		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] -= 1;
	}
}

规则("系统-状态-免控")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0.0;
	}

	动作
	{
		设置受到的击退(事件玩家, 0);
		
		While(事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0.0);
			清除状态(事件玩家, 冰冻);
			清除状态(事件玩家, 沉睡);
			清除状态(事件玩家, 燃烧);
			清除状态(事件玩家, 击倒);
			清除状态(事件玩家, 击晕);
			清除状态(事件玩家, 被入侵);
			清除状态(事件玩家, 定身);
			事件玩家.wuyang_hit = 数组(0, 0);
			事件玩家.echo_target = 数组(0, 0);
			事件玩家.vendetta_vars[0] = 0;
			事件玩家.vendetta_vars[3] = 0;
			事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Debuff")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
			设置受到的击退(事件玩家, 0);
			等待(0.1, 无视条件);

			等待直到(事件玩家.a_sys_user_status[全局.t_enum_status_immunity] <= 0 || (具有状态(事件玩家, 冰冻) || 具有状态(事件玩家, 击倒) || 具有状态(事件玩家, 击晕) || 具有状态(事件玩家, 沉睡) || 具有状态(事件玩家, 燃烧) || 具有状态(事件玩家, 被入侵) || 具有状态(事件玩家, 定身) || 数量(已过滤的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Debuff")))) > 0) || 事件玩家.wuyang_hit[0] > 0 || 事件玩家.echo_target[0] > 0 || 事件玩家.vendetta_vars[0] + 事件玩家.vendetta_vars[3] > 0, 1);
		End;

		设置受到的击退(事件玩家, 100);
	}
}

规则("系统-状态-免控")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		(具有状态(事件玩家, 冰冻) || 具有状态(事件玩家, 击倒) || 具有状态(事件玩家, 击晕) || 具有状态(事件玩家, 沉睡) || 具有状态(事件玩家, 燃烧) || 具有状态(事件玩家, 被入侵) || 具有状态(事件玩家, 定身) || 数量(已过滤的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Debuff")))) > 0 || 事件玩家.wuyang_hit[0] > 0 || 事件玩家.echo_target[0] > 0 || 事件玩家.vendetta_vars[0] + 事件玩家.vendetta_vars[3] > 0) == 真;
		事件玩家.a_sys_user_status[全局.t_enum_status_immunity] > 0.0;
	}

	动作
	{
		清除状态(事件玩家, 冰冻);
		清除状态(事件玩家, 沉睡);
		清除状态(事件玩家, 燃烧);
		清除状态(事件玩家, 击倒);
		清除状态(事件玩家, 击晕);
		清除状态(事件玩家, 被入侵);
		清除状态(事件玩家, 定身);
		事件玩家.wuyang_hit = 数组(0, 0);
		事件玩家.echo_target = 数组(0, 0);
		事件玩家.vendetta_vars[0] = 0;
		事件玩家.vendetta_vars[3] = 0;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 字符串包含(当前数组元素[5], 自定义字符串("Debuff")) ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
	}
}

规则("系统-状态-金甲")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	条件
	{
		被攻击方.a_sys_user_status[全局.t_enum_status_golden] > 0;
	}

	动作
	{
		被攻击方.a_sys_user_status[全局.t_enum_status_golden] -= 1;
		等待(0.02, 无视条件);
	}
}

规则("系统-状态-金甲")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.a_sys_user_status[全局.t_enum_status_golden] > 0;
	}

	动作
	{
		While(事件玩家.a_sys_user_status[全局.t_enum_status_golden] > 0);
			If(!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Golden Armor")));
				开始伤害调整(事件玩家, 所有玩家(所有队伍), 1, 受伤害者和伤害者);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_damage_adjust, 上一个伤害调整ID, 总计消耗时间, -1, 空, 自定义字符串("Golden Armor"));
		
				创建效果(所有玩家(所有队伍), 巴蒂斯特维生力场保护效果, 颜色(橙色), 事件玩家, 1.0, 可见，位置和半径);
				事件玩家.sys_default_status_pool[数量(事件玩家.sys_default_status_pool)] = 数组(全局.t_enum_effect, 最后创建的实体, 总计消耗时间, -1, 空, 自定义字符串("Golden Armor"));
			End;
			等待直到(!对任意为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Golden Armor")) || 事件玩家.a_sys_user_status[全局.t_enum_status_golden] <= 0, 9999);
		End;

		事件玩家.a_sys_user_status[全局.t_enum_status_golden] = 0;
		事件玩家.sys_default_status_pool = 映射的数组(事件玩家.sys_default_status_pool, 当前数组元素[5] == 自定义字符串("Golden Armor") ? 数组分割(当前数组元素, 0, 2) : 当前数组元素);
		等待直到(对全部为“真”(事件玩家.sys_default_status_pool, 当前数组元素[5] != 自定义字符串("Golden Armor")), 1.0);
	}
}

